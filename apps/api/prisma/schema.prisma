  /// Ad/AdSpendDaily уже хранят расход по каждому объявлению. Эта колонка
  /// замыкает цепочку «объявление → лид → сделка» (ROMI по объявлению).
  /// Пишется ОДИН раз первым касанием и не перезаписывается: атрибуция — какое
  /// объявление ПРИВЕЛО человека, а не какое он видел последним.
  adExternalId       String?
  /// ctwa_clid из referral WhatsApp (04.10.2026) — «идентификатор клика по рекламе
  /// click-to-WhatsApp». Нужен, чтобы позже отдавать события («квалифицированный лид»)
  /// обратно в Meta через Conversions API; без него связь клик → клиент не замкнуть.
  /// Пишется ОДИН раз первым касанием, как adExternalId, и не перезаписывается.
  /// СЕЙЧАС ТОЛЬКО ХРАНИТСЯ: наружу не уходит и на ответы бота не влияет.
  adClickId          String?
  /// О ЧЁМ БЫЛА РЕКЛАМА, ПО КОТОРОЙ ЧЕЛОВЕК ПРИШЁЛ: "job" (вакансия) или
  /// "property" (объект). Пишется первым касанием и живёт весь разговор
  /// (17.09.2026). До этого признак вакансии существовал ровно ОДИН ход — на
  /// сообщении с referral (routes/webhooks.ts, adHint), и уже на втором ходе
  /// бот вёл кандидата по сценарию покупателя. Не Prisma-enum намеренно:
  /// значения проверяются кодом и появляются без миграции.
  adTopic            String?
  /// ОБЪЕКТ, ПО РЕКЛАМЕ КОТОРОГО ЧЕЛОВЕК НАПИСАЛ (17.09.2026, вечер). Пишется
  /// первым касанием и живёт весь разговор — как adTopic рядом. Нужен потому,
  /// что на шаблонную фразу с рекламы бот теперь отвечает НЕЙТРАЛЬНЫМ вопросом
  /// (решение владельца), и объект из объявления должен дождаться следующего
  /// хода, когда человек скажет, что ему нужно. Без него бот спрашивал «какую
  /// квартиру вы ищете» вместо разговора про ту самую квартиру из ролика.
  /// Не связь Prisma, а просто id: объект могут удалить, и падать из-за этого
  /// подсказке модели незачем (читатель проверяет deletedAt сам).
  adPropertyId       String?
  /// НАКРУТКА ПОВТОРНОЙ ПЕРЕСЫЛКОЙ НЕРАСПОЗНАННОГО ВИДЕО (30.08.2026, живой лид
  /// «Муродали») — метка ставится один раз, когда бот дошёл до
  /// MAX_UNRESOLVED_SHARE_REPLIES (messengers/conversation.ts), и остаётся
  /// НАВСЕГДА: Instagram Messaging API не даёт заблокировать или пожаловаться
  /// на отправителя программно (это действие есть только внутри самого
  /// приложения Instagram) — значит единственное, что может сделать код, это
  /// перестать отвечать САМ и не забывать об этом решении при следующем
  /// сообщении того же subscriberId, даже если разговор к тому моменту
  /// выглядит иначе (архивирован, переоткрыт агентом и т.п.). null — диалог ни
  /// разу не переходил этот порог.
  spamFlaggedAt      DateTime?
  /// Почему именно — текст для сотрудника в инбоксе (см. saveIncoming рядом с
  /// spamFlaggedAt): без него отметка молчит о причине, и агент не поймёт,
  /// стоит ли идти в приложение Instagram блокировать этого человека руками.
  spamFlagReason     String?
  /// Объекты, о которых шла речь в этом диалоге (ConversationProperty).
  propertyLinks      ConversationProperty[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([channel, subscriberId])
  @@unique([endpointScopeId, subscriberId])
  /// Список отмеченных спамеров (для ручной блокировки сотрудником) — без индекса
  /// это полный проход по всем диалогам ради единиц отмеченных.
  @@index([spamFlaggedAt])
  /// Сравнение сценариев группирует по этому полю — без индекса свёртка идёт
  /// последовательным чтением всей таблицы диалогов.
  @@index([salesScenario])
  /// Ключ сортировки инбокса и отбора для кронов (напоминания молчащим, потерянные
  /// диалоги) — без индекса это каждый раз полный проход по всем перепискам
  /// (аудит 09.08.2026).
  @@index([lastMessageAt])
  @@index([contactProfileId])
  /// Фильтр/джойн по нашему аккаунту (панель мессенджера, выбор промта под
  /// конкретный IG/WA-аккаунт) — без индекса это полный проход по диалогам
  /// (аудит 18.08.2026).
  @@index([accountId])
  /// Раньше искать диалог(и) клиента обслуживал уникальный индекс clientId
  /// (он же ограничивал «один диалог на карточку»). Без @unique нужен обычный
  /// индекс явно — тех же запросов (карточка клиента, cardFill, скоринг) стало
  /// не меньше, просто теперь они законно находят больше одной строки.
  @@index([clientId])
  @@index([propertyChatAgentId])
}

/// Payload-less immutable admission identity/order. Not an inbox or action receipt.
/// Retained with its conversation epoch; legacy ProcessedMessage cleanup is independent.
model CustomerPropertyIngressTicket {
  /// Original Meta envelope metadata only; never FINAL-IN or execution authority.
  routingSourceVersion Int?
  routingSourceHash String?
  routingScopeRevision BigInt?
  routingProvenance String?
  rolloutAssignmentId String?
  rolloutAssignment CustomerAgentRolloutAssignment? @relation(fields: [rolloutAssignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([rolloutAssignmentId])
  eventKey       String @id
  order          BigInt @unique @default(autoincrement())
  scopeKey       String
  /// Exact new admission namespace. Historical NULL tickets grant no writes.
  endpointScopeId String?
  endpointScope CustomerEndpointScope? @relation(fields: [endpointScopeId], references: [id], onDelete: Restrict)
  conversationId String?
  conversation   BotConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// Never renewed/reassigned after first binding; retained after native deletion.
  originalConversationId String?
  tombstonedAt DateTime?
  eventKind String?
  payloadVersion Int?
  payloadCiphertext String?
  payloadHash String?
  receivedAt DateTime @default(now())
  providerOccurredAt DateTime?
  originVersion Int?
  originCiphertext String?
  originCapturedAt DateTime?
  /// Historical NULL is not a replayable received event.
  processingState String?
  claimRevision BigInt @default(0)
  leaseOwner String?
  leaseUntil DateTime?
  nextAttemptAt DateTime?
  attempts Int @default(0)
  errorCode String?
  turnKey String?
  headEventKey String?
  plannedAt DateTime?
  /// Immutable RAW-intake brain choice only, before FINAL; never authority or a provider reservation.
  intakeAgentRevisionId String?
  intakeAgentRevision CustomerAgentRevision? @relation("CustomerAgentIntakeRevision", fields: [intakeAgentRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "CustomerIngress_intake_revision_fkey")
  agentRevisionId String?
  agentRevision CustomerAgentRevision? @relation("CustomerAgentTurnRevision", fields: [agentRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Reserved identity only; provider accounting row is born at the first actual attempt.
  providerOperationId String?
  providerDeadlineAt DateTime?
  /// Optional immutable sender classification, encrypted and bound to original input.
  senderObservationVersion Int?
  senderObservationCiphertext String?
  senderObservedAt DateTime?
  /// Immutable encrypted, original-IN-bound interpretation, not business authority.
  mediaObservationVersion Int?
  mediaObservationCiphertext String?
  mediaObservedAt DateTime?
  outboxParts CustomerOutboxPart[]
  createdAt      DateTime @default(now())
  /// Durable fact-only output fence; never an action receipt or retry state.
  managedOutputRecordedAt DateTime?
  /// Set atomically with scoped IN append; NULL historical tickets prove no append.
  inputRecordedAt DateTime?

  @@index([conversationId, scopeKey])
  @@index([endpointScopeId])
  // Applied SQL index name after PostgreSQL's 63-byte identifier truncation.
  @@index([processingState, nextAttemptAt, leaseUntil], map: "CustomerPropertyIngressTicket_processingState_nextAttemptAt_le_")
}

/// One physical publication. Provider acceptance and local projection are distinct.
model CustomerOutboxPart {
  id String @id @default(uuid())
  partKey String @unique
  ticketEventKey String?
  ticket CustomerPropertyIngressTicket? @relation(fields: [ticketEventKey], references: [eventKey], onDelete: Restrict)
  inquiryId String?
  inquiry CustomerInquiry? @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  publicMetaCommentId String?
  publicMetaComment InstagramComment? @relation(fields: [publicMetaCommentId], references: [id], onDelete: SetNull)
  publicTelegramCommentId String?
  publicTelegramComment TelegramGroupComment? @relation(fields: [publicTelegramCommentId], references: [id], onDelete: SetNull)
  publicSourceRevision BigInt?
  originalNativeId String
  conversationId String?
  conversation BotConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  turnKey String
  ordinal Int
  mode String
  sourceKind String
  sourceKey String
  agentRevisionId String?
  agentRevision CustomerAgentRevision? @relation(fields: [agentRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  channel String
  endpointScopeId String
  endpointScope CustomerEndpointScope @relation(fields: [endpointScopeId], references: [id], onDelete: Restrict)
  transportJson Json
  payloadEncrypted String
  payloadHash String
  payloadVersion Int
  fenceJson Json
  p03Json Json?
  receiptRefsJson Json
  approvedAssetPurpose String?
  status String @default("READY")
  claimRevision BigInt @default(0)
  leaseOwner String?
  leaseUntil DateTime?
  nextAttemptAt DateTime?
  acceptedAt DateTime?
  projectionRecordedAt DateTime?
  cancelRequestedAt DateTime?
  supersededAt DateTime?
  attempts CustomerDeliveryAttempt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([turnKey, ordinal, mode])
  @@unique([id, endpointScopeId])
  @@index([status, nextAttemptAt, leaseUntil])
  @@index([conversationId])
  @@index([publicMetaCommentId, publicSourceRevision], map: "customer_outbox_public_meta_source_idx")
  @@index([publicTelegramCommentId, publicSourceRevision], map: "customer_outbox_public_tg_source_idx")
}

/// Explicit owner-approved bot corrections, separate from genuine customer IN.
model RecruitmentRecovery {
  id String @id
  campaign String
  originalConversationId String
  conversationId String?
  conversation BotConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "RecruitmentRecovery_conversation_fkey")
  endpointScopeId String
  endpointScope CustomerEndpointScope @relation(fields: [endpointScopeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "RecruitmentRecovery_endpoint_fkey")
  transportJson Json
  fenceJson Json?
  sourceHash String
  sourceAt DateTime
  catalogHash String
  payloadEncrypted String
  payloadHash String
  actorId String
  actor Agent @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "RecruitmentRecovery_actor_fkey")
  status String @default("READY")
  providerMid String?
  attemptAt DateTime?
  finishedAt DateTime?
  projectionAt DateTime?
  reason String?
  createdAt DateTime @default(now())
  @@unique([campaign, originalConversationId], map: "RecruitmentRecovery_campaign_conversation_key")
  @@unique([originalConversationId], map: "RecruitmentRecovery_original_once_key")
  @@unique([endpointScopeId, providerMid], map: "RecruitmentRecovery_scope_mid_key")
  @@index([status, createdAt], map: "RecruitmentRecovery_status_created_idx")
}

/// Persist before a physical POST; UNKNOWN is never implicit permission to retry.
model CustomerDeliveryAttempt {
  id String @id @default(uuid())
  partId String
  endpointScopeId String
  part CustomerOutboxPart @relation(fields: [partId, endpointScopeId], references: [id, endpointScopeId], onDelete: Restrict)
  endpointScope CustomerEndpointScope @relation(fields: [endpointScopeId], references: [id], onDelete: Restrict)
  attemptNo Int
  claimRevision BigInt
  startedAt DateTime @default(now())
  finishedAt DateTime?
  outcome String @default("IN_FLIGHT")
  providerMid String?
  /// Observation survives even when its MID cannot be uniquely associated.
  reportedMid String?
  errorCode String?
  dispatchFenceJson Json

  @@unique([partId, attemptNo])
  @@index([endpointScopeId, providerMid])
}

/// СУТОЧНЫЙ БЮДЖЕТ ХОДОВ ИИ ТАМ, ГДЕ СВОЕЙ КОЛОНКИ НЕТ (аудит 22.08.2026).
///
/// Решение владельца от 21.08.2026 («чтобы люди не использовали нейросеть как
/// бесплатный ChatGPT») закрыло дыру ровно в одном канале из трёх: счётчики жили
/// колонками BotConversation, то есть только в переписке Meta. В Telegram и в
/// комментариях под публикациями предела не было вовсе — единственным тормозом
/// оставался дебаунс в 25 секунд.
///
/// Отдельная таблица, а не семь новых колонок в каждой таблице канала: у
/// комментария нет «диалога» вообще (есть автор), у TelegramConversation таких
/// колонок нет, а следом подключается ИИ-чат сайта royalhome.tj — три копии
/// одного счёта разошлись бы на первой же правке предела. Заводить ради счётчика
/// фальшивый BotConversation нельзя: он тут же появится в инбоксе «Сообщения»
/// как переписка, которой не существует.
///
/// Колонки названы ТОЧНО так же, как одноимённые у BotConversation: расчёт
/// остатка (lib/aiDailyBudget.ts) один на оба хранилища и различает их только
/// именем таблицы.
/// @@ Счётчик суточных обращений к ИИ по одному собеседнику.
model AiBudgetCounter {
  id              String    @id @default(uuid())
  /// Метка канала: TELEGRAM | INSTAGRAM_COMMENTS | FACEBOOK_COMMENTS | SITE_CHAT.
  /// Комментарии отделены от личной переписки нарочно: под постом и в директе это
  /// разные разговоры, и общий счёт запирал бы человека в одном из-за другого.
  channel         String
  /// Идентификатор собеседника внутри канала: chatId в Telegram, автор комментария
  /// у Meta. Своей карточки клиента здесь нет — размер предела решает вызывающий,
  /// он один знает, известен ли собеседник CRM.
  peerId          String
  /// Сутки счётчиков — "YYYY-MM-DD" ПО ДУШАНБЕ (UTC+5), см. lib/dushanbeTime.ts.
  /// Строкой, а не DateTime: сравнение суток на равенство в одном UPDATE проще и
  /// не зависит от того, как драйвер округлит границу дня.
  aiBudgetDate    String?
  /// Сколько РЕАЛЬНЫХ обращений к модели было за эти сутки.
  aiTurnsToday    Int       @default(0)
  /// Расшифровки голосовых. Голосовое — это реплика, а не вложение: половина
  /// клиентов в Душанбе наговаривает вместо того, чтобы печатать.
  aiVoiceToday    Int       @default(0)
  /// Разобранные снимки.
  aiPhotoToday    Int       @default(0)
  /// Видео — настоящая нагрузка, дороже голосового в десятки раз.
  aiVideoToday    Int       @default(0)
  /// Документы. Незнакомцу ИИ их не разбирает вовсе.
  aiDocToday      Int       @default(0)
  /// Когда собеседнику последний раз ушла вежливая фраза «сейчас подключится
  /// агент» из-за упёртого предела. Ровно одна такая фраза в сутки.
  aiLimitNoticeAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Ключ счёта. Он же снимает гонку: два сообщения одного человека
  /// обрабатываются параллельно, и вторая вставка обязана попасть в ON CONFLICT,
  /// а не завести вторую строку с собственным бюджетом.
  @@unique([channel, peerId])
}

/// СУТОЧНЫЙ ПОТОЛОК ИИ-ДЕЙСТВИЙ, КОТОРЫЕ ЗАПУСКАЕТ СОТРУДНИК (13.09.2026, аудит
/// надёжности). Не путать с AiBudgetCounter выше — та таблица считает ходы модели
/// в переписке с КЛИЕНТОМ (canal+peerId в диалоге), эта — платные ИИ-вызовы,
/// которые нажатием кнопки в CRM запускает СВОЙ сотрудник (agentId), и у них другая
/// ось: не «клиент», а «кто из агентов». Первое применение — улучшение фото объекта
/// (routes/properties/photos.ts): без потолка один агент мог бы за день прогнать
/// платную модель через весь каталог фото. `action` — строкой, а не отдельной
/// таблицей на каждый вид действия: следующий платный самостоятельный ИИ-вызов
/// сотрудника (не диалог с клиентом) ложится сюда же новым значением action.
model AgentAiActionCounter {
  id        String   @id @default(uuid())
  agentId   String
  action    String
  /// Сутки по Душанбе, "YYYY-MM-DD" — та же причина и тот же модуль, что у
  /// AiBudgetCounter (lib/dushanbeTime.ts, границы суток только через него).
  day       String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Ключ счёта — он же снимает гонку двух параллельных запросов одного агента,
  /// как и у AiBudgetCounter (INSERT ... ON CONFLICT вместо read-then-write).
  @@unique([agentId, action, day])
}

/// АРХИВ. Что сотрудник просил доработать в CRM. Приходило из личной переписки
/// директора в Telegram Business: голосовые расшифровывались и разбирались ИИ в
/// структуру.
///
/// Функция удалена 12.08.2026 по решению владельца — кода, который пишет сюда или
/// читает отсюда, больше нет. Таблица оставлена НАРОЧНО: в ней накопленные задачи,
/// и терять их из-за отключённой функции незачем. Новых строк не появляется.
model TeamRequest {
  id                String              @id @default(uuid())
  /// TELEGRAM_BUSINESS (личка директора) | TELEGRAM_FORWARD (директор переслал боту) | MANUAL.
  source            String              @default("TELEGRAM_BUSINESS")
  /// Кто наговорил/написал — снапшот на момент получения (имя в Telegram может смениться).
  authorName        String?
  authorUsername    String?
  chatId            String?
  /// message_id в Telegram: защита от повторной обработки одного сообщения при
  /// перезапуске поллера (getUpdates может отдать апдейт снова, если offset не успел уйти).
  telegramMessageId Int?
  /// Номер задачи внутри одного сообщения: в трёхминутном голосовом обычно несколько
  /// разных просьб, и каждая живёт своей строкой со своим статусом.
  partIndex         Int                 @default(0)
  /// VOICE (расшифровано) | TEXT — источник исходного текста, влияет на доверие к формулировкам.
  kind              String              @default("TEXT")
  /// Исходный текст: расшифровка голосового или сообщение как есть. Хранится всегда —
  /// разбор ИИ может ошибиться, оригинал должен оставаться доступным.
  rawText           String
  /// Короткий заголовок задачи, сформулированный ИИ.
  title             String?
  /// Суть задачи в 1–3 предложениях, очищенная от «эээ», повторов и приветствий.
  summary           String?
  /// Раздел CRM, к которому относится просьба («Объекты», «Финансы», «Сайт»...) — как понял ИИ.
  area              String?
  type              TeamRequestType     @default(OTHER)
  priority          TeamRequestPriority @default(NORMAL)
  /// Чего не хватает для реализации: список уточняющих вопросов (string[]). Бот задаёт
  /// их сотруднику сам, в переписке — директору остаётся только итог.
  openQuestions     Json                @default("[]")
  /// Что бот ответил сотруднику на это сообщение. Хранится как память диалога:
  /// без неё следующий ответ сотрудника («в месячном») выглядел бы новой задачей
  /// вместо уточнения к предыдущей.
  reply             String?
  status            TeamRequestStatus   @default(NEW)
  /// Когда задачу впервые забрала Claude-сессия — чтобы одна и та же не всплывала
  /// в каждой новой сессии как «новая».
  seenAt            DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([chatId, telegramMessageId, partIndex])
  @@index([status, createdAt])
}

enum TeamRequestType {
  BUG
  FEATURE
  QUESTION
  /// Не задача, а информация к сведению — не требует доработки.
  INFO
  OTHER
}

enum TeamRequestPriority {
  LOW
  NORMAL
  HIGH
}

enum TeamRequestStatus {
  NEW
  /// Ждём ответа директора на уточняющие вопросы.
  CLARIFYING
  IN_PROGRESS
  DONE
  REJECTED
}

model Interaction {
  showingEvidenceVersion Int @default(0)
  showingOffCrm Boolean @default(false)
  showingOffCrmDetails String?
  buyerIntentAtCreation Boolean?
  /// Private investigation evidence; excluded from ordinary activity and timeline reads.
  investigationOnly Boolean @default(false)
  id                     String              @id @default(uuid())
  customerBookingActionId String? @unique
  customerBookingAction CustomerAction? @relation(fields: [customerBookingActionId], references: [id], onDelete: Restrict)
  managedShowingRevision BigInt?
  clientId               String
  client                 Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Кто действовал — П-10. AGENT требует agentId; для SYSTEM/AI/BOT/CLIENT agentId ВСЕГДА
  /// null (CHECK в БД, см. миграцию 2026091722xxxx_interaction_actor_kind_check). Пишется
  /// только через lib/timeline.ts.
  actorKind              InteractionActorKind @default(AGENT)
  /// Nullable с 17.09.2026 (П-10): заполнено только при actorKind=AGENT. До этого было
  /// NOT NULL и директорский фолбэк подписывал автоматику живым человеком — см. разбор
  /// docs/audit/recon-17-09/04-timeline-authorship.md.
  agentId                String?
  /// onDelete: Restrict — с 19.09.2026. По умолчанию (SetNull) удаление агента
  /// обнуляло agentId у его записей: строка с actorKind=AGENT оставалась без
  /// автора и упиралась в CHECK Interaction_actor_kind_agent_id_check (23514),
  /// а не в P2003, поэтому ветка «деактивируем вместо удаления» в
  /// routes/agents.ts не срабатывала и удаление сотрудника падало с 500.
  /// Запрет тут и по смыслу: история звонков фиксирует, КТО что делал, обнулять
  /// автора задним числом нельзя (та же причина, что у снапшота комиссии).
  agent                  Agent?              @relation("InteractionAgent", fields: [agentId], references: [id], onDelete: Restrict)
  /// Кому адресована задача (nextAction/nextActionDate), когда автора-человека нет —
  /// например SYSTEM-эскалация или AI-подсказка всё равно должна попасть в список дел
  /// конкретного агента. При actorKind=AGENT дублирует agentId по смыслу, но не
  /// синхронизируется автоматически — читающий код берёт `subjectAgentId ?? agentId`.
  subjectAgentId         String?
  subjectAgent           Agent?              @relation("InteractionSubject", fields: [subjectAgentId], references: [id])
  type                   InteractionType
  propertyId             String?
  property               Property?           @relation(fields: [propertyId], references: [id])
  notes                  String
  outcome                InteractionOutcome?
  /// Кто фактически проставил outcome/nextAction — "HUMAN" (форма «Как прошёл
  /// звонок», по умолчанию для всех прежних записей), "AI_AUTO" (разбор
  /// звонка заполнил сам, без участия агента — см. lib/aiCallOutcome.ts) или
  /// "SYSTEM_STUB" (заглушка NEUTRAL, которой lib/telephony/incomingCalls.ts
  /// помечает отвеченный входящий ДО разбора — только чтобы clientAutoStatus.ts
  /// не читал пустой исход как «связи не было»; applyAiCallOutcome имеет право
  /// переписать именно эту заглушку настоящим исходом, "HUMAN"/"AI_AUTO" — нет).
  /// Не Prisma-enum, как suggestedOutcome/transcriptionStage: проверяется в
  /// коде, значения появляются без миграции.
  outcomeSource          String              @default("HUMAN")
  nextAction             String?
  nextActionDate         DateTime?
  /// Когда задачу (nextAction/nextActionDate) отметили выполненной — PATCH
  /// /interactions/:id/complete проставляет это вместо того, чтобы стирать
  /// nextAction/nextActionDate (раньше стирал — история "выполнено vs просрочено"
  /// терялась безвозвратно). null + nextActionDate в прошлом = просрочена.
  /// Нужно для расчёта KPI "Дисциплина CRM" (см. apps/api/src/kpi.ts).
  completedAt            DateTime?
  /// Task cancelled when its assignment ends; preserves original text/date without claiming completion.
  taskCancelledAt        DateTime?
  /// Когда агенту ушёл push «встреча через час» — без этой отметки джоб слал бы
  /// напоминание на каждом тике, пока встреча не наступит. Вечерняя сводка отметки
  /// не требует: она уходит раз в сутки одним сообщением на все задачи дня.
  reminderSentAt         DateTime?
  /// Какие ступени напоминаний уже отправлены: "1d", "2h", "40m", "1h", "15m" (см.
  /// lib/meetingReminders.ts). У показа покупателя ступеней три — за день, за 2 часа
  /// и за 40 минут. У встречи с собственником — за 2 часа и 40 минут, если встреча
  /// назначена на завтра, иначе за день и за час. У прочих задач одна — за час.
  /// Массив, а не колонка на ступень: ступени меняются требованиями, схема — нет.
  remindersSent          String[]            @default([])
  /// Когда запись обработана (штраф Royal Score начислен, агенту ушёл его пуш) —
  /// чтобы сделать это один раз, а не на каждом тике джоба. Имя осталось от
  /// показа (notifyMissedShowings), но поле общее — используется и для встреч/
  /// задач (notifyOverdueTasks, lib/meetingReminders.ts).
  noShowNotifiedAt       DateTime?
  /// Когда РУКОВОДСТВУ отдельно ушёл пуш по этой записи (владелец 07.09.2026,
  /// разбор часов алармов) — специально ОТДЕЛЬНО от noShowNotifiedAt выше: тот
  /// гейтится обычными рабочими часами агента (Settings.workHours*, не будим
  /// агента ночью), а пуш руководству обязан ждать именно часов алармов
  /// (Settings.alarmHours*, отдельная настройка). Раньше оба уходили одним
  /// пушем под одним гейтом — руководитель получал пуш в рабочие часы агента,
  /// а не в свои. См. lib/directorOverdueDigest.ts.
  supervisorNotifiedAt   DateTime?
  /// Когда клиенту ушла просьба подтвердить показ (см. lib/meetingReminders.ts).
  /// Нужна не только для показа состояния в CRM: по ней считается, дали ли
  /// человеку время ответить, прежде чем дёргать агента «клиент молчит».
  confirmAskedAt         DateTime?
  /// Когда клиент ответил на эту просьбу. Показ считается подтверждённым.
  /// МОЛЧАНИЕ СЮДА НЕ ПИШЕТСЯ И НИЧЕГО НЕ ОТМЕНЯЕТ: половина людей просто не
  /// отвечает на такие сообщения, а на показ приходит.
  confirmedAt            DateTime?
  /// Когда стало известно, что показ не состоится: клиент прямо сказал, что не
  /// сможет прийти, либо показ сняли — бот по его словам или агент руками в CRM.
  /// Сам по себе показ НЕ отменяет: «не смогу» оставляет встречу в календаре,
  /// решение за агентом. ОТМЕНА — это declinedAt ВМЕСТЕ с пустым nextAction; по
  /// этой паре отменённые показы не попадают в отчёты (см. lib/tasks.ts,
  /// COUNTED_SHOWING_WHERE) и в календарь.
  declinedAt             DateTime?
  /// Ключ записи разговора в Cloudflare R2 (не готовая ссылка: она подписывается на
  /// 10 минут в момент клика — см. lib/r2Client.ts, r2PresignDownloadUrl). Хранить
  /// постоянную ссылку нельзя: разговор клиента с агентом не должен утекать по
  /// пересланному URL. Заполняется lib/telephony/callRecordings.ts после звонка.
  recordingUrl           String?
  /// Расшифровка разговора (тот же Gemini, что расшифровывает голосовые клиентов, —
  /// ai/transcribe.ts). Приходит позже записи: расшифровка идёт очередью, и пустое
  /// поле при заполненном recordingUrl — нормальное промежуточное состояние.
  transcript             String?
  /// Перевод расшифровки на русский. Оригинал остаётся в transcript и никогда не
  /// затирается: половина клиентов агентства говорит по-таджикски, и спорные места
  /// разбираются по тому, что человек сказал на самом деле, а не по пересказу машины.
  /// null — разговор и так был по-русски (переводить нечего).
  transcriptRu           String?
  /// ЗАПАСНЫЕ НОМЕРА, НАЗВАННЫЕ КЛИЕНТОМ В ЭТОМ ЗВОНКЕ, — ЗАШИФРОВАНО (03.09.2026,
  /// требование владельца, см. lib/telephony/callPhoneMasking.ts). Если клиент во
  /// время разговора называет номер, отличный от того, что уже есть на карточке
  /// (Client.phone/whatsappPhone/extraPhones), сам номер в `transcript` заменяется
  /// звёздочками — иначе агент, открывший расшифровку, мог бы просто списать номер
  /// себе, в обход CRM. Здесь — тот же номер, но зашифрованный (lib/phoneCrypto.ts,
  /// AES-256-GCM, ключ PHONE_ENCRYPTION_KEY) для внутренних целей системы: дедуп,
  /// будущий поиск дублей карточек. Не читается напрямую ни одним экраном агента.
  mentionedPhonesEncrypted String[]           @default([])
  /// Длительность разговора в секундах — берётся из callTracker.talkSeconds(), а не
  /// из длины файла: считать её заново пришлось бы разбором аудио.
  recordingDurationSec   Int?
  /// ЧЕМ КОНЧИЛСЯ ДОЗВОН — по данным станции, а не по тексту заметки (27.08.2026).
  /// "TALKED" — клиент взял трубку (любой длительности), "NO_ANSWER" — телефон
  /// клиента звонил, он не ответил, "AGENT_NO_PICKUP" — трубку не снял сам агент и
  /// клиенту не звонили вовсе, "CANCELLED" — агент отменил вызов, когда телефон
  /// клиента уже звонил.
  ///
  /// ЗАЧЕМ ОТДЕЛЬНОЕ ПОЛЕ. Различить «клиент не ответил» и «агент не снял трубку»
  /// было можно только по строке notes — то есть догадкой по человеческому тексту,
  /// который меняется при первой же правке формулировки. На этом различии держится
  /// гейт перевода в Неактивные (lib/inactiveTrafficLight.ts): попытка дозвониться
  /// засчитывается как след работы, а несостоявшийся звонок агента — нет.
  /// outcome для этого не годится: он про исход РАЗГОВОРА и заполняется агентом
  /// или разбором ИИ, а у половины недозвонов остаётся пустым.
  ///
  /// Обычная строка, а не enum БД, — тот же приём, что у outcomeSource и
  /// transcriptionStage: новое значение заводится без миграции.
  /// null — запись сделана агентом руками (звонка через CRM не было) либо создана
  /// до 27.08.2026 и станцией не размечена.
  callAttempt            String?
  /// Заметка, которую агент писал ПРЯМО ВО ВРЕМЯ разговора (поле в окне звонка).
  /// Отдельная колонка, а не `notes`: `notes` перезаписывается при отбое строкой
  /// «Звонок через CRM, разговор 1:23» (см. lib/telephony/callTracker.ts), и всё,
  /// что человек писал под диктовку клиента, пропало бы в момент отбоя. Отсюда же
  /// текст подставляется в обязательное окно «Как прошёл звонок»: агент уже записал
  /// суть, второй раз печатать её не должен.
  liveNote               String?
  /// Голосовая заметка агента к этому звонку (не диктовка в текст, а сама запись —
  /// кнопка микрофона в форме «Как прошёл звонок», см. CommentWithVoice/voice-note
  /// endpoint в routes/me.ts). Путь под /uploads/voice-notes, необязательное поле —
  /// форма отправляется и без записи.
  voiceNoteUrl           String?
  /// Расшифровка voiceNoteUrl тем же Gemini, что и остальная диктовка/звонки
  /// (ai/transcribe.ts). НЕ вставляется в notes/liveNote как текст — агент прочитал
  /// или наговорил комментарий сам; расшифровка лежит рядом как сырьё для
  /// последующего дополнения карточки клиента, не как замена его словам.
  voiceNoteTranscript    String?
  /// Где сейчас конвейер «запись → расшифровка → карточка», пока он не закончил —
  /// SEARCHING/QUEUED/TRANSCRIBING/TRANSLATING/ANALYZING (см. CALL_TRANSCRIPTION_STAGES
  /// в @royal-home/shared). Обычная строка, а не тип БД — новую стадию заводят без
  /// миграции, значение проверяется в коде (тот же приём, что у suggestedOutcome).
  /// null — конвейер этим разговором сейчас не занят: либо ещё не начал, либо уже
  /// закончил (см. transcript/callAnalysis), либо ждёт своей очереди повтора.
  /// Решение владельца 15.08.2026: не заставлять смотреть на статичное «готовится»
  /// минутами напролёт, а показывать, что именно сейчас происходит.
  /// Частичный индекс `Interaction_transcriptionStage_partial_idx ... WHERE "transcriptionStage"
  /// IS NOT NULL` (миграция 20261001120000_night_e_indexes, №198) в схеме не описать — Prisma не
  /// знает частичных индексов; живёт только в migration.sql и в `migrate diff` расхождения не даёт.
  transcriptionStage     String?
  /// Доля готовых частей расшифровки (0–100) — у длинного разговора их несколько,
  /// у короткого одна и прогресс либо 0, либо сразу 100. Смысл есть только при
  /// transcriptionStage = "TRANSCRIBING".
  transcriptionProgress  Int?
  createdAt              DateTime            @default(now())
  cardSuggestion         CardSuggestion?
  callAnalysis           CallAnalysis?
  /// «Позвонить через мобильный» посреди разговора (плохая связь в браузере) —
  /// эта запись ПРОДОЛЖАЕТ ту, на которую ссылается: разговор не закончился по
  /// существу, он идёт дальше другим каналом. callTracker.finishCall не открывает
  /// окно «как прошёл звонок» для звонка-предка, если у него есть продолжение —
  /// иначе агент увидел бы два окна на один разговор (или окно про ещё идущий
  /// разговор). См. POST /me/active-call/retry-mobile в routes/me.ts.
  continuesInteractionId String?
  continuesInteraction   Interaction?        @relation("CallContinuation", fields: [continuesInteractionId], references: [id], onDelete: SetNull)
  continuedBy            Interaction[]       @relation("CallContinuation")
  /// «Связался со своего телефона» — ручная фиксация контакта, сделанного В ОБХОД
  /// CRM-телефонии (пачка 10, 11.09.2026, docs/flow-audit-lead-to-showing-11-09.md
  /// ТОП-10 п.1). Кнопка в карточке клиента создаёт запись type=CALL с этим флагом
  /// и обязательным комментарием (≥10 символов). Считается ПОПЫТКОЙ (attempts), а
  /// не РАЗГОВОРОМ (talked) — см. lib/inactiveTrafficLight.ts::countContactTrace:
  /// звонок через личный телефон CRM не слышала, длительности и исхода станции у
  /// него нет, поэтому светофор и гейт передачи видят в нём только след работы,
  /// не критерий KPI «состоявшийся разговор». Лимит 2 записи в сутки на клиента —
  /// проверяется в routes/clients/interactions.ts, не здесь.
  outsideCrm             Boolean             @default(false)
  /// Цена объекта в сомони на момент автоподбора (12.09.2026, решение владельца
  /// «при снижении цены уведомлять повторно»), заполняется только у записей
  /// АВТОПОДБОРА (notes начинается с AUTO_MATCH_MARKER, см.
  /// lib/propertyMatchFilter.ts). Дедуп по клиенту+объекту сравнивает текущую
  /// цену с этим значением у последней такой записи: упала на 5% и больше —
  /// уведомляем снова, иначе клиент считается уже уведомленным. null у всех
  /// записей до миграции и у прочих типов Interaction — для них дедуп работает
  /// как раньше, без учёта цены.
  matchNotifiedPriceTjs  Decimal?
  /// Робозвонок «как прошёл показ» по этой записи — только у показов (см. PostShowingCall).
  postShowingCall        PostShowingCall?
  /// Машинный тег автозадачи (21.09.2026, дедуп/автозакрытие автозадач,
  /// docs/TASKS.md «Автозадачи не видят состоявшегося контакта»). Заполняется
  /// ТОЛЬКО когда nextAction завела автоматика через lib/autoTasks.ts
  /// (upsertAutoTask) — ручная задача агента/ИИ-ассистента (routes/interactions.ts,
  /// ai/assistant.ts) этого поля не получает и остаётся null. Смысл поля —
  /// «какой генератор отвечает за эту задачу», а не текст nextAction: текст
  /// меняется («ждёт 19 дн.» → «ждёт 20 дн.»), и дедуп/автозакрытие по тексту
  /// как раз и порождали дубли до этой правки. Значения — свободная строка
  /// (тот же приём, что transcriptionStage/outcomeSource выше): новый вид
  /// автозадачи заводится без миграции, набор проверяется в коде
  /// (см. AutoTaskKind в lib/autoTasks.ts).
  autoTaskKind           String?

  @@index([clientId])
  @@index([agentId])
  @@index([subjectAgentId])
  @@index([propertyId])
  @@index([type, createdAt])
  @@index([nextActionDate])
  @@index([continuesInteractionId])
  /// Гейт перевода в Неактивные спрашивает «была ли попытка дозвониться до этого
  /// клиента» — путь ровно по этим трём колонкам (lib/inactiveTrafficLight.ts).
  @@index([clientId, type, callAttempt])
  /// Дедуп открытой автозадачи по клиенту+виду (upsertAutoTask) — точечный поиск
  /// вместо полного скана Interaction клиента.
  @@index([clientId, autoTaskKind, completedAt])
}

model Deal {
  id                      String    @id @default(uuid())
  clientId                String
  client                  Client    @relation(fields: [clientId], references: [id])
  propertyId              String
  property                Property  @relation(fields: [propertyId], references: [id])
  agentId                 String
  agent                   Agent     @relation(fields: [agentId], references: [id])
  stage                   DealStage @default(NEGOTIATION)
  /// Фактическая цена продажи — вводит агент при отправке на закрытие
  /// (PENDING_APPROVAL), почти всегда ниже цены объявления (торг). Живёт на
  /// сделке, а не сразу на Property.soldPrice: до одобрения руководителем
  /// объект остаётся в продаже, его нельзя помечать проданным заранее.
  soldPrice               Decimal?
  commissionAmount        Decimal?
  commissionPercent       Decimal?
  /// Валюта комиссии — снапшот валюты объекта в момент создания сделки. Без неё
  /// суммы по сделкам в долларах и в сомони складывались 1:1 во всей отчётности
  /// (Финансы, Отчёты, Дашборд, сводка директору). Снапшот, а не чтение из Property:
  /// смена валюты объекта задним числом не должна переписывать закрытую сделку.
  currency                Currency  @default(TJS)
  /// Снапшот распределения комиссии, фиксируется в момент закрытия сделки
  /// (COMPLETED) по действующим на тот момент долям из Settings — чтобы смена
  /// настроек задним числом не переписывала уже выплаченные деньги.
  /// Если у объекта не было интейкера, его доля уходит компании.
  commissionIntakeAmount  Decimal?
  commissionRealtorAmount Decimal?
  commissionCompanyAmount Decimal?
  /// Кому причитается доля за приём объекта — снапшот на момент закрытия.
  /// Без него получатель резолвился через property.intakeAgentId в момент
  /// построения отчёта, и смена интейкера у проданного объекта переписывала
  /// выплату за уже закрытый месяц с одного агента на другого.
  commissionIntakeAgentId String?
  /// Сделка закрыта по ОТКАЗНОМУ лиду (клиент отказал прежнему агенту и был передан
  /// дальше). Решение владельца 30.07: агентская часть комиссии в этом случае делится
  /// не поровну, а 70% продавшему и 30% приведшему объект. Доля компании не меняется.
  /// Снапшот, а не вычисление на лету: клиент может отказать ещё раз уже после сделки,
  /// и тогда закрытая выплата задним числом сменила бы правило.
  refusedLeadSplit        Boolean   @default(false)
  startedAt               DateTime  @default(now())
  closedAt                DateTime?
  notes                   String?
  /// Резерв объекта истёк, пока сделка была ещё живой (Пачка 8, 11.09.2026).
  /// Пишется независимо от Settings.dealReservationExpiryAction — при "cancel"
  /// стоит рядом со stage=CANCELLED (история, почему отменилась именно так),
  /// при "keep" это единственный след для канбана, что резерв уже истёк.
  reservationExpiredAt    DateTime?
  /// Отзыв покупателя и/или продавца после закрытия (Пачка 11, 11.09.2026) — см. DealReview.
  reviews                 DealReview[]

  /// Документы сделки (Пачка 14, 11.09.2026) — checklist перед закрытием, см. DealDocument ниже.
  documents               DealDocument[]
  /// Факт выплаты комиссии агенту-риелтору. Отдельно от commissionRealtorAmount:
  /// сумма фиксируется при закрытии сделки (снапшот распределения), а сама выплата
  /// происходит позже, отдельным действием бухгалтерии/руководителя — до неё деньги
  /// посчитаны, но ещё не отданы. null = ещё не выплачено.
  realtorPayoutAt         DateTime?
  realtorPayoutById       String?
  realtorPayoutBy         Agent?    @relation("DealRealtorPayoutBy", fields: [realtorPayoutById], references: [id])
  realtorPayoutNote       String?

  /// АННУЛИРОВАНИЕ ЗАКРЫТОЙ СДЕЛКИ (глубокая проверка 02.10.2026, C10; решение
  /// владельца «да, по советам»). Директор аннулирует сделку (мошенничество,
  /// ошибка) кнопкой «Аннулировать» с причиной: стадия становится CANCELLED —
  /// поэтому её не считает продажей ни один счётчик (все считают COMPLETED), —
  /// объект возвращается в продажу, баллы за сделку снимаются. Эти поля — след,
  /// что это не обычная отмена: кто, когда и почему. closedAt и суммы сделки
  /// остаются как история. Вернуть аннулированную сделку в работу нельзя.
  annulledAt              DateTime?
  annulledById            String?
  annulledBy              Agent?    @relation("DealAnnulledBy", fields: [annulledById], references: [id], onDelete: SetNull)
  annulReason             String?

  /// ОПТИМИСТИЧНАЯ БЛОКИРОВКА — тот же приём и тот же довод, что у Property.version
  /// (см. комментарий там): PATCH сделки тоже был findUnique → update без связи,
  /// а канбан двигают несколько человек одновременно.
  version                 Int       @default(0)

  @@index([clientId])
  @@index([agentId])
  @@index([propertyId])
  @@index([stage])
  @@index([closedAt])
}

/// ОТЗЫВ И РЕКОМЕНДАЦИЯ ПОСЛЕ СДЕЛКИ (Пачка 11, 11.09.2026, docs/gaps-audit-11-09.md).
///
/// Через 3 дня после Deal COMPLETED (jobs/dealReviewAsk.ts, поставлено из
/// jobs/dealCloseFollowup.ts) бот спрашивает покупателя и продавца в их канал:
/// оценку 1-5 и, если есть кому порекомендовать, номер телефона. Ответ разбирает
/// lib/dealReviewParser.ts — лёгкий регэксп-парсер, без нового промпта модели.
///
/// Один Deal может дать ДВЕ записи — одну покупателю, одну продавцу (разные
/// clientId), поэтому уникальность не на dealId, а на (dealId, clientId).
model DealReview {
  id             String    @id @default(cuid())
  dealId         String
  deal           Deal      @relation(fields: [dealId], references: [id])
  /// Кому адресован вопрос — покупателю ИЛИ продавцу сделки (Client.id).
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  /// Канал, в который бот задал вопрос — для диагностики, не для логики: сам
  /// ответ приходит туда же, куда обычно пишет клиент (findClientDeliveryTarget).
  channel        String
  /// 1-5, заполняется при разборе ответа. null — вопрос задан, ответа ещё нет.
  rating         Int?
  /// Сырой текст ответа клиента — для истории, парсер мог не разобрать не всё.
  text           String?
  /// Номер, который клиент оставил как рекомендацию. Не факт, что валиден —
  /// createLeadFromChannel сам проверит перед созданием лида.
  referralPhone  String?
  askedAt        DateTime  @default(now())
  answeredAt     DateTime?

  @@unique([dealId, clientId])
  @@index([clientId])
  @@index([answeredAt])
}

enum DealDocumentKind {
  OWNERSHIP
  CONTRACT
  PASSPORT
  RECEIPT
  OTHER
}

/// Документы сделки (Пачка 14, 11.09.2026) — свидетельство собственности, договор,
/// паспорт, квитанция и т.п. Файл лежит в закрытом хранилище uploads-private (как
/// вложения переписки, lib/privateFiles.ts), выдаётся только через авторизованный
/// роут (routes/dealDocuments.ts), не статикой.
model DealDocument {
  id             String            @id @default(uuid())
  dealId         String
  deal           Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind           DealDocumentKind
  /// Имя файла в uploads-private — тот же формат uuid.ext, что и у вложений переписки.
  fileName       String
  /// Как файл назывался у того, кто его загрузил — для отображения в списке.
  originalName   String
  mimeType       String
  uploadedById   String
  uploadedBy     Agent             @relation(fields: [uploadedById], references: [id])
  uploadedAt     DateTime          @default(now())

  @@index([dealId])
}

/// Расход компании за месяц: реклама (по источникам — для стоимости лида), зарплаты, офис, прочее.
model Expense {
  status          String          @default("PAID")
  paymentDate     DateTime?
  counterparty    String?
  paymentMethod   String?
  categoryId      String?
  createdById     String?
  exchangeRate    Decimal?
  rateCapturedAt  DateTime?
  paymentUndo     Json?
  version         Int @default(0)
  requestKey      String?         @unique
  recurringId     String?
  occurrenceDate  String?
  receipts        ExpenseReceipt[]
  id              String          @id @default(uuid())
  category        ExpenseCategory
  /// Для ADVERTISING: канал, к которому относится расход (стоимость лида считается по нему).
  source          ClientSource?
  /// Для SALARY: сотрудник, которому относится выплата.
  agentId         String?
  agent           Agent?          @relation(fields: [agentId], references: [id])
  amount          Decimal
  currency        Currency        @default(TJS)
  /// Первый день месяца, к которому относится расход.
  month           DateTime
  note            String?
  createdAt       DateTime        @default(now())
  /// Мягкое удаление — запись остаётся в БД для архива и отчётности, просто скрыта из
  /// активных списков/сумм. Настоящего DELETE для финансовых записей больше нет.
  deletedAt       DateTime?
  /// Ключ АВТОМАТИЧЕСКОЙ строки: «ads:META:2026-08», «ai:2026-08». Такие строки
  /// создаёт и обновляет сама CRM (расход рекламного кабинета за месяц, расходы на
  /// ИИ) — ключ делает запись идемпотентной: сколько бы раз ни прошла сверка, строка
  /// одна, сумма актуальная. null — обычный расход, заведённый человеком; его
  /// автоматика не трогает никогда. Удалённую (deletedAt) автоматика не воскрешает:
  /// решение человека «этой строки быть не должно» сильнее пересчёта.
  autoKey         String?         @unique
  /// Отпечаток исходных данных авто-строки (27.08.2026, аудит №4): по нему видно,
  /// изменился ли НАБОР сделок месяца. Зарплатная строка раньше пересчитывалась
  /// каждую ночь и плыла вслед за курсом валют — «зарплата июля» месяц ездила
  /// туда-сюда, а ручная правка директора молча откатывалась следующей ночью.
  autoFingerprint String?
  /// Сумму правил человек — автоматика больше её не трогает (ставится в PATCH).
  manualEditedAt  DateTime?

  @@index([month])
  @@index([category, month])
  @@index([status, month])
  @@index([paymentDate])
  @@index([categoryId])
  @@unique([recurringId, occurrenceDate])
  @@index([deletedAt])
}

/// ОБЪЯВЛЕНИЕ рекламной системы и объект, за который оно платит.
///
/// Зачем таблица вообще: расходы на рекламу до сих пор жили одной строкой в месяц
/// (Expense с категорией ADVERTISING и каналом-источником) — этого хватало для
/// «стоимости лида по каналу», но не отвечало на вопрос владельца «сколько мы
/// вложили в ЭТУ квартиру». Ответ возможен только на уровне объявления: деньги
/// Meta считает по нему, и он же — единственное место, где видно, какую публикацию
/// продвигали.
///
/// ПОЧЕМУ ПРИВЯЗКА ЖИВЁТ ЗДЕСЬ, А НЕ СЧИТАЕТСЯ НА ЛЕТУ. Публикация может уехать из
/// ленты (Graph отдаёт ограниченное окно), название кампании — смениться, карточку
/// объекта — поправить. Один раз доказанная связь должна пережить всё это, поэтому
/// она записывается, а не выводится заново при каждом открытии отчёта.
model Ad {
  id            String         @id @default(uuid())
  platform      AdPlatform     @default(META)
  /// Идентификатор объявления в самой системе. Для MANUAL — придуманный CRM.
  externalId    String
  /// Из какого рекламного кабинета объявление. Кабинетов у агентства несколько:
  /// личный кабинет владельца и кабинет подрядчика, который ведёт рекламу, — и
  /// расход по объекту складывается из обоих. Без этого поля нельзя ни отделить
  /// «чьи это деньги», ни отключить один кабинет, не потеряв историю второго.
  adAccountId   String?
  name          String
  campaignId    String?
  campaignName  String?
  adsetId       String?
  adsetName     String?
  /// Адрес продвигаемой публикации и её короткий код — то, по чему объявление
  /// узнаётся среди наших постов. Пусто у рекламы, ведущей на сайт или в форму.
  postUrl       String?
  postShortcode String?
  /// Идентификатор медиа в Instagram, если Meta его отдала.
  mediaId       String?
  /// Картинка объявления от рекламной системы. Показывается в отчёте только у
  /// строк без объекта: у привязанных обложка берётся из карточки — она крупнее,
  /// свежее и не протухает вместе со ссылкой Meta.
  thumbnailUrl  String?
  /// Текст продвигаемой публикации, каким его отдала Meta при сверке.
  ///
  /// Хранится в базе, а не берётся из ленты Instagram на лету, по двум причинам.
  /// Первая: рекламируемого поста в ленте может не быть вовсе — реклама идёт со
  /// Страницы Facebook или с аккаунта, не подключённого к CRM (на живых данных
  /// агентства 21.08.2026 в ленте не нашлось ни одного из 25 объявлений). Вторая:
  /// по этому тексту объявление привязывается к объекту и человек узнаёт пост в
  /// галерее — и то и другое должно работать, даже если доступ к Instagram завтра
  /// отвалится. Название кампании заменой не служит: Meta режет его до первой
  /// строки, и у половины объявлений там одинаковое «Продаётся квартира».
  caption       String?
  /// Объявление продвигает само агентство, а не конкретную квартиру.
  ///
  /// Отдельный признак, а не «просто не привязано»: реклама услуг Royal Home
  /// («доверьте продажу нам», «ищете жильё — обращайтесь») объекта не имеет и
  /// иметь не будет, тогда как непривязанная квартира — это незакрытая работа.
  /// Пока они лежали вместе, список «без объекта» не мог опустеть никогда.
  brand         Boolean        @default(false)
  /// ОСНОВНОЙ объект объявления — первый по весу среди AdProperty. Пишется ТОЛЬКО
  /// через lib/ads/adAllocation.ts::setAdProperties вместе со строками AdProperty,
  /// иначе два источника правды разойдутся. Деньги по объектам считаются по
  /// AdProperty (с запасным путём на это поле для строк, заведённых до миграции).
  propertyId    String?
  property      Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  matchSource   AdMatchSource?
  /// Все объекты, за которые платит объявление, с долями (см. AdProperty).
  properties    AdProperty[]
  /// Материалы объявления, разобранные из креатива Meta: ролики, картинки, карточки
  /// карусели, публикация. [{kind, id, permalink?, thumbnailUrl?, text?, propertyId?}].
  /// Нужны, чтобы увидеть «в объявлении четыре ролика, а привязан один объект».
  creativeAssets Json?
  /// Сколько РАЗНЫХ материалов в объявлении (материалы, доказанно про один и тот
  /// же объект, считаются одним). assetCount больше числа связей — объявление неполное.
  assetCount    Int            @default(1)
  /// ЧУЖАЯ РЕКЛАМА — не наша, в отчёт и итоги не входит.
  ///
  /// Кабинет, из которого агентство ведёт нашу рекламу, не обязан быть только
  /// нашим: подрядчик ведёт из него и других клиентов. Считать их бюджеты нашими
  /// расходами на квартиры нельзя — цифра «сколько вложено в объект» перестала бы
  /// значить хоть что-то (решение владельца 20.08.2026: «не хочу, чтобы данные
  /// путались»).
  ///
  /// Своим считается объявление, которое продвигает НАШУ публикацию (нашлась в
  /// ленте наших аккаунтов Instagram) или нашу Страницу Facebook. Всё остальное
  /// сохраняется, но помечается здесь: пусть лежит отдельным списком, где человек
  /// может сказать «нет, это наше» — молча выбрасывать чужой расход тоже нельзя,
  /// иначе разницу с кабинетом никогда не объяснить.
  excluded      Boolean        @default(false)
  /// СРОКИ И СОСТОЯНИЕ — то, что директор спрашивает первым: когда запустили,
  /// сколько крутится, идёт ли сейчас. До 21.08.2026 их не было вовсе, и отчёт
  /// показывал расход без ответа на вопрос «за какой период».
  ///
  /// createdTime — когда объявление создано в кабинете; startTime/stopTime —
  /// заданные сроки показа (у групп объявлений), stopTime пуст у бессрочных.
  /// status — что видно в Ads Manager: ACTIVE, PAUSED, ADSET_PAUSED, DELETED.
  createdTime   DateTime?
  startTime     DateTime?
  stopTime      DateTime?
  status        String?
  /// Цель кампании (OUTCOME_ENGAGEMENT, OUTCOME_TRAFFIC…) — по ней понятно, чего
  /// от объявления ждали: переписок, переходов на сайт или охвата.
  objective     String?
  /// Когда объявление впервые попало в CRM и когда его последний раз сверяли.
  firstSeenAt   DateTime       @default(now())
  lastSyncedAt  DateTime       @default(now())

  spend AdSpendDaily[]
  /// Настройки группы объявлений, считанные из Meta (04.10.2026, слой обучения
  /// «Студии запуска рекламы»). Нет строки — настройки ещё не читались.
  adSetSettings AdSetSettings?

  @@unique([platform, externalId])
  @@index([propertyId])
  @@index([postShortcode])
}

/// НАСТРОЙКИ ГРУППЫ ОБЪЯВЛЕНИЙ, КАК ИХ ОТДАЛА META (04.10.2026) — сырьё для базы «какие
/// настройки давали какую цену переписки» (читателя нет: «Студия запуска» убрана 12.10.2026,
/// данные копятся на будущее). Только чтение
/// (ads_read): CRM ничего в Meta не запускает и не меняет. Одна строка на объявление
/// (у нас группа = объявление, но связь по объявлению, чтобы расход и клиенты, которые
/// уже лежат на Ad, считались без второго ключа). Перезаписывается каждой синхронизацией.
///
/// Деньги — целыми МИНИМАЛЬНЫМИ единицами валюты кабинета (центы), как их отдаёт Meta;
/// в сомони/доллары не переводятся: срез по бюджету считается в валюте кабинета.
/// Все поля необязательные: Meta не обязана отдать каждое (бюджет бывает на кампании, а
/// не на группе; таргетинг у части кампаний шаблонный).
model AdSetSettings {
  id                  String   @id @default(uuid())
  adId                String   @unique
  ad                  Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  /// Внешний id группы объявлений в Meta.
  adsetId             String?
  /// Валюта кабинета на момент чтения ("USD" / "TJS"): бюджеты Meta отдаёт в её минимальных единицах. Пусто — строка записана до появления поля.
  currency            String?
  /// destination_type: WHATSAPP / INSTAGRAM_DIRECT / MESSENGER / MESSAGING_… / WEBSITE …
  destination         String?
  optimizationGoal    String?
  bidStrategy         String?
  billingEvent        String?
  dailyBudgetCents    Int?
  lifetimeBudgetCents Int?
  startAt             DateTime?
  endAt               DateTime?
  /// Срок показа в сутках (расчёт: конец − начало, округление вверх); пусто у бессрочных.
  durationDays        Int?
  /// "TJ" (вся страна), "DUSHANBE" (город/точка в Душанбе), "OTHER", "MIXED".
  geoScope            String?
  /// Разобранное geo_locations как пришло (урезанное).
  geoRaw              Json?
  ageMin              Int?
  ageMax              Int?
  /// Как у Meta: 1 — мужчины, 2 — женщины; пусто — все.
  genders             Int[]
  /// Включена ли Advantage+ аудитория; null — Meta не сказала.
  advantageAudience   Boolean?
  /// "AUTOMATIC" (плейсменты не заданы) или "MANUAL".
  placementsMode      String?
  /// publisher_platforms: facebook / instagram / messenger / audience_network.
  platforms           String[]
  /// promoted_object как пришёл (page_id, whatsapp_phone_number …).
  promotedObject      Json?
  /// Урезанный targeting: без пользовательских аудиторий поимённо и интересов целиком.
  rawTargeting        Json?
  syncedAt            DateTime @default(now()) @updatedAt
}

/// ДОЛЯ ОБЪЕКТА В ОБЪЯВЛЕНИИ (03.10.2026). Одно объявление Meta в «гибком» формате
/// несёт несколько роликов про разные квартиры; расход объявления делится между
/// объектами по весам методом наибольшего остатка (lib/ads/adAllocation.ts), чтобы
/// сумма долей равнялась расходу объявления до цента.
model AdProperty {
  id         String         @id @default(uuid())
  adId       String
  ad         Ad             @relation(fields: [adId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Относительный вес; доля = вес / сумма весов объявления.
  weight     Decimal        @default(1) @db.Decimal(8, 3)
  source     AdMatchSource
  createdAt  DateTime       @default(now())

  @@unique([adId, propertyId])
  @@index([propertyId])
}

/// РАСХОД ПО ОБЪЯВЛЕНИЮ ЗА ОДИН ДЕНЬ — самая мелкая крупица, из которой потом
/// складывается любой срез: месяц, объект, кампания, система.
///
/// Почему по дням, а не «итого за месяц»: Meta уточняет цифры задним числом
/// (отклонённые показы, возвраты, доначисления), поэтому синхронизация каждый раз
/// перезаливает последние дни поверх — а это возможно только при уникальном ключе
/// «объявление + день». Повторный прогон за те же сутки не создаёт вторую строку
/// и не удваивает бюджет.
///
/// ДАТА — календарный день РЕКЛАМНОГО КАБИНЕТА, а не Душанбе: Meta нарезает
/// статистику в часовом поясе аккаунта и другого варианта не предлагает. Расхождение
/// с нашими сутками возможно на границе месяца; переводить нечего — исходных часов
/// в ответе нет вовсе.
///
/// ВАЛЮТА — валюта кабинета (у нас USD). Хранится как пришла, в отчётную приводится
/// при агрегации через lib/money.ts, ровно как суммы сделок и расходов: единый курс
/// на всю CRM, а не свой у каждого отчёта.
model AdSpendDaily {
  id            String   @id @default(uuid())
  adId          String
  ad            Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  spend         Decimal  @db.Decimal(12, 2)
  currency      Currency @default(USD)
  impressions   Int      @default(0)
  reach         Int      @default(0)
  clicks        Int      @default(0)
  /// «Начатые переписки» — главный результат рекламы агентства: человек написал в
  /// Direct. Именно эту цифру Ads Manager показывает колонкой «Результат».
  conversations Int      @default(0)
  syncedAt      DateTime @updatedAt

  @@unique([adId, date])
  @@index([date])
}

/// ПОВТОРЯЮЩИЙСЯ ПЛАТЁЖ — аренда, серверы, домены, связь (решение владельца
/// 20.08.2026: «завёл один раз — дальше строка появляется сама»).
///
/// Каждый месяц в день оплаты крон заводит из шаблона обычную строку Expense
/// (ключ rec:<id>:<месяц> — идемпотентно), а за три дня до срока напоминает
/// финансистам, что подходит оплата. Сумма меняется — правится шаблон, старые
/// строки не переписываются: они уже отражают то, что реально заплатили.
model RecurringExpense {
  deletedAt         DateTime?
  period            String          @default("MONTH")
  startsOn          String?
  endsOn            String?
  autoPay           Boolean         @default(false)
  skippedDates      String[]        @default([])
  counterparty      String?
  paymentMethod     String?
  categoryId        String?
  id                String          @id @default(uuid())
  title             String
  category          ExpenseCategory @default(OFFICE)
  amount            Decimal
  currency          Currency        @default(TJS)
  /// День месяца, когда платёж должен быть оплачен (1–28; 29–31 не даём, чтобы
  /// февраль не пропускал платёж).
  dayOfMonth        Int
  note              String?
  /// Выключенный шаблон ничего не создаёт и не напоминает — но история строк цела.
  active            Boolean         @default(true)
  /// Последний месяц («2026-08»), за который строка уже создана, — защита от
  /// второго срабатывания крона в тот же день.
  lastCreatedMonth  String?
  /// Последний месяц, за который отправлено напоминание «подходит оплата».
  lastRemindedMonth String?
  /// Для ADVERTISING: канал, который ночная задача копирует в создаваемый расход
  /// (CRM-07, 04.10.2026). null у шаблонов, заведённых до этого поля, — они создают
  /// расход без канала, как раньше.
  source            ClientSource?
  /// Для SALARY: сотрудник, которого ночная задача копирует в создаваемый расход.
  agentId           String?
  agent             Agent?          @relation(fields: [agentId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([active])
}

model ExpenseCategoryDefinition {
  id            String @id @default(uuid())
  title         String
  rootCategory  ExpenseCategory
  parentId      String?
  icon          String
  color         String
  budgetMonthly Decimal?
  active        Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([parentId])
}

model ExpenseReceipt {
  id           String @id @default(uuid())
  expenseId    String
  expense      Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())
  @@index([expenseId])
}

/// Журнал обращений к ИИ. Без разбивки по видам токенов и без модели перерасход
/// не виден: чтение кэша дешевле входа в десять раз, а выход дороже входа в пять,
/// поэтому одна сумма «tokens» не переводится в деньги никаким множителем.
model AiLog {
  id               String   @id @default(uuid())
  endpoint         String
  /// Идентификатор модели на момент вызова. Цены меняются и модели уходят —
  /// без этого поля старые записи нечем пересчитать.
  model            String?
  /// Сумма всех видов токенов. Оставлена для старых записей и быстрых прикидок.
  tokens           Int?
  inputTokens      Int?
  outputTokens     Int?
  cacheWriteTokens Int?
  cacheReadTokens  Int?
  /// Стоимость вызова в долларах, посчитанная по ценам на момент записи.
  /// null — цена для этой модели неизвестна (сторонний поставщик).
  costUsd          Decimal? @db.Decimal(12, 6)
  ms               Int
  ok               Boolean
  /// Версия системного промта, которым отвечал этот вызов (13.09.2026, разбор
  /// «жалоба на ответ бота — узнать, каким текстом промта он отвечал»). Строка
  /// вида дата+пометка, обновляется ВРУЧНУЮ при значимой правке промта (см.
  /// SYSTEM_PROMPT_VERSION в ai/assistant.ts, LIVE_VOICE_PROMPT_VERSION в
  /// ai/liveVoicePersona.ts) — ничего автоматического, просто чтобы старый вызов
  /// можно было отличить от нового после правки текста. Null — вызов не связан
  /// с версионируемым промтом (эмбеддинги, обложки и т.п.) либо случился до
  /// появления этого поля.
  promptVersion    String?
  createdAt        DateTime @default(now())
  /// Диалог мессенджера (Conversation.id) или канал живого звонка (channelId,
  /// см. lib/telephony/liveVoiceBridge.ts — тот же ключ, что хранит
  /// ShowingSurveyCall.channelId) — если вызов сделан в его рамках, иначе null
  /// (фоновые/системные вызовы: карточка объекта, ночной инсайт, аудит бота...).
  /// Без @relation, намеренно: у диалога и звонка разные таблицы, единого FK нет,
  /// а удаление собеседника/звонка не должно ронять уже записанную стоимость
  /// (13.09.2026, «стоимость разговора нигде не видна» — владелец).
  conversationId   String?
  /// Managed physical attempt; historical NULL logs retain their old meaning.
  operationId String?
  operation AiProviderOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
  attemptNo Int?
  provider String?
  api String?
  profileRevision String?
  pricingRevision String?
  providerOutcome String?
  attemptState String?
  usageSource String?
  usageCompleteness String?
  costStatus String?
  thinkingTokens Int?
  audioInputTokens Int?
  audioOutputTokens Int?
  searchUnits Int?
  reservedUsd Decimal? @db.Decimal(18, 9)
  settledUsd Decimal? @db.Decimal(18, 9)

  @@index([createdAt])
  @@index([conversationId])
  @@unique([operationId, attemptNo])
}

/// Stable server billing scope; changing an agent revision does not reset a day.
model AiProviderDailyBudget {
  id String @id @default(uuid())
  policyKey String
  dayKey String
  capUsd Decimal? @db.Decimal(18, 9)
  reservedUsd Decimal @default(0) @db.Decimal(18, 9)
  settledUsd Decimal @default(0) @db.Decimal(18, 9)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([policyKey, dayKey])
}

/// One bounded paid operation across all model/key/cache retries and restarts.
model AiProviderOperation {
  id String @id @default(uuid())
  policyKey String
  policyHash String
  /// YYYY-MM-DD in the existing Dushanbe budget timezone.
  dayKey String
  deadlineAt DateTime
  maxAttempts Int
  attemptsReserved Int @default(0)
  maxCostUsd Decimal? @db.Decimal(18, 9)
  reservedUsd Decimal @default(0) @db.Decimal(18, 9)
  settledUsd Decimal @default(0) @db.Decimal(18, 9)
  status String @default("OPEN")
  attempts AiLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([policyKey, dayKey])
  @@index([status, deadlineAt])
}

/// Явный кэш системного промта Gemini (30.08.2026, тумблер geminiExplicitCachingEnabled
/// в Settings). Содержимое кэша хранится у Google под TTL — здесь только СВОЙ учёт,
/// какой хэш стабильного текста уже закэширован под каким именем и до какого срока,
/// чтобы не создавать новый кэш на каждый вызов (это стоит как обычный ввод один раз).
///
/// hash — от (модель + стабильный текст + схема инструмента, если есть): один и тот
/// же текст правил при смене намерения клиента (см. promptEconomy) даёт РАЗНЫЙ хэш —
/// не нужно перечислять варианты вручную, старые просто устаревают по TTL сами.
model GeminiCache {
  hash      String   @id
  /// Имя ресурса у Google: "cachedContents/xxxxx" — им ссылаемся в generateContent.
  name      String
  model     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Кто/когда/что удалил или изменил в чувствительных разделах (финансы, сотрудники,
/// публикация объектов) — история не редактируется приложением, только читается в Настройках.
/// agentName снят как снапшот на момент действия: агент мог быть переименован/удалён позже.
/// Журнал ошибок (сервер + браузер) — сырьё для автоматического отчёта о багах.
/// Пишется best-effort из центрального обработчика ошибок API и с фронта
/// (window.onerror). Директор получает утренний push-дайджест, если за сутки
/// были ошибки. Чистится автоматически (90 дней), в отличие от AuditLog.
model ErrorLog {
  id           String    @id @default(uuid())
  /// "api" | "web"
  source       String
  message      String
  stack        String?
  /// URL запроса (api) или страницы (web).
  url          String?
  agentId      String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  /// Кто и когда отметил ошибку разобранной. Разобранные не попадают в счётчики
  /// «за сутки/за неделю» и в утреннее уведомление директора, но остаются в журнале
  /// до автоочистки — чтобы можно было вернуться к истории, а не терять её.
  resolvedAt   DateTime?
  resolvedById String?
  /// Явный ключ дедупликации (`logSystemError(..., { dedupKey })`). До 25.09.2026
  /// ключ искался как НАЧАЛО текста — а у ~80 вызовов ключ вида "post-stats:YOUTUBE"
  /// в тексте не стоит вовсе, и повтор не узнавался никогда (4 одинаковых записи
  /// за минуту на проде и пуш директору на каждую как на «новую поломку»).
  dedupKey     String?

  @@index([createdAt])
  @@index([resolvedAt])
  @@index([source, dedupKey, createdAt])
}

/// Находки LLM-аудита переписок бота (кнопка «Проверить диалоги» на Здоровье
/// системы, 18.08.2026): бот сам вычитывает недавние диалоги против собственных
/// правил (цены, ссылки/номера, тон, повторы, потеря контекста) вместо того,
/// чтобы владелец ловил это по скриншотам от клиентов.
model BotAuditFinding {
  id             String    @id @default(uuid())
  conversationId String
  /// "INSTAGRAM" | "FACEBOOK" | "WHATSAPP" | "TELEGRAM"
  channel        String
  /// price | links_phone | context_loss | repetition | tone | ignored_question | other
  type           String
  quote          String
  why            String
  severity       String    @default("medium")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?

  @@index([createdAt])
  @@index([resolvedAt])
  @@index([type])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  agentId    String?
  agentName  String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, createdAt])
  /// «История объекта» и «история клиента» на карточке отбирают журнал по одному
  /// entityId — без индекса каждая такая карточка читала весь журнал действий
  /// целиком (аудит 09.08.2026). Составной с createdAt: записи всегда идут от
  /// свежих к старым, сортировка берётся из того же индекса.
  @@index([entityId, createdAt])
  /// Фильтры по ДЕЙСТВИЮ и по СОТРУДНИКУ (27.08.2026, аудит №4): журнал не
  /// чистится никогда и пишется на каждое действие CRM, а квота передач
  /// (lib/clientTransfer.ts) считает count по action+agentId на КАЖДОМ нажатии
  /// «Передать клиента» — без индекса это полный проход по вечно растущей
  /// таблице прямо в синхронном пути кнопки.
  @@index([action, createdAt])
  @@index([agentId, createdAt])
}

/// Сайт royalhome.tj уведомляет об этом, когда объект с origin=CRM (externalId
/// проставлен) редактируется или удаляется прямо в админке сайта — CRM больше не
/// "слепая" к правкам на другой стороне. Директор/админ видит и решает: принять
/// правку сайта в CRM или откатить сайт к версии CRM.
model SiteEditNotification {
  id         String    @id @default(uuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// UPDATED | DELETED — что сделали на сайте.
  action     String
  /// Изменённые поля и их новые значения, как их прислал сайт (для UPDATED).
  changes    Json?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  /// ACCEPTED (правку сайта применили в CRM) | REJECTED (переслали версию CRM обратно на сайт).
  resolution String?

  @@index([propertyId, resolvedAt])
}

model Settings {
  buyerSellerAutomationMode String @default("PREVIEW")
  investigationCaseConfig Json @default("{}")
  sellerControlConfig Json @default("{}")
  postShowingCohortConfig Json @default("{}")
  /// Property narration only. Owner-selected ElevenLabs voices; no implicit default voice.
  propertyNarrationConfig Json @default("{}")
  id                                String    @id @default("singleton")
  /// Desktop shell rollout only; null or invalid configuration means OFF.
  uiShellRollout                    Json?
  /// Честная структура комиссии сделки (% от цены объекта):
  /// интейкер (принял объект) + риелтор (продал) + компания. Сумма — то, что
  /// платит клиент (по умолчанию 0.5+0.5+1 = 2%). Меняются в Настройках;
  /// в закрытых сделках доли зафиксированы снапшотом (см. Deal.commission*Amount).
  commissionIntakePercent           Decimal   @default(0.5)
  commissionRealtorPercent          Decimal   @default(0.5)
  commissionCompanyPercent          Decimal   @default(1.0)
  monthlyCommissionPlan             Decimal   @default(8000)
  /// ВЕРОЯТНОСТЬ ЗАКРЫТИЯ ПО СТАДИИ СДЕЛКИ — для прогноза денег к концу месяца
  /// (lib/financeForecast.ts). Json вида {NEGOTIATION: 0.2, AGREEMENT_PENDING: 0.5,
  /// CONTRACT_SIGNED: 0.8, PENDING_APPROVAL: 0.95}; ключи и значения по умолчанию —
  /// DEAL_STAGE_WIN_PROBABILITY_DEFAULT в @royal-home/shared. Настройка, а не
  /// константа в коде: истории переходов по стадиям в базе нет, вывести веса из
  /// данных нечем, и правит их владелец сам. null — работают значения по умолчанию.
  dealStageWinProbability           Json?
  /// Ключ Anthropic API, задаётся администратором через Настройки (не только через .env).
  anthropicApiKey                   String?
  /// Ключ Google Gemini API (текстовый A/B-тест бота + расшифровка голосовых),
  /// задаётся администратором через Настройки; .env GEMINI_API_KEY — запасной путь.
  geminiApiKey                      String?
  /// РЕЗЕРВНЫЙ ключ Gemini (другой проект Google AI Studio). Подключается сам, когда
  /// основной исчерпал повторы или отклонён — страхует от отказов, специфичных
  /// конкретному ключу: удалён при ротации, выбран лимит, заблокирован проект.
  /// Хранился только в .env GEMINI_API_KEY_2, из-за чего был невидим в интерфейсе и
  /// расходился между средами (12.08.2026: на проде его не было вовсе, а в Настройках
  /// лежал живой основной — понять это можно было только зайдя на сервер).
  geminiApiKey2                     String?
  /// Системный промт чат-бота (личность/логика ИИ-ассистента). Редактируется админом
  /// в Настройках; если пусто (null) — используется дефолт из кода (DEFAULT_BOT_PROMPT).
  botSystemPrompt                   String?
  /// Системный промт ответов на КОММЕНТАРИИ под публикациями Instagram. Отдельный
  /// от промта диалога: комментарии читают посторонние, там свои правила (что
  /// скрывать, когда звать в директ, как не здороваться дважды). Пусто (null) —
  /// действует зашитый по умолчанию (DEFAULT_COMMENT_PROMPT, messengers/comments.ts):
  /// очищенное поле обязано означать «вернуться к стандартному», а не «промта нет».
  botCommentPrompt                  String?
  /// Какая модель пишет текстовые ответы бота клиентам: "claude" (по умолчанию, проверенный)
  /// или "gemini" (для A/B-теста). Голосовые расшифровываются Gemini независимо от этой настройки.
  aiTextProvider                    String    @default("claude")
  /// Глобальный рубильник бота: false — не отвечает ни на одном канале (сообщения
  /// клиентов копятся в истории для агента, но ИИ не вызывается и не тратит токены).
  botEnabled                        Boolean   @default(true)
  /// Рубильники бота ПО КАНАЛАМ: «выключить Instagram, оставив WhatsApp».
  /// Это НЕ подключение канала — за подключение отвечают metaEnabled и ключи;
  /// здесь только то, говорит ли БОТ в этом канале. Выключенный канал продолжает
  /// принимать входящие в переписку CRM (сотрудник отвечает руками) — ровно так же,
  /// как ведёт себя выключенный botEnabled. Действуют вместе с botEnabled: общий
  /// рубильник сильнее, канальный лишь сужает.
  /// Включены по умолчанию: до появления этих полей бот отвечал везде, и выкатка
  /// не должна менять поведение.
  botWhatsappEnabled                Boolean   @default(true)
  botInstagramEnabled               Boolean   @default(true)
  botFacebookEnabled                Boolean   @default(true)
  botTelegramEnabled                Boolean   @default(true)
  /// ЧАТ НА САЙТЕ (23.08.2026) — виджет в углу royalhome.tj, тот же бот, что и в
  /// мессенджерах (см. messengers/websiteChat.ts). Отдельный рубильник, а не общий
  /// с каналами Meta: у сайта нет ни ключей, ни транспорта, гасить его приходится
  /// по другим причинам (например, поток «просто посмотреть» в час пик).
  /// Выключено — виджет вежливо предлагает оставить номер, а бот не отвечает.
  botWebsiteChatEnabled             Boolean   @default(true)
  /// Дневной потолок расходов на ИИ в USD. null = без лимита. Проверяется
  /// перед каждым вызовом judgeCase (insightJudge.ts); при превышении кейсы
  /// пропускаются, статус диджеста становится PARTIAL.
  aiDailyCostCapUsd                 Float?
  /// Рубильник прямой интеграции с Meta (Instagram Direct). Выключен по
  /// умолчанию: включать только после того, как вебхук подтверждён в панели
  /// Meta и приложение переведено в рабочий режим.
  metaEnabled                       Boolean   @default(false)
  /// Ключи Meta — задаются в Настройках, как и ключи ИИ, чтобы не лезть на сервер.
  /// Секреты хранятся зашифрованными (AES-256-GCM, см. crypto.ts); .env остаётся
  /// запасным вариантом, если значение здесь пустое.
  metaAppSecret                     String?
  /// Номер приложения Meta (не секрет). Нужен ровно для одного: обменять короткий
  /// маркер рекламного кабинета на 60-дневный и продлевать его дальше — обмен
  /// требует пары «приложение + секрет» (см. lib/ads/metaAdsToken.ts). Для
  /// переписки не используется: там маркеры выдаются иначе.
  metaAppId                         String?
  metaVerifyToken                   String?
  metaWaToken                       String?
  /// Идентификатор номера-отправителя в WhatsApp. Не секрет — хранится как есть.
  metaWaPhoneId                     String?
  /// Кабинет WhatsApp (WABA ID), в котором лежат одобренные Meta тексты первого
  /// сообщения (lib/whatsappFirstContact.ts). Не секрет. Заполняется САМ с первым
  /// же вебхуком WhatsApp (entry[].id), владельцу искать его в панели Meta не нужно.
  metaWaBusinessAccountId           String?
  metaIgToken                       String?
  /// Секрет приложения Instagram (Instagram → «Настройка API для входа в Instagram»).
  /// У входа через Instagram своё приложение со своим секретом, и вебхуки Instagram
  /// подписываются им, а не секретом приложения Facebook.
  metaIgAppSecret                   String?
  /// Когда маркер Instagram последний раз продлевали (живёт 60 дней, продление
  /// раз в неделю — см. messengers/instagramFeed.ts). null — ни разу.
  metaIgTokenRefreshedAt            DateTime?
  /// МАРКЕР УДАЛЕНИЯ INSTAGRAM (20.09.2026) — НЕ metaIgToken выше. Тот ходит через
  /// прокси на graph.instagram.com («Instagram API» без входа через Facebook) —
  /// у этого продукта метода удаления нет вовсе, отсюда вечное `400 Unsupported
  /// delete request`, которое раньше считалось окончательным ограничением площадки
