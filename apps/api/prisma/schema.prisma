  /// Пишется РЯДОМ с уходом в INACTIVE/Корзину, не трогается больше нигде.
  lastAgentId String?
  lastAgent   Agent?  @relation("LastClientAgent", fields: [lastAgentId], references: [id], onDelete: SetNull)

  /// ПРЕДЛОЖЕНИЕ РЕАКТИВАЦИИ ПРЕЖНЕМУ АГЕНТУ, ОЖИДАЕТ РЕШЕНИЯ. Пока это поле
  /// заполнено, карточка НЕ workStatus=ACTIVE и assignedAgentId её ещё не
