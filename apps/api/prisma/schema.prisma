// Генератор Prisma 7. `prisma-client-js` и его `binaryTargets` убраны вместе
// с движком на Rust: клиент теперь ходит в Postgres через `pg` (драйверный
// адаптер, см. `src/lib/prismaAdapter.ts`), бинарника под платформу больше нет
// и подбирать его для образа не нужно.
//
// `output` в семёрке обязателен, и клиент кладётся в дерево исходников, а не в
// `node_modules`. Для нас это ещё и решение старой беды: worktree-агенты делят
// один общий `node_modules`, и `prisma generate` в одной сессии подсовывал
// соседней клиент под чужую схему (обходной рецепт в `scripts/agent-stand.mjs`
// теперь не нужен). Каталог в .gitignore — его создаёт `prisma generate`.
//
// `importFileExtension = "js"` — под наш `module: NodeNext`: в исходниках
// расширение импорта пишется таким, каким оно будет ПОСЛЕ компиляции.
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

// Адрес базы в семёрке живёт в `prisma.config.ts` рядом с этим файлом; здесь
// остаётся только вид СУБД.
datasource db {
  provider = "postgresql"
}

enum Role {
  /// Владелец компании: полный доступ ко всему, управлять его учёткой может только другой директор.
  DIRECTOR
  ADMIN
  MANAGER
  AGENT
  /// Конвейер подготовки объекта (спецификация владельца, 02.08.2026): проверка
  /// карточки, съёмка фото и видео. Работает с очередью объектов, а не со своими
  /// карточками, поэтому видит все.
  MARKETING
  /// Монтаж видео: забирает объект в работу и возвращает готовое.
  EDITOR
  /// Проверка причин закрытия («купил самостоятельно», «продал через другое
  /// агентство») — карточка уходит к ней, а не следующему агенту.
  SECURITY
