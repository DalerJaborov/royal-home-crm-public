  /// видео теперь общий, UPLOAD_VIDEO_MAX_BYTES в packages/shared. Колонку не
  /// удаляем — миграций ради этого не делаем.
  propertyVideoMaxSizeMb            Int       @default(600)
  /// Сколько раз лид может перейти между агентами, прежде чем станет «Потерянным»
  /// и перестанет распределяться. Спецификация владельца называет три; число
  /// вынесено в настройки, потому что «ни одна цифра не остаётся в коде».
  leadMaxTransfers                  Int       @default(3)
  /// Режим «не принимаю лиды» у агента: сколько часов он может длиться подряд и
  /// сколько часов после его окончания тумблер недоступен. Спецификация владельца
  /// называет 48 и 24; числа в Настройках, потому что «ни одна цифра не остаётся
  /// в коде».
  agentPauseMaxHours                Int       @default(48)
  agentPauseCooldownHours           Int       @default(24)
  /// ОБЯЗАТЕЛЬНЫЕ ОКНА (спецификация владельца): на сколько минут можно отложить
  /// заполнение итога и сколько раз; через сколько часов после приёма объекта в
  /// работу требуется «Итог объекта»; в какое окно суток он показывается — ночью
  /// требовать отчёт бессмысленно, он переносится на ближайшее утро.
  summarySnoozeMinutes              Int       @default(10)
  /// Через сколько минут после принятия лида требуется «Итог разговора». Час —
  /// время на то, чтобы реально позвонить: требование в ту же секунду означало бы
  /// отчёт о разговоре, которого ещё не было.
  callSummaryAfterMinutes           Int       @default(60)
  /// ШТРАФ ЗА БЕЗДЕЙСТВИЕ (Fair Play). Через сколько дней без единой записи по
  /// принятому клиенту приходит предупреждение, через сколько — штраф, и во
  /// сколько баллов он обходится. Подобрать эти числа можно только на живой
  /// работе: короткий срок превратит штрафы в фон, длинный — в формальность.
  inactivityWarnAfterDays           Int       @default(3)
  inactivityPenaltyAfterDays        Int       @default(5)
  inactivityPenaltyPoints           Int       @default(5)
  summarySnoozeMaxCount             Int       @default(4)
  propertySummaryAfterHours         Int       @default(36)
  propertySummaryWindowStart        String    @default("10:00")
  propertySummaryWindowEnd          String    @default("15:00")
  /// «Застой сделки» (lib/dealStalePipeline.ts, владелец 30.08.2026: «типа как
  /// СБ» — если агент долго не двигает клиента). Продавец без единого объекта в
  /// CRM дольше стольких дней — застой. По умолчанию 10, а не месяц из
  /// формулировки владельца буквально: база живёт всего 2 недели, месячный
  /// порог не сработал бы ни разу, а проблема уже видна на 10 днях.
  dealStaleSellerDays               Int       @default(10)
  /// То же для покупателя без единой сделки (Deal) любой стадии. 21, короче
  /// месяца по той же причине, что и выше — настраиваемо на будущее.
  dealStaleBuyerDays                Int       @default(21)
  /// Клиент не ответил боту НИ РАЗУ столько дней подряд — переводим в Неактивные
  /// автоматически, без агента (владелец 30.08.2026: «молчаливые тоже пусть идут
  /// туда»). Цвет ставится RED (реального контакта не было) с готовой причиной
  /// STOPPED_RESPONDING — тем же значением, что агент выбирает вручную для этого
  /// же случая, так что дальше карточка идёт по обычному пути светофора.
  silentClientInactiveDays          Int       @default(5)
  /// «Потерянные» ИЛИ «Неактивные» дольше стольких дней — автоматически в Корзину
  /// (владелец 30.08.2026: «через 3 месяца пусть уходят в корзину»). Обычное
  /// мягкое удаление (trashClient) — восстановимо, история и переписка целы.
  /// Отсчёт: для LOST — от lostAt, для INACTIVE — от уже существующего inactiveSince.
  lostOrInactiveToTrashAfterDays    Int       @default(90)
  /// «Ждёт варианты»/«Ждёт показ» (Путь покупателя): через сколько минут CRM
  /// напоминает агенту, что клиент всё ещё ждёт, и сколько раз повторяет
  /// напоминание, прежде чем заблокировать агенту выдачу новых лидов (решение
  /// владельца 04.08.2026 — числа настраиваемые, не зашитые в код).
  waitingCheckAfterMinutes          Int       @default(60)
  waitingCheckMaxRepeats            Int       @default(2)
  /// «Не отвечает» (переработка 12.08.2026, ТЗ владельца): через сколько минут повторить
  /// звонок и сколько попыток подряд делать, прежде чем поставить руководителю задачу
  /// «Проверить контакт с клиентом». Числа настраиваемые — заказчик сам пометил их как
  /// «например, три раза по пятнадцать минут», а не как жёсткое правило.
  noAnswerRetryMinutes              Int       @default(15)
  noAnswerMaxAttempts               Int       @default(3)
  /// «ХВОСТ» ДОЗВОНА (план «CRM вместо РОПа» 20.08.2026, п. вопросов владельцу №9,
  /// достроено 01.09.2026): внутридневная серия (noAnswerRetryMinutes×noAnswerMaxAttempts)
  /// решает только «звонили ли только что» — после её исчерпания карточка уходит
  /// руководителю, но КЛИЕНТ мог просто не быть на связи именно сегодня. Хвост даёт
  /// ещё два шанса позже, не трогая саму внутридневную серию: через noAnswerTailDay1
  /// дней и ещё раз через noAnswerTailDay2 дней после НЕЁ — отдельные задачи агенту,
  /// не эскалация руководителю. Выключается noAnswerTailEnabled=false, если хвост
  /// не нужен вовсе (например, лид уже ушёл другому агенту к этому моменту).
  noAnswerTailEnabled               Boolean   @default(true)
  noAnswerTailDay1                  Int       @default(2)
  noAnswerTailDay2                  Int       @default(5)
  /// «ПРОПУЩЕННЫЙ ЗВОНОК БЕЗ ПЕРЕЗВОНА» (Пачка 18, 12.09.2026 — факт с прода: 24
  /// пропущенных за 30 дней без исходящего контакта в течение суток). Часы считаются
  /// ТОЛЬКО в рабочем окне (Settings.workHoursStart/End, см. lib/telephony/
  /// missedCallEscalation.ts) — ночь и выходные не тикают. Порог 1 — повторный пуш
  /// агенту, которому назначен звонок (или сразу руководству, если у номера нет
  /// карточки/ответственного — для него это финальная ступень). Порог 2 — эскалация
  /// руководству и задача, когда за агентом карточка есть.
  missedCallbackHours                Int       @default(2)
  missedCallbackEscalateHours        Int       @default(6)
  /// «Итог показа»: через сколько минут ПОСЛЕ НАЗНАЧЕННОГО ВРЕМЕНИ показа (а не после
  /// отметки «выполнено» агентом — так CRM не ждёт агента бесконечно) открывается
  /// обязательное окно. То же число задаёт срок «Итога приёмки» у продавца
  /// (см. SELLER_SHOWING_SUMMARY_AFTER, lib/pendingSummaries.ts) — оба окна об одном
  /// и том же «встреча закончилась, доехал», отдельного числа для продавца нет.
  meetingSummaryAfterShowingMinutes Int       @default(90)

  /// ─── СВЕТОФОР НЕАКТИВНЫХ (владелец 20-21.08.2026, мозговой штурм «лазейки»,
  /// см. lib/inactiveTrafficLight.ts) ───
  ///
  /// Цвет ставит СИСТЕМА, не агент — иначе им можно манипулировать. Вычисляется из
  /// причины перевода в Неактивные (см. Client.inactiveReasonKey) и того, был ли
  /// реальный контакт к этому моменту:
  ///   GREEN  — контакт был, пауза по делу (клиент сам попросил подождать, отложил,
  ///            думает, семейные обстоятельства и т.п.) — шансы высокие, спешить некуда;
  ///   YELLOW — контакт был, но клиент пропал без объяснения (просил перезвонить и исчез);
  ///   RED    — живого контакта не было вовсе, только недозвоны.
  /// У каждого уровня свой шаг напоминаний и свой предел попыток — после него карточка
  /// уходит в Потерянные (LOST), как и раньше делали недозвоны у активных лидов.
  inactiveGreenPingHours    Int @default(24)
  inactiveGreenMaxAttempts  Int @default(5)
  inactiveYellowPingHours   Int @default(48)
  inactiveYellowMaxAttempts Int @default(2)
  inactiveRedPingHours      Int @default(36)
  inactiveRedMaxAttempts    Int @default(2)
  /// Сколько РЕАЛЬНЫХ попыток контакта (дозвон или ответ клиента в переписке) нужно
  /// накопить, чтобы разрешить перевод в Неактивные с причиной «перестал отвечать» или
  /// «другое» — без этого агент мог слить клиента в неактив без единой попытки
  /// связаться, освободив себе слот бесплатно (закрытая лазейка). Для причин, где
  /// клиент САМ что-то ответил («думает», «отложил», «попросил перезвонить позже» —
  /// InactiveReason, отличных от STOPPED_RESPONDING/OTHER), хватает одного реального
  /// контакта: сам факт причины уже доказывает, что разговор состоялся.
  inactivateMinAttempts     Int @default(2)
  /// Перевёл клиента в Неактивные — следующий лид агенту не раньше чем через это время.
  /// Без задержки перевод в Неактив был бы способом ускорить получение нового лида, и
  /// лазейка открылась бы заново, просто на другом действии.
  inactivateCooldownHours   Int @default(5)
  /// Вернувшийся ПОТЕРЯННЫЙ или НЕАКТИВНЫЙ клиент по-прежнему уходит сначала прежнему
  /// агенту (решение владельца 19.08.2026 в силе — клиент помнит, с кем говорил), но
  /// теперь с таймером: не принял за это время — лид уходит в общую очередь KPI, а не
  /// лежит у прежнего агента бесконечно (не блокирует существующий лимит активных лидов).
  lostReturnAcceptMinutes   Int @default(120)

  /// ─── ДУБЛИ ПРИ РАЗДАЧЕ (03.09.2026, план вечерней сессии, раздел L) ───
  /// Похожая новая заявка (совпадение по имени + близкому номеру — не точный
  /// телефон, тот склеивается уровнем 1 раньше) не раздаётся другому агенту, пока
  /// агент, за которым закреплена СУЩЕСТВУЮЩАЯ карточка, не подтвердит, что это
  /// разные люди. Не ответил за это время — заявка уходит в обычную раздачу как
  /// отдельный человек (тот же принцип, что у lostReturnAcceptMinutes выше, но в
  /// часах: вопрос не такой срочный, как принятие уже назначенного лида).
  duplicateReviewTimeoutHours Int @default(6)
  /// Сколько раз ЗА МЕСЯЦ агент может подтвердить «это мой клиент» на вопрос
  /// duplicateReview, прежде чем это станет сигналом руководителю (не доказательством
  /// обмана — агент, отвечающий на такой вопрос, сам заинтересованная сторона, см.
  /// lib/duplicateReview.ts). Три подряд — обычная жизнь (клиент правда писал с
  /// нескольких номеров); больше — стоит присмотреться, тот же порядок величины,
  /// что у agentLossSeriesThreshold ниже.
  duplicateClaimAnomalyThreshold Int @default(3)

  /// ─── ПРОДАВЕЦ БЕЗ ОБЪЕКТА — антифрод (владелец 21.08.2026) ───
  /// Продавец принят в работу (исход звонка PROPERTY_ACCEPTED), но карточки объекта всё
  /// ещё нет. На первом сроке — жёлтая метка в дашборде руководителя, на втором — красная
  /// с задачей в СБ. Норма по опыту — 1-3 дня, владелец согласился на запас 3/5.
  sellerPropertyMissingWarnDays     Int @default(3)
  sellerPropertyMissingCriticalDays Int @default(5)

  /// ─── НОМЕР ЗАПРОШЕН — ЗАГЛОХЛО (план «Пульс компании», фаза 2, п.1а жалобы
  /// 31.08.2026) ───
  /// Бот/агент попросил номер, диалог (BotConversation/TelegramConversation) ещё
  /// не привязан к карточке клиента (то есть номер так и не пришёл), и с
  /// последнего сообщения клиента прошло больше этого числа часов — сигнал в
  /// «первую линию» дашборда. Норма по опыту переписки — заглохший диалог виден
  /// уже к вечеру того же дня, отсюда 18ч, а не сутки: раньше владелец узнаёт,
  /// позже смысла проверять меньше (клиент, скорее всего, уже написал другим).
  /// См. lib/staleContactRequests.ts.
  staleContactRequestHours Int @default(18)

  /// ─── ПОКУПАТЕЛЬ «ДУМАЕТ» — медленный трек (владелец 21.08.2026) ───
  /// Первые два напоминания короткие (клиент недавно видел объект и решает по
  /// конкретному показу), дальше медиана поиска жилья — недели (отраслевые данные,
  /// NAR 2024/2025), и частые напоминания только раздражают — переходим на редкий шаг.
  buyerThinkingFirstPingHours  Int @default(48)
  buyerThinkingSecondPingHours Int @default(72)
  buyerThinkingSlowTrackDays   Int @default(7)
  /// ФИНАЛЬНЫЙ ШАГ медленного трека (план 20.08.2026, вопрос владельцу №10, достроено
  /// 01.09.2026): раньше третий уровень зацикливался сам на себя тем же интервалом
  /// (buyerThinkingSlowTrackDays) навсегда. После buyerThinkingSlowTrackCycles повторов
  /// в этом темпе шаг переходит на buyerThinkingFinalTrackDays (по плану — «раз в две
  /// недели») и дальше уже не меняется — совсем без финального перехода клиент,
  /// висящий месяцами, получал бы напоминание каждую неделю бессрочно.
  buyerThinkingSlowTrackCycles Int @default(4)
  buyerThinkingFinalTrackDays  Int @default(14)

  /// ─── ЗАНЯТОСТЬ АГЕНТА В РАЗДАЧЕ (владелец 21.08.2026) ───
  /// Показ по календарю или живой разговор через CRM исключает агента из раздачи новых
  /// лидов на это время — раньше лид с тикающим таймером на принятие мог прийти прямо
  /// посреди показа (вероятный корень случая 18.08.2026 с Нурмухаммадом, из-за которого
  /// автопередачу при непозвонившем агенте тогда выключили насовсем).
  agentOccupancyShieldEnabled      Boolean @default(true)
  agentOccupancyShieldAfterMinutes Int     @default(30)

  /// Сколько МИНУТ С МОМЕНТА ПРИЁМА (Client.acceptedAt) лид гарантированно остаётся за
  /// первоначальным агентом, даже если первый звонок сорван (leadCallMinutes истёк) и
  /// leadReassignOnMissedCallEnabled включена — вместо мгновенной передачи (см.
  /// penalizeMissedFirstCalls) двум следующим по очереди агентам уходит только пуш
  /// «этот лид может достаться вам», а настоящая передача происходит только по
  /// истечении этого срока. Должно быть НЕ МЕНЬШЕ leadCallMinutes, иначе окна пула
  /// просто не остаётся и передача снова становится мгновенной, как до 21.08.2026.
  /// Круг короткий не просто так — иначе клиенту никто не звонит, пока лид сидит в
  /// пуле дольше, чем стоило бы.
  leadPoolAfterMinutes Int @default(25)

  /// ─── ПЕРЕДАТЬ КЛИЕНТА (владелец 21.08.2026) ───
  /// Сколько передач в месяц агент делает свободно, без вопросов — дальше не блокировка,
  /// а повод для личного разговора с руководителем (не автоматика).
  transferQuotaPerMonth        Int      @default(3)
  /// Резерв объекта на сделке (Путь покупателя, решение владельца 30.07.2026):
  /// сколько РАБОЧИХ дней (суббота/воскресенье не считаются) объект остаётся
  /// в PropertyStatus.RESERVED, прежде чем автоматически вернуться в продажу,
  /// если сделка ещё не закрыта и не отменена.
  dealReservationBusinessDays  Int      @default(3)
  /// Что делать со СДЕЛКОЙ, когда резерв истёк, а сделка ещё не закрыта и не
  /// отменена (Пачка 8, 11.09.2026, докстринг lib/dealReservation.ts): "cancel" —
  /// перевести в CANCELLED (по умолчанию, объект уже вернулся в AVAILABLE тем же
  /// тиком, сделка по свободному объекту не должна висеть открытой); "keep" —
  /// оставить как есть, только пометить Deal.reservationExpiredAt для канбана.
  /// Строка, а не Prisma-enum: как и остальные однобуквенные тумблеры настроек,
  /// не требует миграции на новое значение.
  dealReservationExpiryAction  String   @default("cancel")

  /// «RESERVED без движения» (docs/flow-audit-property-11-09.md, Пачка 9 #4):
  /// сколько КАЛЕНДАРНЫХ дней сделка по объекту может не менять стадию (DealStage),
  /// прежде чем агент и руководитель получат пуш «сделка стоит». Резерв при этом
  /// НЕ снимается — это отдельное решение человека (см. dealReservationBusinessDays
  /// выше, срабатывает по другому признаку и раньше).
  dealStaleReserveDays          Int      @default(7)
  /// Чек-лист документов сделки (Пачка 14, 11.09.2026): какие DealDocumentKind
  /// обязательны, прежде чем сделку можно отправить на закрытие (PENDING_APPROVAL)
  /// или закрыть напрямую. Хранится строками (имена DealDocumentKind), а не через
  /// Prisma-enum-массив, тем же способом, что и transferConflictKeywords ниже —
  /// список значений можно расширять без миграции. Директор может пропустить
  /// проверку через skipDocuments у самого запроса (см. routes/deals.ts) — это
  /// пишется в аудит, а не в настройки.
  dealRequiredDocuments         String[] @default([])
  /// Контексты диалплана АТС, из которых звонок считается ВХОДЯЩИМ.
  ///
  /// Пустой список — действует встроенный набор (см. lib/telephony/incomingCalls.ts,
  /// DEFAULT_INBOUND_*). Это настройка, а не константа, потому что контекст транка
  /// живёт в ЧУЖОЙ системе (FreePBX) и меняется без выката CRM: новый транк,
  /// переименование, переезд на pjsip. Один такой случай уже стоил недели молча
  /// потерянных входящих (11.08.2026, `from-trunk-sip-out` не подошёл под голое
  /// `from-trunk`).
  ///
  /// Каждая запись — точное имя ЛИБО префикс: контекст подходит, если равен записи
  /// или начинается с `запись-`. Переопределение ПОЛНОЕ: указав свой список, не
  /// забудьте вписать в него `ext-queues` — иначе перестанет распознаваться очередь.
  /// Какой контекст у станции на самом деле, покажет счётчик отбраковок на дашборде
  /// телефонии (GET /calls/telephony/dashboard, поле `rejected`).
  incomingInboundContexts      String[] @default([])
  /// Заводить карточку клиента по незнакомому номеру прямо во время звонка.
  /// Выключено — звонок остаётся только в журнале входящих (прежнее поведение:
  /// курьеры и реклама не должны засорять базу).
  incomingAutoCreateClient     Boolean  @default(true)
  /// С каким типом заводится такая карточка ДО квалификации. OTHER по умолчанию:
  /// пока оператор не спросил, покупатель это или продавец, назначать карточку
  /// агенту не за что — а BUYER немедленно отправил бы её в распределение.
  incomingDefaultKind          String   @default("OTHER")
  /// Отдавать карточку агенту сразу после того, как оператор выбрал тип обращения.
  /// Выключено — карточка остаётся без ответственного, руководитель назначает сам.
  incomingAssignOnQualify      Boolean  @default(true)
  /// Номер, на который АТС уводит звонок, когда оператор недоступен.
  ///
  /// САМУ ПЕРЕАДРЕСАЦИЮ ПО-ПРЕЖНЕМУ ДЕЛАЕТ СТАНЦИЯ — правило обязано работать
  /// именно тогда, когда CRM лежит. Изменилось другое: раньше CRM это значение
  /// только показывала, а вписывал его в станцию человек по SSH. Теперь CRM
  /// записывает его во внутреннюю базу Asterisk (AMI DBPut, семейство
  /// ROYALHOME/failover), откуда диалплан читает номер на каждом звонке. Настройка
  /// станции при этом не переписывается: запасной путь очереди описан один раз и
  /// меняются только ЗНАЧЕНИЯ — см. lib/telephony/failoverSync.ts.
  incomingForwardPhone         String?
  /// Что станция делает со звонком, которого никто не взял:
  ///   "none"     — ничего (прежнее поведение: клиент слушает музыку, пока не бросит);
  ///   "forward"  — звонит на номер дежурного (incomingForwardPhone);
  ///   "voicemail"— предлагает оставить сообщение, CRM его расшифрует;
  ///   "both"     — сначала дежурный, если и там не взяли — сообщение.
  ///
  /// Умолчание "none" — прежнее поведение: настройка, приехавшая на прод уже
  /// что-то меняющей в живой телефонии, опаснее любой пользы от неё.
  incomingNoAnswerAction       String   @default("none")
  /// Сколько секунд звонок ждёт оператора, прежде чем сработает правило выше.
  /// 20 секунд — примерно четыре гудка: дольше человек начинает класть трубку.
  incomingNoAnswerSeconds      Int      @default(20)
  /// НОЧНОЙ РЕЖИМ (запрос владельца 14.08.2026: «когда нас нет — звук
  /// автоответчика»). В нерабочее время очередь операторов пропускается вовсе:
  /// звонить в пустой офис — значит заставить клиента слушать музыку впустую.
  ///   "none"      — ночного режима нет, круглосуточно как днём;
  ///   "forward"   — сразу дежурному (номер тот же incomingForwardPhone);
  ///   "voicemail" — сразу автоответчик: приветствие → запись → карточка.
  /// Границы "HH:MM" по Душанбе; окно через полночь (22:00–08:00) поддержано.
  /// Исполняет станция (значения уезжают в её базу через failoverSync) — правило
  /// обязано работать и тогда, когда CRM лежит.
  incomingNightAction          String   @default("none")
  incomingNightStart           String   @default("21:00")
  incomingNightEnd             String   @default("09:00")
  /// КУДА ИДЁТ ВХОДЯЩИЙ В ПЕРВУЮ ОЧЕРЕДЬ (решение владельца 21.08.2026: «Нурмухаммаду
  /// пусть ничего не идёт, звонок прямо на 44 650-14-14 идёт на SIP»).
  ///   "queue"     — очередь операторов, как было с самого запуска телефонии;
  ///   "extension" — прямо на SIP-аппарат (incomingPrimaryExtension), очередь молчит.
  ///
  /// Умолчание "queue" — прежнее поведение: настройка, которая на первом же выкате
  /// перенаправляет живые звонки агентства, опаснее любой пользы от неё.
  incomingPrimaryTarget        String   @default("queue")
  /// Внутренний номер аппарата для режима "extension" (например, 1021 — софтфон на
  /// телефоне директора). Пусто в этом режиме = звонить некуда, поэтому CRM
  /// возвращается к очереди: тишина в трубке хуже, чем прежнее поведение.
  incomingPrimaryExtension     String?
  /// Показывать оператору окно во время разговора. Выключатель на случай, если
  /// окно мешает: сбор данных о звонках при этом продолжается.
  incomingPanelEnabled         Boolean  @default(true)
  /// Уведомление о входящем звонке на телефон оператора (решение владельца
  /// 11.08.2026: «даже если CRM на айфоне закрыт, звонки должны прийти»).
  /// Окно оператора живёт только в открытой вкладке — без этого уведомления
  /// человек с закрытой CRM узнаёт о звонке исключительно по звонящей трубке.
  incomingPushEnabled          Boolean  @default(true)
  /// ЧАСЫ ПРИЁМА ВХОДЯЩИХ, "HH:MM" по Душанбе. ЭТО НЕ workHoursStart/End: те
  /// часы решают, когда готовый лид уходит агенту, а эти — когда CRM вправе
  /// поднимать оператора уведомлением. Разделены намеренно: смена оператора и
  /// рабочий день агентства — разные вещи, и сведение их в одну настройку
  /// означало бы, что сдвиг одной молча меняет другую.
  ///
  /// Выключено по умолчанию — круглосуточно, то есть ровно прежнее поведение:
  /// настройка, приехавшая на прод уже что-то запрещающей, тихо ломает работу
  /// у того, кто её не заказывал.
  incomingHoursEnabled         Boolean  @default(false)
  incomingHoursStart           String   @default("09:00")
  incomingHoursEnd             String   @default("21:00")
  /// ВХОДЯЩИЙ ЗВОНОК ИЗВЕСТНОГО КЛИЕНТА — СНАЧАЛА ЕГО АГЕНТУ (владелец 16.08.2026,
  /// прямая отмена прежнего правила «входящие только оператору» от 08.08.2026).
  /// Станция звонит ответственному, и только если тот не взял — возвращает звонок
  /// в очередь 1000. Выключено по умолчанию: правило трогает живую телефонию, и
  /// работать оно начинает не от выката, а от решения владельца. Требует контекста
  /// royalhome-agent-route на FreePBX — без него CRM не переводит ничего вовсе
  /// (см. lib/telephony/inboundRouting.ts, docs/telephony-inbound-routing.md).
  incomingRouteToAssignedAgent Boolean  @default(false)
  /// Сколько секунд станция звонит агенту, прежде чем вернуть звонок в очередь.
  /// 150 (2.5 минуты) — выбор владельца 29.08.2026: агенту дают максимум шансов
  /// взять трубку, ценой того, что клиент дольше слушает гудки; дальше — голосовая
  /// почта, не очередь операторов. 0 — «без ограничения» (владелец 20.08.2026):
  /// звонить, пока клиент сам не положит трубку, на голосовую почту не перейдёт
  /// вовсе (см. lib/telephony/incomingSettings.ts, dial timeout на станции).
  incomingRouteRingSeconds     Int      @default(150)
  /// РЕЖИМ МАРШРУТИЗАЦИИ НЕЗНАКОМЫХ ЗВОНКОВ (владелец 20.08.2026) — заготовка на
  /// будущее, а не переключатель поведения станции. Сейчас на линии реально
  /// действует только "assigned_then_forward" (клиента с ответственным уводит
  /// ему lib/telephony/inboundRouting.ts, незнакомого — на incomingForwardPhone,
  /// как и раньше). Остальные значения CRM синхронизирует в AstDB станции тем же
  /// путём, что и incomingNoAnswerAction (см. lib/telephony/routingModeSync.ts),
  /// но диалплана, который бы их читал, ещё нет — владелец сам решает, когда
  /// дойдут руки завести на станции очередь по KPI (kpi_queue), возврат роли
  /// оператора (dedicated_operator) или голосовое меню (ivr_menu). «Веерный
  /// вызов всем агентам» в списке нет и не будет: предложен и в тот же день
  /// отменён владельцем 20.08.2026 — агенты путают такой звонок со своим
  /// собственным клиентом. Строка, а не enum: список заведомо будет расти, а
  /// миграция ради каждого нового варианта — цена без выгоды (тот же приём,
  /// что у incomingNoAnswerAction/period в ProblemReport).
  incomingRoutingMode          String   @default("assigned_then_forward")
  /// ДЕЖУРНАЯ РОТАЦИЯ ДЛЯ РЕЖИМА "dedicated_operator" (владелец 20.08.2026,
  /// лёгкая версия вместо полного возврата удалённой 18.08.2026 роли оператора:
  /// без рабочего места, без отдельных прав — просто список, кто сегодня дежурит).
  /// Порядок в массиве — порядок ротации; дежурный на сегодня выбирается по
  /// номеру календарного дня в Душанбе (`lib/dushanbeTime.ts`) по модулю длины
  /// списка, чтобы не хранить отдельный курсор и не зависеть от того, сколько
  /// звонков было вчера. Пустой список = дежурить некому, звонок остаётся на
  /// incomingForwardPhone, как при "assigned_then_forward".
  incomingDutyAgentIds         String[] @default([])
  /// РАЗБОР ПРОБЛЕМНЫХ МЕСТ (решение владельца 11.08.2026) — два отчёта, два
  /// выключателя. Порознь, а не одним: недельный нужен, чтобы чинить по ходу, а
  /// месячный — чтобы видеть, стало ли лучше; выключить хочется обычно один из них.
  /// Выключенный отчёт не собирается вовсе — ни кроном, ни кнопкой «Собрать
  /// сейчас»: иначе выключатель означал бы «не присылать пуш», а не «не собирать».
  problemReportWeeklyEnabled   Boolean  @default(true)
  problemReportMonthlyEnabled  Boolean  @default(true)

  /// ПОДСКАЗКА АГЕНТУ ПЕРЕД СОЕДИНЕНИЕМ (идея владельца 20.08.2026: «агент ответил на
  /// звонок, но даже не знает, с кем общается»). Станция играет агенту в ухо короткую
  /// справку о звонящем; клиент её не слышит — он в это время слушает гудки.
  ///
  /// Выключено по умолчанию: возможность трогает живую телефонию и требует правки
  /// диалплана на АТС (docs/telephony-whisper.md). Включать должен человек, а не выкат.
  callWhisperEnabled       Boolean  @default(false)
  /// Играть на ВХОДЯЩИХ — главный случай: агент не знает, кто звонит.
  callWhisperIncoming      Boolean  @default(true)
  /// Играть на ИСХОДЯЩИХ — агент сам выбрал, кому звонит, поэтому по умолчанию нет.
  /// Полезно, когда звонок идёт из списка задач и человек уже забыл контекст.
  callWhisperOutgoing      Boolean  @default(false)
  /// ЧТО ИМЕННО ОЗВУЧИВАТЬ — списком блоков, а не одним «уровнем детализации».
  /// Уровни (коротко/средне/подробно) остаются в интерфейсе пресетами поверх этого
  /// списка: владелец хотел выбирать состав сам, а пресеты закрывают частые случаи.
  /// Значения — WHISPER_PARTS в lib/telephony/whisperText.ts. Порядок в массиве роли
  /// не играет: фраза всегда собирается в фиксированном порядке, имя первым — если
  /// агент отвлёкся и услышал только начало, услышать он должен имя.
  callWhisperIncomingParts String[] @default(["name", "role", "anchor"])
  /// Для исходящих список свой и по умолчанию короче — агент и так знает, кому звонит.
  callWhisperOutgoingParts String[] @default(["name", "role"])
  /// Язык подсказки по умолчанию: "tg" — таджикский, "ru" — русский. У сотрудника может
  /// стоять своё (Agent.whisperLanguage), и оно сильнее агентского.
  callWhisperLanguage      String   @default("tg")
  /// Голос из каталога Gemini TTS. Проверено на живых образцах 20.08.2026: Kore с прямым
  /// указанием языка в тексте читает таджикский разборчиво.
  callWhisperVoice         String   @default("Kore")
  /// Добавлять зацепку от ИИ по истории клиента («ваъда дода буд: рӯзи душанбе занг занед»).
  /// Отдельным выключателем: остальные блоки собираются из полей карточки и врать не умеют,
  /// а этот пишет модель — ошибётся она, и агент войдёт в разговор уверенно и неправильно.
  callWhisperAiHint        Boolean  @default(false)
  /// ДОПОЛНИТЕЛЬНЫЕ КЛЮЧИ GOOGLE, сверх основного и запасного (владелец 20.08.2026:
  /// «могу выдать ещё несколько, чтобы вообще никогда не падали»). Каждый зашифрован
  /// отдельно, порядок = порядок перебора при отказе.
  ///
  /// ЗАЧЕМ СПИСОК, А НЕ ТРЕТЬЕ ПОЛЕ. Устойчивость упирается не в число ключей, а в
  /// суточную квоту, а она считается НА ПРОЕКТ Google, а не на ключ: пять ключей
  /// одного проекта делят одну квоту и от падений не спасают. Список позволяет
  /// добавить по ключу из каждого нового проекта, сколько бы их ни завели.
  geminiApiKeysExtra       String[] @default([])

  /// ИМЕНА МОДЕЛЕЙ GEMINI — ИЗ НАСТРОЕК, А НЕ ТОЛЬКО ИЗ .env (22.08.2026).
  ///
  /// Google закрыл две модели за месяц: gemini-2.5-flash 02.08 и gemini-2.5-pro 22.08,
  /// обе — молча, с HTTP 404 на каждый вызов. Оба раза бот работал на резервной
  /// (то есть медленнее и дороже) до тех пор, пока у кого-то не доходили руки войти
  /// на сервер по SSH и поправить .env. Имя модели — не секрет и не архитектура,
  /// это расходник, который меняется чаще, чем выкатывается код.
  ///
  /// Пусто — работает прежнее правило `.env || дефолт из кода` (ai/geminiTransport.ts):
  /// настройка ничего не ломает, пока её не заполнили.
  ///
  /// Порядок в списках = порядок перебора при отказе.
  /// Основная модель диалогов и разбора текста (GEMINI_MODEL).
  geminiModel                   String?
  /// Резервные модели диалогов, по очереди после основной (GEMINI_FALLBACK_MODEL).
  geminiFallbackModels          String[]  @default([])
  /// Дорогие модели расшифровки голосовых, по очереди (GEMINI_TRANSCRIBE_MODELS).
  /// Голос требует модели умнее диалоговой: Flash не разбирал продиктованный номер
  /// телефона, и карточки не объединялись (решение владельца 19.08.2026).
  geminiTranscribeModels        String[]  @default([])
  /// Модель рисования обложек для статей блога.
  geminiImageModel              String?
  /// ДЕШЁВАЯ СТУПЕНЬ для простых задач: классификация, извлечение полей, перевод
  /// расшифровки — там, где не нужен разговор с клиентом (флаг `simple` в ai/client.ts).
  /// Пусто — простые задачи идут той же моделью, что и диалоги, как было всегда.
  ///
  /// ВЫКЛЮЧЕНО ПО УМОЛЧАНИЮ НАМЕРЕННО. Экономия здесь очевидна (полторы тысячи вызовов
  /// в неделю), а вот качество на нашем материале — нет: заполнение карточки разбирает
  /// таджикско-русскую речь с опечатками. Включать, посмотрев на живых карточках, а не
  /// потому, что дешевле; при отказе дешёвой модели перебор сам поднимется на обычную.
  geminiLiteModel               String?
  /// Секрет, которым станция забирает файлы подсказок (зашифрован, см. crypto.ts).
  /// В отличие от музыки ожидания и приветствия здесь ИМЕНА КЛИЕНТОВ: публичный путь
  /// /uploads/telephony/*.wav для них недопустим.
  callWhisperStationToken       String?
  /// Когда станция последний раз забирала манифест. Видно в Настройках: перестала ходить —
  /// это заметно сразу, а не через неделю тишины.
  callWhisperFetchedAt          DateTime?
  /// ─── АНТИФРОД: ТИШИНА ПОСЛЕ ПОКАЗА (мозговой штурм владельца 20-21.08.2026) ───
  /// Сколько дней клиент без единого касания через CRM (звонок/сообщение) после
  /// проведённого показа считается тревожным сигналом для «Контроля руководителя»
  /// (routes/oversight.ts). Показ был — интерес подтверждён живым визитом, — а
  /// дальше тишина: либо агент забыл клиента, либо сделка ушла в обход компании.
  /// Само по себе число ничего не решает и не блокирует — это только сигнал
  /// человеку посмотреть глазами, ровно как остальные плитки «Контроля».
  sellerSilenceAfterShowingDays Int       @default(7)

  /// ─── АНТИФРОД: ЗВОНОК-ОПРОС ПОСЛЕ ПОКАЗА (владелец 13.09.2026) ───
  /// Продолжение антифрода выше (тишина после показа/серия у агента), но не
  /// сигнал руководителю посмотреть, а прямая проверка: бот живым голосом
  /// звонит ПОКУПАТЕЛЮ через ShowingSurveyDelayMinutes после запланированного
  /// времени показа/встречи (lib/showingSurvey.ts::runShowingSurveyTick,
  /// триггер — nextActionDate, а не отметка агента «выполнено», тот же приём,
  /// что у requireMeetingSummaries — агент не может сорвать проверку, ничего
  /// не отмечая) и косвенными вопросами выясняет, не увёл ли агент клиента в
  /// обход агентства (docs/post-viewing-survey-design-11-09.md, раздел 5).
  /// Результат скрыт от агента — видит только директор, при найденном красном
  /// флаге сразу и по каждому случаю отдельно (то же решение владельца
  /// 07.09.2026, что и у lib/agentOffCrmAlarm.ts: не ждать серию).
  /// ВЫКЛЮЧЕНО ПО УМОЛЧАНИЮ — владелец включит сам, когда проверит звук
  /// живого голоса (PR #348).
  /// ⚠️ НЕ ЧИТАЕТСЯ С 17.09.2026 — рубильник опроса после показа теперь один,
  /// `postShowingCallEnabled` (см. модель ShowingSurveyCall ниже о том, почему
  /// колонка пока оставлена).
  showingSurveyEnabled Boolean @default(false)

  /// ─── АНТИФРОД: ВЕЧНЫЕ ПЕРЕГОВОРЫ (план 20.08.2026, red flag, достроено 01.09.2026) ───
  /// Ветка «Переговоры» окна «Итог приёмки»/«Итог показа» переспрашивает исход раз в
  /// 24 часа (см. pendingSummaries.ts) — сама по себе не ограничена по числу кругов.
  /// Если кругов больше этого числа подряд — сигнал в «Контроль руководителя»:
  /// «переговоры», которые не заканчиваются, обычно значат — сделка идёт мимо компании
  /// или агент просто оттягивает честный отказ.
  sellerNegotiationMaxRounds Int @default(3)

  /// ─── АНТИФРОД: СЕРИЯ У ОДНОГО АГЕНТА (план 20.08.2026, red flag, достроено 01.09.2026) ───
  /// Сколько переводов в Неактивные/потерь клиентов у ОДНОГО агента за последние 7 дней
  /// считается тревожной серией (не общий счётчик по компании, как было раньше в
  /// oversight.ts, а именно по каждому агенту отдельно). Три случая подряд у новичка —
  /// возможно, ему нужна помощь; три случая подряд у опытного — стоит присмотреться.
  agentLossSeriesThreshold Int @default(3)

  /// ─── СЛОВА-ПРИЗНАКИ КОНФЛИКТА В ПРИЧИНЕ ПЕРЕДАЧИ (владелец 22.08.2026) ───
  /// Раньше жили хардкодом в lib/clientTransfer.ts (CONFLICT_KEYWORDS) — первая
  /// прикидка мозгового штурма 20-21.08.2026, ни разу не сверенная с реальными
  /// случаями. Обязательный комментарий к причине передачи OTHER ищется на
  /// вхождение любого из этих слов без учёта регистра; совпадение уводит
  /// передачу мимо автоподбора агента прямо руководителю (см. routeTransferTarget).
  /// Пустой список — не «взять дефолт из кода», а осознанно выключить это
  /// распознавание: OTHER тогда идёт обычной очередью KPI, как остальные причины.
  transferConflictKeywords String[] @default(["конфликт", "жалоб", "недовол", "оскорб", "груб", "агресс", "скандал", "хам"])

  /// ИНСАЙТЫ ОТ ИИ (03.09.2026, аудит §4.1/§4.2) — глобальный рубильник генерации
  /// диджестов InsightDigest. Выключен = cron пропускает сборку кейсов, существующие
  /// диджесты остаются доступными для чтения. Включён по умолчанию: фича новая, но
  /// безопасная (только чтение + ручная разметка), а владелец просил «сразу видеть».
  insightDigestEnabled Boolean @default(true)

  /// ─── РЕАКТИВАЦИЯ СТАРЫХ КЛИЕНТОВ ПАЧКОЙ (Пачка 12, 11.09.2026,
  /// docs/gaps-audit-11-09.md, владелец: «всё остальное делай») ───
  /// Раз в неделю (понедельник 10:00 Душанбе, см. cron.ts) бот сам пишет
  /// небольшой пачке остывших клиентов (COLD/LOST/workStatus=INACTIVE, давно
  /// без касания агента), не дожидаясь, пока их «найдут» вручную. Выключено
  /// по умолчанию — рассылка первому включению должна быть осознанным
  /// решением владельца, а не тихим побочным эффектом миграции.
  reactivationEnabled Boolean @default(false)
  /// Сколько ДНЕЙ без Client.lastContactAt (последнего касания СОТРУДНИКОМ, не
  /// входящего сообщения клиента) должно пройти, прежде чем карточка попадает
  /// в очередь на реактивацию.
  reactivationAfterDays Int @default(60)
  /// Потолок карточек в ОДНОЙ недельной пачке — рассылка контролируемая, а не
  /// залповая по всей базе остывших клиентов разом.
  reactivationBatchSize Int @default(20)
  /// Шаблон сообщения. Плейсхолдеры {name} (Client.fullName) и {agent} (имя
  /// того, кому достанется задача «перезвонить» — см. jobs/clientReactivation.ts)
  /// подставляются перед отправкой; отсутствие плейсхолдера в тексте не ошибка.
  reactivationMessageTemplate String @default("Здравствуйте, {name}! Это Royal Home. Ваш вопрос с недвижимостью всё ещё актуален? Если да — {agent} на связи и поможет.")

  /// ─── «БОТ НА ПАУЗЕ И ЗАБЫЛИ» (Пачка 17, 12.09.2026, lib/botPauseWatch.ts) ───
  /// Факт прода 11.09.2026: 187 диалогов (Instagram 162, WhatsApp 25) на паузе бота
  /// без единого касания человеком дольше 3 суток — агент ответил вручную один раз,
  /// поставил бота на паузу и забыл, клиент с тех пор молчит в пустоту. Крон раз в
  /// час (см. cron.ts) находит такие диалоги и будит сначала агента, потом
  /// руководство.
  botPauseWatchEnabled  Boolean @default(true)
  /// Сколько часов клиент ждёт ответа человека при паузе бота, прежде чем агенту
  /// уйдёт напоминание. Не чаще раза в сутки на диалог (BotConversation/
  /// TelegramConversation.pauseAlertSentAt).
  botPauseAlertHours    Int     @default(24)
  /// Через сколько часов молчания пауза снимается автоматически (бот отвечает
  /// снова) и уходит пуш руководству — агент, у которого клиент, не ответил.
  botPauseEscalateHours Int     @default(72)

  /// ГРУППЫ FACEBOOK ДЛЯ РУЧНОЙ РАЗДАЧИ (28.09.2026). Каждая строка —
  /// `Название | https://www.facebook.com/groups/…`. Groups API у Meta закрыт
  /// (22.04.2024), значит публикация в группу — только руками; CRM лишь готовит
  /// текст и открывает группу (lib/facebookGroupShare.ts). Пустой список — блок
  /// в карточке объекта и строка в дайджесте директора не показываются.
  facebookShareGroups   String[] @default([])

  /// ПОВТОРНЫЕ ПОКАЗЫ (28.09.2026, agent-brief.md reposts-digests) — см.
  /// докстринг PropertySocialRepost и lib/socialReposts.ts::scheduleRepostsTick.
  /// Выключено по умолчанию, как и остальные рубильники автопубликации.
  repostsEnabled        Boolean  @default(false)
  /// Через сколько дней после последней публикации объект получает новый круг.
  repostAfterDays       Int      @default(21)
  /// Сколько кругов повтора допускается на объект максимум.
  repostMaxRounds       Int      @default(3)

  /// ПОДБОРКИ ОБЪЕКТОВ (28.09.2026, agent-brief.md reposts-digests) — см.
  /// докстринг SocialDigestPost и lib/socialDigests.ts::runSocialDigestsTick.
  digestsEnabled         Boolean   @default(false)
  /// День недели публикации, 0 (воскресенье) — 6 (суббота), см. Date#getUTCDay
  /// через lib/dushanbeTime.ts::dushanbeWallClock. По умолчанию 5 — пятница.
  digestWeekday          Int       @default(5)
  /// Час публикации по Душанбе (0-23).
  digestHourDushanbe     Int       @default(12)
  /// Когда подборка последний раз реально прогонялась — та же защита от
  /// второго прогона в тот же день, что у Settings.dailyStoriesLastRunAt
  /// (см. lib/dailyStories.ts::runDailyStoriesTick).
  digestLastRunAt        DateTime?
}

/// ─── ИНСАЙТЫ ОТ ИИ (аудит 02.09.2026 §4.1/§4.2) ───────────────────────────────
/// Двухнедельный диджест находок ИИ по звонкам, штрафам и потерям клиентов.
/// Собирается кроном 15-го и 30-го числа; каждый кейс — один инцидент с таймлайном
/// и вердиктом (что агент сделал не так и как лучше). Директор разбирает на встрече.

model InsightDigest {
  id          String        @id @default(uuid())
  /// Начало периода: 1-е или 16-е число, 00:00 по Душанбе.
  periodStart DateTime      @unique
  /// Конец периода (15-е или последнее число месяца, 23:59:59 Душанбе).
  periodEnd   DateTime
  /// Дата встречи, к которой диджест готовится (15-е / 30-е).
  meetingAt   DateTime
  /// READY — собран полностью; PARTIAL — часть источников недоступна; FAILED — крон упал.
  status      String        @default("READY")
  /// Покрытие: сколько звонков проанализировано, сколько найдено проблем, сколько штрафов.
  coverage    Json
  createdAt   DateTime      @default(now())
  cases       InsightCase[]
}

model InsightCase {
  id           String        @id @default(uuid())
  digestId     String
  digest       InsightDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)
  agentId      String
  clientId     String
  /// call_low_score | score_penalty | agent_bypass | client_lost | complaint | positive
  kind         String
  /// 1–5, чем выше тем серьёзнее. Индекс ниже ускоряет выборку «сначала плохие».
  severity     Int
  /// Уникальный ключ источника: "call:<interactionId>", "score:<eventId>", "audit:<findingId>".
  /// Защита от дублей при повторном запуске крона на том же периоде.
  sourceKey    String        @unique
  /// Снапшот реплик / звонков / событий, относящихся к кейсу.
  timeline     Json
  /// Вердикт ИИ: что было сделано неверно, как лучше, краткое резюме.
  verdict      Json?
  /// Когда директор/руководитель разобрал кейс на встрече.
  reviewedAt   DateTime?
  /// Кто разобрал (Agent.id).
  reviewedById String?
  /// Заметка со встречи — свободный текст директора.
  meetingNote  String?

  createdAt DateTime @default(now())

  @@index([digestId, severity])
  @@index([agentId, createdAt])
}

/// ТОЧКА ВОЗВРАТА НАСТРОЕК — копия строки Settings, снятая ПЕРЕД её изменением.
///
/// Зачем это отдельная таблица, а не журнал действий. AuditLog по правке настроек
/// пишет только ИМЕНА изменённых полей и намеренно не пишет значения (там секреты).
/// Значит откатиться по нему нельзя в принципе: видно, что «меняли metaIgToken», но
/// не видно, на что именно его меняли и что было до. Владелец просил кнопку «сбросить
/// всё» ровно на случай испорченной настройки — но «по умолчанию» в этой строке
/// означает ПУСТО (нет маркеров Instagram, ключей Gemini, паролей АТС, промта бота),
/// то есть авария больше той, ради которой кнопку жали.
///
/// Поэтому снимков МНОГО, а не один слот. Вопрос владельца был точным: «если сделать
/// снимок, а потом кто-то испортит настройки и снова нажмёт кнопку — вернёмся к
/// испорченным?». С одним слотом — да. С историей испорченное состояние ложится
/// рядом с исправным и ничего не затирает, а вернуться можно к любой точке.
model SettingsSnapshot {
  id             String   @id @default(uuid())
  /// Вся строка Settings целиком, как её отдал Prisma (JSON: Decimal строками,
  /// даты в ISO). Целиком, а не «изменённые поля»: точка возврата обязана быть
  /// самодостаточной, иначе восстановление превращается в склейку цепочки правок,
  /// и любая дыра в цепочке (обрезка по сроку хранения) делает её неверной.
  /// СЕКРЕТЫ ЛЕЖАТ ЗДЕСЬ РОВНО ТАКИМИ ЖЕ, КАКИМИ ЛЕЖАЛИ В Settings, — то есть
  /// зашифрованными (AES-256-GCM, crypto.ts). Расшифровка ради снимка означала бы
  /// вторую, открытую копию всех ключей агентства.
  payload        Json
  /// Кто вызвал изменение, породившее эту точку. Без связи с Agent — как в AuditLog:
  /// увольнение сотрудника не должно уносить с собой точки возврата.
  agentId        String?
  agentName      String
  /// Что породило точку: "update" — обычное сохранение Настроек, "restore" — сам
  /// откат (он тоже изменение, и до него тоже нужна точка, иначе неудачный откат
  /// необратим).
  reason         String   @default("update")
  /// Имена полей, которые изменились этим сохранением, — чтобы список точек читался
  /// как история («тут трогали ключи Meta»), не сравнивая каждый раз 180 полей.
  changedFields  String[]
  /// Отпечаток ключа шифрования (sha256 от SETTINGS_ENCRYPTION_KEY, первые 16 hex)
  /// на момент снимка. Сам ключ, разумеется, не хранится.
  ///
  /// Зачем. Секреты в payload зашифрованы ТЕМ ключом, что действовал тогда. Если ключ
  /// сменили, старые значения не расшифруются — и «восстановление» вернуло бы в
  /// Настройки мусор, который выглядит как настоящий маркер, а на деле обрывает
  /// WhatsApp, Instagram и телефонию до следующего ручного ввода. По несовпадению
  /// отпечатка откат СОХРАНЯЕТ действующие секреты и честно сообщает, какие поля
  /// не были возвращены. null — ключ не был настроен (значения лежали как есть).
  keyFingerprint String?
  createdAt      DateTime @default(now())

  /// Список точек всегда идёт от свежих к старым, и по этому же индексу работает
  /// обрезка по сроку хранения (lib/settingsSnapshots.ts).
  @@index([createdAt])
}

/// Разбор ошибок бота: случай, когда он ответил плохо, и вывод из этого случая.
///
/// Два сигнала, оба честные и дешёвые. Первый — вместо бота ответил живой человек:
/// значит бот не справился, а реплика оператора и есть правильный ответ. Второй —
/// клиент переспросил или не понял: значит бот выразился непонятно. Из накопленных
/// случаев ночной разбор выводит короткие правила, и они подмешиваются в промт —
/// так бот перестаёт наступать на те же грабли (требование владельца 31.07.2026).
model BotLesson {
  id             String            @id @default(uuid())
  investigationOnly Boolean        @default(false)
  createdAt      DateTime          @default(now())
  /// "operator_override" — ответил человек; "client_confused" — клиент не понял;
  /// "call_answer" — пара «вопрос клиента → ответ агента» из телефонного разговора
  /// (07.08.2026): бот учится говорить так, как говорят живые продавцы агентства.
  kind           String
  channel        String
  conversationId String?
  /// Что бот сказал перед тем, как всё пошло не так.
  botMessage     String
  /// Реплика человека: правильный ответ оператора или слова непонимания клиента.
  humanMessage   String
  /// Короткое правило, выведенное ИИ из случая. null — случай ещё не разобран.
  lesson         String?
  /// Правило подмешивается в промт, пока владелец его не выключил.
  active         Boolean           @default(true)
  /// Недельная сводка по оборванным перепискам, из которой родилось предложение
  /// (kind="lost_client"). null — обычное правило из живой ошибки бота.
  ///
  /// Предложения из сводки заводятся здесь ЖЕ и с active=false нарочно: механика
  /// «правило действует / не действует» уже есть, вторая такая же означала бы два
  /// разных выключателя для одного и того же — а промт всё равно собирается
  /// отсюда (learnedRulesBlock). Пока владелец не включил предложение, оно
  /// физически не может попасть боту в промт.
  digestId       String?
  digest         LostClientDigest? @relation(fields: [digestId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([lesson, active])
  @@index([digestId])
}

/// Комментарий под нашей публикацией в Instagram и всё, что бот с ним сделал.
///
/// Комментарии приходят тем же вебхуком, что и личные сообщения, но живут по
/// другим правилам: их видят посторонние, отвечать надо не мгновенно (мгновенный
/// ответ под постом — главный признак робота), а спам и оскорбления надо убирать
/// с глаз, а не отвечать на них.
///
/// Таблица здесь не ради истории, а ради надёжности: Meta доставляет одно и то же
/// событие повторно, поэтому commentId уникален — второй ответ на тот же
/// комментарий физически невозможен. Она же держит отложенный ответ (replyDueAt) и
/// помнит, кому и когда мы писали в личные, чтобы не превратиться в спамера.
model InstagramComment {
  publicRolloutAssignmentId String?
  publicRolloutAssignment CustomerAgentRolloutAssignment? @relation(fields: [publicRolloutAssignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([publicRolloutAssignmentId])
  id                String    @id @default(uuid())
  publicSourceRevision BigInt @default(0)
  publicOriginVersion Int?
  publicOriginCiphertext String?
  publicOriginCapturedAt DateTime?
  customerOutboxParts CustomerOutboxPart[]
  /// Где оставлен комментарий: INSTAGRAM | FACEBOOK.
  ///
  /// Таблица заведена под Instagram и названа так же, но с 16.08.2026 сюда же
  /// ложатся комментарии со страницы Facebook (владелец: «хочу читать и их, а
  /// отвечать в Messenger»). Переименовывать таблицу ради этого нельзя — на неё
  /// смотрят экран «Комментарии», очередь крона и статистика, — а вот отвечать в
  /// нужный канал без этого поля невозможно: у Instagram и Facebook разные
  /// адреса Graph и разные маркеры доступа.
  channel           String    @default("INSTAGRAM")
  /// Идентификатор комментария у Meta. Ключ идемпотентности: повторная доставка
  /// того же события упирается в это ограничение и ничего не делает.
  commentId         String    @unique
  /// Публикация, под которой оставлен комментарий.
  mediaId           String
  /// В КАКОЙ НАШ аккаунт пришёл комментарий (entry.id вебхука). Комментарий ждёт
  /// ответа минуту-две (см. replyDueAt) и разбирается кроном — маркер аккаунта
  /// нужно ЗАПОМНИТЬ здесь, иначе к моменту ответа (воронка лид-магнита шлёт
  /// личное сообщение) узнать, чьим токеном отвечать, будет неоткуда. null —
  /// комментарий принят до появления нескольких аккаунтов, отвечаем аккаунтом
  /// по умолчанию.
  accountExternalId String?
  /// Заполнен, если это ответ в ветке (в том числе на нашу же реплику).
  parentId          String?
  /// Автор комментария в Instagram и его @ник, если Meta его прислала.
  authorId          String
  authorName        String?
  text              String
  /// Когда отвечать. Вебхук приходит мгновенно, а живой человек отвечает не сразу:
  /// пауза 1-2 минуты задаётся при приёме и разбирается кроном.
  replyDueAt        DateTime
  /// PENDING — ждёт ответа; WORKING — взят в обработку (защита от двойного тика
  /// крона); REPLIED, HIDDEN, SKIPPED, ESCALATED, FAILED — чем всё кончилось.
  status            String    @default("PENDING")
  /// Что именно бот ответил публично и какой у нашей реплики идентификатор:
  /// по нему узнаём собственные комментарии и не отвечаем сами себе по кругу.
  replyText         String?
  replyCommentId    String?
  repliedAt         DateTime?
  hiddenAt          DateTime?
  /// Каким был статус ПЕРЕД ручным скрытием — чтобы возврат восстанавливал историю,
  /// а не пересобирал её догадкой «есть replyText → бот ответил». Заполняется только
  /// ручным скрытием: когда комментарий прячет сам бот (спам), никакого прежнего
  /// состояния не было — он был в работе, и восстанавливать там нечего.
  /// null у записей, скрытых до появления поля, — для них остаётся прежняя догадка.
  statusBeforeHide  String?
  /// Когда автору ушло личное сообщение. По этому полю держится лимит «одно
  /// личное в сутки на человека» — без него бот заваливал бы личку активного
  /// комментатора.
  dmSentAt          DateTime?
  dmText            String?
  /// Объект, о котором пост, если публикация к нему привязана (Property.instagramUrl).
  /// Не связь, а голый идентификатор: объект могут удалить безвозвратно, а запись
  /// о том, что мы отвечали, должна пережить это.
  propertyId        String?
  /// Почему ход закончился ничем или чем-то необычным: "own", "loop_guard",
  /// "bot_off", "spam", "no_answer" — видно в журнале, не надо гадать.
  note              String?
  /// Сколько раз пытались обработать. Модель может не ответить; после трёх
  /// попыток зовём человека вместо бесконечных повторов.
  attempts          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  /// Выборка крона: что пора отвечать.
  @@index([status, replyDueAt])
  /// Лимит личных сообщений и защита от зацикливания — по автору.
  @@index([authorId, createdAt])
  /// Узнаём собственные реплики, если Meta пришлёт их обратно как новый комментарий.
  @@index([replyCommentId])
  /// «Голос рынка» (03.10.2026): комментарии по объекту.
  @@index([propertyId, createdAt])
}

/// Комментарии в группе-обсуждении Telegram-канала (01.09.2026) — тот же принцип,
/// что у InstagramComment (очередь → пауза → крон отвечает), но по-Telegram-овски
/// проще: один бот на всю переписку, поэтому нет ни accountExternalId, ни DM-лимита
/// (Telegram не различает «личное» и «публичное» по разным маркерам). Права на
/// удаление сообщений у бота на 01.09.2026 не подтверждены живьём — HIDDEN-путь
/// Instagram сюда сознательно не перенесён, спам получает статус SKIPPED и остаётся
/// в группе на глазах у людей, только без ответа бота.
model TelegramGroupComment {
  publicRolloutAssignmentId String?
  publicRolloutAssignment CustomerAgentRolloutAssignment? @relation(fields: [publicRolloutAssignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([publicRolloutAssignmentId])
  id             String    @id @default(cuid())
  publicSourceRevision BigInt @default(0)
  publicOriginVersion Int?
  publicOriginCiphertext String?
  publicOriginCapturedAt DateTime?
  customerOutboxParts CustomerOutboxPart[]
  /// message_id сообщения-комментария в группе. Нумеруется внутри чата, поэтому ключ
  /// идемпотентности — пара (groupChatId, messageId), а не он один (CHANNEL-NEW-23).
  messageId      String
  /// Группа-обсуждение, из которой пришёл комментарий (chat.id на момент приёма).
  /// Ответ и удаление идут в неё, а не в текущую группу из Настроек, которую могли
  /// сменить. null у строк, принятых до этого поля: они работают по прежнему
  /// правилу (дубль ловится по messageId, ответ уходит в текущую группу).
  groupChatId    String?
  /// message_id зеркала поста канала в группе, под которым оставлен комментарий
  /// (reply_to_message.message_id) — то, чем Telegram отличает «комментарий к
  /// посту №5» от «комментарий к посту №9».
  postMessageId  String
  authorId       String
  authorName     String?
  text           String
  replyDueAt     DateTime
  /// PENDING → WORKING → REPLIED/SKIPPED/ESCALATED/FAILED — тот же набор смыслов,
  /// что у InstagramComment.status.
  status         String    @default("PENDING")
  replyText      String?
  replyMessageId String?
  repliedAt      DateTime?
  /// "rude" | "loop_guard" | "bot_off" | "no_answer" — почему ответа не будет.
  note           String?
  attempts       Int       @default(0)
  /// Объект, о котором пост («голос рынка», 03.10.2026): ставится при приёме, если
  /// зеркало поста несёт id исходного поста канала и он совпал с
  /// Property.publishedPostIds.TELEGRAM, либо унаследован от соседнего комментария
  /// той же ветки. Строкой, без внешнего ключа, как InstagramComment.propertyId.
  propertyId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// Идемпотентность приёма в пределах группы (null различается в Postgres, поэтому
  /// строки без группы дополнительно ловит запасная проверка в ingestGroupComment).
  @@unique([groupChatId, messageId])
  /// Выборка крона: что пора отвечать.
  @@index([status, replyDueAt])
  /// Лимит ответов одному автору под одним постом в сутки.
  @@index([postMessageId, authorId, createdAt])
  @@index([propertyId])
}

/// Разбор ОДНОЙ переписки, которая кончилась плохо.
///
/// Зачем отдельно от BotLesson. BotLesson копит случаи, где ошибка бота видна
/// глазами: вместо него ответил сотрудник, клиент прямо переспросил. Там сигнал
/// сильный, и вывод из него сразу идёт в промт. Здесь сигнал СЛАБЫЙ: человек
/// замолчал — но мог просто передумать, уехать или купить у соседа. Автоматически
/// учиться на догадках опасно, поэтому разборы копятся неделю и показываются
/// владельцу списком, а действующим правилом становятся только те, что он отметил.
///
/// Признак «плохо кончилось» — объективный ФАКТ из базы, а не мнение бота о себе:
/// заявки нет (clientId пуст) и разговор мёртв (клиент попросил не писать, или
/// напоминания кончились, или тишина дольше суток). ИИ здесь отвечает только на
/// вопрос «на каком шаге ушёл человек», а не решает, был ли исход плохим.
model LostConversation {
  id             String            @id @default(uuid())
  createdAt      DateTime          @default(now())
  /// Диалог, который оборвался. Уникален: платить за разбор одного и того же
  /// диалога каждую ночь нельзя, а джоб идёт по скользящему окну и иначе брал бы
  /// одни и те же записи снова.
  conversationId String            @unique
  channel        String
  /// Почему считаем исход плохим: "opted_out" — попросил не писать;
  /// "follow_ups_exhausted" — бот исчерпал напоминания; "silent" — просто замолчал.
  reason         String
  /// Шаг, на котором ушёл человек (вывод ИИ): greeting | needs | budget |
  /// district | properties | phone | other.
  stage          String
  /// Насколько далеко разговор ушёл по данным САМОГО БОТА (leadDraft.stage):
  /// chatting | awaiting_phone. Это факт из базы, и он страхует вывод модели.
  draftStage     String?
  /// Последнее сообщение в диалоге — по нему разбор попадает в нужную неделю.
  lastMessageAt  DateTime
  /// Сколько реплик успел написать клиент и сколько напоминаний получил.
  clientMessages Int               @default(0)
  followUpsSent  Int               @default(0)
  /// Что, по мнению ИИ, пошло не так, и что он предлагает поменять. Пустое
  /// предложение — тоже результат: «вины бота не видно, человек просто ушёл».
  finding        String
  suggestion     String
  /// Первоисточник: последняя реплика бота и последняя реплика клиента. Без него
  /// владелец отмечал бы предложения вслепую.
  botMessage     String
  clientMessage  String
  /// В какую недельную сводку разбор попал. null — ещё не попал ни в одну.
  digestId       String?
  digest         LostClientDigest? @relation(fields: [digestId], references: [id], onDelete: SetNull)

  @@index([lastMessageAt])
  @@index([digestId])
}

/// Недельная сводка владельцу: сколько переписок оборвалось, на каком шаге чаще
/// всего и что предлагается поменять.
///
/// Побочный результат, ради которого это и делалось: владелец впервые видит, НА
/// КАКОМ ШАГЕ теряются люди. Числа считаются на месте и хранятся: пересчитать их
/// задним числом нельзя — диалоги живут дальше и меняются.
model LostClientDigest {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  /// Границы недели (по Душанбе). periodStart уникален — повторный запуск джоба
  /// за ту же неделю не должен плодить вторую сводку.
  periodStart  DateTime @unique
  periodEnd    DateTime
  /// Сколько переписок оборвалось за неделю.
  lostCount    Int      @default(0)
  /// Сколько заявок из мессенджеров пришло за ту же неделю. Без знаменателя число
  /// потерь ни о чём не говорит: 12 потерянных при 3 заявках и при 120 — разные новости.
  wonCount     Int      @default(0)
  /// {шаг: сколько} и {причина: сколько} — готовые числа для экрана.
  stageCounts  Json     @default("{}")
  reasonCounts Json     @default("{}")

  reviews   LostConversation[]
  proposals BotLesson[]

  @@index([periodStart])
}

/// Отметка: этот объект бот уже показывал этому собеседнику фотографиями.
///
/// Предохранитель от повторного показа. До него единственной защитой было то, что
/// модель видит присланные снимки в переписке, — а история обрезается до последних
/// сорока реплик, ходы бывают параллельными, и модель просто ошибается. Клиент
/// получал те же три фотографии второй раз: для него это признак робота, для нас —
/// лишние сообщения в лимите переписок Meta.
///
/// Ключ — канал + получатель, а не диалог: показ живёт в messengers/propertyShowcase.ts,
/// который знает только их, и одна таблица накрывает и BotConversation, и любой
/// будущий канал. Отметки старше срока показа чистятся на месте, при следующем показе
/// тому же собеседнику (см. SHOW_AGAIN_AFTER_MS).
/// Идентификаторы уже обработанных входящих сообщений — защита от ПОВТОРНОЙ
/// доставки вебхука.
///
/// Meta шлёт дубль, если не получила 200 достаточно быстро, а мы отвечаем ей до
/// того, как отработает ИИ (иначе не успеваем вовсе). Значит дубль — не
/// теоретическая возможность, а обычное дело при любой задержке сети: клиент
/// получал два ответа бота на одно своё сообщение, а в историю диалога его реплика
/// попадала дважды.
///
/// Уникальность пары и есть сам замок: вторая попытка записи падает на ограничении
/// БД, и это работает даже когда оба дубля обрабатываются одновременно — проверкой
/// «а нет ли уже такого» такую гонку не закрыть.
model ProcessedMessage {
  id        String   @id @default(uuid())
  /// WHATSAPP | INSTAGRAM | FACEBOOK — канал, откуда пришло сообщение.
  channel   String
  /// Идентификатор сообщения у поставщика (wamid у WhatsApp, mid у Meta).
  messageId String
  /// Когда начата обработка (замок ставится ДО неё, см. lib/webhookDedupe.ts).
  createdAt DateTime @default(now())
  /// Когда обработка ЗАВЕРШИЛАСЬ успешно. NULL значит «ещё идёт или процесс
  /// умер посреди неё» — 21.09.2026, разбор потери сообщений клиентов при
  /// рестарте контейнера. Отсутствие этого поля было причиной: отметка
  /// «обработано» ставилась ДО обработки и снималась только в catch, поэтому
  /// смерть всего процесса (не исключение) оставляла её навсегда — повторная
  /// доставка того же сообщения молча отбрасывалась как дубль, хотя ответа
  /// клиент так и не получил. Теперь дубль — это `completedAt IS NOT NULL`,
  /// а зависшая (`completedAt IS NULL` дольше разумного окна) отметка не
  /// блокирует повтор.
  completedAt DateTime?
  /// Кто поставил отметку — случайный идентификатор процесса (24.09.2026,
  /// webhookDedupe.ts::PROCESS_INSTANCE_ID). NULL — отметка от старого кода
  /// (до этой правки) или строка, пережившая свой процесс через рестарт без
  /// сброса. Позволяет отличить «эту отметку поставил Я, ещё обрабатываю» от
  /// «эту отметку поставил процесс, которого уже нет» без ожидания таймера —
  /// см. докстринг isDuplicateDelivery.
  claimedBy String?

  @@unique([channel, messageId])
  @@index([createdAt])
}

model ShownProperty {
  id          String   @id @default(uuid())
  endpointScopeId String?
  endpointScope CustomerEndpointScope? @relation(fields: [endpointScopeId], references: [id], onDelete: Restrict)
  /// INSTAGRAM | FACEBOOK | WHATSAPP — тот же канал, что у переписки.
  channel     String
  /// Идентификатор собеседника в канале (psid/igsid/wa_id).
  recipientId String
  /// Номер объекта из карточки (Property.shortId) — именно им оперирует модель.
  /// Без внешнего ключа нарочно: отметка переживает удаление объекта и ничего не
  /// значит после него, а лишняя обратная связь в Property ради трёх строк не нужна.
  shortId     Int
  sentAt      DateTime @default(now())

  @@unique([channel, recipientId, shortId])
  @@unique([endpointScopeId, recipientId, shortId])
  @@index([sentAt])
}

/// ЖУРНАЛ ПОКАЗОВ: какой объект бот реально отправил конкретному человеку.
///
/// Не путать с ShownProperty выше. Тот — предохранитель отправки: живёт неделю,
/// сам себя стирает, ключуется по номеру объекта без всякой связи с карточкой
/// клиента и нужен ровно для «не слать те же фотографии дважды».
///
/// Здесь — история, и она нужна для другого. Решение владельца 11.08.2026: если
/// бот отправил клиенту ссылку или фотографии конкретного объекта, лид уходит
/// ХОЗЯИНУ этого объекта (Property.intakeAgentId) безусловно, без порога
/// совпадения и без оглядки на очередь по KPI. Клиент уже смотрит именно эту
/// квартиру — отдать его другому агенту значит выбросить начатый разговор.
///
/// Записи НЕ удаляются недельной уборкой ShownProperty: у них своя жизнь и свой
/// ретеншн (ночная уборка в cron.ts). Уникальности нет нарочно — это журнал
/// событий, а не состояние: показали дважды — две строки, так и было.
model PropertyExposure {
  id          String    @id @default(uuid())
  /// NULL legacy provenance never becomes scoped ownership evidence by peer matching.
  endpointScopeId String?
  endpointScope CustomerEndpointScope? @relation(fields: [endpointScopeId], references: [id], onDelete: Restrict)
  /// INSTAGRAM | FACEBOOK | WHATSAPP — тот же канал, что у переписки.
  channel     String
  /// Идентификатор собеседника в канале (psid/igsid/wa_id). Пара с channel — это
  /// и есть мост к карточке клиента, пока её ещё нет: бот показывает объекты
  /// РАНЬШЕ, чем узнаёт телефон, то есть раньше, чем клиент вообще заводится.
  recipientId String
  /// Проставляется задним числом, когда из переписки родится лид.
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// SetNull, а не Cascade: объект могли удалить, но факт «клиенту это показывали»
  /// от этого не перестал быть фактом — номер ниже остаётся.
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  /// Номер объекта из карточки — переживает удаление самого объекта.
  shortId     Int
  /// PHOTO | LINK — отправили снимки или адрес карточки.
  kind        String
  sentAt      DateTime  @default(now())

  @@index([clientId, propertyId])
  @@index([channel, recipientId, sentAt])
  @@index([endpointScopeId, recipientId, sentAt])
  @@index([sentAt])
}

/// Откуда код узнал, что в диалоге речь об этом объекте.
///   SHARED_MEDIA   — клиент переслал наш пост/рилс (sharedMediaHint);
///   NUMBER_IN_TEXT — клиент назвал номер объекта словами («объект №112»);
///   LISTING_LINK   — клиент прислал ссылку на карточку или писал со страницы объекта на сайте;
///   AD_REFERRAL    — человек написал из нашей рекламы этого объекта (BotConversation.adPropertyId);
///   EXPOSURE       — объект показали клиенту (PropertyExposure: фото/ссылка ботом или агентом).
enum ConversationPropertySource {
  SHARED_MEDIA
  NUMBER_IN_TEXT
  LISTING_LINK
  AD_REFERRAL
  EXPOSURE
}

/// СВЯЗЬ «ДИАЛОГ ↔ ОБЪЕКТ» — основа «голоса рынка» (03.10.2026, lib/propertyVoice/).
///
/// Раньше BotConversation не знала, о каком объекте шла речь: код узнавал объект
/// в момент ответа (пересланный пост, номер, реклама, показ) и тут же забывал.
/// Теперь каждое такое узнавание оставляет здесь след, и вопросы и возражения из
/// переписки можно собрать по объекту. Только факты, которые код УЖЕ определил, —
/// никаких догадок. Идемпотентно: пара (диалог, объект) одна, повтор только
/// двигает lastSeenAt и растит hits.
model ConversationProperty {
  id             String                     @id @default(uuid())
  conversationId String
  conversation   BotConversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Источник первого интереса. EXPOSURE заменяется при первом интересе клиента;
  /// последующие источники интереса не перезаписывают его.
  source         ConversationPropertySource
  firstSeenAt    DateTime                   @default(now())
  lastSeenAt     DateTime                   @default(now())
  hits           Int                        @default(1)

  @@unique([conversationId, propertyId])
  @@index([propertyId])
}

/// Что ИИ услышал в разговоре и предлагает записать в карточку клиента.
///
/// Появилась 07.08.2026 вместе с расшифровкой звонков. Решение владельца: поля
/// карточки заполняются НЕ молча, а с подтверждением агента — тот, кто говорил с
/// клиентом, единственный может сказать, верно ли машина поняла. Молчаливое
/// заполнение осталось только для переписки с ботом (lib/clientAutopilot.ts), где
/// текст точный и спорить не о чем; живая речь распознаётся с ошибками.
///
/// Предложение живёт до решения агента и не мешает работе: не подтвердил — карточка
/// осталась как была.
model CardSuggestion {
  id            String       @id @default(uuid())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Разговор, из которого всё вынуто. Нужен, чтобы показать «после звонка 7 августа»
  /// и чтобы не строить второе предложение по тому же звонку.
  interactionId String?      @unique
  interaction   Interaction? @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  /// Кому показывать: тот, кто вёл разговор. Чужие предложения агенту не видны.
  agentId       String
  agent         Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  budgetMin  Decimal?
  budgetMax  Decimal?
  districtId String?
  district   District?     @relation(fields: [districtId], references: [id])
  rooms      Int?
  type       PropertyType?
  notes      String?
  /// Ориентир, названный клиентом словами: «напротив кинотеатра Зебунисо», «за
  /// рынком Саховат», «ЖК Пойтахт». Разбор его извлекал (ai/cardFill.ts) и путь
  /// ПЕРЕПИСКИ записывал в карточку, а путь ЗВОНКА терял: колонки здесь не было,
  /// и услышанное в разговоре не доезжало никуда.
  address    String?
  /// Короткие цитаты клиента, на которых держится предложение: подтверждать поля
  /// без опоры — вслепую. Расшифровку целиком свой автор разговора читает с
  /// 15.08.2026 в карточке, но ради одного поля ходить туда незачем.
  evidence   String[]

  /// pending — ждёт агента; applied — принято (возможно, с правками); dismissed — отклонено.
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([clientId, status])
  @@index([agentId, status])
}

/// Разбор телефонного разговора: что получилось, что нет, о чём договорились.
///
/// Появился 07.08.2026 вместе с расшифровкой. Смысл не в оценке ради оценки, а в
/// двух вещах, которых в CRM не было ничем: руководитель видит КАК агент говорит с
/// клиентом (а не только сколько звонков сделал), и накапливается материал для
/// разбора — какие возражения повторяются, где теряем клиентов, что отвечать боту.
///
/// Один разбор на разговор. Живёт отдельно от Interaction, а не колонками в ней:
/// разбор появляется позже самого звонка, может пересчитываться на новой модели и
/// нужен далеко не всем записям в хронологии (показы и встречи сюда не попадают).
model CallAnalysis {
  id            String      @id @default(uuid())
  interactionId String      @unique
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  /// Агент денормализован намеренно: сводки строятся по сотрудникам за период, и
  /// каждый такой запрос иначе тянул бы за собой всю хронологию.
  agentId       String
  agent         Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// 0-100. Не «оценка сотрудника», а насколько разговор продвинул сделку.
  score            Int
  /// Шаги, по которым считается счёт: поздоровался и представился, выяснил
  /// потребность, назвал ценность предложения, отработал возражение, договорился
  /// о следующем шаге.
  greeted          Boolean @default(false)
  foundNeed        Boolean @default(false)
  presentedValue   Boolean @default(false)
  handledObjection Boolean @default(false)
  agreedNextStep   Boolean @default(false)

  /// Возражения клиента дословно — из них строится сводка «что чаще всего мешает».
  objections String[]
  /// О чём договорились: «перезвонит в понедельник», «ждёт подборку до вечера».
  agreements String[]
  /// Суть разговора в двух-трёх предложениях — чтобы руководителю не читать всё.
  summary    String
  /// Что конкретно улучшить агенту. Пишется ему, а не про него: «спросите бюджет
  /// до показа объектов» вместо «не выяснил бюджет».
  coaching   String?

  /// ЧЕРНОВИК ИТОГА ДЛЯ ОКНА «КАК ПРОШЁЛ ЗВОНОК» (решение владельца 12.08.2026:
  /// «пусть карточки заполняются сами, агент проверяет галочкой»). Модель
  /// предлагает исход и следующий шаг, агент подтверждает или правит одним
  /// касанием — вместо того чтобы писать итог с нуля сразу после разговора.
  /// Это ПРЕДЛОЖЕНИЕ, а не факт: настоящий исход живёт в Interaction.outcome и
  /// ставится только рукой человека.
  suggestedOutcome    String?
  suggestedNextAction String?
  /// Та же суть разговора таджикской кириллицей — агенту, которому русский даётся
  /// тяжело (владелец 12.08.2026). Читать разговор целиком ради «о чём
  /// договорились» — не то же самое, что прочесть три строки на родном языке.
  summaryTj           String?

  /// СИГНАЛ «КЛИЕНТ УЖЕ ОБРАЩАЛСЯ» (владелец 19.08.2026) — клиент явно сказал в
  /// разговоре, что уже звонил/писал раньше, но карточка для этого номера в CRM
  /// новая (например, звонил с другого телефона). Триггер для проверки похожих
  /// карточек (см. GET /clients/:id/similar-notes) — не автослияние, просто флаг.
  mentionsPriorContact Boolean @default(false)

  /// ОБЪЕКТ РАЗГОВОРА — «голос рынка» (03.10.2026). Заполняется ТОЛЬКО когда объект
  /// доказан данными CRM (lib/propertyVoice/callProperty.ts), а не угадан по
  /// тексту: Interaction.propertyId, Client.matchedPropertyId или единственный
  /// объект продавца при звонке продавцу. null — объекта нет или он неоднозначен.
  /// Строкой, без внешнего ключа: объект могут удалить, а разбор звонка остаётся.
  propertyId String?

  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([createdAt])
  @@index([propertyId])
}

/// ЖИВОЙ ГОЛОС (эксперимент, пункт 5 очереди ИИ 23.08.2026) — черновой журнал сессий
/// разговора бота с клиентом через Gemini Live API по отдельному тестовому номеру.
///
/// ОТДЕЛЬНАЯ ТАБЛИЦА, А НЕ Interaction/CallAnalysis — НАМЕРЕННО. Тот конвейер
/// (запись → расшифровка → карточка клиента → разбор качества) требует известного
/// clientId и agentId (обе связи NOT NULL в Interaction), а звонок на тестовый
/// внутренний номер их не имеет — это не разговор агента с клиентом CRM, а сессия
/// проверки самой фичи. Втягивать её в боевую хронологию клиентов значило бы либо
/// подделывать эти связи, либо мешать реальным разговорам агентства. Минимальная
/// цель этой таблицы — не потерять текст разговора; дальше это задел на будущее
/// (см. докстрин liveVoiceBridge.ts).
model LiveVoiceSession {
  /// Private robot investigation; set by the originating scenario, never inferred from transcript.
  investigationOnly Boolean @default(false)
  id          String    @id @default(uuid())
  /// Server-established binding only; CallerID is not customer authorization.
  customerInquiryId String?
  customerInquiry CustomerInquiry? @relation(fields: [customerInquiryId], references: [id], onDelete: SetNull)
  /// ID канала ARI звонящего (не externalMedia-канала). НЕ уникален (02.10.2026):
  /// звонок, вернувшийся к консультанту от агента, — вторая сессия на том же
  /// канале, и уникальность роняла её запись в журнал. Итог и запись мост пишет по
  /// id строки (lib/telephony/liveVoiceBridge.ts, LiveVoiceSession.dbId).
  channelId   String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  /// Расшифровка обеих сторон разговора, как её вернул Gemini Live
  /// (inputAudioTranscription + outputAudioTranscription), склеенная по ходу
  /// сессии. Пусто — Live API транскрипцию не прислал вовсе (см. отчёт задачи).
  transcript  String?
  /// Чем кончилась сессия: "channel_ended" (звонок положили), "gemini_error",
  /// "ari_error" и т.п. — для честной диагностики первого живого прогона, которого
  /// ещё не было.
  endedReason String?
  /// Карточка клиента, если звонок настоящий (originateLiveVoiceCallToClient,
  /// 13.09.2026) — null для ручного тестового набора произвольного номера.
  /// Без @relation (как у CallbackRequest.clientId) — удаление клиента не
  /// должно ронять уже записанную историю звонка.
  clientId    String?
  /// Ключ записи разговора в R2 (см. lib/telephony/liveVoiceBridge.ts::
  /// saveLiveVoiceRecording) — стерео WAV, левый канал клиент, правый бот.
  /// Null — запись короче секунды (нечего сохранять) или R2 не настроен.
  recordingUrl String?
  /// Версия промта живого голоса на момент ЭТОГО звонка (13.09.2026, тот же
  /// разбор, что у AiLog.promptVersion) — живой голос не пишется в AiLog вовсе
  /// (нет учёта токенов/стоимости Live-сессии), поэтому версия промта хранится
  /// прямо на записи сессии. См. LIVE_VOICE_PROMPT_VERSION в ai/liveVoicePersona.ts.
  promptVersion String?
  /// Кто слышал и говорил за робота в ЭТОМ звонке (02.10.2026): "google" или
  /// "elevenlabs" — владелец сравнивает их по записям. Null — звонки до правки.
  provider      String?
  /// Кто кому звонит (24.09.2026, консультант на входящих): "outbound" — звонит
  /// бот (клиенту, опрос, проверка собственника), "inbound" — позвонили нам,
  /// "test" — проверочный звонок из Настроек. Null — сессии до этой правки.
  direction   String?
  /// Номер звонящего: со звонка для входящего, набранный — для исходящего.
  callerNumber String?
  /// Досье собеседника (ContactProfile), к которому привязан звонок. Без
  /// @relation по той же причине, что clientId: история звонка переживает
  /// слияние и удаление досье.
  contactProfileId String?
  createdAt   DateTime  @default(now())

  @@index([clientId])
  @@index([channelId])
}

/// ЗВОНОК-ОПРОС ПОСЛЕ ПОКАЗА (антифрод, владелец 13.09.2026) — см. докстринг
/// Settings.showingSurveyEnabled выше и lib/showingSurvey.ts. Отдельная модель,
/// А НЕ строка в Interaction: результат скрыт от агента по дизайну
/// (docs/post-viewing-survey-design-11-09.md), и держать его в общей таблице
/// взаимодействий клиента — той самой, что показывается агенту в карточке, —
/// значило бы прятать секретность за фильтром в каждом будущем запросе, а не
/// за границей таблицы. Строку заводит runShowingSurveyTick СРАЗУ при выборе
/// показа для звонка (до самого звонка) — это и есть дедупликация: уникальность
/// interactionId не даёт тику подхватить один и тот же показ дважды.
/// ⚠️ ВЫВЕДЕНО ИЗ ОБРАЩЕНИЯ 17.09.2026. Опросов после показа было построено два:
/// эта (13.09) и `PostShowingCall` — владелец 16.09 выбрал вторую (окно
/// 09:00–19:00, звонок только туда, где клиент сам ничего не сказал, две попытки,
/// разбор с обязательной цитатой, сторона продавца, досье, порог 4). Код, который
/// сюда писал и отсюда читал, снят: экраны Контроля руководителя и кабинета СБ
/// теперь читают `PostShowingCall` (lib/postShowingCallFeed.ts), путь и форма
/// ответа у них прежние.
///
/// ТАБЛИЦА ОСТАВЛЕНА НАМЕРЕННО, а не удалена тем же коммитом: миграция уже
/// применена на проде, и дроп в один шаг с переездом чтения не оставляет пути
/// назад. Удаляется отдельной миграцией после того, как новый механизм отработает
/// на живых звонках. То же про Settings.showingSurveyEnabled выше.
model ShowingSurveyCall {
  id            String    @id @default(cuid())
  /// Interaction (SHOWING/MEETING), из-за которого звонили. Без @relation —
  /// тот же приём, что у LiveVoiceSession.clientId: удаление взаимодействия не
  /// должно ронять уже собранный результат проверки.
  interactionId String    @unique
  clientId      String
  /// Агент, которого проверяем, — ОН НЕ ДОЛЖЕН получить доступ к этой записи ни
  /// через один интерфейс: проверка прав — там, где это читает директор, а не здесь.
  agentId       String
  propertyId    String?
  /// Канал ARI живого голоса (см. liveVoiceBridge.ts) — null, пока звонок не
  /// состоялся (строка заведена раньше самого звонка, см. докстринг модели).
  channelId     String?
  calledAt      DateTime?
  transcript    String?
  /// Ключ записи в R2 — тот же путь, что у LiveVoiceSession.recordingUrl.
  recordingUrl  String?
  /// Заполняется через record_concern (function calling внутри звонка,
  /// liveVoiceSurveyPersona.ts) — модель сообщает о находке в момент, когда
  /// услышала её, а не полагаемся на то, что вспомнит к концу разговора.
  redFlags      Json?
  /// Директору отправлено уведомление — по каждому найденному флагу сразу и
  /// отдельно (решение владельца 07.09.2026, см. lib/agentOffCrmAlarm.ts — та
  /// же логика «не ждать серию»), не при повторном флаге на ту же карточку.
  escalatedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([agentId])
  @@index([clientId])
}

/// ЧЕМ КОНЧИЛСЯ РОБОЗВОНОК ПОКУПАТЕЛЮ (см. PostShowingCall).
///
/// PENDING — поставлен, ждёт своего часа. CALLING — станция набирает или разговор
/// идёт прямо сейчас. DONE — поговорили, исход разобран. NO_ANSWER — не взяли
/// трубку, попытка осталась. GIVEN_UP — обе попытки потрачены впустую.
/// SKIPPED — не звонили вовсе, причина в skipReason.
enum PostShowingCallStatus {
  PENDING
  CALLING
  DONE
  NO_ANSWER
  GIVEN_UP
  SKIPPED
}

/// ЧТО ПОКУПАТЕЛЬ СКАЗАЛ ПРО ПОКАЗ.
///
/// Первые три — обычная жизнь воронки продаж, они закрывают вопрос и никого не
/// беспокоят. NO_MEETING, AGENT_COMPLAINT, BYPASS — красные: у всех трёх материал
/// один и тот же, прямое противоречие данным CRM, и потому каждый поднимает
/// руководителя ОДИНОЧНЫМ случаем, а не долей (docs/buyer-antifraud-funnel-13-09-2026.md).
/// REFUSED — отказался говорить, UNCLEAR — модель не поняла; ни то, ни другое уликой
/// не считается: человек не обязан отвечать роботу.
enum PostShowingCallOutcome {
  LIKED
  NOT_SUITABLE
  THINKING
  NO_MEETING
  AGENT_COMPLAINT
  BYPASS
  REFUSED
  UNCLEAR
}

/// РОБОЗВОНОК ПОКУПАТЕЛЮ ПОСЛЕ ПОКАЗА (решение владельца 13.09.2026).
///
/// ЗАЧЕМ. Личная встреча — единственное, чего CRM не видит: звонки записываются и
/// разбираются ИИ, переписка лежит в системе, а что произошло на показе, знает
/// только агент. Сказал «клиенту не понравилось» — опровергнуть нечем. Второй
/// источник тут ровно один, и он не заинтересованная сторона: сам покупатель.
///
/// ПОЧЕМУ ЗВОНОК, А НЕ СООБЩЕНИЕ (владелец 13.09.2026: «мы не можем отправить
/// сообщение спустя 24 часа… поэтому вместо опроса по сообщению лучше сделаем
/// робозвонок»). Вне 24-часового окна Меты свободный текст не проходит вовсе, а
/// одобренных шаблонов WhatsApp у агентства пока нет. То есть письменный опрос
/// отказывает ровно в тех случаях, ради которых заведён. У звонка лимитов нет, он
/// достаёт и тех, кто в мессенджер не писал ни разу, и слышит то, чего в тексте
/// не бывает — заминку на вопросе про агента.
///
/// ПОЧЕМУ ОТДЕЛЬНАЯ ТАБЛИЦА, А НЕ СТУПЕНЬ В Interaction.remindersSent. Ступень в
/// массиве отвечает на один вопрос — «спрашивали ли уже». Здесь нужны попытки,
/// исход, красные флаги и ПРИЧИНА, по которой не позвонили вовсе: без последней
/// нельзя измерить покрытие опроса, а на покрытии держится вся статистика порога 4
/// («доля показов, кончившихся тишиной»). Плюс отчёт по агенту — это группировка
/// по agentId, а не разбор строк в массиве.
///
/// АГЕНТ ЭТОГО НЕ ВИДИТ. Ни один экран агента сюда не смотрит, и исход НЕ создаёт
/// записи в хронологии карточки: строка «Опрос: жалоба на агента» в открытой ленте
/// сожгла бы механизм один раз и навсегда (тот же класс, что «спутник светится» в
/// CLAUDE.md). Разговор целиком лежит в LiveVoiceSession по channelId.
model PostShowingCall {
  previewOnly Boolean @default(false)
  id                String                  @id @default(uuid())
  /// Показ, из-за которого звоним. Один звонок на показ — повторная постановка
  /// тем же тиком не создаёт второй записи (@unique, ON CONFLICT DO NOTHING).
  showingId         String                  @unique
  showing           Interaction             @relation(fields: [showingId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Агент, который вёл ЭТОТ показ, — снимок на момент постановки. Карточку могут
  /// передать другому, а вопрос «кто показывал» задним числом не меняется, и
  /// статистика по агенту обязана считаться по тому, кто там был.
  agentId           String
  agent             Agent                   @relation("PostShowingCallAgent", fields: [agentId], references: [id])
  /// Объект, который показывали. null — у показа объект не проставлен вовсе
  /// (бывает), тогда сторона продавца по нему не проверяется без отдельного
  /// разбора переписки (см. порог 5 в файле воронки).
  propertyId        String?
  property          Property?               @relation(fields: [propertyId], references: [id])
  status            PostShowingCallStatus   @default(PENDING)
  /// Когда звонить. Не «время показа + 2,5 часа» буквально: час ночной или
  /// позднее 19:00 (решение владельца 16.09.2026) переносится на ближайшее утро.
  scheduledFor      DateTime
  attempts          Int                     @default(0)
  lastAttemptAt     DateTime?
  /// Канал ARI последней попытки — по нему разговор находится в LiveVoiceSession.
  channelId         String?
  /// Человек реально заговорил. Отдельно от answeredAt станции: трубку могли снять
  /// и молча положить, и это не разговор.
  talkedAt          DateTime?
  outcome           PostShowingCallOutcome?
  /// Уверенность модели в исходе. Ниже порога исход считается неустановленным:
  /// обвинение по догадке машины дороже пропущенного случая.
  outcomeConfidence Float?
  /// Дословная цитата из расшифровки — ОБЯЗАТЕЛЬНА для красных исходов. Без неё
  /// руководителю предъявляется пересказ пересказа.
  quote             String?
  redFlags          String[]                @default([])
  /// Короткая человеческая сводка разговора для карточки СБ.
  summary           String?
  /// Почему не позвонили: "disabled", "no_phone", "client_answered", "weekly_limit",
  /// "stale", "opted_out", "station_down". Обычная строка, а не тип БД: новая
  /// причина заводится без миграции (тот же приём, что у Interaction.callAttempt).
  skipReason        String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  /// Проверка со стороны продавца, выросшая из тишины по этому звонку.
  sellerProbeCall   SellerProbeCall?

  /// Выборка тика: что пора набирать.
  @@index([status, scheduledFor])
  /// Недельный лимит «не чаще одного звонка на клиента».
  @@index([clientId, createdAt])
  /// Отчёт порога 4: доля тишины по агенту за скользящие 30 дней.
  @@index([agentId, createdAt])
  @@index([channelId])
}

/// Чем кончилась попытка дозвониться до собственника (см. SellerProbeCall).
enum SellerProbeCallStatus {
  PENDING
  CALLING
  DONE
  NO_ANSWER
  GIVEN_UP
  SKIPPED
  UNKNOWN
}

/// Что собственник сказал про свою квартиру.
///
/// STILL_SELLING — в продаже, всё как было: подозрение слабеет, круг закрыт.
/// SOLD_ELSEWHERE — продал; это ещё не обвинение агенту (мог продать сам), но
/// именно тот ответ, ради которого звонили. OWNER_CHANGED_MIND — передумал
/// продавать: объяснение снятия объекта, не связанное с показом.
/// REFUSED — отказался говорить, UNCLEAR — понять нельзя.
enum SellerProbeCallOutcome {
  STILL_SELLING
  SOLD_ELSEWHERE
  OWNER_CHANGED_MIND
  REFUSED
  UNCLEAR
}

/// ЗВОНОК СОБСТВЕННИКУ ПОКАЗАННОГО ОБЪЕКТА — порог 5.2 воронки
/// (мысль владельца 12.09.2026, уточнена 16.09.2026).
///
/// ЗАЧЕМ. У кражи две стороны. Покупатель может быть в доле — ему выгодно купить
/// без комиссии; продавцу врать незачем, он просто хочет продать. Поэтому там,
/// где покупатель после показа молчит, вторую половину картины спрашивают у
/// собственника.
///
/// ЗВОНИМ НЕ ВСЕМ, И ЭТО ГЛАВНОЕ. Прямое указание владельца 16.09: сначала
/// система сама сужает круг — опознаёт по переписке и записям звонков, какой
/// объект реально смотрели, и проверяет, не ушло ли общение из CRM. Запись здесь
/// заводится, только когда сошлись минимум три признака (`signals` ниже — их
/// снимок на момент решения: без него через месяц нельзя будет объяснить, почему
/// звонили именно этому человеку).
///
/// ФОРМУЛИРОВКА РАЗГОВОРА — ПРО НАШИ РАСХОДЫ, А НЕ ПРО ЕГО ЧЕСТНОСТЬ: «мы
/// продолжаем рекламировать вашу квартиру — она ещё в продаже?». Отвечать на
/// такое естественно, а продавший мимо агентства оказывается перед выбором:
/// признаться или разрешить нам дальше тратить деньги на рекламу проданного.
model SellerProbeCall {
  previewOnly Boolean @default(false)
  id               String                   @id @default(uuid())
  /// Звонок покупателю, из тишины которого выросла эта проверка. Один к одному:
  /// по одному показу собственника спрашивают один раз.
  postShowingCallId String?                 @unique
  postShowingCall  PostShowingCall?         @relation(fields: [postShowingCallId], references: [id], onDelete: Cascade)
  sourceKind       String                   @default("POST_SHOWING")
  sourceId         String?
  sourceKey        String?                  @unique
  anchorAt         DateTime?
  assignmentAt     DateTime?
  buyerClientId    String?
  evidence         Json?
  sourcePhoneHash  String?
  propertyId       String
  property         Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sellerClientId   String
  seller           Client                   @relation("SellerProbeSeller", fields: [sellerClientId], references: [id], onDelete: Cascade)
  /// Агент, чью работу проверяем, — снимок: карточку могут передать, а вопрос
  /// «кто показывал» задним числом не меняется.
  agentId          String
  agent            Agent                    @relation("SellerProbeAgent", fields: [agentId], references: [id])
  status           SellerProbeCallStatus    @default(PENDING)
  scheduledFor     DateTime
  attempts         Int                      @default(0)
  lastAttemptAt    DateTime?
  channelId        String?
  talkedAt         DateTime?
  outcome          SellerProbeCallOutcome?
  /// Дословная фраза собственника — обязательна для SOLD_ELSEWHERE.
  quote            String?
  summary          String?
  /// Признаки, по которым решили звонить (ключи из lib/sellerBypassProbe.ts).
  signals          String[]                 @default([])
  /// Ни одна попытка не дошла до разговора: номер выключен, недоступен или
  /// неверен. Сам по себе это не улика — телефон мог сесть. Сигналом владельцу
  /// становится только вместе с карточкой, заведённой агентом ВРУЧНУЮ: номер из
  /// канала проверен самим фактом связи, а вписанный руками — никем.
  deadNumber       Boolean                  @default(false)
  skipReason       String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([status, scheduledFor])
  @@index([sellerClientId])
  @@index([sourceKind, anchorAt])
  @@index([agentId, createdAt])
  @@index([channelId])
}

/// Ночной разбор всех разговоров: где агентство сильно, где просаживается.
///
/// Отличие от сводки в разделе «Звонки»: та считает цифры (средний счёт, доля
/// договорённостей, частота возражений) — их и должна считать база. Здесь ответ на
/// другой вопрос: что с этими цифрами делать. Он виден только в формулировках самих
/// разговоров, поэтому его собирает модель — один раз в сутки, а не при каждом
/// открытии страницы.
model CallInsight {
  id         String   @id @default(uuid())
  /// За сколько дней собран разбор и по скольким разговорам — без этого выводы
  /// нечем взвесить: «мало договорённостей» по восьми звонкам и по двумстам это
  /// разные новости.
  days       Int
  calls      Int
  /// Что получается, коротким списком.
  strengths  String[]
  /// Где теряем клиентов — не общие слова, а что именно происходит в разговорах.
  weaknesses String[]
  /// Что спрашивает рынок: районы, бюджеты, типы жилья.
  demand     String[]
  /// Что сделать руководителю на этой неделе.
  actions    String[]
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Ключ входа по отпечатку или лицу (passkey, WebAuthn).
///
/// ЗАЧЕМ. Пароль на телефоне — самое слабое место входа: его набирают на ходу,
/// потому делают коротким, а часто и одинаковым с другими сервисами. Ключ входа
/// заменяет его отпечатком или лицом: закрытая часть никогда не покидает
/// устройство и не может быть подсмотрена, переслана или подобрана.
///
/// ЧТО ЗДЕСЬ ХРАНИТСЯ. Только ОТКРЫТАЯ часть ключа — ею нельзя войти, она годится
/// лишь для проверки подписи. Ни отпечатка, ни лица, ни пароля здесь нет и быть
/// не может: биометрия остаётся внутри телефона и наружу не выдаётся вообще.
///
/// Пароль при этом никуда не девается: ключ — дополнительный способ входа, а не
/// замена. Телефон потерян или сломан — сотрудник входит паролем, как раньше.
model Passkey {
  id           String    @id @default(uuid())
  agentId      String
  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Идентификатор ключа со стороны устройства (base64url). Уникален глобально.
  credentialId String    @unique
  /// Открытый ключ (base64url) — проверяет подпись, войти по нему нельзя.
  publicKey    String
  /// Счётчик подписей устройства. Растёт с каждым входом; если пришло значение
  /// меньше сохранённого, это признак клонированного ключа — вход отклоняется.
  counter      BigInt    @default(0)
  /// Как показать ключ человеку в списке: «iPhone Далера», «Рабочий ноутбук».
  deviceName   String?
  /// Ключ привязан к конкретному устройству — переносить его между людьми нельзя.
  transports   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([agentId])
}

/// Входящий звонок на номер агентства — журнал того, что раньше в CRM не отражалось
/// никак (решение владельца 08.08.2026).
///
/// ЗВОНКИ ПО-ПРЕЖНЕМУ ИДУТ ТОЛЬКО ОПЕРАТОРУ. На станции входящий маршрут ведёт в
/// очередь 1000, где сидят операторы 1001–1002; агентов там нет и не будет — это
/// прямое требование владельца. CRM в маршрутизацию не вмешивается вообще: она
/// только слушает события АТС и записывает, кто звонил, дозвонился ли и о чём с
/// этим делать дальше.
///
/// ПОЧЕМУ ОТДЕЛЬНАЯ ТАБЛИЦА, А НЕ ЗАПИСЬ В ХРОНОЛОГИИ. Хронология (Interaction)
/// требует и клиента, и автора-агента, а половина входящих — это номера, которых
/// в базе нет вовсе: курьеры, реклама, ошиблись номером. Заводить на каждый такой
/// звонок карточку клиента значит за месяц засыпать базу мусором, а терять их
/// молча — снова не знать, сколько обращений агентство не приняло. Известный
/// клиент получает и то, и другое: запись здесь и запись в своей хронологии.
/// Обработанные сообщения автоответчика (lib/telephony/voicemailIngest.ts).
///
/// CRM не может удалить файл со станции — доступ к каталогу только на чтение, и
/// это правильно. Поэтому «не обработать дважды» решается здесь: имя файла
/// уникально (в нём секунда записи и номер звонившего), обработанные помнит эта
/// таблица. Строки переживают файл (станция ротирует записи через 60 дней) — они
/// же связывают сообщение с карточкой и записью хронологии.
model VoicemailMessage {
  id            String   @id @default(uuid())
  file          String   @unique
  phone         String
  recordedAt    DateTime
  clientId      String?
  interactionId String?
  createdAt     DateTime @default(now())
  /// РАЗОБРАНО ДО КОНЦА. Сама строка — это ЗАМОК: она встаёт до расшифровки,
  /// чтобы второй проход не оплатил ту же минуту дважды. Пока замка хватало
  /// только на «уже занято», и падение процесса посреди работы (автовыкат
  /// перезапускает контейнеры на каждый мерж в main) теряло сообщение навсегда:
  /// имя файла в базе есть, карточки, задачи «перезвонить» и раздачи нет, в
  /// журнале — ни строки. Здесь отмечается конец работы, а не её начало.
  processedAt   DateTime?
  /// Когда проход взялся за это сообщение в последний раз — по нему видно
  /// брошенный замок: `processedAt` пуст, а взялись давно.
  claimedAt     DateTime @default(now())
  /// Сколько проходов за него брались. Потолок повторов: платная расшифровка не
  /// должна крутиться вечно на одном сломанном файле (та же причина, по которой
  /// слишком большой файл не качают заново).
  attempts      Int      @default(1)

  /// Карточка клиента открывает свою голосовую почту по clientId — без индекса
  /// это полный проход по таблице (аудит 18.08.2026).
  @@index([clientId])
  /// Поиск сообщений по номеру (когда карточки ещё нет) — та же причина.
  @@index([phone])
  /// Брошенные замки ищутся по «не разобрано» — проход делает это каждую минуту.
  @@index([processedAt])
}

model IncomingCall {
  id                String    @id @default(uuid())
  /// Канал АТС — по нему события связываются со звонком. Уникален: повторная
  /// доставка того же события не должна заводить второй звонок.
  channelId         String    @unique
  /// Досье собеседника (21.09.2026). Заводится на первом же входящем, до всякой
  /// карточки клиента, — именно оно и есть «карточка на каждого написавшего».
  contactProfileId String?
  contactProfile   ContactProfile? @relation(fields: [contactProfileId], references: [id], onDelete: SetNull)
  /// Номер звонящего в том виде, в каком его хранит CRM (+992…). Станция сообщает
  /// девять цифр без кода страны — приводится при записи (см. lib/telephony/incomingCalls.ts).
  phone             String
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  /// Разговор состоялся: кто-то из операторов снял трубку. Ответ самой очереди
  /// (человек слушает музыку ожидания) ответом НЕ считается — иначе брошенный в
  /// очереди звонок выглядел бы обслуженным.
  answered          Boolean   @default(false)
  /// Длительность разговора в секундах. У пропущенного — сколько человек ждал.
  talkSeconds       Int?
  /// Внутренний номер оператора, снявшего трубку, — если станция его сообщила.
  answeredBy        String?
  /// Ответил консультант на телефоне (ИИ), а человек так и не снял трубку
  /// (24.09.2026, робозвонок, правка 5). answered при этом true: звонок не пропущен.
  answeredByConsultant Boolean  @default(false)
  /// Клиент, найденный по номеру. null — звонившего в базе нет.
  clientId          String?
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Запись в хронологии клиента, если она заводилась.
  interactionId     String?
  /// Кому поставлена задача перезвонить. null — задачи нет (дозвонился либо
  /// звонившего некому вести).
  callbackAgentId   String?
  callbackAgent     Agent?    @relation("IncomingCallCallback", fields: [callbackAgentId], references: [id], onDelete: SetNull)
  /// Карточку завёл САМ ЭТОТ ЗВОНОК (номера не было в базе). Отличать нужно ради
  /// оператора: у заведённой звонком карточки имя вида «Входящий +992…» и пустой
  /// запрос — окно просит заполнить их, а у давнего клиента не просит ничего.
  autoCreatedClient Boolean   @default(false)
  /// Когда оператор указал тип обращения. Пусто — звонок так и остался
  /// неразобранным: это и есть мера работы оператора, а не число снятых трубок.
  qualifiedAt       DateTime?
  /// «Не по делу»: курьер, реклама, ошиблись номером — звонок к недвижимости
  /// отношения не имеет. Оператор помечает это отдельным исходом, а не типом
  /// «Другое»: аренда и работа — настоящие обращения, и руководство их смотрит,
  /// а курьер не клиент вовсе. Пометка делает две вещи: удаляет карточку, если её
  /// завёл сам этот звонок, и ЗАПОМИНАЕТ НОМЕР — при следующем звонке с него
  /// карточка не заводится (курьер звонит каждый день, помечать его ежедневно
  /// значит превратить разбор в отписку). Сам звонок из журнала не исчезает:
  /// учёт нагрузки на оператора должен оставаться честным.
  irrelevant        Boolean   @default(false)
  /// Кто разобрал. Не обязательно тот, кто говорил: разобрать могут и позже.
  qualifiedById     String?
  qualifiedBy       Agent?    @relation("IncomingCallQualifiedBy", fields: [qualifiedById], references: [id], onDelete: SetNull)
  /// Что CRM решила про перевод звонка на ответственного агента: "routed" — увели
  /// агенту, любой другой код — причина, по которой звонок остался в очереди
  /// (см. RouteSkipReason в lib/telephony/inboundRouting.ts). null — решение не
  /// принималось вовсе (звонок старше возможности). Хранится строкой, а не enum:
  /// список причин ещё будет расти, а миграция ради нового кода отказа — цена,
  /// которую не хочется платить при разборе живой телефонии.
  routeDecision     String?
  /// Кому звонок увели. Заполнен только при routeDecision = "routed".
  routedToId        String?
  routedTo          Agent?    @relation("IncomingCallRouted", fields: [routedToId], references: [id], onDelete: SetNull)
  /// Когда автоматика ОТРАБОТАЛА по этому звонку — неважно, с каким исходом.
  /// Это и есть замок идемпотентности: разбор разговора приходит не мгновенно и
  /// может прийти дважды (догоняющая расшифровка + ночной подбор кроном), а
  /// вторая попытка обязана не завести вторую карточку и не заплатить второй раз
  /// за ИИ. Пусто — автоматика этого звонка ещё не касалась.
  autoLeadAt        DateTime?
  /// Чем автоматика кончила: см. AutoLeadStatus в lib/telephony/autoLeadFromCall.ts.
  /// Хранится строкой по той же причине, что и routeDecision: список исходов ещё
  /// будет расти, а миграция ради нового кода — цена, которую не хочется платить.
  autoLeadStatus    String?
  /// Имя файла сообщения, наговоренного на автоответчик по ЭТОМУ звонку
  /// (18.08.2026, новая схема приёма). Пусто — сообщения не было.
  ///
  /// Зачем колонка, если есть таблица VoicemailMessage: «трубку не взяли, но
  /// человек наговорил, чего хочет» — это ПРИЗНАК САМОГО ЗВОНКА, и по нему
  /// принимаются два решения в трёх разных местах. Автоматика лида пропускает
  /// неотвеченные звонки («разбирать нечего»), а такой звонок разбирать есть чем;
  /// список «Без разбора» показывает только состоявшиеся разговоры, а этот звонок
  /// человек обязан увидеть, если ИИ не понял сообщение. Джойн к VoicemailMessage
  /// ради условия в каждом из этих запросов стоил бы дороже одной строки.
  voicemailFile     String?
  createdAt         DateTime  @default(now())

  @@index([startedAt])
  @@index([clientId])
  @@index([answered, startedAt])
  @@index([qualifiedAt, startedAt])
  /// «Звонил ли уже этот номер и не помечен ли он как не по делу» — вопрос
  /// задаётся при КАЖДОМ звонке с незнакомого номера, до создания карточки.
  @@index([phone, irrelevant])
  /// Подбор кроном: «отвеченные звонки, до которых автоматика ещё не дошла».
  @@index([autoLeadAt, answered, startedAt])

  @@index([contactProfileId])
}

/// ГОТОВАЯ ПОДСКАЗКА О КЛИЕНТЕ — озвученная заранее и лежащая на станции.
///
/// ПОЧЕМУ ЗАРАНЕЕ, А НЕ В МОМЕНТ ЗВОНКА (решение владельца 20.08.2026). Считать фразу и
/// звать синтез речи на горячем пути значит поставить на пути каждого звонка ещё одну
/// точку отказа: Gemini падает, интернет моргает, а клиент в это время слушает гудки.
/// Файл делается заранее и лежит на самой АТС — в момент звонка не считается ничего, и
/// подсказка играет, даже когда CRM недоступна.
///
/// ОДНА СТРОКА = ОДИН ФАЙЛ. Ключ (клиент + направление + язык) уникален: на клиента нужен
/// ровно один файл на языке его ответственного агента, второй появляется только если
/// клиенту звонит кто-то с другим языком в карточке.
///
/// digest — отпечаток ПОЛЕЙ, ИЗ КОТОРЫХ СОБРАНА ФРАЗА (имя, вид, объект, бюджет, состав
/// блоков, язык, голос). Совпал — файл не трогаем; изменился — переозвучиваем. Без
/// отпечатка агент однажды услышит вчерашнюю правду («покупатель» у человека, который
/// сегодня продаёт), а это хуже, чем не услышать ничего.
/// КУСОЧЕК ОЗВУЧКИ — одно слово или имя, синтезированное один раз и переиспользуемое.
///
/// Зачем (владелец 20.08.2026, после первого же упора в квоту). Подсказка целиком —
/// это один запрос к синтезу НА КАЖДОГО клиента, и при изменении карточки запрос
/// повторяется. Но фраза состоит из конечного словаря («харидор», «фурӯшанда»,
/// «манзил», названия районов) и одного изменчивого куска — имени. Словарь озвучивается
/// ОДИН РАЗ навсегда, имена повторяются между клиентами (Фаррух, Мадина), а готовый
/// файл собирается склейкой на нашей стороне — бесплатно и мгновенно.
///
/// Что это даёт: первая заливка базы дешевле в разы, а переозвучка после правки
/// карточки почти всегда не стоит НИ ОДНОГО запроса — все куски уже есть.
model WhisperClip {
  id         String   @id @default(uuid())
  /// Что произносится, дословно. Ключ переиспользования вместе с языком и голосом.
  text       String
  /// "tg" | "ru" — язык, на котором это озвучено.
  language   String
  /// Голос синтеза: сменили голос — прежние куски не подходят, нужны свои.
  voice      String
  /// Файл на диске CRM (без расширения), лежит там же, где готовые подсказки.
  fileName   String   @unique
  durationMs Int
  /// Когда кусок последний раз пригодился — по нему чистятся залежавшиеся.
  usedAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([text, language, voice])
  @@index([usedAt])
}

model CallWhisper {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// "in" — входящий звонок клиента, "out" — исходящий звонок агента клиенту.
  /// Состав фразы у них разный, поэтому это разные файлы, а не один.
  direction  String
  /// "tg" | "ru" — язык того, КОМУ играем (сотрудника), а не клиента.
  language   String
  /// Отпечаток исходных данных фразы; несовпадение = переозвучить.
  digest     String
  /// Имя файла на станции без расширения: royalhome/whisper/<fileName>.
  /// Имя случайное, НЕ телефон и не имя клиента: файлы лежат на диске АТС, и по имени
  /// файла не должно читаться, чей это клиент.
  fileName   String   @unique
  /// Озвученный текст — виден в Настройках («что услышит агент») и нужен, чтобы понять
  /// причину странной подсказки, не проигрывая файл.
  text       String
  /// Длительность в миллисекундах: в интерфейсе видно, не разрослась ли фраза сверх
  /// разумного — клиент в это время слушает гудки.
  durationMs Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([clientId, direction, language])
  /// Подбор кроном: «что переозвучить» — сначала самые старые.
  @@index([updatedAt])
}

/// ПОДСКАЗКА АГЕНТУ ПО ПРИМЕТАМ ОБЪЕКТА (24.09.2026, решение Dan).
/// Оператор переводит звонок с офисного телефона агенту объекта (код 7+номер),
/// консультант — голосом; агент перед соединением слышит, О КАКОМ объекте речь:
/// «3-комнатная квартира, 80 квадратов, этаж 5 из 9, ориентир Садбарг, 85 тысяч
/// долларов» — не номер: «агент номер не помнит». Озвучивается кроном заранее,
/// как CallWhisper: на пути звонка синтеза нет, а станция забирает файлы раз в минуту.
model PropertyWhisper {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// "tg" | "ru" — язык агента, которому играем.
  language   String
  /// Отпечаток исходных данных фразы; несовпадение = пересобрать.
  digest     String
  /// Имя файла на станции без расширения, случайное — как у CallWhisper.
  fileName   String   @unique
  text       String
  durationMs Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([propertyId, language])
}

/// Воронка «комментарий → чек-лист в директ»: под рекламным роликом человек
/// пишет ключевое слово, бот отвечает публично и присылает файл в личные
/// сообщения. Всё, что владелец задаёт в разделе «Воронка», лежит здесь.
///
/// Почему кампания, а не пара полей в Settings: у каждого ролика свой лид-магнит,
/// своё ключевое слово и свои тексты, а старые кампании должны оставаться со
/// своими счётчиками, когда идёт следующая реклама.
model LeadMagnetCampaign {
  id                   String            @id @default(uuid())
  /// Как кампания называется внутри CRM — снаружи это название не видит никто.
  name                 String
  enabled              Boolean           @default(false)
  /// Аккаунт Instagram, чьи комментарии ловит эта кампания.
  ///
  /// Появилось 17.08.2026 по живому случаю: одно и то же видео выложили на
  /// royal.home.tj и royalhome.info, СОАВТОРАМИ друг друга. Meta доставляет
  /// комментарий под таким постом в вебхуки ОБОИХ аккаунтов, и человек получал
  /// два приглашения в директ — от каждого аккаунта по одному (замок выдачи
  /// стоит по паре «кампания + человек», а кампаний было две, по одной на
  /// зеркало поста). Хуже того, отвечать могло не то зеркало: у комментария
  /// получатель берётся из entry.id, и при несовпадении CRM молча брала аккаунт
  /// по умолчанию.
  ///
  /// Заполнено — кампания видит комментарии ТОЛЬКО этого аккаунта. Пусто —
  /// прежнее поведение («любой аккаунт»), чтобы уже заведённые кампании
  /// продолжали работать без правки руками.
  accountId            String?
  account              MessengerAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Публикация, под которой ловим комментарии. Адрес — то, что владелец
  /// копирует из Instagram; mediaId вычисляется из него при первом совпадении
  /// (у комментария в вебхуке есть только mediaId, а не адрес).
  /// Пусто в обоих полях — ловим под ЛЮБОЙ нашей публикацией.
  postUrl              String?
  mediaId              String?
  /// Ключевые слова. Сравнение без учёта регистра и по вхождению, поэтому
  /// «ЧЕКЛИСТ» ловит и «чеклист», и «хочу чек-лист пожалуйста».
  keywords             String[]          @default([])
  /// Отвечать на ЛЮБОЙ комментарий под этой публикацией, без ключевого слова.
  /// Смысл в рекламе, где призыв звучит как «напиши что угодно под этим видео».
  anyComment           Boolean           @default(false)
  /// ЕЩЁ публикации этой же кампании — чтобы не заводить копию кампании на каждый
  /// ролик (просьба владельца 30.08.2026: «хочу в одну кампанию добавлять несколько
  /// ссылок»). Работают наравне с одиночными postUrl/mediaId выше: комментарий
  /// подходит, если совпал ХОТЯ БЫ с одной публикацией из списка.
  ///
  /// Списка два по той же причине, по которой существуют оба одиночных поля: адрес
  /// публикации (permalink) приходит от Graph API НЕ всегда, и кампания, привязанная
  /// только ссылкой, однажды неделю не выдала ни одного файла (прод, 22.08.2026).
  /// Идентификатор надёжнее ссылки — заполняем оба, когда можем.
  postUrls             String[]          @default([])
  mediaIds             String[]          @default([])
  /// Варианты публичного ответа под комментарием. Выбирается по идентификатору
  /// комментария (не случайно — иначе повторная обработка после сбоя дала бы
  /// другой текст): под постом двадцать одинаковых ответов выдают робота.
  /// Пусто — публично не отвечаем вовсе, только пишем в директ.
  publicReplies        String[]          @default([])
  /// Первое личное сообщение. По правилам Meta по комментарию можно отправить
  /// РОВНО ОДНО сообщение, поэтому здесь не файл, а приглашение нажать кнопку:
  /// нажатие открывает окно переписки, и дальше мы уже можем и проверить
  /// подписку, и прислать файл.
  inviteText           String
  inviteButton         String            @default("Хочу чек-лист")
  /// Требовать подписку перед выдачей. Выключено — файл уходит сразу.
  requireFollow        Boolean           @default(true)
  /// Требовать подписку на ВСЕ наши аккаунты Instagram, а не только на тот, под чьим
  /// постом человек написал (royal.home.tj И royalhome.info).
  ///
  /// Зачем (просьба владельца, повторена 30.08.2026): страниц две, реклама ведёт на
  /// одну, а вторая так и остаётся без подписчиков. Проверка `is_user_follow_business`
  /// отвечает про ТОТ аккаунт, чьим маркером спросили, — поэтому «обе» нельзя выразить
  /// одним запросом, нужен обход по аккаунтам.
  ///
  /// Выключено по умолчанию: требование строже прежнего, и включаться должно
  /// осознанно — лишний барьер на оплаченном трафике стоит денег.
  requireFollowAll     Boolean           @default(false)
  followText           String
  followButton         String            @default("Я подписался")
  /// Что отвечаем, когда человек нажал «я подписался», а подписки не видно.
  notFollowingText     String
  /// Сколько раз перепроверяем подписку, прежде чем перестать просить. Человек,
  /// которого спрашивают четвёртый раз, уходит и жалуется на спам.
  maxFollowChecks      Int               @default(3)
  /// Отдавать ли файл, когда проверка подписки не удалась (отказ Graph API).
  /// По умолчанию да: наш сбой не повод наказывать человека, пришедшего с рекламы.
  deliverIfUnsure      Boolean           @default(true)
  /// Отдавать ли файл, когда человек ВТОРОЙ раз нажал «я подписался», а Instagram
  /// подписки всё равно не видит (твёрдое «нет», а не отказ API — тот закрыт
  /// настройкой выше).
  ///
  /// Заведено 30.08.2026 по разбору прода: последняя выдача была 27.08, восемь
  /// человек ходили по кругу «нажал → Обунаро ҳанӯз намебинам → нажал → то же
  /// самое», а из 46 успешных выдач у ВСЕХ подписка подтвердилась — то есть на
  /// неподтверждённых воронка не отдавала ни разу.
  ///
  /// По умолчанию ВЫКЛЮЧЕНО: у владельца есть прямое требование «без подписки не
  /// выдавать» (тест lead-magnet-flow «не подписан — файл не уходит ни при каких
  /// повторах»), и молча его переопределять нельзя. Включается осознанно, на
  /// кампанию — тогда второе нажатие считается словом человека и файл уходит.
  deliverOnSecondClaim Boolean           @default(false)
  /// Сообщение вместе с файлом.
  deliveredText        String
  /// Сам файл: лежит в /uploads/lead-magnets, наружу отдаётся статикой — иначе
  /// Meta его не заберёт (она качает файл своими серверами по ссылке).
  filePath             String?
  fileName             String?
  fileSize             Int?
  /// Запасная ссылка: уходит, если файл не задан или Meta его не приняла.
  link                 String?
  /// Продолжает ли обычный бот разговор после выдачи файла.
  ///
  /// Карточку клиента воронка НЕ заводит и завести не может: у человека из
  /// Instagram нет телефона, а `Client.phone` — обязательное и уникальное поле.
  /// Лид получается обычным путём, когда бот доводит разговор до контакта
  /// (ai/leadQualifier.ts). Выключают это на большой рекламе, где половина
  /// пришедших берёт файл и уходит: платить за ход модели каждому «спасибо»
  /// незачем, а живой вопрос всё равно увидит агент в переписке.
  handoffToBot         Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  createdById          String?

  deliveries LeadMagnetDelivery[]

  @@index([enabled])
}

/// Один человек в одной кампании: где он сейчас в воронке и чем всё кончилось.
/// Он же ключ идемпотентности — повторная доставка того же комментария или второе
/// нажатие кнопки не должны присылать файл дважды.
model LeadMagnetDelivery {
  id              String             @id @default(uuid())
  campaignId      String
  campaign        LeadMagnetCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// Идентификатор человека в Instagram. У комментария и у личного сообщения он
  /// один и тот же, поэтому по нему и связываются два конца воронки.
  igUserId        String
  username        String?
  /// Комментарий, с которого всё началось, и его текст — для журнала.
  commentId       String?
  commentText     String?
  /// INVITED — ушло приглашение; AWAITING_FOLLOW — просим подписаться;
  /// DELIVERED — файл или ссылка отданы; FAILED — не смогли.
  state           String             @default("INVITED")
  followChecks    Int                @default(0)
  /// Была ли подписка на момент выдачи. null — проверить не удалось.
  wasFollowing    Boolean?
  /// Файлом или всё-таки ссылкой. Видно, как часто срабатывает запасной путь.
  deliveredAsFile Boolean?
  /// `message_id` приглашения у Meta — то, чем можно ПРЕДЪЯВИТЬ отправку.
  ///
  /// Появилось 17.08.2026 после разбора жалобы «пришло пустое сообщение»: при
  /// успехе код не логировал ничего, и ответ Meta нигде не оставался. Пришлось
  /// доказывать отправку косвенно — по пометке `lead_magnet` в очереди
  /// комментариев и по тому, что у других людей файл дошёл. Идентификатор
  /// снимает этот спор: он либо есть (Meta приняла и назвала сообщение), либо
  /// null (приняла молча — тело успешного ответа не гарантировано, см. callGraph).
  ///
  /// Каким путём ушло — видно рядом, в `InstagramComment.note`: `lead_magnet` это
  /// карточка с кнопкой, `lm_quick_reply` и `lm_no_button` — запасные пути.
  inviteMid       String?
  /// Карточки клиента здесь нет нарочно. У человека из Instagram нет телефона, а
  /// без него `Client` не заводится (поле обязательное и уникальное). Стал ли он
  /// клиентом — видно по диалогу: у BotConversation с тем же subscriberId
  /// появляется clientId, когда бот доводит разговор до контакта. Так «сколько из
  /// получивших чек-лист оставили телефон» считается без единого лишнего поля.
  invitedAt       DateTime           @default(now())
  askedFollowAt   DateTime?
  deliveredAt     DateTime?
  lastError       String?
  updatedAt       DateTime           @updatedAt

  @@unique([campaignId, igUserId])
  @@index([igUserId, state])
  @@index([campaignId, state])
}

/// Незавершённая многочастевая загрузка видео — то, что позволяет докачать
/// ролик с середины, а не слать гигабайт заново после каждого обрыва.
///
/// Живёт ровно между «клиент начал слать файл» и «файл собран в R2». Успешное
/// завершение превращает сессию в PropertyVideo и удаляет её.
///
/// Незакрытые части лежат в R2 платно, поэтому брошенные сессии подчищает
/// уборщик (lib/videoUploadCleanup.ts): отменяет загрузку в хранилище и удаляет
/// строку. Без него забытый агентом ролик оплачивался бы вечно.
model VideoUploadSession {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Ключ повторной отправки от клиента. По нему очередь находит свою прерванную
  /// сессию после перезагрузки страницы — второй раз файл начинать не нужно.
  uploadKey   String   @unique
  /// Относительный путь БУДУЩЕГО файла в закрытом локальном хранилище (см.
  /// PropertyVideo.storageKey) — известен уже на старте сессии, части складываются
  /// во временную папку сессии (по id этой же записи) и собираются в этот путь.
  /// Для purpose=HANDOFF это путь ВНУТРИ сессии (uploads-private-video-sessions),
  /// не итоговый файл — итоговый уходит в videoHandoffDir тем же кодом, что и
  /// одиночная загрузка (см. completeVideoUploadSession в lib/videoHandoff.ts).
  storageKey  String
  filename    String
  sizeBytes   Int
  contentType String
  partSize    Int
  totalParts  Int
  /// Принятые номера частей: [{ partNumber }]. До 31.08.2026 сюда же писался R2 ETag —
  /// на локальном диске подтверждать часть нечем, кроме факта её записи на диск.
  parts       Json                     @default("[]")
  /// RAW — сырой ролик объекта (PropertyVideo, как раньше). HANDOFF — докачка
  /// готового ролика от монтажёра через эту же докачку с середины вместо одного
  /// запроса POST /:id/video-handoff/upload (23.09.2026, большие файлы рвали
  /// одиночный запрос — 700 МБ и таймаут Node 300с). @default(RAW) — старые
  /// строки и вся раздача сырых видео читаются как раньше без миграции данных.
  purpose     VideoUploadSessionPurpose @default(RAW)
  createdById String
  createdBy   Agent    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
  @@index([updatedAt])
}

/// Что произойдёт с собранным файлом на COMPLETE — см. VideoUploadSession.purpose.
enum VideoUploadSessionPurpose {
  RAW
  HANDOFF
}

/// Что именно лежит в черновике: снимок или ролик.
enum PropertyDraftMediaKind {
  PHOTO
  VIDEO
}

/// Состояние файла черновика. UPLOADING — файл ещё принимается (у ролика есть
/// план частей, у снимка это состояние не встречается: снимок пишется целиком за
/// один запрос). READY — файл на диске и готов переехать в карточку объекта.
enum PropertyDraftMediaStatus {
  UPLOADING
  READY
}

/// ЧЕРНОВИК НОВОГО ОБЪЕКТА (11.09.2026, просьба владельца «черновик сделай»).
///
/// Зачем на сервере, а не в localStorage, как было до этого. Черновик в браузере
/// не переживает смену устройства и не может держать файлы: агент снимает квартиру
/// на телефон, а дозаполняет карточку вечером с ноутбука — и двадцать снимков,
/// которые он уже отдал, обязаны быть там же. Отсюда же берётся и ответ на вопрос
/// «почему прогресс загрузки виден сразу»: файлы уходят в черновик, пока агент
/// заполняет остальные шаги, а в карточку объекта переезжают одним движением при
/// сохранении.
///
/// Черновик НЕ является объектом: он не попадает ни в каталог, ни в конвейер
/// подготовки, ни в лимит активных объектов агента, и потому брошенный на середине
/// черновик никого не беспокоит — в отличие от «минимального объекта», за классом
/// которого (осиротевшие спутники) в этом репозитории уже охотились отдельной
/// сессией.
///
/// Один агент — один черновик: мастер заводит по одному объекту за раз, и выбор
/// «какой из черновиков продолжить» был бы лишним вопросом на пустом месте.
model PropertyDraft {
  id        String   @id @default(uuid())
  agentId   String   @unique
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Снимок полей мастера ровно в том виде, в каком их держит форма (строки, а не
  /// числа): черновик обязан уметь хранить наполовину набранное поле.
  values    Json     @default("{}")
  /// На каком шаге агент остановился — чтобы вернуть его туда же, а не в начало.
  step      Int      @default(0)
  /// Monotonic field/lifecycle revision; retained after deletion to reject stale writes.
  revision  Int      @default(0)
  /// A closed row is a tombstone, invisible to the wizard and never resurrected by PUT.
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Срок жизни. Черновик недельной давности — это уже не та квартира и не тот
  /// разговор; подставлять его вреднее, чем пустая форма.
  expiresAt DateTime
  media     PropertyDraftMedia[]

  @@index([expiresAt])
}

/// Файл, отданный в черновик до создания объекта.
///
/// Снимок обрабатывается тем же конвейером sharp, что и фото карточки, и ложится
/// В ТУ ЖЕ папку uploads под тем же именем вида `<uuid>.webp` — поэтому «переезд»
/// в карточку объекта не двигает ни одного байта: создаётся строка PropertyPhoto с
/// теми же url/thumbUrl. Ролик пишется в закрытое локальное хранилище
/// (lib/localVideoStorage.ts) ключом `<id черновика>/<uuid>.<ext>` — формат ключа
/// тот же двухуровневый, что и у видео объекта, так что при переезде меняется
/// только строка в базе.
model PropertyDraftMedia {
  id          String                   @id @default(uuid())
  draftId     String
  draft       PropertyDraft            @relation(fields: [draftId], references: [id], onDelete: Cascade)
  kind        PropertyDraftMediaKind
  status      PropertyDraftMediaStatus @default(UPLOADING)
  /// Ключ повторной отправки от клиента — та же защита от задвоения при обрыве
  /// связи, что у PropertyPhoto.uploadKey и VideoUploadSession.uploadKey.
  uploadKey   String                   @unique
  filename    String
  contentType String
  sizeBytes   Int
  order       Int                      @default(0)
  /// PHOTO: готовые пути в общей папке uploads.
  url         String?
  thumbUrl    String?
  /// VIDEO: ключ в закрытом локальном хранилище.
  storageKey  String?
  /// VIDEO: план докачки частями (тот же протокол, что у VideoUploadSession).
  partSize    Int?
  totalParts  Int?
  /// VIDEO: принятые номера частей, [{ partNumber }].
  parts       Json                     @default("[]")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([draftId])
}

/// Кэш оценки фото продавца из переписки (21.09.2026, «объект продавца заполняется
/// сам, но деньги на токены зря не тратятся»). Ключ — sha256 СОДЕРЖИМОГО файла, а
/// не clientId или сообщение: тот же снимок, пересланный ещё раз или другому
/// агенту, смотрится моделью ровно один раз на весь репозиторий, а не один раз на
/// клиента или на попытку. Пишет только фоновое задание jobs/sellerPhotoInsight.ts
/// (lib/sellerMedia.ts::scheduleSellerPhotoInsights ставит его в очередь), читает
/// POST /properties/drafts/from-client/:clientId (routes/properties/drafts.ts, при
/// раскладке снимков — обложка первой, планировки последними) и полоса «Объект
/// продавца» (SellerObjectSummary.photoCount/planCount) — оба чтения из готовой
/// таблицы, БЕЗ обращения к ИИ.
model ChatPhotoInsight {
  /// sha256 файла (hex, 64 символа) — тот же принцип дедупликации, что у
  /// listSellerAttachments (lib/sellerMedia.ts): содержимое, а не имя файла или id
  /// сообщения, которые у одной и той же картинки могут отличаться.
  sha256    String             @id
  /// Снимок распознан как планировка/чертёж, а не фото помещения — такие в
  /// обложку не годятся и уходят в конец списка при раскладке черновика.
  isPlan    Boolean            @default(false)
  /// Видимое состояние ремонта по кадру. null — снимок не о состоянии помещения
  /// (сама планировка, документ, вид из окна без интерьера).
  condition PropertyCondition?
  /// Число комнат, различимое НА ПЛАНИРОВКЕ (заполняется только при isPlan=true) —
  /// у обычных фото и нечитаемых планов остаётся null.
  rooms     Int?
  /// Насколько снимок годится в обложку объявления, 0-100 (выше — лучше) —
  /// единственный критерий сортировки кандидатов на обложку черновика.
  score     Int                @default(0)
  createdAt DateTime           @default(now())
}

/// Образец манеры живого сотрудника: пара «вопрос клиента → ответ человека».
///
/// Просьба владельца 22.08.2026 («чтобы бот умнел с каждой перепиской», как в боте
/// Ширин Свитс). Промт бота этой таблицей НЕ переписывается: лучшие пары
/// подмешиваются в системный промт отдельным блоком образцов (см. ai/styleLearning.ts),
/// а правила остаются ровно там, где их написал человек.
///
/// Отдельная таблица, а не поле у диалога: пример живёт дольше разговора, из
/// которого взят, и читается ВСЕМИ разговорами сразу.
model StyleExample {
  id         String   @id @default(uuid())
  /// Что спросил клиент. Может быть пусто: сотрудник иногда пишет первым.
  /// Телефоны и ники вычищены ПЕРЕД сохранением (sanitizeStyleText) — текст
  /// уходит в промт чужих разговоров, и чужому номеру там не место.
  clientText String
  /// Что ответил живой сотрудник — это и есть эталон манеры. Так же вычищен.
  agentText  String
  /// Кто именно ответил. null — ручной ответ прямо из мессенджера, мимо CRM:
  /// Meta называет только аккаунт страницы, а не сотрудника (MessageSender
  /// kind="manual"). Хранится, чтобы потом можно было отсеять примеры того, кто
  /// отвечает плохо, — скопом, не разбирая каждый.
  /// Внешнего ключа сюда намеренно нет: сотрудника могут уволить и удалить из
  /// CRM (см. передачу дел при удалении агента), а его манера остаётся ценной —
  /// пример не должен ни удаляться каскадом, ни мешать удалению самого агента.
  agentId    String?
  /// HISTORY — разовый импорт прошлых переписок; TAKEOVER — сотрудник вмешался в
  /// живой разговор бота (значит бот ответил не так, а человек показал как надо).
  source     String
  /// Из какого канала манера ("INSTAGRAM", "WHATSAPP", "TELEGRAM"…). На отбор
  /// сейчас не влияет, но пишут в них по-разному, и разделить пригодится.
  channel    String?
  /// Выключить неудачный пример, не удаляя его.
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  /// Дубль — норма, а не ошибка: одну и ту же фразу сотрудники пишут десятки раз.
  /// Уникальность отсекает их молча, на стороне базы.
  @@unique([clientText, agentText])
  @@index([enabled, createdAt])
}

/// ЖУРНАЛ ПЕРЕХОДОВ СТАТУСОВ И ЭТАПОВ (26.08.2026, архитектурное ревью, пункт 4).
///
/// Переходы Client.status/workStatus и Deal.stage раньше не датировались нигде:
/// любой будущий отчёт «где застревают сделки» или «сколько лид живёт на этапе»
/// был невозможен В ПРИНЦИПЕ — историю задним числом не восстановить. Совет
/// «посадить дерево»: данные пишем с сегодняшнего дня, отчёты построим, когда
/// накопится история. Никакого UI пока нет — только запись.
///
/// Запись НАМЕРЕННО без внешних ключей: журнал обязан переживать удаление
/// клиента, сделки и сотрудника — история переходов и есть то, что остаётся.
model StageEvent {
  id         String   @id @default(uuid())
  /// "CLIENT" | "DEAL" — чей переход.
  entityType String
  entityId   String
  /// Какое поле сменилось: "status" | "workStatus" | "stage" — у клиента их
  /// два независимых, и без имени поля переходы двух машин состояний смешаются.
  field      String
  /// Откуда ушли. null — запись о создании: первый статус, прежнего не было.
  from       String?
  to         String
  /// Кто перевёл. null — переход сделала сама CRM (бот, cron, автоправило).
  agentId    String?
  at         DateTime @default(now())

  /// Путь одной сущности по времени — главный (и пока единственный) запрос журнала.
  @@index([entityType, entityId, at])
}

/// ПУЛЬС КРОН-ТИКОВ (26.08.2026, архитектурное ревью, пункт 9).
///
/// 43 тика — 43 способа молча потерять «переназначение протухших лидов» или
/// утреннюю сводку: тик, который перестал запускаться, не пишет ничего никуда,
/// и узнаётся это от владельца через неделю. Каждый запуск обёртки
/// scheduleTracked (lib/cronHeartbeat.ts) обновляет свою строку; сторожевой тик
/// сравнивает давность с ожидаемым интервалом и поднимает logSystemError.
/// Выключаемые модули пульта директора (docs/pult-direktora-audit-02-09-2026.md §4).
/// Реестр id/подписей — в @royal-home/shared (pultModules.ts); строки только для
/// выключенных или когда-либо переключавшихся модулей, отсутствие строки = включён.
model PultModule {
  id          String   @id
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// ПРОСТОЙ ТЕЛЕФОНИИ — окно, в котором CRM не могла достучаться до станции
/// (дыра 4.2 из docs/karta-resheniy-i-dyr-09-09-2026.md).
///
/// Зачем таблица, а не признак в памяти. Счётчик тишины («агент не пытался N
/// рабочих дней») считает попытки по доказанным следам, а главный след — звонок
/// через АТС. Станция лежит день — звонков нет ни у кого, и на следующее утро
/// владелец получает тревогу СРАЗУ ПО ВСЕМ агентам, которые работали как обычно.
/// Одна такая рассылка стоит доверия ко всей системе контроля. Признак в памяти
/// процесса это не чинит: тревога считает задним числом, ей нужна история.
///
/// endedAt = null — простой ещё идёт. Закрывается первым же успешным зондом.
model StationOutage {
  id        String    @id @default(cuid())
  startedAt DateTime
  endedAt   DateTime?
  /// Текст отказа последнего зонда — чтобы в разборе было видно, что именно
  /// не отвечало: сама станция, сеть контейнера или неверные учётные данные.
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([startedAt])
  @@index([endedAt])
}

model CronHeartbeat {
  /// Имя тика — то, что увидит директор в алерте. Стабильное, латиницей.
  name           String    @id
  /// Cron-выражение — по нему сторож считает ожидаемый интервал.
  expr           String
  /// Последний ЗАПУСК (начало). Свежий lastRunAt при старом lastOkAt — тик
  /// запускается, но не доживает до конца.
  lastRunAt      DateTime?
  /// Последнее УСПЕШНОЕ завершение.
  lastOkAt       DateTime?
  /// Текст последней ошибки (обрезан) — быстрая диагностика без грепа логов.
  lastError      String?
  /// Последний пропуск тика из-за выключенного модуля пульта (lib/pultModules.ts):
  /// сторож считает его признаком жизни, а не молчанием.
  lastSkippedAt  DateTime?
  lastSkipReason String?
  /// Когда сторож в последний раз поднимал тревогу по этому тику — чтобы одно
  /// молчание не рождало алерт каждые 15 минут.
  alertedAt      DateTime?
  updatedAt      DateTime  @updatedAt
}

/// Статусы заданий очереди (чертёж каркаса §2, 26.08.2026).
enum BackgroundJobStatus {
  PENDING /// ждёт срока runAt
  RUNNING /// взят воркером (lockedAt показывает, не завис ли)
  DONE
  GIVEN_UP /// попытки исчерпаны, onGiveUp выполнен
  SKIPPED /// модуль пульта выключен (jobs/jobModules.ts) — не исполнялось, не ошибка
}

/// ПЕРСИСТЕНТНАЯ ОЧЕРЕДЬ ФОНОВЫХ ЗАДАНИЙ (чертёж каркаса §2, 26.08.2026).
///
/// До неё фоновая работа жила в памяти процесса (setTimeout до 13 часов у
/// повторов ответа клиенту) — и каждый деплой, а их несколько в день, молча
/// убивал всё ждущее. Очередь — только про «сделай X не позже чем можно,
/// переживи перезапуск, не сделай дважды»: без приоритетов, без каналов,
/// без cron-выражений (расписания — в cron.ts).
///
/// Исполняет jobs/runner.ts в worker-процессе; контракт обработчика —
/// jobs/registry.ts. Каждый run обязан быть идемпотентным: воркер может
/// исполнить задание дважды (падение между run и DONE).
model BackgroundJob {
  id          String              @id @default(cuid())
  /// Ключ обработчика в jobs/registry.ts: "geocode", "ai-reply-retry", ...
  type        String
  /// Валидируется Zod-схемой обработчика ПЕРЕД run: payload писала прошлая
  /// версия кода, а читает будущая — это внешние данные.
  payload     Json
  status      BackgroundJobStatus @default(PENDING)
  runAt       DateTime            @default(now())
  attempts    Int                 @default(0)
  maxAttempts Int
  /// Текст последней неудачи — виден при разборе без грепа логов.
  lastError   String?
  /// Идемпотентность постановки: повторный enqueue с тем же ключом — no-op,
  /// пока задание ждёт или исполняется; после DONE тот же ключ ПЕРЕЗАВОДИТ
  /// задание заново (см. jobs/enqueue.ts) — «geocode:{id}» обязан срабатывать
  /// на каждую правку адреса, а не один раз за жизнь объекта.
  dedupeKey   String?             @unique
  lockedAt    DateTime?
  /// hostname контейнера — для отладки «кто взял и умер».
  lockedBy    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, runAt])
}

/// СКОЛЬКО ПОДПИСЧИКОВ INSTAGRAM БЫЛО В СЕТИ В КАЖДЫЙ ЧАС (23.09.2026, владелец:
/// «доработай тепловую карту полностью»). Метрика Meta `online_followers`:
/// сама Meta отдаёт её только за последние 30 дней, поэтому раз в сутки
/// забираем и складываем сюда — иначе истории длиннее месяца не будет вовсе.
/// Источник среза «Подписчики в сети» на карте и часов выхода роликов
/// (lib/instagramInsights.ts, lib/audienceHeatmap.ts, lib/publishScheduleRules.ts).
///
/// Одна строка на (аккаунт, час) — повторный сбор того же часа перезаписывает
/// число, а не добавляет второе. Около 24 строк в сутки.
model InstagramOnlineFollowersHour {
  /// Id аккаунта Instagram из /me: сменили основной аккаунт — часы старого не
  /// смешиваются с часами нового (карта берёт аккаунт последнего сбора).
  igUserId  String
  /// Начало часа, UTC.
  at        DateTime
  count     Int
  fetchedAt DateTime @default(now()) @updatedAt

  @@id([igUserId, at])
  @@index([at])
}

/// СКОЛЬКО СООБЩЕНИЙ НАПИСАЛИ КЛИЕНТЫ В КАЖДЫЙ ЧАС (23.09.2026) — счётчик для
/// тепловой карты (lib/audienceHeatmap.ts, срез «Переписка»). До него карта
/// знала о переписке только две отметки на диалог — начало и последнее
/// сообщение: истории сообщений со временем у нас нет (тексты лежат массивом
/// JSON без отметок), а ProcessedMessage живёт три дня. Разговор из тридцати
/// реплик весил на карте как разговор из двух.
///
/// Одна строка на (час, канал), прибавляется на каждое входящее сообщение
/// клиента — десятки строк в сутки.
model AudienceMessageHour {
  /// Начало часа, UTC.
  hourStart DateTime
  /// INSTAGRAM, FACEBOOK, WHATSAPP, TELEGRAM, WEBSITE.
  channel   String
  count     Int      @default(0)

  @@id([hourStart, channel])
}

/// СКОЛЬКО РАЗ ФИЛЬТРЫ ОТВЕТА ЧИНИЛИ РЕПЛИКУ БОТА (27.08.2026, совет экспертов,
/// пункт 8). Восемь с лишним guard-ов молча правят текст перед отправкой —
/// повторное приветствие, дубль ссылки, обещание наличия, повтор вопроса. Их
/// срабатывания и есть прямая мера расхождения промта с желаемым поведением:
/// без счётчиков промт в тысячу строк правился вслепую.
///
/// Одна строка на (сутки, фильтр) — таблица растёт на десяток строк в день.
model GuardHit {
  id    String @id @default(uuid())
  /// "YYYY-MM-DD" ПО ДУШАНБЕ: «за сегодня» на экране обязано означать местный
  /// день, а не окно, съезжающее на пять часов (см. lib/dushanbeTime.ts).
  day   String
  /// Ключ фильтра из ai/guardMetrics.ts (repeat_greeting, off_topic, …).
  guard String
  count Int    @default(0)

  @@unique([day, guard])
  @@index([day])
}

/// КАРТА ОБСЛЕДОВАННОГО: куда в CRM реально заходят живые люди (08.09.2026).
///
/// Владелец: «есть места, куда мы ещё не доходили в коде и на экране» — и это
/// самый опасный класс, потому что там баги не просто есть, их НИКТО НИКОГДА
/// не видел. Покрытие тестами на этот вопрос не отвечает: оно показывает, куда
/// заходили ТЕСТЫ, а это другое множество.
///
/// Здесь фиксируется факт посещения. Разность «всё, что зарегистрировано в
/// приложении» (реестр маршрутов и экранов, scripts/coverage-map.ts) минус
/// «то, что попало сюда» и есть список необследованного — где искать баги, на
/// которые ещё не пожаловались.
///
/// Дёшево по определению: пишется ШАБЛОН маршрута («GET /api/v1/clients/:id»),
/// а не конкретный URL, поэтому строк тут сотни, а не миллионы, и растёт таблица
/// только при появлении НОВОГО маршрута или экрана. Сам счёт идёт в памяти
/// процесса, в базу уходит пачкой раз в минуту (lib/routeHits.ts).
model RouteHit {
  id    String @id @default(uuid())
  /// "api" — маршрут сервера, "screen" — экран приложения.
  kind  String
  /// api: "GET /api/v1/clients/:id" · screen: "/clients/:id".
  /// Именно шаблон, а не конкретный путь: иначе на каждого клиента своя строка.
  key   String
  count Int    @default(0)
  /// Когда сюда зашли ВПЕРВЫЕ — показывает, что маршрут ожил только что
  /// (например, экран открыли первый раз за всё время наблюдения).
  firstSeenAt DateTime @default(now())
  /// Последнее посещение: маршрут, живший месяц назад и замолчавший, — тоже
  /// сигнал, его не отличить от необследованного без этой даты.
  lastSeenAt  DateTime @default(now())

  @@unique([kind, key])
  @@index([kind, lastSeenAt])
}

/// ПОЧТОВЫЙ ЯЩИК ЖИВЫХ СОБЫТИЙ (12.09.2026) — как события из worker доходят до
/// подписчиков в api.
///
/// Процессов два (docker-compose.prod.yml: контейнер `api` с ENABLE_BACKGROUND=0
/// и контейнер `worker`), а SSE-подписки живут только в HTTP-процессе. Значит
/// нужен общий канал.
///
/// ПОЧЕМУ НЕ pg_notify, хотя он тут напрашивается. LISTEN требует СВОЕГО
/// постоянного соединения с Postgres, которое держит один и тот же сеанс. У
/// Prisma такого соединения не достать: движок запросов сам мультиплексирует пул
/// и уведомления наружу не отдаёт. Нужен драйвер `pg` — а его в зависимостях нет
/// и ставить нельзя. Redis/BullMQ в проекте тоже нет.
///
/// Поэтому канал — эта таблица, «хвост» которой api дочитывает раз в секунду.
/// Цена: ОДИН короткий индексный запрос в секунду на процесс, и только пока есть
/// хоть один подписчик (см. lib/eventBus.ts). Это дешевле того, что заменяется:
/// сейчас каждая открытая вкладка опрашивает десятки роутов каждые 25 секунд.
/// Внутри своего процесса доставка мгновенная, без ожидания опроса, — строка
/// помечена `origin`, и свой же обход её пропускает.
///
/// Строки живут минуты: чистка в lib/eventBus.ts сносит всё старше LIVE_EVENT_TTL.
/// Это транспорт, а не журнал, — журнал переходов лежит в StageEvent.
model LiveEventOutbox {
  /// Монотонный номер: читаем «всё, что больше последнего виденного».
  seq       Int      @id @default(autoincrement())
  /// Тип из LIVE_EVENT_TYPES (@royal-home/shared).
  type      String
  /// ТОЛЬКО идентификаторы и признаки — ни телефонов, ни текстов (см. liveEvents.ts).
  payload   Json
  /// Персональные получатели; пусто вместе с roles — широковещательное.
  agentIds  String[]
  /// Получатели по роли.
  roles     String[]
  /// Кто опубликовал: свой же обход пропускает свои строки, чтобы не задвоить.
  origin    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// ЗАПИСИ БЭКАПОВ (перенос мобильного макета 14.09.2026, шаг 5 «/backups»).
///
/// `ops/backup.sh` и `ops/restore-drill.sh` раньше писали успех/отказ ТОЛЬКО
/// в Telegram и в файлы/логи на VPS — ни одной строки в базе, поэтому CRM не
/// могла показать реальный статус бэкапов, только честное «нет данных».
/// Теперь оба скрипта шлют сюда один best-effort отчёт на шаг (POST
/// /api/v1/backups/report, X-Api-Key = BACKUP_REPORT_API_KEY) — отказ самого
/// отчёта НЕ считается сбоем бэкапа и не роняет скрипт (см. комментарий в
/// ops/backup.sh). История короткая намеренно: это журнал «жив ли бэкап», не
/// архив на годы — старые строки чистит ротация в routes/backups.ts.
model BackupRun {
  id     String @id @default(uuid())
  /// "DB" | "UPLOADS" | "PRIVATE_UPLOADS" | "PROPERTY_VIDEO" | "OFFSITE" |
  /// "RESTORE_DRILL" — шаги пишут отдельными строками, не одной агрегированной,
  /// чтобы отказ одного шага (например, оффсайт-копии) не прятал успех других.
  kind    String
  success Boolean
  /// Человеко-читаемый размер как отдаёт `du -sh`/`ls -lh` в самом скрипте
  /// ("8.7G", "412K") — не байты: сами скрипты не считают точный размер
  /// заранее, а заводить BigInt-поле ради строки, которая и так уже есть
  /// готовой формы, было бы лишней сложностью.
  sizeLabel  String?
  /// Короткая причина отказа или деталь успеха, тот же текст, что уходит в
  /// Telegram-алерт (alert() в backup.sh) — не дублировать формулировку заново.
  detail     String?
  startedAt  DateTime
  finishedAt DateTime
  createdAt  DateTime @default(now())

  @@index([kind, finishedAt])
}

/// СНИМОК СУТОЧНОЙ САМОПРОВЕРКИ ВНЕШНИХ ДОСТУПОВ (перенос мобильного макета
/// 14.09.2026, шаг 5 «/integrations»).
///
/// `lib/integrationHealth.ts` (`runIntegrationHealthChecks()`) уже считает
/// живость каждого канала каждую ночь (cron.ts) — но раньше результат никуда
/// не сохранялся: успех уходил в консоль, отказ в `ErrorLog` вперемешку со
/// всеми остальными ошибками, и «список каналов со статусом» показать было
/// нечем. Экран `/integrations` читает ЭТОТ снимок, а не гоняет живые
/// проверки на каждое открытие — иначе каждый заход на экран бил бы по
/// Gemini/Meta Graph/R2 и дублировал алерты в Telegram, которые и так шлёт
/// ночной прогон. Одна строка на канал, перезаписывается следующим прогоном.
model IntegrationHealthSnapshot {
  /// Имя канала — то же значение, что `IntegrationCheck.name`.
  name String @id
  /// true — жив, false — сломан (запись в ErrorLog уже сделана ночным
  /// прогоном), null — не настроен, проверять нечего.
  ok        Boolean?
  detail    String?
  checkedAt DateTime @default(now()) @updatedAt
}

/// ЩИТ ИСХОДЯЩИХ: СОСТОЯНИЕ ОДНОГО ДИАЛОГА (17.09.2026).
///
/// Два инцидента за три дня — петля двух наших ботов 15.09 и сторож номеров,
/// круживший «Ташаккур, рақаматонро қабул кардам» по шести кандидатам 17.09, —
/// сломались в разных местах, а наружу дали одно и то же: человек получил то,
/// чего не ждал, много раз подряд. Поэтому счётчики живут НЕ в сценарии, а
/// отдельной лёгкой строкой на диалог, которую трогает единственная точка —
/// lib/outboundShield.ts, ниже всех кронов и очередей.
///
/// Почему отдельная таблица, а не поля на BotConversation: щит одинаково
/// сторожит и Meta-диалоги, и Telegram (две разные модели), и одна отправка
/// обязана стоить один upsert, без чтения истории `messages` целиком.
model OutboundShieldState {
  id           String  @id @default(uuid())
  endpointScopeId String?
  endpointScope CustomerEndpointScope? @relation(fields: [endpointScopeId], references: [id], onDelete: Restrict)
  /// WHATSAPP | INSTAGRAM | FACEBOOK | TELEGRAM | WEBSITE
  channel      String
  /// Получатель: subscriberId у Meta, chatId у Telegram.
  subscriberId String
  /// Имя/ник получателя, как его знает переписка — по нему щит узнаёт свой же
  /// аккаунт, когда идентификаторы не совпадают (см. lib/ownAccountGuard.ts).
  recipientName String?

  /// Последнее НАСТОЯЩЕЕ входящее (с идентификатором провайдера). Записи без
  /// него входящими не считаются: ровно из такой поддельной реплики выросла
  /// петля 17.09.
  lastInboundAt DateTime?
  lastInboundId String?

  /// Сообщений бота с момента последнего настоящего входящего (правило 1).
  botSentSinceInbound Int @default(0)

  /// Скользящие окна темпа (правило 3): начало окна и счётчик в нём.
  hourWindowStart DateTime?
  hourCount       Int       @default(0)
  dayWindowStart  DateTime?
  dayCount        Int       @default(0)

  /// Отпечатки текстов бота за сутки: [{ h: хэш, t: мс, n: сколько раз }].
  /// Хранится здесь, а не считается по истории: пересчёт JSON переписки на
  /// каждую отправку — тот самый N+1, только в оперативной памяти.
  recentTexts Json @default("[]")

  /// Пауза, поставленная ЩИТОМ (правило 6). Совпадает с BotConversation.pausedUntil
  /// ровно до тех пор, пока её не перебил человек: по этому совпадению щит и
  /// понимает, что снимать паузу можно — чужую (операторскую) он не трогает.
  pausedUntil    DateTime?
  pausedReason   String?
  pausedAt       DateTime?
  /// Shield-owned post-native-pause fence. Legacy pauses have no undo authority.
  pauseFence     Json?
  /// Когда по этому диалогу последний раз писали в журнал и будили руководство.
  loggedAt       DateTime?
  alertedAt      DateTime?
  /// Сколько раз щит остановил отправку в этом диалоге — для разбора.
  firedCount     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, subscriberId])
  @@unique([endpointScopeId, subscriberId])
  @@index([pausedUntil])
}

/// ОБЩИЙ ПУЛЬС ИСХОДЯЩИХ (правило 5): по минуте на строку.
///
/// Петлю двух ботов на уровне одного диалога не видно вовсе — там у каждого
/// «всё в норме», а наружу летит вал. Поминутный счётчик стоит один upsert на
/// инициативную отправку и даёт и текущие 10 минут, и среднее за неделю.
model OutboundShieldPulse {
  bucket DateTime @id
  count  Int      @default(0)
}

/// ГЛОБАЛЬНАЯ ПАУЗА ИНИЦИАТИВЫ БОТА (правило 5). Одна строка на всю систему.
///
/// ⚠️ Глушит ТОЛЬКО инициативу (кроны, очереди, напоминания). Ответы живым
/// людям продолжают идти: «тихий бот» для настоящего клиента — это тот же
/// ущерб, ради предотвращения которого щит и написан (решение владельца 17.09).
model OutboundShieldGlobal {
  id          Int       @id @default(1)
  pausedUntil DateTime?
  reason      String?
  alertedAt   DateTime?
  updatedAt   DateTime  @updatedAt
}

/// ─────────────────────────────────────────────────────────────────────────────
/// ДОСЬЕ СОБЕСЕДНИКА (владелец 21.09.2026: «карточки на каждого написавшего
/// сделать срочно, это важнее всего»).
///
/// Зачем: до этой таблицы всё, что бот знал о человеке, лежало в черновике
/// ОДНОГО диалога (`leadDraft`) плюс в переписке, обрезанной до 40 реплик. Тот
/// же человек из другого канала — новый незнакомец; вернулся через неделю — имя
/// и номер спрашиваются заново. Карточка `Client` не спасает: она заводится
/// только когда лид оформлен, то есть ПОСЛЕ телефона и готовности, а до этого
/// человека для CRM не существует вовсе.
///
/// Досье заводится на ПЕРВОМ входящем в любом канале — до карточки клиента и
/// независимо от того, станет ли человек лидом (спам тоже получает досье: иначе
/// «этому уже отвечали и это реклама» негде запомнить).
///
/// Словарь категорий, видов идентификаторов и схема фактов — общие для сервера и
/// экрана: `packages/shared/src/contactProfile.ts`. Логика —
/// `apps/api/src/lib/contactProfiles.ts`. Разбор: docs/contact-profile-and-bot-roles-20-09.md.
/// @@ Досье собеседника: один человек, сколько бы каналов он ни использовал.
model ContactProfile {
  id              String           @id @default(uuid())
  /// Как обращаться. Пусто — имени пока не знаем; именем из профиля канала бот
  /// НЕ обращается (см. nameSource), поэтому здесь может быть пусто при
  /// заполненном профиле мессенджера.
  displayName     String?
  /// Откуда имя: "self" (назвал сам), "vcard" (визитка), "profile" (профиль
  /// канала). Строкой, а не enum: список источников ещё будет расти.
  nameSource      String?
  /// Кто это в понимании бота — код из CONTACT_CATEGORIES общего словаря.
  /// Новое досье всегда UNKNOWN: категория не угадывается при создании.
  category        String           @default("UNKNOWN")
  /// Когда категория стала текущей.
  categorySetAt   DateTime?
  /// История смен: [{category, at, source, conv?}]. Прошлое при смене категории
  /// НЕ стирается (прямое требование владельца): человек может сегодня
  /// продавать, а через месяц покупать, и обе роли — настоящие.
  categoryHistory Json             @default("[]")
  /// На каком языке с ним говорить: "ru" | "tg" | "en"… Пусто — не решено
  /// (в том числе при равенстве счётчиков: обратиться не на том языке хуже, чем
  /// ответить на языке последнего сообщения).
  language        String?
  /// Счётчики языка по входящим: {"ru": 12, "tg": 3}. Решение по большинству, а
  /// не по последнему сообщению: одно «salom» не делает переписку таджикской.
  languageCounts  Json             @default("{}")
  /// Что человек уже рассказал, по областям — {version, buyer, seller, job, misc},
  /// каждый факт с происхождением и временем (схема в общем словаре). Без
  /// происхождения досье через месяц превращается в свалку утверждений, которую
  /// нельзя ни проверить, ни состарить.
  facts           Json             @default("{}")
  /// Первое и последнее касание — по любому каналу.
  firstSeenAt     DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  /// Сколько входящих сообщений от него насчитали всего. Дешёвая мера «свой или
  /// случайный», по которой видно вернувшегося человека без чтения переписок.
  messagesIn      Int              @default(0)
  /// Карточка клиента, если она у человека уже появилась. Досье НЕ заменяет её:
  /// досье есть у каждого написавшего, `Client` — только у оформленного лида.
  clientId        String?
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Досье слито в другое (ручным подтверждением администратора). Запись не
  /// удаляется, а помечается: ссылки диалогов на неё остаются рабочими, а
  /// ошибочное слияние можно разобрать — удаление было бы необратимо.
  mergedIntoId    String?
  mergedInto      ContactProfile?  @relation("ContactProfileMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom      ContactProfile[] @relation("ContactProfileMergedInto")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  identities                  ContactIdentity[]
  jobApplications             JobApplication[]
  botConversations            BotConversation[]
  telegramConversations       TelegramConversation[]
  telegramDirectConversations TelegramDirectConversation[]
  incomingCalls               IncomingCall[]
  linkCandidatesLeft          ContactLinkCandidate[]       @relation("ContactLinkCandidateLeft")
  linkCandidatesRight         ContactLinkCandidate[]       @relation("ContactLinkCandidateRight")
  mergesIn                    ContactProfileMerge[]        @relation("ContactProfileMergeTarget")
  mergesOut                   ContactProfileMerge[]        @relation("ContactProfileMergeSource")

  /// Инбокс и разборы сортируют по последнему касанию, поиск идёт по карточке
  /// клиента и по категории — индексы сразу, а не после первого замера.
  @@index([lastSeenAt])
  @@index([clientId])
  @@index([category])
  @@index([mergedIntoId])
}

/// ИДЕНТИФИКАТОР КАНАЛА, ПРИНАДЛЕЖАЩИЙ ДОСЬЕ.
///
/// Уникальна ПАРА (kind, value) — тот же приём, что `Client.phone @unique`, и
/// именно он гарантирует, что второго досье по одному и тому же идентификатору
/// не бывает даже при одновременных входящих: вставка второго упадёт на
/// уникальном индексе, а не заведёт двойника молча.
/// @@ Идентификатор человека в одном канале (номер, wa_id, chatId).
model ContactIdentity {
  id          String         @id @default(uuid())
  profileId   String
  profile     ContactProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Вид — код из CONTACT_IDENTITY_KINDS общего словаря.
  kind        String
  /// Значение в НОРМАЛИЗОВАННОМ виде. Для PHONE это хвост из девяти цифр — тот
  /// же, каким CRM уже узнаёт клиента по номеру (`lib/clientPhones.ts`), иначе
  /// «+992 90 123-45-67» и «992901234567» были бы двумя разными людьми.
  value       String
  /// Насколько можно верить: "TRANSPORT" (подтвердил сам канал) | "STATED"
  /// (человек назвал сам) | "PROFILE" (взято из профиля). Автоматически
  /// связывать каналы разрешено ТОЛЬКО по TRANSPORT — напечатанный в чате номер
  /// заводит кандидата на ручное подтверждение, потому что продавец диктует
  /// номер жены, а агент пересылает чужой контакт.
  trust       String
  firstSeenAt DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())

  @@unique([kind, value])
  @@index([profileId])
}

/// «ПОХОЖЕ, ЭТО ТОТ ЖЕ ЧЕЛОВЕК» — предложение связать два досье, которое
/// подтверждает человек, а не код.
///
/// Существует ровно потому, что ненадёжный признак (напечатанный номер, имя,
/// ник) сливать автоматически нельзя: склеенные досье разных людей — это чужой
/// бюджет и чужой адрес в ответе бота, и разобрать это потом почти невозможно.
/// @@ Предложение связать два досье (ждёт подтверждения человеком).
model ContactLinkCandidate {
  id          String         @id @default(uuid())
  leftId      String
  left        ContactProfile @relation("ContactLinkCandidateLeft", fields: [leftId], references: [id], onDelete: Cascade)
  rightId     String
  right       ContactProfile @relation("ContactLinkCandidateRight", fields: [rightId], references: [id], onDelete: Cascade)
  /// Почему предложено: код правила (например "STATED_PHONE").
  reason      String
  /// Чем подтверждается — то, что человек увидит в окне подтверждения.
  evidence    Json           @default("{}")
  /// "PENDING" | "IN_PROGRESS" | "ACCEPTED" | "REJECTED" | "OBSOLETE".
  /// Отклонённая пара больше не предлагается: иначе разбор превращается в
  /// ежедневную отписку. IN_PROGRESS занимается на время самого слияния, чтобы
  /// два нажатия подряд не слили одну пару дважды. OBSOLETE ставится, когда
  /// одно из досье пары уехало в чужое слияние: предлагать надгробие нельзя.
  status      String         @default("PENDING")
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?
  /// Кто решил. Без связи с Agent намеренно (тот же приём, что
  /// `IncomingCall.interactionId`): удаление сотрудника не должно ни каскадом
  /// тронуть журнал решений, ни требовать обратной связи в модели Agent.
  decidedById String?

  @@unique([leftId, rightId])
  @@index([status])
}

/// ЖУРНАЛ СЛИЯНИЙ ДОСЬЕ. Нужен, чтобы ошибочное слияние можно было разобрать
/// словами «кто, когда и на каком основании», а не догадками по датам.
/// @@ Запись о слиянии двух досье.
model ContactProfileMerge {
  id         String         @id @default(uuid())
  /// Досье, которое осталось жить.
  targetId   String
  target     ContactProfile @relation("ContactProfileMergeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  /// Досье, которое слили в target (запись остаётся, см. mergedIntoId).
  sourceId   String
  source     ContactProfile @relation("ContactProfileMergeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  /// Код основания: "MANUAL" | "TRANSPORT_PHONE" и далее.
  reason     String
  /// Что было в source на момент слияния — чтобы вернуть, если слили не то.
  snapshot   Json           @default("{}")
  mergedAt   DateTime       @default(now())
  /// Кто слил; без связи с Agent по той же причине, что и decidedById выше.
  mergedById String?

  @@index([targetId])
  @@index([sourceId])
}

/// СВОЙ ШАБЛОН ОБЛОЖКИ, загруженный владельцем в Настройках (23.09.2026).
/// Пара файлов, ровно как у исходников «Royal Gold»: слой геометрии (SVG с
/// подстановками `{{rooms}}`, `{{price}}` и т. д.) и числа (`spec.json`,
/// проверяется схемой `coverTemplateSpecSchema` в @royal-home/shared).
/// Встроенный шаблон здесь НЕ лежит: он живёт кодом и не удаляется.
model CoverTemplate {
  id        String   @id @default(uuid())
  /// Как шаблон называется в списке Настроек.
  name      String
  /// `/uploads/cover-templates/<файл>.svg` — слой геометрии после очистки
  /// (скрипты и внешние ссылки вырезаются при загрузке).
  svgUrl    String
  /// Разобранный `spec.json` целиком — из него берутся холсты, цвета и
  /// коррекция фото. Хранить файлом незачем: он маленький и нужен целиком.
  spec      Json
  /// Необязательные слои шаблона: листья по краям и свой знак.
  leavesUrl String?
  logoUrl   String?
  createdAt DateTime @default(now())
  createdBy String?

  @@index([createdAt])
}

/// Сообщение бота модератору в Telegram (22.09.2026, lib/telegramModeration).
/// Нужно, чтобы решение, принятое где угодно (CRM, другой админ), погасило кнопки
/// у ВСЕХ: без message_id отредактировать уже отправленное сообщение нельзя.
model TelegramModerationMessage {
  id              String    @id @default(uuid())
  /// REVIEW — объект на проверке; PHOTOS — досланные фото (batchId).
  kind            String
  propertyId      String
  batchId         String?
  agentId         String
  chatId          String
  messageId       Int
  /// Текст сообщения как отправлен — editMessageText требует текст целиком,
  /// а дописать надо строку решения под ним.
  text            String
  /// Property.version на момент отправки — по нему видно, что карточка устарела.
  propertyVersion Int
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([propertyId, resolvedAt])
  @@index([batchId])
}

/// Пачка досланных фото на решение в Telegram. Короткий id пачки уходит в
/// callback_data вместо списка фото (предел Telegram — 64 байта).
model TelegramPhotoBatch {
  id           String    @id @default(uuid())
  shortCode    Int       @unique @default(autoincrement())
  propertyId   String
  photoIds     String[]
  /// Фото, по которым уже есть решение «по одному»: {photoId: "ok"|"no"}.
  decisions    Json      @default("{}")
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())

  @@index([propertyId])
}

/// Диалог модератора с ботом («жду причину», «жду новое значение поля»). В базе,
/// а не в памяти: перезапуск API или второй экземпляр не теряют состояние.
model TelegramDialogState {
  chatId    String   @id
  agentId   String
  kind      String
  payload   Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

/// Обработанные нажатия кнопок — повторная доставка того же callback_query
/// (вебхук повторил, поллер перечитал) не выполняет решение второй раз.
model TelegramCallbackSeen {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// ФАКТЫ ОБ ОБЪЕКТЕ ПРОДАВЦА (владелец 21.09.2026: «всё, что продавец присылает и
/// говорит, само попадает в объект»). Снимок, который фоновое задание
/// seller-facts (jobs/sellerFacts.ts) обновляет по новым сообщениям и
/// расшифровкам, а мастер, чат и полоса продавца только читают.
///
/// ОТДЕЛЬНОЙ ТАБЛИЦЕЙ, А НЕ КОЛОНКАМИ Client. Client — самая широкая и самая
/// читаемая таблица CRM (списки, карточка, кроны светофоров); JSON фактов и
/// служебные отметки разбора нужны ровно трём экранам продавца. Строка
/// заводится только у продавцов, о которых реально есть что сказать, и уходит
/// вместе с клиентом (onDelete: Cascade).
model SellerObjectFacts {
  clientId        String    @id
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// SellerObjectFacts из @royal-home/shared; читается через safeParse — JSON писала
  /// прошлая версия кода.
  facts           Json?
  /// sha256 входа последнего УДАВШЕГОСЯ разбора (прошлые факты + новые реплики):
  /// тот же вход второй раз в модель не уходит.
  factsInputHash  String?
  /// До какого момента реплики переписки уже учтены — в модель идут только более
  /// поздние (инкрементальный разбор).
  factsSourceUpTo DateTime?
  /// Звонки, чьи расшифровки уже учтены. Списком id, а не датой: расшифровка
  /// появляется позже самого звонка, и граница по createdAt её бы теряла.
  factsCallIds    String[]  @default([])
  factsUpdatedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// ЖУРНАЛ ОТПРАВЛЕННЫХ СМС (23.09.2026). Каждая попытка — строка, и удачная, и
/// отказ провайдера: по нему видно, сколько ушло, кому и почему не дошло. Текст
/// кода входа сюда НЕ пишется (purpose=LOGIN_CODE хранит только «код входа»).
model SmsMessage {
  id                String    @id @default(uuid())
  /// Номер в форме провайдера: 992XXXXXXXXX.
  phone             String
  /// LOGIN_CODE | PROPERTY_SHARE | CALL_PROPERTIES | TEST
  purpose           String
  /// Текст, как ушёл (для кода входа — заглушка без самого кода).
  text              String
  /// SENT | FAILED | DRY_RUN — ушло ли к провайдеру. Дошло ли до телефона — ниже.
  status            String
  provider          String?
  providerMessageId String?
  /// Статус доставки от Payom: SERVICE_ACCEPTED → SENT → DELIVERED / UNDELIVERABLE /
  /// REJECTED / EXPIRED … Первый — из ответа на отправку, дальше — вебхуком
  /// (routes/sms.ts). Вебхуки приходят вразнобой, поэтому пишется только более
  /// свежий по deliveryStatusAt (время события у Payom, не наше).
  deliveryStatus    String?
  deliveryStatusAt  DateTime?
  /// Сколько частей насчитал провайдер (кириллица — 70 знаков на часть).
  parts             Int?
  error             String?
  agentId           String?
  clientId          String?
  propertyId        String?
  createdAt         DateTime  @default(now())

  @@index([createdAt])
  @@index([clientId, propertyId, createdAt])
  @@index([phone, purpose, createdAt])
  @@index([providerMessageId])
}

/// ПЕРВОЕ СООБЩЕНИЕ КЛИЕНТУ В WHATSAPP (24.09.2026) — кнопка «Написать первым» в
/// карточке клиента. Строка на каждую отправку одобренного Meta текста: по ней
/// видно, дошло ли, ответил ли клиент, и не даёт отправлять повторно, пока ответа
/// нет (каждое такое сообщение Meta берёт деньгами). Связи строками, как у
/// SmsMessage: журнал отправок переживает удаление карточки и сотрудника.
model WhatsAppFirstContact {
  id              String    @id @default(uuid())
  clientId        String
  /// Кто нажал кнопку — ему же уходит пуш, когда клиент ответит.
  agentId         String
  /// Переписка, в которую лёг текст (заводится при отправке, если её не было).
  conversationId  String?
  /// Номер получателя, цифрами с кодом страны.
  recipient       String
  /// Объект, про который клиент просил. Его ссылка уходит сама, когда клиент ответит.
  propertyId      String?
  templateName    String
  /// Идентификатор сообщения у Meta — по нему приходят «доставлено/прочитано/не дошло».
  waMessageId     String?   @unique
  /// SENT | DELIVERED | READ | FAILED | REPLIED
  status          String    @default("SENT")
  /// Почему не дошло — словами, для агента.
  failReason      String?
  sentAt          DateTime  @default(now())
  repliedAt       DateTime?

  @@index([clientId, sentAt])
  @@index([recipient, repliedAt])
}

/// Код входа по СМС. Хранится только хэш; живёт 5 минут, 5 попыток, одноразовый.
model LoginSmsCode {
  id         String    @id @default(uuid())
  agentId    String
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  codeHash   String
  /// Куда ушёл код: sms | telegram (19.10.2026).
  channel    String    @default("sms")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  /// Код ушёл пушем: хеш секрета подтверждения доставки, момент подтверждения и
  /// момент, когда ушла запасная СМС (19.10.2026).
  ackTokenHash   String?
  ackedAt        DateTime?
  fallbackSentAt DateTime?

  @@index([agentId, createdAt])
  @@index([ackTokenHash])
}

/// Short-lived customer-bot diagnostics; free text only by explicit opt-in.
/// Never a business receipt.
model BotTurnTrace {
  id              String   @id
  schemaVersion   Int
  coverage        String
  createdAt       DateTime
  updatedAt       DateTime
  completedAt     DateTime?
  expiresAt       DateTime
  checkpointSeq   Int
  outcome         String
  channel         String
  source          String
  eventKey        String?
  conversationKey String?
  accountKey      String?
  payload         Json

  @@index([expiresAt])
  @@index([createdAt, channel])
  @@index([eventKey, createdAt])
  @@index([conversationKey, createdAt])
}

/// ПОВТОР ОДНОЙ И ТОЙ ЖЕ ЗАПИСИ НЕ СОЗДАЁТ ВТОРУЮ (23.09.2026). Сайт шлёт на
/// создание объекта, клиента, сделки и записи в хронологию заголовок
/// Idempotency-Key; повтор с тем же ключом (офлайн-очередь после обрыва, второе
/// нажатие «Сохранить») получает ответ первого запроса, а не новую строку.
/// Разбор — шапка lib/idempotency.ts. Строки живут трое суток.
model IdempotencyKey {
  id          String    @id @default(uuid())
  agentId     String
  key         String
  method      String
  path        String
  /// null — первый запрос ещё выполняется.
  status      Int?
  body        Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([agentId, key])
  @@index([createdAt])
}

/// ПОСЕЩАЕМОСТЬ САЙТА ROYALHOME.TJ ПО ЧАСАМ (24.09.2026, Dan: «забыли добавить к
/// тепловой карте статистику с нашего сайта»). Сайт — отдельное приложение со
/// своей базой; CRM раз в час забирает его `GET /api/v1/crm/stats`
/// (lib/siteStats.ts) и складывает сюда. Источник среза «Посетители сайта» на
/// тепловой карте. Повторный сбор того же часа перезаписывает числа — сайт
/// отдаёт итог за час, а не прибавку.
model SiteVisitHour {
  /// Начало часа, UTC.
  hourStart DateTime @id
  /// Открытых страниц за час (без админки сайта).
  views     Int
  /// Разных посетителей за час (по случайной метке браузера, без личных данных).
  visitors  Int
  fetchedAt DateTime @default(now()) @updatedAt
}

/// СТАТИСТИКА ОБЪЕКТА НА САЙТЕ ПО ДНЯМ (24.09.2026): сколько раз открыли
/// страницу объекта и что нажали — WhatsApp, «поделиться», «в избранное»
/// (звонок и Telegram — когда такие кнопки появятся на странице объекта).
/// Вкладка «Статистика» в карточке объекта и путь покупателя. День — по
/// Душанбе. Строка на (объект, день), повторный сбор перезаписывает.
model SitePropertyDay {
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Полночь дня по Душанбе, выраженная в UTC (как `dushanbeDayStart`).
  day            DateTime
  views          Int      @default(0)
  visitors       Int      @default(0)
  phoneClicks    Int      @default(0)
  whatsappClicks Int      @default(0)
  telegramClicks Int      @default(0)
  shareClicks    Int      @default(0)
  favoriteClicks Int      @default(0)
  fetchedAt      DateTime @default(now()) @updatedAt

  @@id([propertyId, day])
  @@index([day])
}

/// СНИМОК ПЕРЕДАЧИ ДЕЛ (владелец 24.09.2026: «добавь кнопку для возврата, если такое
/// в будущем случится, — и даже после деактивации, чтобы вернуть всё как было»).
/// Одна запись на одно нажатие «Передать дела»: кому какие клиенты, задачи и
/// объекты ушли и какими они были до этого (items — JSON со снимками полей).
/// Возврат (lib/agentHandoverRevert.ts) идёт по этому снимку и трогает только то,
/// что всё ещё у получателя: карточку, которую с тех пор передали дальше, не
/// отбирает, а считает пропущенной.
model AgentHandoverBatch {
  id            String    @id @default(uuid())
  fromAgentId   String
  fromAgent     Agent     @relation("HandoverBatchFrom", fields: [fromAgentId], references: [id], onDelete: Cascade)
  /// Кто нажал «Передать дела» (null — удаление сотрудника автоматикой).
  actorId       String?
  /// Явный получатель, если руководитель выбрал человека; null — раздача по команде.
  toAgentId     String?
  clients       Int       @default(0)
  tasks         Int       @default(0)
  properties    Int       @default(0)
  /// Учётка отключена тем же нажатием — возврат включит её обратно.
  deactivated   Boolean   @default(false)
  items         Json
  createdAt     DateTime  @default(now())
  revertedAt    DateTime?
  revertedById  String?
  revertSummary Json?

  @@index([fromAgentId, createdAt])
}

/// «Первые секунды ролика» (24.09.2026, Dan: «разбор первых секунд ролика»):
/// разбор ИИ трёх кадров первых трёх секунд готового ролика (jobs/videoOpening.ts).
/// Один на пару (объект, файл ролика): тот же файл второй раз не смотрим, новый
/// ролик объекта — новый разбор. Читает lib/firstSeconds.ts (Маркетинг → Обзор).
model VideoOpening {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Property.videoHandoffFinalPath на момент разбора.
  videoPath   String
  /// OK — разобран; NO_FILE — файла ролика на сервере нет; FAILED — кадры или ИИ
  /// не дались, экран повторит не раньше чем через сутки.
  status      String
  /// OPENING_SHOTS из packages/shared/src/videoOpening.ts: что показано первым.
  firstShot   String?
  hasPerson   Boolean  @default(false)
  hasText     Boolean  @default(false)
  /// 0–10: насколько начало цепляет, по мнению ИИ.
  hookScore   Int?
  note        String?
  tip         String?
  durationSec Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, videoPath])
}

/// РОБОТ ПРИГЛАШАЕТ КАНДИДАТА НА СОБЕСЕДОВАНИЕ (владелец 25.09.2026).
///
/// HR нажимает «Позвать на собеседование», выбирает день и время — и робот
/// звонит кандидату на языке его переписки (ru/tg), рассказывает о работе,
/// называет время и адрес и понимает ответ: придёт, просит другое время или
/// отказывается. Статусы — строками, как у PostShowingCall: PENDING → CALLING →
/// DONE, с NO_ANSWER между попытками, GIVEN_UP после последней, SKIPPED (нет
/// номера, собеседование уже прошло) и CANCELLED (время переназначили — старый
/// звонок не нужен).
model InterviewInviteCall {
  id               String         @id @default(uuid())
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  /// Время собеседования, которое робот называет. Снимок: если HR перенесёт,
  /// заводится новый звонок, а этот гаснет CANCELLED.
  interviewAt      DateTime
  /// Язык разговора (ru | tg) — из досье, по которому выбирается голос.
  language         String         @default("ru")
  status           String         @default("PENDING")
  scheduledFor     DateTime
  attempts         Int            @default(0)
  lastAttemptAt    DateTime?
  channelId        String?
  talkedAt         DateTime?
  /// CONFIRMED | RESCHEDULE | DECLINED | UNCLEAR — разбор расшифровки.
  outcome          String?
  /// Какое время кандидат попросил вместо назначенного, его словами.
  proposedTime     String?
  quote            String?
  summary          String?
  skipReason       String?
  /// Номер, который робот набрал (последние 9 цифр). «Трубку взял не кандидат»
  /// относится к НОМЕРУ: на тот же номер робот больше не звонит, а исправленный
  /// HR номер пускает (проверка робота 02.10.2026).
  phone            String?
  /// Сколько раз строку вернули в очередь после НАШЕГО сбоя (обрыв связи с
  /// моделью, выкат, нет звука со станции). Не больше одного раза: пока звук
  /// мёртв, кандидату иначе звонили бы раз за разом.
  failureRetries   Int            @default(0)
  /// Ключ записи разговора в R2 — HR слушает её из анкеты.
  recordingKey     String?
  requestedById    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, scheduledFor])
  @@index([jobApplicationId, createdAt])
  @@index([channelId])
}

/// СВОБОДНЫЙ РОЛИК В СОЦСЕТИ (12.10.2026, владелец: «обычный промо-ролик без объекта,
/// чтобы тоже был кросспостинг»). Ролик, который маркетинг/админ/директор загружает сам
/// и рассылает по выбранным каналам сразу или по расписанию. Объекта у него нет —
/// публикует тот же `publishApprovedPost` (lib/socialPublish.ts), для которого запись
/// играет роль «хозяина» пометок (`publishedChannels`/`publishedPostIds` ниже — те же
/// метки страховки от дублей, что лежат на Property: незавершённая загрузка TikTok,
/// сессия YouTube, попытка Facebook).
///
/// Файл лежит в /uploads/handoff/promo-<uuid>.mp4 (закрытая подписанная раздача; имя не
/// совпадает ни с одним шаблоном ночной чистки диска — lib/diskCleanup.ts его не тронет).
/// Удаляется вместе с записью.
model SocialVideoPost {
  id            String    @id @default(uuid())
  /// Внутреннее название для списка — в соцсети не уходит (туда уходит `caption`).
  title         String
  caption       String    @default("")
  /// Короткое описание ролика «своими словами» — по нему ИИ пишет подписи и рисует обложку
  /// (экран хранит его, чтобы «Перегенерировать» работало и после перезагрузки страницы).
  brief         String?
  /// "/uploads/handoff/promo-<uuid>.mp4"
  videoPath     String
  originalName  String
  sizeBytes     Int
  /// Факты файла (ffprobe при загрузке); null — не удалось измерить.
  durationSec   Float?
  width         Int?
  height        Int?
  hasAudio      Boolean?
  videoCodec    String?

  /// Обложка: NONE — без обложки (площадка возьмёт кадр сама) | UPLOAD — загружена | AI — нарисована ИИ.
  coverMode     String    @default("NONE")
  /// Вертикаль 1080×1920 (Instagram cover_url, Telegram thumbnail) — "/uploads/covers/promo-<uuid>-cover.jpg".
  coverPath     String?
  /// Квадрат 1080×1080 (миниатюры Facebook и YouTube) — "/uploads/covers/promo-<uuid>-square.jpg".
  coverSquarePath String?

  /// Чем нарисована обложка режима AI: { provider, usedFrame, usedTrends } (packages/shared SocialVideoCoverMeta).
  coverMeta     Json?
  /// Адреса «канал + аккаунт»: [{ channel, accountId|null }] (12.10.2026, выбор аккаунта: два Instagram, несколько
  /// Telegram). null — ролик до этой правки: адреса выводятся из `channels` с аккаунтом по умолчанию.
  destinations  Json?
  /// SHA-256 загруженного файла (до перепаковки) - по нему находим «этот файл уже загружали» (12.10.2026).
  contentHash   String?
  /// Выбранные каналы: INSTAGRAM | FACEBOOK | YOUTUBE | TIKTOK | TELEGRAM | THREADS.
  channels      String[]  @default([])
  /// DRAFT | SCHEDULED | PUBLISHING | DONE | PARTIAL | FAILED | REMOVED (packages/shared/src/socialVideo.ts).
  status        String    @default("DRAFT")
  scheduledAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?

  /// Исход по каждому каналу: { INSTAGRAM: { state, error, note, postId, url, retriable,
  /// attempts, startedAt, finishedAt }, ... } — то, что показывает экран «процесса».
  channelResults Json?
  /// Где ролик уже висит (как Property.publishedChannels) и id постов/служебные метки.
  publishedChannels String[] @default([])
  publishedPostIds  Json?
  /// Ссылка на пост Instagram (permalink приходит от площадки при публикации).
  instagramUrl  String?

  createdById   String?
  createdBy     Agent?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([status, scheduledAt])
  @@index([deletedAt, createdAt])
  @@index([contentHash])
}

model CustomerPublicEffect {
  id                String   @id
  sourceId          String
  sourceRevision    BigInt
  sourceHash        String
  endpointScopeId   String
  policyRevision    BigInt
  agentRevisionId   String
  authorKey         String
  dayKey            String
  kind              String
  category          String
  payloadEncrypted  String?
  payloadHash       String
  status            String   @default("IN_FLIGHT")
  providerId        String?
  recipientKey      String?
  outcomeReason     String?
  createdAt         DateTime @default(now())
  finishedAt        DateTime?

  @@unique([sourceId, kind], map: "CustomerPublicEffect_source_kind")
  @@index([endpointScopeId, authorKey, createdAt])
  @@index([recipientKey, createdAt])
}

model CustomerAgentRolloutAssignment {
  id String @id @default(uuid())
  cohortId String?
  surface String
  endpointScopeId String
  endpointScope CustomerEndpointScope @relation(fields:[endpointScopeId],references:[id],onDelete:Cascade,onUpdate:Restrict)
  subjectKey String
  bucketBps Int?
  lane String
  candidateRevisionId String?
  candidateRevision CustomerAgentRevision? @relation(fields:[candidateRevisionId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  createdAt DateTime @default(now())
  /// Append-only lane generation (31.10.2026, owner: move old LEGACY clients to the core).
  /// 0 = original enrollment; 1 = CORE row superseding the LEGACY row. Effective lane = max generation.
  generation Int @default(0)
  supersedesAssignmentId String? @unique
  supersedesAssignment CustomerAgentRolloutAssignment? @relation("CustomerAgentLaneCutover", fields:[supersedesAssignmentId], references:[id], onDelete:Restrict, onUpdate:Restrict)
  supersededBy CustomerAgentRolloutAssignment? @relation("CustomerAgentLaneCutover")
  transitionReason String?
  ingressTickets CustomerPropertyIngressTicket[]
  metaComments InstagramComment[]
  telegramComments TelegramGroupComment[]
  @@unique([surface,endpointScopeId,subjectKey,generation],map:"CustomerAgentRolloutAssignment_subject_generation_key")
  @@index([cohortId])
}

/// Shared short admission lock; never held across an external HTTP call.
model CustomerLegacyPhysicalFence {
  id String @id
}

/// Foundation reservation only. No producer/controller activation is implied.
model CustomerLegacyPhysicalQuiescence {
  endpointScopeId String @id
  endpointScope CustomerEndpointScope @relation(fields: [endpointScopeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scopeRevision BigInt
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz
}

/// Physical evidence retained across account removal, with no customer content.
model CustomerLegacyPhysicalAttempt {
  id String @id
  endpointScopeId String?
  scopeRevision BigInt?
  channel String?
  surface String?
  targetDigest String
  payloadDigest String
  operation String
  effectKey String?
  sourceHash String?
  actorKind String
  actorId String?
  status String
  providerId String?
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz
  finishedAt DateTime? @db.Timestamptz
  @@index([status, endpointScopeId], map: "CustomerLegacyPhysicalAttempt_idle")
  @@index([endpointScopeId, sourceHash])
}

/// Genuine staff recruitment command/outbound ledger. Never a fabricated BOT turn.
/// PREVIEW/QUEUED are local state; ACCEPTED requires provider receipt, DELIVERED a delivery callback.
model RecruitmentCommunication {
  id String @id
  previewId String
  jobApplicationId String
  actorId String
  purpose String
  channel String
  status String @default("PREVIEW")
  previewHash String
  snapshotJson Json
  expiresAt DateTime
  idempotencyKey String?
  effectKey String? @unique
  providerReceipt String?
  providerStatus String?
  reason String?
  resultJson Json?
  attemptStartedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([previewId, channel])
  @@unique([actorId, idempotencyKey, channel])
  @@index([jobApplicationId, createdAt])
  @@index([status, createdAt])
  @@index([providerReceipt])
}

/// Durable webhook inbox: a receipt may arrive before the POST response.
model RecruitmentSmsReceipt {
  providerId String @id
  status String
  occurredAt DateTime
  receivedAt DateTime @default(now())
}

/// «Принято» руководителем по красному флагу «Контроля» (23.10.2026). Сам флаг
/// вычисляется на лету и нигде не хранится; здесь только отметка, что директор его
/// увидел. Ключ (sliceKey, subjectId) уникален — повторное «принято» не плодит строк.
model OversightAck {
  id        String   @id @default(uuid())
  sliceKey  String
  subjectId String
  ackedById String
  ackedBy   Agent    @relation(fields: [ackedById], references: [id])
  ackedAt   DateTime @default(now())
  note      String?  @db.VarChar(500)

  @@unique([sliceKey, subjectId])
  @@index([ackedById])
}

enum ReelAutoBoostStatus {
  /// Пробный режим решил создать объявление (в Meta ничего не ушло) либо боевой
  /// режим ещё не успел его создать.
  PLANNED
  ACTIVE
  PAUSED
  FAILED
  /// Осознанно не продвигаем (Meta считает публикацию непригодной для продвижения).
  SKIPPED
}

/// Журнал автопродвижения роликов (23.10.2026, lib/ads/reelsAutoBoost.ts). Одна строка
/// = одна публикация Instagram: instagramMediaId уникален, поэтому один ролик не станет
/// двумя объявлениями ни при повторе тика, ни при перезапуске. Строка не удаляется —
/// это история решений (PAUSED/SKIPPED остаются и не дают создать объявление заново).
model ReelAutoBoostAd {
  id               String              @id @default(uuid())
  propertyId       String
  property         Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  instagramMediaId String              @unique
  /// Объявление и креатив в Meta; пусты, пока ничего не создано (пробный режим).
  metaAdId         String?
  metaCreativeId   String?
  status           ReelAutoBoostStatus @default(PLANNED)
  /// Человеческая причина последнего решения, по-русски.
  reason           String              @db.VarChar(500)
  /// Расход и начатые переписки по данным Meta на момент lastCheckedAt.
  /// Расход — в валюте кабинета (боевой режим требует USD, иначе стоп-лосс врал бы).
  spendUsd         Decimal?            @db.Decimal(12, 2)
  conversations    Int?
  /// Сколько раз пытались создать объявление (FAILED повторяется не чаще раза в 6 часов, до 3 раз).
  attempts         Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  lastCheckedAt    DateTime?

  @@index([status, createdAt])
  @@index([propertyId])
}


/// Private investigation workspace; signals never equal a finding of guilt.
model InvestigationCase {
  assignmentAt DateTime?
  assignmentEpochKey String?
  id String @id @default(uuid())
  caseKey String @unique
  clientId String?
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  propertyId String?
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  showingId String?
  subjectAgentId String?
  subjectAgent Agent? @relation("InvestigationSubject", fields: [subjectAgentId], references: [id], onDelete: SetNull)
  title String
  source String
  status String @default("OPEN")
  level String @default("C1")
  revision Int @default(0)
  firstOccurredAt DateTime
  lastSignalAt DateTime
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  evidence InvestigationEvidence[]
  decisions InvestigationDecision[]
  @@index([status, lastSignalAt])
  @@index([clientId, propertyId])
  @@index([subjectAgentId, lastSignalAt])
}

model InvestigationEvidence {
  id String @id @default(uuid())
  caseId String
  case InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sourceType String
  sourceId String
  independenceKey String
  kind String
  summary String
  payload Json?
  occurredAt DateTime
  createdAt DateTime @default(now())
  @@unique([caseId, sourceType, sourceId, kind])
  @@index([caseId, occurredAt])
}

model InvestigationDecision {
  level String @default("C1")
  id String @id @default(uuid())
  caseId String
  case InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestKey String @unique
  actorId String
  action String
  note String
  previousStatus String
  newStatus String
  caseRevision Int
  createdAt DateTime @default(now())
  @@index([caseId, createdAt])
}

