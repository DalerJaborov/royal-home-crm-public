  deletedAt   DateTime?
  deletedById String?
  deletedBy   Agent?    @relation("DeletedByClientAgent", fields: [deletedById], references: [id])

  /// РЕАКТИВАЦИЯ К ПРЕЖНЕМУ АГЕНТУ (разбор 31.08.2026, п.12, решение владельца
  /// после того, как он отложил вопрос 12.08.2026 — см. lastAgentId в services/leads/intake.ts).
  /// Кто вёл карточку последним перед тем, как она стала Неактивной или ушла в
