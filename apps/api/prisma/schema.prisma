  duplicateReviewOfClientId   String?
  duplicateReviewOfClient     Client?   @relation("ClientDuplicateReview", fields: [duplicateReviewOfClientId], references: [id], onDelete: SetNull)
  /// Обратная сторона self-relation выше — карточки, которые сочли похожими НА эту.
  duplicateReviewCandidateOf  Client[]  @relation("ClientDuplicateReview")
  /// Кого спросили «это ваш клиент?» — агент, за которым закреплена карточка-кандидат
  /// (duplicateReviewOfClientId), а НЕ агент этой (новой) карточки — своей у неё пока нет.
  duplicateReviewAskedAgentId String?
  duplicateReviewAskedAgent   Agent?    @relation("DuplicateReviewAskedAgent", fields: [duplicateReviewAskedAgentId], references: [id], onDelete: SetNull)
  duplicateReviewAskedAt      DateTime?
  /// Не ответил за Settings.duplicateReviewTimeoutHours — заявка уходит в обычную
  /// раздачу как отдельный человек, пара остаётся видна в «На слияние» (история).
  duplicateReviewDueAt        DateTime?
  /// Чем совпало: "NAME_AND_PHONE_TAIL" (сегодня единственный источник) — для
  /// отображения причины в интерфейсе, не для логики.
  duplicateReviewMatchedBy    String?

  /// Ник в соцсети (@nozil760, raxxmanzadee) — узнаваем и уникален, поэтому по нему
  /// удобно искать. В fullName его не пускаем: там должно стоять человеческое имя
  /// либо заглушка. Наружу отдаётся ТОЛЬКО по праву clients.viewOrigin — агенту
  /// происхождение лида не показываем (см. lib/clientOrigin.ts).
  socialUsername String?
  /// Из какой сети ник: INSTAGRAM | TELEGRAM | FACEBOOK | WHATSAPP.
  socialChannel  String?

  /// Заявки агентов на удаление этой карточки (на рассмотрение руководства).
  deleteRequests ClientDeleteRequest[]
  /// Сколько объектов на продажу услышал ИИ из разговоров с этим продавцом —
  /// звонки (ai/callAnalysis.ts) и переписка ОТДЕЛЬНЫМ фоновым разбором каждого
  /// входящего сообщения (ai/chatPropertyCount.ts), а не живой мозг бота
  /// (ai/leadQualifier.ts) — трогать его схему слишком рискованно для ответа
  /// клиенту в реальном времени. Пишет ТОЛЬКО ИИ, агент не может исправить
  /// напрямую — только подать заявку на пересмотр (PropertyCountDispute), решает
  /// руководитель (владелец 06.09.2026, разбор слепых зон п.3: «не агент решает
  /// сколько у клиента объектов — ИИ сам понимает и вносит»). Каждое новое
  /// упоминание ЗАМЕНЯЕТ значение, а не складывается — та же логика, что у
  /// budgetMin/Max при уточнении бюджета.
  sellerDeclaredPropertyCount   Int?
  /// Когда именно ИИ впервые услышал текущее число — от этого момента, а не от
  /// встречи, считается срок до аларма «заявлено N, добавлено M»
  /// (lib/sellerNoPropertyAlarm.ts) — решение владельца 06.09.2026.
  sellerDeclaredPropertyCountAt DateTime?
  propertyCountDisputes         PropertyCountDispute[]
  /// Симметрично выше, но для ПОКУПАТЕЛЯ — сколько объектов он хочет купить
  /// (владелец 06.09.2026: «а если хочет купить несколько»). Тот же источник
  /// (звонки + фоновый разбор переписки), то же правило замены целиком, но пока
  /// БЕЗ отдельного аларма и без заявки на пересмотр — сравнивать «заявлено
  /// покупок / реально закрыто сделок» решает уже пункт 4 (per-объектный
  /// трекинг), это только сбор самого числа.
  buyerDesiredPropertyCount   Int?
  buyerDesiredPropertyCountAt DateTime?

  interactions                Interaction[]
  deals                       Deal[]
  /// Вопросы «как всё прошло» после закрытия сделки, где этот клиент — сторона
  /// (покупатель или продавец) — Пачка 11, 11.09.2026, см. DealReview.
  dealReviews                 DealReview[]
  /// Робозвонки после показа, где этот клиент — покупатель (13.09.2026).
  postShowingCalls            PostShowingCall[]
  /// Звонки этому клиенту как СОБСТВЕННИКУ показанного объекта (16.09.2026).
  sellerProbeCalls            SellerProbeCall[]       @relation("SellerProbeSeller")
  /// Накопленные факты об объекте продавца (lib/sellerFacts.ts) — 1:1, отдельной таблицей.
  sellerObjectFacts           SellerObjectFacts?
  telegramConversation        TelegramConversation?
  /// НЕСКОЛЬКО ДИАЛОГОВ НА КАРТОЧКУ (владелец 19.08.2026) — раньше поле было
  /// одиночным (clientId был @unique у BotConversation), и если тот же человек
  /// писал в Instagram, потом звонил, попросили написать в WhatsApp — вторая
  /// переписка физически не могла привязаться к той же карточке: у CRM уже
  /// была одна. Звонки (Interaction) такого ограничения никогда не имели —
  /// теперь и переписка по разным каналам ведёт себя так же: сколько угодно
  /// диалогов, все видны на одной карточке.
  botConversation             BotConversation[]
  telegramDirectConversations TelegramDirectConversation[]
  cardSuggestions             CardSuggestion[]
  incomingCalls               IncomingCall[]
  contactProfiles             ContactProfile[]
  jobApplications             JobApplication[]
  /// Озвученные подсказки о клиенте, лежащие на станции (см. CallWhisper).
  callWhispers                CallWhisper[]
  /// Какие объекты бот показывал этому клиенту (в т.ч. до появления карточки —
  /// такие записи привязываются сюда задним числом при создании лида).
  propertyExposures           PropertyExposure[]
  shareLinks                  PropertyShareLink[]
  /// Несколько желаемых мест поиска (владелец 12.09.2026, docs/geo-match-plan-12-09.md):
  /// покупатель в разговоре часто называет два-три места сразу («ищу у ЦУМа или в
  /// 82-м микрорайоне») — одна точка с радиусом это не покрывает. Фундамент под
  /// гео-подбор объектов (сам подбор делает другой блок, здесь только хранение).
  desiredPlaces                ClientDesiredPlace[]

  @@index([assignedAgentId])
  @@index([assignedAgentId, agentAttentionRequestedAt])
  @@index([status])
  @@index([desiredDistrictId])
  @@index([aiScore])
  @@index([createdAt])
  /// Счётчики разделов (routes/dashboard.ts) на каждый тик считают «сколько
  /// нового с прошлого захода» условием `OR: [createdAt > seen, assignedAt >
  /// seen]`. По `createdAt` индекс был, по `assignedAt` — нет вовсе, и на OR
  /// из двух колонок, одна из которых неиндексирована, планировщик уходит в
  /// полный перебор таблицы Client — дважды на каждый вызов (покупатели и
  /// продавцы). А это самый частый роут в системе. Добавлено 19.09.2026.
  @@index([assignedAt])
  @@index([reactivationOfferedToAgentId])
  @@index([acceptedAt])
  @@index([escalatedAt])
  @@index([deletedAt])
  @@index([whatsappPhone])
  /// Триграммный поиск по подстроке телефона (20260914140100_client_phone_trgm_search) —
  /// индексы созданы сырым SQL (GIN/gin_trgm_ops недоступен через обычный @@index),
  /// но начиная с Prisma 7.10 расширенный синтаксис индекса объявляет их декларативно
  /// без preview-флагов (тот же приём для GeoAlias.normalized, schema.prisma:1461).
  /// Имена в map: должны совпадать байт в байт с именами в миграции — иначе
  /// `migrate dev` предложит DROP старого + CREATE нового вместо признания «свой».
  /// Пересоздавать эти индексы физическим DROP+CREATE нельзя: построение GIN
  /// на живой таблице Client надолго блокирует её (замечено при разборе дрейфа
  /// 13-14.09.2026, см. миграции property_deal_version_lock и agent_must_change_password).
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Client_phone_trgm_idx")
  @@index([whatsappPhone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Client_whatsappPhone_trgm_idx")
  /// Тот же приём для fullName (20260805160000_pg_trgm_fuzzy_search). В отличие
  /// от phone/whatsappPhone выше, этот индекс ФИЗИЧЕСКИ ОТСУТСТВОВАЛ в базе —
  /// миграция 20260812071550_call_analysis_draft (12.08.2026) его снесла, и месяц
  /// поиск по имени клиента шёл полным перебором, пока не заметили 14.09.2026
  /// (psql на проде). Миграция 20260914080510_restore_lost_fuzzy_search_trgm_indexes
  /// его восстанавливает — здесь объявление закрывает дрейф уже ПОСЛЕ восстановления.
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Client_fullName_trgm_idx")
  /// Ночной автостатус (lib/clientAutoStatus.ts) отбирает покупателей по kind и
  /// сортирует по давности контакта — без составного индекса это полный проход по
  /// всем клиентам каждую ночь (аудит 09.08.2026).
  @@index([kind, lastContactAt])
  /// Светофор неактивных (lib/inactiveTrafficLight.ts) каждый тик отбирает по
  /// workStatus+inactiveLevel, кому пора напоминание — без составного индекса это
  /// полный проход по всем клиентам агентства на каждом тике.
  @@index([workStatus, inactiveLevel, inactiveSince])
  /// Таймер возврата (leads.ts::reassignStaleReturns) отбирает по сроку — без
  /// индекса каждый тик читал бы всю таблицу ради единиц строк с таймером.
  @@index([returnAcceptDueAt])
  /// Таймер проверки дублей (lib/duplicateReview.ts::sweepExpiredDuplicateReviews) —
  /// тот же довод, что у returnAcceptDueAt выше.
  @@index([duplicateReviewDueAt])
  /// Крон автовозврата «Отложенных» (lib/deferredClients.ts) каждый тик отбирает
  /// по workStatus=DEFERRED + deferredUntil<=now — без составного индекса это
  /// полный проход по всей таблице клиентов на каждом тике.
  @@index([workStatus, deferredUntil])
}

/// Желаемое место поиска покупателя — координата с радиусом (владелец 12.09.2026,
/// docs/geo-match-plan-12-09.md): фундамент под гео-подбор объектов, который будет
/// искать в радиусе от этой точки (сам подбор делает другой блок — lib/propertyMatchFilter.ts
/// и routes/matching.ts, этот файл не трогать). Один-ко-многим, а не поля на Client:
/// покупатель часто называет два-три места сразу («ищу у ЦУМа или в 82-м микрорайоне»),
/// и одна точка с радиусом этого не покрывает. Стиль пары «родитель → дети» —
/// как у PropertyDraft/PropertyDraftMedia выше: свой @@index на внешний ключ,
/// каскадное удаление вместе с карточкой клиента.
model ClientDesiredPlace {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lat       Decimal
  lng       Decimal
  /// Радиус поиска вокруг точки, метры. По умолчанию 1000 — то же значение,
  /// что подставляет форма редактирования клиента при добавлении места.
  radiusM   Int      @default(1000)
  /// Как назвал место клиент или агент («ЦУМ», «82-й микрорайон») — чтобы в
  /// карточке было видно название, а не «точка №2». Позже сюда добавится ссылка
  /// на справочник ориентиров — сейчас просто текст.
  label     String?
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([lat, lng])
}

/// Состояние диалога Telegram-бота приёма заявок: история сообщений для контекста Claude
/// и черновик данных лида, накапливаемый по ходу разговора. Один чат = одна запись.
model TelegramConversation {
  id            String    @id @default(uuid())
  endpointScopeId String?
  endpointScope CustomerEndpointScope? @relation(fields: [endpointScopeId], references: [id], onDelete: Restrict)
  customerInquiry CustomerInquiry?
  chatId        String    @unique
  /// Досье собеседника (21.09.2026). Заводится на первом же входящем, до всякой
  /// карточки клиента, — именно оно и есть «карточка на каждого написавшего».
  contactProfileId String?
  contactProfile   ContactProfile? @relation(fields: [contactProfileId], references: [id], onDelete: SetNull)
  username      String?
  /// Тот же счётчик просьб номера, что у BotConversation (Telegram идёт своим
  /// путём сборки ответа — telegram/bot.ts и messengers/telegramDirectMessages.ts).
  /// Предел, подключённый не во всех каналах, — известный класс поломок этого
  /// репозитория, поэтому колонка добавлена сразу обеим таблицам.
  phoneAsksSent Int       @default(0)
  /// [{role:"user"|"assistant", content:"..."}]
  messages      Json      @default("[]")
  /// {budgetMin?, budgetMax?, districtId?, type?, rooms?, notes?} — заполняется по мере диалога.
  leadDraft     Json?
  clientId      String?   @unique
  client        Client?   @relation(fields: [clientId], references: [id])
  /// Момент последнего входящего сообщения — для сортировки и «непрочитано» в инбоксе.
  lastMessageAt DateTime?
  /// Когда руководитель последний раз открывал диалог в инбоксе «Сообщения» —
  /// по нему считается индикатор «непрочитано» (lastMessageAt > readAt).
  readAt        DateTime?
  /// Оператор взял диалог на себя — бот молчит до этого момента (как в BotConversation).
  pausedUntil   DateTime?
  /// С какого момента началась текущая пауза — см. одноимённое поле BotConversation
  /// (шаг 5 переноса, 10.09.2026): та же логика записи и то же назначение (список
  /// «бот на паузе больше суток» в инбоксе «Чаты»).
  botPausedAt   DateTime?
  /// См. одноимённое поле BotConversation — Пачка 17, 12.09.2026, lib/botPauseWatch.ts.
  pauseAlertSentAt DateTime?
  /// Склейка быстрых сообщений (01.10.2026, находка №132) — тот же буфер окна
  /// ожидания, что у BotConversation (messengers/debounceBuffer.ts). Каждое
  /// сообщение в переписку ложится сразу, а сюда — его текст для общего хода:
  /// три сообщения подряд получают один ответ бота, а не три.
  pendingMessages    Json      @default("[]")
  /// Отметки доставок пачки ({ voice } — было ли голосовое: от него зависит
  /// голосовой ответ). Сами снимки ждут в памяти процесса, см. telegram/bot.ts.
  pendingAttachments Json      @default("[]")
  /// Начало текущей пачки — от него считается потолок ожидания (botReplyMaxWaitSec).
  pendingSince       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// То же, что у BotConversation: инбокс сортирует по этой колонке, кроны по ней
  /// отбирают — индекса не было (аудит 09.08.2026).
  @@index([lastMessageAt])
  @@index([contactProfileId])
  @@index([endpointScopeId])
}

/// Direct Messages канала (01.09.2026, t.me/<канал>?direct) — НЕ то же самое,
/// что TelegramConversation (личка с ботом). Все, кто пишет каналу напрямую,
/// делят ОДИН И ТОТ ЖЕ chat.id (сам канал/его DM-инбокс), Telegram различает
/// отправителей только через direct_messages_topic.topic_id (проверено вживую
/// getUpdates 01.09.2026). Поэтому ключ диалога — ПАРА (chatId, topicId), как
/// у BotConversation (@@unique([channel, subscriberId])), а не голый chatId,
/// как у TelegramConversation — там это был бы риск склеить разных клиентов.
model TelegramDirectConversation {
  id            String    @id @default(uuid())
  endpointScopeId String?
  endpointScope CustomerEndpointScope? @relation(fields: [endpointScopeId], references: [id], onDelete: Restrict)
  customerInquiry CustomerInquiry?
  /// Тот же счётчик просьб номера, что у BotConversation и TelegramConversation:
  /// у этого канала своя таблица и своя обрезка истории до 40 реплик
  /// (messengers/telegramDirectMessages.ts), значит и терял он счёт так же.
  phoneAsksSent Int       @default(0)
  /// chat.id инбокса Direct Messages (общий для всех отправителей).
  chatId        String
  /// Досье собеседника (21.09.2026). Заводится на первом же входящем, до всякой
  /// карточки клиента, — именно оно и есть «карточка на каждого написавшего».
  contactProfileId String?
  contactProfile   ContactProfile? @relation(fields: [contactProfileId], references: [id], onDelete: SetNull)
  /// direct_messages_topic.topic_id — ключ конкретного отправителя.
  topicId       String
  /// direct_messages_topic.user.id — для справки, сам ключ диалога — topicId.
  fromUserId    String?
  username      String?
  /// [{role:"user"|"assistant", content:"..."}]
  messages      Json      @default("[]")
  leadDraft     Json?
  /// НЕ уникален (как у BotConversation, не как у TelegramConversation) —
  /// канал новый, до конца не изученный вживую, безопаснее не запирать 1:1.
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id])
  lastMessageAt DateTime?
  readAt        DateTime?
  /// Оператор взял диалог на себя — бот молчит, тот же принцип, что у
  /// TelegramConversation/BotConversation.
  pausedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([chatId, topicId])
  @@unique([endpointScopeId, chatId, topicId])
  @@index([lastMessageAt])
  @@index([clientId])
  @@index([contactProfileId])
}

/// Диалог мессенджер-бота (Instagram/Facebook/WhatsApp через бот-платформу). Тот же
/// принцип, что TelegramConversation, но ключ — канал + ID подписчика: один
/// эндпоинт обслуживает несколько соцсетей. Хранит историю сообщений (контекст
/// для Claude) и черновик лида, пока не собран телефон и не создан клиент.
/// АККАУНТ МЕССЕНДЖЕРА — один подключённый Instagram/WhatsApp/Facebook.
///
/// Появился 15.08.2026: до него CRM держала РОВНО ОДИН аккаунт на канал
/// (одиночные поля metaIgToken и подобные в Settings), и второй Instagram
/// подключить было некуда — входящее разбиралось без учёта получателя, а ответ
/// всегда уходил единственным маркером. Агентству понадобился второй аккаунт
/// (Royal Home Info: советы, чек-листы, вакансии), и это перестало быть
/// настройкой — стало моделью.
///
/// Ключ маршрутизации — externalId: для Instagram и Facebook это id из
/// entry[].id вебхука Meta, для WhatsApp — phone_number_id. Именно по нему
/// входящее сообщение находит свой аккаунт, а ответ уходит его маркером.
/// @@ Аккаунт мессенджера, от имени которого мы переписываемся.
model MessengerAccount {
  id               String   @id @default(uuid())
  customerEndpointScopes CustomerEndpointScope[]
  /// INSTAGRAM | FACEBOOK | WHATSAPP — тот же справочник, что у диалогов.
  channel          String
  /// Идентификатор аккаунта у Meta: entry[].id (IG/FB) либо phone_number_id (WA).
  externalId       String
  /// Как аккаунт называется для сотрудников: «Royal Home», «Royal Home Info».
  title            String
  /// Секрет приложения Meta, под которым живёт ЭТОТ аккаунт. Хранится зашифрованным
  /// (crypto.ts), как и token. Пусто — подпись вебхука сверяется общими секретами
  /// из Settings (metaAppSecret / metaIgAppSecret), то есть прежнее поведение.
  ///
  /// Зачем: до 30.08.2026 секрет был только глобальный, и аккаунт, заведённый под
  /// ДРУГИМ приложением Meta, получал 403 на весь вебхук ещё до разбора тела — без
  /// единого следа в CRM. Главный подозреваемый в девятидневной тишине «Royal Home Info».
  appSecret        String?
  /// ВТОРОЙ идентификатор того же аккаунта Instagram.
  ///
  /// У аккаунта их два, и Meta шлёт РАЗНЫЕ в разных событиях: в комментариях
  /// приходит `user_id` (17841…, он же externalId), в личных сообщениях — `id`
  /// (369…, 374…). 17.08.2026 на этом встала воронка: сообщения второго аккаунта
  /// не находили получателя, CRM отвечала маркером аккаунта по умолчанию, и Meta
  /// на каждый вызов отвечала «The requested user cannot be found» — со стороны
  /// «файл не приходит, сколько ни подписывайся».
  ///
  /// Заполняется само при сверке с Meta (см. accounts.ts).
  messagingId      String?
  /// Ник аккаунта в Instagram без «@»: royal.home.tj, royalhome.info.
  ///
  /// Нужен ровно для одного: узнать САМИХ СЕБЯ во входящем. 16.08.2026 наши два
  /// аккаунта написали друг другу и вежливо здоровались по кругу, пока владелец
  /// не поставил оба диалога на паузу. Сверить по externalId нельзя: у Instagram
  /// два разных вида идентификаторов, и отправитель приходит как IGSID, не
  /// совпадающий с id аккаунта. Ник — единственное, что совпадает.
  ///
  /// Заполняется само при сверке аккаунтов с Meta (см. accounts.ts).
  username         String?
  /// ТРЕТИЙ (и далее) идентификатор получателя — вводится ВРУЧНУЮ, не сверкой.
  ///
  /// ЗАЧЕМ. 21–22.08.2026 «Royal Home Info» девять дней отвечался маркером
  /// «Royal Home»: во входящих был получатель 873975375804470 — ЧИСЛО, НЕ
  /// РАВНОЕ ни externalId (user_id), ни messagingId (id из области приложения).
  /// reconcileInstagramAccountIds честно спрашивал Meta «чей это маркер» шесть
  /// раз (видно по ErrorLog) и оба раза получал верный ответ — но ответ на
  /// `GET /me?fields=id,user_id,username` СТРУКТУРНО не может вернуть больше
  /// двух идентификаторов, а этот получатель — не из их числа: скорее всего
  /// это ID связанной Страницы Facebook (аккаунт заведён через Facebook Login
  /// for Business до перехода этого файла на Instagram Login, см. meta.ts,
  /// GRAPH_INSTAGRAM_ORIGIN), а такой ID у Instagram-маркера через
  /// graph.instagram.com узнать НЕЧЕМ — его не отдаёт ни один вызов с этим
  /// токеном. Самопочинка здесь бессильна принципиально, не по недосмотру.
  ///
  /// Поэтому третий (и любой следующий) идентификатор такого рода добавляется
  /// человеком в Настройках → Каналы, когда встретится ошибка «неизвестный
  /// получатель» — ровно как эта. Список, а не одно поле: не гарантировано,
  /// что сюрпризов не будет ещё.
  extraExternalIds String[] @default([])
  /// Маркер доступа, зашифрован тем же способом, что ключи в Settings.
  token            String
  /// Выключенный аккаунт не отвечает и не принимает — но диалоги и история целы.
  enabled          Boolean  @default(true)
  /// Аккаунт по умолчанию канала: им отвечаем на входящее, чей получатель не
  /// опознан (старые диалоги, ручная отправка). Ровно один на канал.
  isDefault        Boolean  @default(false)
  /// СВОЯ «ЛИЧНОСТЬ» БОТА для этого аккаунта — роль, цель, тон, образцы фраз.
  ///
  /// Пусто (обычный случай) — берётся общая из Настроек → Бот, то есть ровно
  /// прежнее поведение. Заполнено — ЗАМЕНЯЕТ её для диалогов этого аккаунта.
  ///
  /// Заменяется ТОЛЬКО личность. Обязательные правила (BOT_CORE_RULES, география,
  /// условия сделки) приклеиваются поверх всегда и отсюда не вытесняются — иначе
  /// свой промт у второго аккаунта отменял бы запрет выдумывать объекты.
  ///
  /// Появилось 15.08.2026: Royal Home Info ведёт советы, чек-листы и вакансии, а
  /// основной аккаунт продаёт — один промт на оба означал, что подписчик Info
  /// получает продающие вопросы там, где просил чек-лист.
  systemPrompt     String?
  /// Когда маркер ЭТОЙ строки последний раз продлён (refreshInstagramTokenIfDue,
  /// instagramFeed.ts). До 14.09.2026 продлевалась только копия в Settings.metaIgToken,
  /// которой входящие сообщения не пользуются вовсе (см. meta.ts/loadCredentials,
  /// accounts.ts/resolveIncomingAccount) — маркеры аккаунтов умирали молча, а
  /// «Royal Home Info» копии в Settings не имел вообще и был обречён гарантированно.
  /// Пусто — ещё ни разу не продлевался этим кодом; тогда за точку отсчёта берётся
  /// `updatedAt`, чтобы только что заведённый аккаунт не продлевался в ту же секунду.
  tokenRefreshedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  conversations BotConversation[]
  leadMagnets   LeadMagnetCampaign[]

  @@unique([channel, externalId])
  @@index([channel, enabled])
}

model BotConversation {
  recruitmentRecoveries RecruitmentRecovery[]
  id                 String            @id @default(uuid())
  /// Gate A keeps the legacy global unique; scoped cutover is a later release.
  endpointScopeId String?
  endpointScope CustomerEndpointScope? @relation(fields: [endpointScopeId], references: [id], onDelete: Restrict)
  customerInquiry CustomerInquiry?
  /// "INSTAGRAM" | "FACEBOOK" | "WHATSAPP" — из какого канала пришёл диалог.
  channel            String
  /// Досье собеседника (21.09.2026). Заводится на первом же входящем, до всякой
  /// карточки клиента, — именно оно и есть «карточка на каждого написавшего».
  contactProfileId String?
  contactProfile   ContactProfile? @relation(fields: [contactProfileId], references: [id], onDelete: SetNull)
  /// ID подписчика у бот-платформы (contact id) — стабилен в пределах канала.
  subscriberId       String
  /// В какой НАШ аккаунт написал человек. null — диалог из времён одного
  /// аккаунта на канал: такому отвечаем аккаунтом по умолчанию.
  accountId          String?
  account            MessengerAccount? @relation(fields: [accountId], references: [id])
  name               String?
  /// [{role:"user"|"assistant", content:"..."}]
  messages           Json              @default("[]")
  /// {stage, budgetMin?, budgetMax?, districtName?, type?, rooms?, notes?} — копится по ходу диалога.
  leadDraft          Json?
  /// Server-owned current property, independent of first advertising attribution.
  customerPropertyFocus Json?
  customerPropertyFocusRevision Int @default(0)
  propertyIngressTickets CustomerPropertyIngressTicket[]
  customerOutboxParts CustomerOutboxPart[]
  /// Буфер текстов, накопленных за окно дебаунса (DEBOUNCE_MS) — несколько
  /// быстрых сообщений подряд склеиваются в один ход ИИ вместо нескольких ответов.
  pendingMessages    Json              @default("[]")
  /// Вложения той же пачки: адреса файлов, которые клиент прислал, пока копилось
  /// окно. Раньше их не было, и ход С КАРТИНКОЙ не мог ждать в общем буфере (там
  /// лежали только строки) — он отвечал сразу. Человек присылает скриншот, через
  /// двадцать секунд дописывает вопрос, и получал ДВА ответа: один про картинку,
  /// второй про вопрос, оба с приветствием. Теперь ждут и картинки: победитель
  /// окна забирает и текст, и вложения и отвечает один раз на всё сразу.
  pendingAttachments Json              @default("[]")
  /// Момент последнего зарегистрированного входящего сообщения — по нему обработчик
  /// понимает, остался ли он «последним» после ожидания дебаунса, или его опередили.
  lastMessageAt      DateTime?
  /// Когда пришло ПЕРВОЕ сообщение текущей пачки. Пауза перед ответом продлевается,
  /// пока клиент дописывает, но не дольше потолка от этого момента — иначе человек,
  /// пишущий каждые 20 секунд, откладывал бы ответ бесконечно.
  pendingSince       DateTime?
  /// Сколько напоминаний бот уже отправил на текущее молчание клиента (0-3).
  /// Обнуляется, как только клиент написал сам, — по требованию владельца
  /// «ответил хотя бы раз → все запланированные напоминания отменяются».
  followUpsSent      Int               @default(0)
  /// Сколько раз бот УЖЕ просил у клиента номер за весь разговор.
  ///
  /// Счётчик в колонке, а не подсчёт по ленте: хранимая лента обрезана до
  /// MAX_STORED_MESSAGES (40, см. messengers/appendMessages.ts), и в длинном
  /// разговоре самые ранние просьбы из неё ВЫПАДАЮТ. Подсчёт по ленте тогда
  /// снова опускался ниже MAX_PHONE_ASKS, и бот принимался просить номер
  /// заново — ровно та навязчивость, против которой предел и поставлен
  /// (владелец 30.08.2026). Найдено разбором 775 живых переписок 20.09.2026.
  ///
  /// Только растёт и никогда не обнуляется: «уже спрашивали три раза» —
  /// свойство всего разговора, а не последних сорока реплик. Читается вместе с
  /// подсчётом по ленте, берётся большее из двух, — поэтому у разговоров,
  /// начатых до появления колонки, поведение не меняется (см.
  /// ai/replyRepeatGuard.ts, effectivePhoneAsks).
  phoneAsksSent      Int               @default(0)
  /// Клиент попросил не писать ему («не пишите», «отписаться»). Инициативных
  /// сообщений больше не шлём никогда; на прямое обращение по-прежнему отвечаем.
  optedOutAt         DateTime?
  /// Когда боту уже отправляли файл-гид «Перед покупкой квартиры» (см.
  /// lib/buyerGuide.ts). Один файл на разговор: второй такой же через день
  /// читается как рассылка. Отметка живёт в диалоге, а не в памяти процесса —
  /// разговор тянется сутками и переживает перезапуск контейнера.
  /// Сколько раз подряд боту пришлось отвечать «я только по квартирам».
  ///
  /// Требование владельца 17.08.2026: человек, который после двух таких ответов
  /// продолжает про футбол и устройство бота, разговаривать о жилье не намерен —
  /// бот замолкает совсем, пока собеседник не вернётся к делу. Обнуляется первым
  /// же сообщением про жильё (см. ai/offTopicGuard.ts).
  offTopicReplies    Int               @default(0)
  guideSentAt        DateTime?
  /// Файл попросили, но человек не подписан на нас: ждём подписки. На каждом
  /// следующем его сообщении проверяем заново и отдаём файл, как только появится
  /// (см. lib/buyerGuide.ts). Отметка снимается вместе с отправкой.
  guideAwaitFollowAt DateTime?
  /// Когда руководитель последний раз открывал диалог в инбоксе «Сообщения» —
  /// по нему считается индикатор «непрочитано» (lastMessageAt > readAt).
  readAt             DateTime?
  /// Когда сторож лидов (lib/phoneLeadWatchdog.ts) уже пробовал оформить заявку по
  /// номеру из этой переписки. ОДНА попытка на диалог, чем бы она ни кончилась.
  ///
  /// Авария 17.09.2026: сторож ходит каждые 15 минут по диалогам без карточки, а
  /// разговор о работе карточку не заводит в принципе (это анкета кандидата) —
  /// диалог оставался кандидатом ВЕЧНО, и каждый тик прогонял приём заново. То, что
  /// приём не завёл карточку, — не повод пробовать снова через 15 минут: причина не
  /// изменится сама. Не оформилось с первого раза — это уже вопрос к человеку, и он
  /// получает сигнал (см. leftForHuman там же).
  watchdogAttemptedAt DateTime?
  // Больше НЕ @unique (19.08.2026) — см. комментарий у Client.botConversation.
  // Индекс вместо уникальности: искали по clientId и раньше (найти диалог(и)
  // клиента), теперь просто может вернуть больше одной строки.
  clientId           String?
  client             Client?           @relation(fields: [clientId], references: [id])
  /// First live reply in an inquiry about an owned property claims the conversation.
  /// Keeps access while its new lead still awaits acceptance; never transfers a client.
  propertyChatAgentId String?
  propertyChatAgent   Agent? @relation("PropertyChatAgent", fields: [propertyChatAgentId], references: [id], onDelete: SetNull)
  propertyChatAgentAt DateTime?
  /// Оператор вручную взял диалог на себя (кнопка в CRM) — ИИ молчит (бот-платформа не
  /// отправляет ответ клиенту) до этого момента, чтобы не дублировать живого агента.
  /// null = бот отвечает как обычно.
  pausedUntil        DateTime?
  /// С какого момента НАЧАЛАСЬ текущая пауза (шаг 5 переноса, 10.09.2026) — pausedUntil
  /// хранит только конец, и список «бот на паузе больше суток» (инбокс «Чаты») посчитать
  /// было не из чего. Пишется в ТОТ ЖЕ момент, что и pausedUntil, везде, где ставится
  /// пауза (conversationDelivery.ts, routes/conversations.ts, routes/clients/lifecycle.ts,
  /// jobs/aiReplyRetry.ts, routes/webhooks.ts); снимается в null вместе со снятием паузы.
  /// Лучший результат, а не идеальный: повторная постановка паузы поверх уже активной
  /// (например, каждый новый ручной ответ) двигает «начало» вперёд — трактуется как
  /// «текущий», не «самый первый», эпизод паузы.
  botPausedAt        DateTime?
  /// Когда последний раз бот сам напомнил клиенту, что тот не ответил после
  /// ссылок на объекты (cron, см. cron.ts) — не даёт слать напоминание повторно
  /// на одно и то же молчание.
  reminderSentAt     DateTime?
  /// «БОТ НА ПАУЗЕ И ЗАБЫЛИ» (Пачка 17, 12.09.2026, lib/botPauseWatch.ts). Когда
  /// агенту в последний раз уходил пуш «клиент ждёт, бот на паузе». Прогон крона
  /// раз в час без этой отметки слал бы то же напоминание каждый час, пока агент
  /// сам не ответит, — отметка держит частоту не чаще раза в сутки на диалог.
  /// Снимается вместе с pausedUntil (новая пауза — новый отсчёт).
  pauseAlertSentAt   DateTime?
  /// Какая МАНЕРА ПРОДАЖИ досталась этому диалогу (код из ai/salesScenarios.ts).
  /// Выбирается случайно ОДИН раз при создании диалога и больше не меняется —
  /// иначе бот сменил бы характер посреди разговора, а исход было бы не к чему
  /// отнести. Случайно на диалог, а не «новый сценарий каждый день»: дни между
  /// собой несопоставимы (выходные, реклама, праздники), и разница манер утонула
  /// бы в разнице дней. null — диалог начался до появления сравнения.
  salesScenario      String?
  /// ─── БОТ ДЕРЖИТ ТЕМУ (решение владельца 11.08.2026) ───
