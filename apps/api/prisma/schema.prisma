  /// или отказался, ждать больше нечего.
  reactivationOfferedToAgentId String?
  reactivationOfferedToAgent   Agent?    @relation("ReactivationOfferAgent", fields: [reactivationOfferedToAgentId], references: [id], onDelete: SetNull)
  reactivationOfferedAt        DateTime?

  /// ─── ДУБЛИ ПРИ РАЗДАЧЕ, РАЗДЕЛ L (03.09.2026, план вечерней сессии) ───
  /// Эта карточка похожа на УЖЕ существующую (совпадение по имени + близкому,
  /// но не точному, номеру — точный номер склеивается уровнем 1 ещё до создания
  /// карточки, см. services/leads/intake.ts::createLeadFromChannel). Пока поле
  /// заполнено, карточка НЕ считается распределённой: assignedAgentId остаётся
