  /// меняет (запрет записи по роли в requireAuth); телефоны клиентов скрыты.
  SHAREHOLDER
  /// РОП (10.10.2026): работает как агент и управляет продажами; без денег
  /// компании и настроек. Лиды по лесенке не получает, назначается вручную.
  HEAD_OF_SALES
}

