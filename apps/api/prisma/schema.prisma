  botCanBookShowings                Boolean   @default(false)
  botCanConfirmShowings             Boolean   @default(true)
  botCanFollowUp                    Boolean   @default(true)
  botCanAnswerComments              Boolean   @default(true)
  /// ЕСТЬ ЛИ ДЕЖУРНЫЙ ОПЕРАТОР / КОЛЛ-ЦЕНТР (смысл уточнён 23.08.2026).
