model PropertyVideo {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Относительный путь файла в закрытом локальном хранилище (31.08.2026, до этого —
  /// ключ в Cloudflare R2, см. историю). Не публичный URL — доступ только через
  /// аутентифицированные роуты (GET .../download, .../file, .../archive.zip).
  storageKey   String
  filename     String
  sizeBytes    Int
  /// Тот же ключ повторной отправки, что и у PropertyPhoto.uploadKey — см. там.
  /// Для видео важнее вдвое: файл идёт минутами, и шанс потерять ответ выше.
  uploadKey    String?  @unique
  uploadedAt   DateTime @default(now())
  uploadedById String
  uploadedBy   Agent    @relation(fields: [uploadedById], references: [id])

  /// Факты сырого файла (23.09.2026, задание C — «звук/длительность/размеры»
  /// честно в CRM): объект №127 (IMG_8361.mov с iPhone) был БЕЗ звука уже при
  /// загрузке, и это не увидел никто — ни агент, ни модератор, ни монтажёр.
  /// Заполняются ffprobe'ом ПОСЛЕ ответа агенту (lib/rawVideoFacts.ts,
  /// routes/properties/videos.ts) — не задерживаем загрузку ради анализа
  /// файла. null — либо ещё не проверено, либо ffprobe недоступен/файл не
  /// читается; отличать эти два случая друг от друга полям незачем, вызывающий
  /// код везде и так тихо пропускает пустые факты. width/height — экранные
  /// (после поворота, если он есть в метаданных).
  hasAudio     Boolean?
  durationSec  Float?
  width        Int?
  height       Int?
  videoCodec   String?

  /// ДОСЫЛКА ПО file_id, НЕ ФАЙЛОМ (24.09.2026, аудит «монтажёр ↔ CRM ↔ соцсети»).
  /// file_id живёт в Telegram, пока жив бот сам (не привязан к чату/сообщению) —
  /// после первой успешной отправки этого конкретного файла повторная отправка
  /// (наблюдателю монтажа, сторожем досылки при повторе объекта, ручным «файлы»
  /// в боте) идёт строкой file_id через sendDocument (0 байт, ~1 с), а не
  /// повторным потоком с диска (sendDocumentFile — десятки-сотни МБ). Сброс
  /// передачи (queueVideoHandoff гасит videoHandoffDeliveredAt на Property) это
  /// поле НЕ трогает — сам файл в Telegram не поменялся, id остаётся годным.
  /// null — этот ролик ещё ни разу не ушёл ни одним получателем.
  telegramFileId       String?
  /// Второй идентификатор из того же ответа Bot API — не используется в коде,
  /// хранится на будущее (сверка «тот ли файл» без похода в Telegram).
  telegramFileUniqueId String?
  /// Когда file_id последний раз подтверждён успешной отправкой (первой или по
  /// file_id) — для отладки «кому что реально ушло», отдельно от самого id.
  telegramDeliveredAt  DateTime?
  /// ДОШЁЛ ЛИ ЭТОТ ФАЙЛ ДО МОНТАЖЁРА В ТЕКУЩЕМ КРУГЕ (25.09.2026, владелец: «если
  /// там 15, все 15 должен получить монтажёр»). `telegramDeliveredAt` выше — про
  /// сам файл у кого угодно (наблюдателю тоже), а эти два — про монтажёра: кому и
  /// когда. Гасятся, когда объект заново занимает место монтажёра
  /// (lib/videoHandoff.ts::resetMontajerDeliveryMarks) — новый круг, файлы снова
  /// все. По ним досылка сторожа и слово «файлы» шлют ТОЛЬКО недошедшее, а
  /// `Property.videoHandoffDeliveredAt` ставится, лишь когда отметка есть у всех.
  montajerDeliveredAt   DateTime?
  montajerDeliveredToId String?

  @@index([propertyId])
}

/// Приватная ссылка на объект для ОДНОГО клиента (docs/plan-18-08-private-listings-and-video.md
/// §4) — механизм, ради которого заведён offSite: агент делится найденным самим
/// объектом с конкретным человеком, а не через общий список/AI-подбор. Токен
/// привязан к паре (объект, клиент), а не к объекту в одиночку — чтобы разным
/// клиентам не путать ссылки и потом можно было посчитать, кому что реально
/// отправляли. clientId необязателен: агент может сгенерировать ссылку и
/// отправить её вручную человеку, ещё не заведённому карточкой в CRM.
model PropertyShareLink {
  id               String    @id @default(uuid())
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id])
  /// Длинный случайный токен (crypto.randomBytes, НЕ инкремент/uuid по порядку) —
  /// публичный роут GET /l/:token отдаёт по нему карточку без какой-либо
  /// аутентификации, безопасность держится только на неугадываемости строки.
  token            String    @unique
  createdByAgentId String
  createdByAgent   Agent     @relation(fields: [createdByAgentId], references: [id])
  createdAt        DateTime  @default(now())
  /// TTL по умолчанию 30 дней, настраивается при генерации. null — бессрочная ссылка.
  expiresAt        DateTime?
  /// Метка ПЕРВОГО открытия — «открыл/не открыл» в списке ссылок карточки. Повторные
  /// просмотры её не двигают: важен сам факт, что клиент увидел объект, а не счётчик.
  viewedAt         DateTime?
  revokedAt        DateTime?

  @@index([propertyId])
  @@index([clientId])
}

/// ОТЧЁТ ВЛАДЕЛЬЦУ ОБЪЕКТА (03.10.2026): публичная страница по секретной ссылке
/// «Что мы сделали для вашей квартиры» (GET /api/v1/public/owner-report/:token, страница
/// /o/:token). Аргумент агента для эксклюзива и разговора о цене. НИЧЕГО не уходит
/// владельцу само: сотрудник сам копирует ссылку и сам решает, кому её передать.
///
/// Одна ДЕЙСТВУЮЩАЯ ссылка на объект (частичный уникальный индекс в migration.sql —
/// Prisma такие не выражает): повторное «создать» отдаёт её же, новая появляется
/// только после отзыва. Отозванная строка остаётся как история (revokedAt).
/// Токен — 32 случайных байта (crypto.randomBytes, base64url), как у PropertyShareLink,
/// только длиннее: страница отдаёт цифры по объекту без входа в CRM.
model PropertyOwnerReportLink {
  id           String    @id @default(uuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  token        String    @unique
  createdAt    DateTime  @default(now())
  createdById  String
  createdBy    Agent     @relation(fields: [createdById], references: [id])
  revokedAt    DateTime?
  /// Последнее открытие страницы и их число — чтобы агент видел, читал ли владелец.
  lastViewedAt DateTime?
  viewsCount   Int       @default(0)

  @@index([propertyId])
}

/// СИГНАЛ ИНТЕРЕСА К ОБЪЕКТУ (владелец 09.09.2026: «хочу видеть, каким объектом
/// интересуются больше всего, чтобы запустить его на таргетинг»).
///
/// ЗАЧЕМ ОТДЕЛЬНАЯ ТАБЛИЦА, А НЕ СЧЁТЧИК. Property.viewsCount существует, но считает
/// он ПОКАЗЫ — совсем другое событие, и у него нет времени: по нему нельзя ответить
/// «что интересно ПРЯМО СЕЙЧАС» и «что спрашивали в августе». Интерес — это поток
/// событий, и хранить его надо потоком.
///
/// Что считается сигналом (каждый — след реального человека, а не догадка):
///   SHARE_SENT   — агент отправил объект клиенту приватной ссылкой;
///   SHARE_OPENED — клиент эту ссылку открыл (сильнее предыдущего);
///   SHOWING      — назначен показ;
///   COMMENT      — комментарий под постом в Instagram;
///   MATCH_SENT   — автоподбор предложил объект агенту ждущего покупателя.
model PropertyInterestEvent {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind       String
  /// Кто проявил интерес, если известен настоящий клиент CRM. Для комментария в
  /// Instagram, у которого нет телефона (createLeadFromChannel требует phone),
  /// настоящей карточки ещё нет — остаётся null.
  clientId   String?
  /// Автор в канале (author psid/igsid у комментария Instagram), когда clientId ещё
  /// нет — тот же мост "идентичность в канале раньше карточки", что recipientId у
  /// PropertyExposure. Без него COMMENT-событие было анонимным навсегда: человек,
  /// реально проявивший интерес, не отличался от статистического шума (13.09.2026).
  externalAuthorId   String?
  externalAuthorName String?
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
  @@index([createdAt])
}

model PriceChange {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  oldPrice    Decimal
  // Валюта на момент изменения — объект мог сменить валюту (TJS↔USD) в том же
  // редактировании; без своей валюты у каждой суммы старая цена рендерилась бы
  // в ТЕКУЩЕЙ валюте объекта, искажая историю (500 000 TJS выглядели бы как $500 000).
  oldCurrency Currency @default(TJS)
  newPrice    Decimal
  newCurrency Currency @default(TJS)
  changedById String
  changedBy   Agent    @relation(fields: [changedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([propertyId])
}

/// Покупатель (ищет жильё) или Продавец (хочет разместить/продать своё через нас) —
/// разделяет вкладки «Клиенты» и «Продавцы», вся логика распределения/приёма общая.
/// OTHER — работа/аренда/прочее обращение из бота: НЕ распределяется агентам вообще
/// (assignedAgentId остаётся null), видно только руководству в «Прочие обращения».
enum ClientKind {
  BUYER
  SELLER
  OTHER
}

/// Светофор неактивных клиентов (владелец 20-21.08.2026, мозговой штурм «лазейки») —
/// см. Client.inactiveLevel и блок Settings.inactive* для смысла каждого цвета.
enum ClientInactiveLevel {
  GREEN
  YELLOW
  RED
}

/// ⚠️ Client.extraPhones ИМЕЕТ триграммный GIN-индекс `Client_extraPhones_trgm_idx`
/// (миграция 20260914140100_client_phone_trgm_search), но он ФУНКЦИОНАЛЬНЫЙ —
/// построен по выражению `client_extra_phones_search_text("extraPhones")`, а не по
/// колонке напрямую (extraPhones — String[], gin_trgm_ops сам по себе на массив не
/// ложится). Расширенный синтаксис Prisma (`@@index([field(ops: raw(...))])`) умеет
/// ссылаться только на поле, а не на выражение/функцию — объявить этот индекс в
/// schema.prisma НЕЛЬЗЯ. Проверено 14.09.2026: попытка `@@index([extraPhones(ops:
/// raw("gin_trgm_ops"))], type: Gin, map: "Client_extraPhones_trgm_idx")` проходит
/// `prisma validate`, но `migrate dev --create-only` предлагает
/// `CREATE INDEX "Client_extraPhones_trgm_idx" ON "Client" USING GIN ("extraPhones"
/// gin_trgm_ops)` — индекс по КОЛОНКЕ напрямую, под тем же именем, что и реальный
/// функциональный индекс: применить это либо упадёт на дубле имени, либо тихо
/// подменит семантику. Это ПОСТОЯННОЕ ИСКЛЮЧЕНИЕ, не todo: если увидишь DROP
/// именно для Client_extraPhones_trgm_idx в своей сгенерированной миграции —
/// это тот самый случай, просто вырежи DROP, как и раньше для необъявляемых
/// сырых индексов, и не трать час на попытку объявить его снова.
model Client {
  mutationRevision Int @default(0)
  contactPhoneOrigins ClientPhoneOrigin[]
  updatedAt DateTime @default(now()) @updatedAt
  dualIntentDecisionSource String?
  dualIntentNeedsReview Boolean @default(false)
  dualIntentEvidence Json?
  dualIntentAnalyzedHash String?
  investigationCases InvestigationCase[]
  /// Final refusal for the current assignment; cleared on a legitimate new assignment.
  assignmentRefusedAt       DateTime?
  assignmentRefusedByAgentId String?
  /// Operational completion only, never a private investigation indicator.
  assignmentCompletedAt     DateTime?
  id                        String               @id @default(uuid())
  /// Pending new-only intake policy. Morning waves exclude this until its job commits.
  customerIntakeActionId String? @unique
  customerIntakeAction CustomerAction? @relation(fields: [customerIntakeActionId], references: [id], onDelete: Restrict)
  /// Короткий числовой ID для читаемых URL (/clients/1042) — id остаётся настоящим
  /// первичным ключом для всех связей, shortId используется только для роутинга.
  shortId                   Int                  @unique @default(autoincrement())
  fullName                  String
  /// Фамилия отдельным полем (спецификация: «имя, фамилия, телефон…» в карточке
  /// лида) — необязательна: у старых карточек имя записано одной строкой без
  /// чёткой границы, и требовать фамилию значило бы ломать их при следующем
  /// сохранении. fullName остаётся источником истины для поиска/бота/шаблонов —
  /// его никто не трогает, lastName — дополнительная подпись сверху.
  lastName                  String?
  phone                     String               @unique
  email                     String?
  status                    ClientStatus         @default(NEW)
  /// «КЛИЕНТ ВЕРНУЛСЯ» — ЗАМЕТНО, БЕЗ ПРОВЕРКИ ХРОНОЛОГИИ (владелец 19.08.2026).
  /// Ставится моментом ЛЮБОГО повторного обращения по уже известному телефону
  /// (обычное «снова обратился», возврат из Неактивных, восстановление из
  /// Корзины). Список клиентов показывает значок «вернулся», пока returnedAt не
  /// старше нескольких дней — агент видит это сразу в строке, не открывая
  /// карточку и не читая хронологию.
  returnedAt                DateTime?
  /// Что видит и переключает АГЕНТ (переработка 12.08.2026) — отдельно от «Состояния»
  /// (status выше), которым управляет только CRM. Только BUYER: у продавцов свой путь
  /// («Итог объекта», PendingSummary kind="property") и это поле для них не имеет смысла.
  workStatus                WorkStatus           @default(ACTIVE)
  kind                      ClientKind           @default(BUYER)
  /// Клиент одновременно и продавец, и покупатель (владелец 06.09.2026, разбор
  /// слепых зон п.4) — например, продаёт свою квартиру и тут же ищет другую.
  /// `kind` остаётся ОДНИМ значением (текущая активная сторона — от него зависит
  /// маршрутизация лида, подбор объектов, KPI), а это поле — просто отметка «у
  /// него есть и вторая сторона тоже», которую ставит kindChangeUpdate вместо
  /// того, чтобы стирать данные противоположной роли при смене типа. Показывается
  /// как «Продавец и покупатель» в CLIENT_KIND_LABELS/formatClientName и
  /// расширяет фильтр kind в sellerNoPropertyAlarm.ts/buyerNoCallAlarm.ts — чтобы
  /// оба алармных крона видели клиента независимо от того, какая сторона у него
  /// сейчас основная.
  dualIntent                Boolean              @default(false)
  /// Concurrent roles require an explicit staff confirmation; historical role changes alone are not proof.
  dualIntentConfirmedAt     DateTime?
  dualIntentConfirmedById   String?
  dualIntentConfirmedBy     Agent? @relation("ClientIntentConfirmation", fields: [dualIntentConfirmedById], references: [id], onDelete: SetNull)
  source                    ClientSource
  /// ad_id объявления Meta, которое ПРИВЕЛО этого клиента (26.08.2026, ревью) —
  /// переносится из BotConversation.adExternalId в момент привязки диалога к
  /// карточке. Только первое касание: заполненное значение не перезаписывается.
  /// Вместе с Ad/AdSpendDaily даёт ROMI по каждому объявлению; UI пока нет —
  /// сначала копим историю, отчёты потом.
  sourceAdId                String?
  budgetMin                 Decimal?
  budgetMax                 Decimal?
  currency                  Currency             @default(TJS)
  desiredDistrictId         String?
  desiredDistrict           District?            @relation(fields: [desiredDistrictId], references: [id])
  desiredRooms              Int?
  /// Какое жильё ищет клиент. Бот вынимает это из разговора с первых реплик, но до
  /// 31.07.2026 хранить было негде и значение выбрасывалось при создании лида, а
  /// подбор объектов по типу не фильтровал вовсе. Срочность владелец заводить не
  /// стал: она устаревает быстрее, чем её успевают прочитать.
  desiredType               PropertyType?
  /// ЧТО ИМЕННО ИЩЕТ КЛИЕНТ — площадь и этаж (спецификация владельца 31.07.2026,
  /// «Получение нового лида»: в карточке обязаны быть площадь, этаж и этажность).
  /// Полей не существовало вовсе, и агент читал эти пожелания из свободных заметок,
  /// а подбор объектов по ним не фильтровал.
  ///
  /// Площадь — «от», а не точная: человек говорит «хотя бы 60 квадратов», а не «ровно».
  desiredAreaMin            Int?
  /// Этаж «от» и «до»: самая частая просьба — «не первый и не последний», и одним
  /// числом её не выразить.
  desiredFloorMin           Int?
  desiredFloorMax           Int?
  /// Этажность дома, которая устроит клиента (например, «не выше пяти, лифта нет»).
  desiredTotalFloors        Int?
  /// Адрес клиента (требование владельца от 30.07.2026: район в карточке был, адреса не было).
  /// Для покупателя — где живёт сейчас; для продавца — адрес его объекта до оформления карточки.
  address                   String?
  /// «Личный лид» — агент привёл клиента сам, не через каналы компании (решение
  /// владельца 30.07). За заполненную карточку такого клиента агенту начисляются
  /// KPI-баллы отдельной метрикой (см. kpi.ts, personalLeads).
  isPersonalLead            Boolean              @default(false)
  /// Момент, когда клиент стал «горячим» (отказал агенту, но карточка заполнена или
  /// уже был показ) — попадает в раздел «Горячие клиенты» и уходит сильному агенту.
  /// Решение владельца 30.07, третий пакет пп. 6 и 10.
  hotSince                  DateTime?
  /// Причина последнего отказа (ключ из REFUSAL_REASONS) — обязательна при отказе,
  /// чтобы следующий, более опытный агент понимал контекст.
  refusalReason             String?
  /// Сколько раз клиент отказал и был передан другому агенту. После 3 — пуш
  /// владельцу и эскалация вместо дальнейшего кружения.
  refusalCount              Int                  @default(0)
  /// «ОТЛОЖЕННЫЕ» (задача G, план 03-04.09.2026) — момент, когда карточка ушла в
  /// workStatus=DEFERRED. От него в разделе «Отложенные» считается «отложен N
  /// дней назад». null, пока клиент никогда не был отложен; сохраняет последнее
  /// значение и после возврата в ACTIVE (история, как у inactiveSince выше).
  deferredAt                DateTime?
  /// Причина отсрочки — ключ RefusalReason (EXPENSIVE/FINANCE_ISSUE/WRONG_OBJECT,
  /// тот же словарь, что и у refusalReason: агент выбирает её тем же окном
  /// «Без сделки», просто эти три причины ведут в DEFERRED, а не в обычный отказ).
  deferredReason            String?
  /// Когда крон (lib/deferredClients.ts) обязан молча вернуть клиента в обычную
  /// работу ТОМУ ЖЕ агенту — 3 месяца для EXPENSIVE/FINANCE_ISSUE, 1 месяц для
  /// WRONG_OBJECT (решение владельца). null, пока клиент не отложен ИЛИ уже
  /// вернулся (досрочно или по таймеру) — поле гасится вместе с выходом из DEFERRED.
  deferredUntil             DateTime?
  /// Причина ПОСЛЕДНЕГО перевода в Неактивные — ключ InactiveReason (packages/shared),
  /// структурно, а не только текстом в SYSTEM-записи хронологии (владелец 21.08.2026:
  /// без структурного поля светофор и отчёт «почему теряем» не построить — нечем
  /// фильтровать). Текст в хронологии остаётся как был, это поле — для логики и отчётов.
  inactiveReasonKey         String?
  /// Светофор неактивных — см. enum ClientInactiveLevel и Settings.inactive*.
  /// null, пока клиент не был в Неактивных ни разу; сохраняет последнее значение и
  /// после возврата в ACTIVE — история, а не индикатор текущего состояния (текущее
  /// состояние = workStatus).
  inactiveLevel             ClientInactiveLevel?
  /// Момент, когда карточка ушла в ТЕКУЩИЙ цикл неактивности — от него считаются
  /// напоминания светофора. Обновляется заново при каждом переводе в Неактивные (в
  /// т.ч. повторном после возврата), не при создании карточки.
  inactiveSince             DateTime?
  /// Момент, когда карточка ВОШЛА в Неактивные по итогу работы агента
  /// (deactivateClient: разбор звонка, текст агента, недозвоны). Только от него
  /// считается пауза выдачи лидов (Settings.inactivateCooldownHours). В отличие от
  /// inactiveSince не сдвигается ни разговором с неактивным клиентом, ни возвратом
  /// агента из отпуска, и не ставится ночным автопереводом молчащих — это не
  /// решение агента (владелец 23.09.2026, пауза держала почти всю команду).
  inactiveEnteredAt         DateTime?
  /// Сколько напоминаний светофора уже отправлено агенту в ТЕКУЩЕМ цикле. После
  /// достижения предела для своего уровня (Settings.inactive*MaxAttempts) карточка
  /// уходит в LOST — см. lib/inactiveTrafficLight.ts.
  inactivePingCount         Int                  @default(0)
  /// Таймер возврата ПОТЕРЯННОГО/НЕАКТИВНОГО клиента (владелец 19.08.2026: сначала
  /// прежнему агенту, без перераспределения; владелец 21.08.2026: но с таймером —
  /// не принял, лид уходит в общую очередь, а не лежит бесконечно). Ставится
  /// ТОЛЬКО в этих двух случаях (leads.ts::resumeExistingChannelLead), не на
  /// каждое обычное повторное обращение — иначе не отличить одно от другого по
  /// одному лишь returnedAt, который обновляется всегда. null — таймер не идёт
  /// или уже снят (реальным касанием агента, см. clearReturnAcceptDue).
  returnAcceptDueAt         DateTime?
  /// ПРОВЕРКА СЛУЖБЫ БЕЗОПАСНОСТИ (спецификация владельца). PENDING | CLEARED |
  /// CONFIRMED, null — проверка не требовалась. Часть причин закрытия («купил
  /// самостоятельно», «продал через другое агентство», «передумал», «снял с
  /// продажи») означает, что сделка со слов агента прошла мимо компании: это
  /// может быть правдой, а может быть способом увести сделку. Отличить по тексту
  /// в CRM нельзя, поэтому карточка уходит не следующему агенту, а в СБ.
  securityReview            String?
  securityReviewedAt        DateTime?
  securityReviewedById      String?
  securityReviewer          Agent?               @relation("SecurityReviewer", fields: [securityReviewedById], references: [id], onDelete: SetNull)
  /// Что установила проверка — своими словами, для истории.
  securityNote              String?
  /// АГЕНТ СПРОСИЛ НОМЕР ТЕЛЕФОНА У ЭТОГО КЛИЕНТА (владелец 07.09.2026) — самый
  /// свежий такой случай. Пишет ТОЛЬКО детектор (lib/agentPhoneAskDetector.ts),
  /// без немедленного пуша директору («не нужно вмешиваться в онлайн») — это
  /// просто факт-якорь для lib/agentOffCrmAlarm.ts (молчание/заморозка ПОСЛЕ
  /// этого момента — повод насторожиться) и для подсказки на экране одобрения
  /// удаления карточки («этот агент недавно спрашивал номер»).
  phoneAskFlaggedAt         DateTime?
  phoneAskFlaggedByAgentId  String?
  /// Когда по ТЕКУЩЕМУ phoneAskFlaggedAt уже отправляли аларм «в обход CRM» —
  /// чтобы не гонять дорогую ИИ-проверку «объяснил ли клиент паузу» на каждом
  /// тике повторно, пока ситуация не изменилась. Новый, более поздний
  /// phoneAskFlaggedAt (повторный случай) делает это поле устаревшим и аларм
  /// снова может сработать.
  offCrmAlarmNotifiedAt     DateTime?
  /// «ОТКАЗ ПРИ ВЫСОКОМ СКОРИНГЕ» — ОЧЕРЕДЬ НА ЧАСЫ АЛАРМОВ (владелец 07.09.2026).
  /// lib/buyerNoCallAlarm.ts::alertRefusedHighScoreBuyer срабатывает мгновенно
  /// (событие, не крон-тик) и раньше слал пуш директору в любое время суток.
  /// Теперь событие только СТАВИТ отметку здесь (в любой час), а отдельный
  /// часовой тик runRefusedHighScoreAlarmTick шлёт сам пуш, только пока идут
  /// часы алармов (Settings.alarmHours*) — так же, как остальные алармы
  /// директору «копятся ночью, уходят с началом следующего окна».
  refusedHighScoreFlaggedAt   DateTime?
  refusedHighScoreNotifiedAt  DateTime?
  /// Когда агенту напомнили дозаполнить карточку (через час после принятия) и когда
  /// о незаполненной карточке сообщили руководству (через 12 часов). Решение
  /// владельца 30.07. Отметки — чтобы напомнить один раз, а не на каждом тике джоба.
  cardReminderSentAt        DateTime?
  cardEscalatedAt           DateTime?
  /// Когда агент нажал «Я в работе» — клиент сложный, карточка заполняется по ходу.
  /// Отсчёт 12 часов начинается заново от этой отметки: если агент правда работает,
  /// он дозаполнит карточку; если жмёт кнопку бесконечно — это видно в хронологии.
  workingMarkedAt           DateTime?
  requirementsNotes         String?
  /// null только для kind=OTHER (работа/аренда/прочее) — такие обращения намеренно
  /// не распределяются агентам, ими занимается напрямую руководство.
  assignedAgentId           String?
  assignedAgent             Agent?               @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  /// Когда лид назначен текущему агенту (автораспределением или вручную).
  assignedAt                DateTime             @default(now())
  /// Когда агент принял лид. null = ждёт принятия: контакты скрыты, работа с лидом заблокирована.
  acceptedAt                DateTime?
  /// Лид «на 1%»: достался агенту потому, что клиенту подходит объект, который
  /// этот агент сам принял (Property.intakeAgentId). Такой лид приносит агенту
  /// обе половины комиссии — 0.5% за интейк и 0.5% за продажу, — и потому не
  /// подчиняется общему лимиту активных лидов (решение владельца 11.08.2026:
  /// «максимум можно много брать лидов, если твои собственные объекты»).
  /// Обычный лид — false: только такие предлагается освободить, когда портфель
  /// полон, а пришёл лид по своему объекту.
  ownPropertyLead           Boolean              @default(false)
  /// ПОЧЕМУ лид достался именно этому агенту:
  ///   own_property_shown   — бот показывал клиенту объект этого агента;
  ///   own_property_match   — запрос клиента совпал с объектом агента выше порога;
  ///   own_property_interest — клиент САМ проявил интерес к объекту этого агента:
  ///                          переслал ссылку/пост на него или явно назвал его в
  ///                          переписке (владелец 21.08.2026: «агент свои объекты
  ///                          лучше всех знает» — тот же вес, что и own_property_shown,
  ///                          безусловно и без очереди, см. leads.ts::pickByPropertyInterest);
  ///   queue                — обычная очередь (нагрузка/KPI/круг).
  /// Нужно не для отчётности, а для объяснимости: лид, ушедший мимо очереди, без
  /// причины выглядит как сбой распределения — и для агента, и для владельца.
  assignReason              String?
  /// Объект, из-за которого лид ушёл этому агенту. SetNull: объект могли продать
  /// или удалить, но причина назначения от этого не меняется — рядом остаётся
  /// запись SYSTEM в хронологии с номером объекта.
  matchedPropertyId         String?
  matchedProperty           Property?            @relation("MatchedProperty", fields: [matchedPropertyId], references: [id], onDelete: SetNull)
  /// ОБЪЕКТ, НАЗВАННЫЙ КЛИЕНТОМ, ЖДЁТ УТРА (24.09.2026, проход по классам после
  /// ОБ-000118). Ночью назначение откладывается, а утренняя волна раньше не
  /// знала, какой объект человек назвал (заявка со страницы объекта, «объект
  /// №112» в чате), и отдавала лид общей очередью. Просто id без связи, как
  /// BotConversation.adPropertyId: продан/удалён — проверяет сам шаг «объект
  /// назван явно» (services/leads/assignment.ts). Не путать с matchedPropertyId:
  /// тот объясняет уже сделанное назначение и считается в статистике объекта.
  requestedPropertyId       String?
  /// АВТОФИКСАЦИЯ ВРЕМЁН (Royal Score, спецификация владельца). Момент первого
  /// открытия карточки клиента ЛЮБЫМ агентом (GET /clients/:id) — проставляется
  /// один раз, дальше не переписывается: это факт, а не «последнее открытие»
  /// (для него уже есть отдельный смысл в интерфейсе — свежесть карточки не
  /// нужно путать с фактом первого касания). null = карточку ещё не открывали.
  firstOpenedAt             DateTime?
  /// Момент первой попытки контакта — первая запись в Interaction по этому
  /// клиенту (POST /clients/:id/interactions), независимо от исхода. До
  /// подключения Originate (см. docs/owner-flow-royal-score.md) это ближайший
  /// проверяемый заменитель «первого звонка через CRM».
  firstContactAt            DateTime?
  /// Момент первого СОДЕРЖАТЕЛЬНОГО результата — первый раз, когда обязательное
