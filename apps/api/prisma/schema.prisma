/// ЧЕМ ДОКАЗАНА связь объявления с объектом. Хранится вместе с привязкой, потому
/// что от источника зависит право синхронизации её переписывать: всё, что нашла
/// машина, она же имеет право пересчитать; MANUAL — решение человека, и ночной
/// прогон его не трогает (иначе работа маркетолога стиралась бы каждый час).
///
/// Порядок доверия — сверху вниз, см. lib/ads/adMatching.ts.
enum AdMatchSource {
  /// Ссылка на продвигаемую публикацию совпала с Property.instagramUrl.
  POST_URL
  /// Публикация найдена в НАШЕЙ ленте Instagram (getAllOwnMedia), номер объекта
  /// взят из её подписи — тем же captionShortId, которым бот узнаёт пересланный
  /// рилс. Работает даже там, где поле в карточке пустое или заполнено мусором
  /// (на 20.08.2026 таких карточек 17).
  FEED_CAPTION
  /// Публикация объявления (id медиа / хвост storyId) есть в НАШИХ записях о публикациях:
  /// Property.publishedPostIds, PropertyPhotoPost.mediaId, PropertyStoryPost.mediaId.
  /// Доказано нашей же базой, без ленты Instagram и без подписи (lib/ads/adMatching.ts).
  CRM_MEDIA
  /// Номер объекта найден в названии кампании/группы/объявления («#1042»).
  ENTITY_NAME
  /// Привязал человек в CRM.
  MANUAL
}

model Agent {
  investigationCases InvestigationCase[] @relation("InvestigationSubject")
  recruitmentRecoveries RecruitmentRecovery[]
  oversightAcks OversightAck[]
  id                          String    @id @default(uuid())
  fullName                    String
  propertyChatConversations   BotConversation[] @relation("PropertyChatAgent")
  phone                       String    @unique
  email                       String?
  /// НИК АГЕНТА В INSTAGRAM (26.09.2026, без `@`) — добавляется первым в список
  /// соавторов Reels при публикации его объектов (lib/instagramCollaborators.ts).
  /// Заполняется вручную в Настройках → Сотрудники; null = агент не подключён,
  /// соавтором не становится.
  instagramUsername           String?
  role                        Role      @default(AGENT)
  /// Пароли убраны 19.10.2026 (вход только по коду СМС/Telegram и ключу
  /// устройства). Колонка пустая до отдельной уборки — сервер её не читает.
  passwordHash                String?
  /// Пароль ВРЕМЕННЫЙ — сотрудник обязан сменить его на своей же смене пароля
  /// (PATCH /me), прежде чем сможет сделать что-либо ещё (см. auth/middleware.ts,
  /// requireAuth). Ставится при создании учётки и при сбросе пароля ЧУЖОЙ рукой
  /// (директор/админ, PATCH /agents/:id) — так пароль, который директор придумал
  /// и продиктовал, после первого входа знает только сам сотрудник, и его
  /// действия в журнале больше не смешиваются с действиями того, кто пароль
  /// назначил (владелец 14.09.2026). false по умолчанию — иначе все уже
  /// существующие сотрудники оказались бы заперты этой миграцией.
  mustChangePassword          Boolean   @default(false)
  isActive                    Boolean   @default(true)
  avatarUrl                   String?
  /// Внутренний SIP-номер агента на Asterisk (схема нумерации — см. docs/telephony-sip-numbering.md):
  /// трёхзначные номера с 101, один агент = один экстеншен. Уникален, необязателен —
  /// пока пусто, звонок из карточки клиента для этого агента недоступен (кнопка
  /// показывает «Телефония не настроена»). Заполняется вручную в Настройках →
  /// Сотрудники, когда владелец пропишет на Asterisk соответствующий PJSIP-эндпоинт.
  sipExtension                String?   @unique
  /// Личный чат агента с CRM-ботом в Telegram — заводится один раз через ссылку
  /// t.me/<бот>?start=<код> (см. telegramLinkCode ниже), дальше бот пишет сюда
  /// напрямую. Сейчас единственное применение — ручная передача видео монтажёру
  /// (см. Property.videoHandoffStatus, 01.09.2026), но поле общее для агента,
  /// не завязано на одну функцию — годится для любых будущих личных пушей в Telegram.
  /// Наблюдатель монтажа (22.09.2026): админ получает в свой Telegram копию
  /// всего, что уходит монтажёру (исходники, напоминания). Монтажёром от этого
  /// не становится — бот узнаёт монтажёра только по Settings.videoMontajerAgentId.
  montageCopiesTelegram       Boolean   @default(false)
  telegramChatId              String?   @unique
  /// Одноразовый код для привязки telegramChatId — показывается в Настройках,
  /// агент отправляет его боту (или переходит по ссылке с ?start=код), после
  /// успешной привязки код обнуляется, чтобы им нельзя было воспользоваться дважды.
  telegramLinkCode            String?   @unique
  /// МОДЕРАЦИЯ В TELEGRAM (22.09.2026, lib/telegramModeration). Включает сам
  /// сотрудник с правом properties.moderate у себя в профиле: объекты на проверке
  /// и досланные фото приходят ему в личный чат с ботом с кнопками решения.
  telegramModeration          Boolean   @default(false)
  /// ГОТОВЫЙ РОЛИК НА ПРОВЕРКУ В TELEGRAM (25.09.2026, lib/clipReview.ts). Включает
  /// сам сотрудник в профиле (ADMIN/DIRECTOR или право properties.moderate): ролик
  /// от монтажёра приходит ему видео с кнопками «Одобрить» / «Вернуть монтажёру».
  clipReviewTelegram          Boolean   @default(false)
  /// «ПРИСЫЛАТЬ МОИ ПОСТЫ В TELEGRAM» (28.09.2026, lib/agentSharePost.ts). Личный
  /// тумблер агента — гейт `Settings.agentSharePostTelegram` включает механизм для
  /// всех, этот выключает его конкретному человеку, кто не хочет получать пост
  /// после каждой публикации. true по умолчанию: пуш уже уходил всегда, это
  /// удобство поверх, а не новая рассылка, которую нужно явно включать.
  sharePostTelegram           Boolean   @default(true)
  /// На каком языке сотруднику играть подсказку о звонящем (Settings.callWhisperEnabled):
  /// "tg" — таджикский, "ru" — русский, "off" — не играть этому человеку вовсе,
  /// null — как выбрано в агентстве (Settings.callWhisperLanguage).
  ///
  /// Язык именно СОТРУДНИКА, а не клиента: подсказку слышит он один. Звонок известного
  /// клиента уходит ровно его ответственному (веерный обзвон отменён владельцем
  /// 20.08.2026), поэтому язык файла известен заранее и на клиента хранится один файл.
  whisperLanguage             String?
  /// ОПЕРАТОР ПЕРВОЙ ЛИНИИ: принимает звонки НЕЗНАКОМЫХ номеров (решение владельца
  /// 20.09.2026: «незнакомый попадает только в очередь на оператора, ни агенту, ни
  /// кому больше; агент отвечает только своим клиентам»).
  ///
  /// Это ПРЯМАЯ ОТМЕНА прежнего критерия «в очередь входящих идут все role=AGENT»
  /// (19.09.2026, agentIncomingReadiness.ts). Роль для этого не годится: оператор —
  /// не роль в CRM, а обязанность, и один и тот же человек может её брать и
  /// отдавать, не меняя ни прав, ни доступа. Поэтому отдельный признак, а не новое
  /// значение Role.
  ///
  /// По умолчанию false у всех, включая уже заведённых: правило владельца — агенты
  /// незнакомых не принимают, значит пустая очередь безопаснее унаследованной.
  /// Состав очереди на станции сверяется по этому признаку (cron, 15 минут).
  takesUnknownCalls           Boolean   @default(false)
  /// Настройки оформления веб-клиента (тема, эффекты, виджеты дашборда) — см. uiPreferencesSchema в @royal-home/shared.
  preferences                 Json?
  /// Персональные надстройки прав поверх пресета роли: {"granted": [...], "revoked": [...]}.
  /// Реестр прав и правила слияния — permissions.ts в @royal-home/shared. null = роль как есть.
  /// Менять может только директор (право permissions.manage), см. routes/agents.ts.
  permissions                 Json?
  /// {"clients": ISO, "sellers": ISO, "otherInquiries": ISO} — когда агент последний раз открывал
  /// раздел; красные счётчики в сайдбаре считают записи новее метки. Отдельно от preferences,
  /// потому что те перезаписываются целиком синком темы с веб-клиента.
  sectionsSeenAt              Json?
  /// Последняя активность в CRM (обновляется не чаще раза в минуту) — «онлайн» на экране Команда.
  lastSeenAt                  DateTime?
  /// «НЕ ПРИНИМАЮ ЛИДЫ» — агент сам временно выходит из распределения (болезнь,
  /// отпуск, завал). До этого момента новые лиды ему не назначаются. Срок ставит
  /// не агент, а система: потолок в Настройках, иначе тумблер превращается в
  /// способ не работать. KPI при этом идёт как обычно — текущие задачи никуда не
  /// делись, и пауза не должна быть способом обнулить просрочки.
  leadsPausedUntil            DateTime?
  /// ЛИЧНЫЕ ВЫХОДНЫЕ АГЕНТА (владелец 11.10.2026): дни недели по Душанбе, 0 —
  /// воскресенье … 6 — суббота. Пусто — работает каждый день. В свой выходной
  /// агент не получает новых чужих лидов, его мобильный не набирается, штрафы и
  /// счётчики тишины не идут. Закрепление клиентов за ним НЕ меняется никогда.
  /// Правило — packages/shared/src/daysOff.ts.
  weeklyDaysOff               Int[]     @default([])
  /// Когда пауза закончилась в прошлый раз — по ней считается «остыть сутки»,
  /// чтобы тумблер не включали заново каждый раз, как он истечёт.
  leadsPausedEndedAt          DateTime?
  /// Кто поставил паузу, если не сам агент (24.09.2026, владелец: «админу и
  /// директору тоже кнопку»). null — пауза своя, её агент снимает сам; иначе
  /// снять может только руководитель. Остывание (leadsPausedEndedAt) такая
  /// пауза не трогает: это не просьба агента.
  leadsPausedById             String?
  leadsPausedBy               Agent?    @relation("AgentLeadPauser", fields: [leadsPausedById], references: [id], onDelete: SetNull)
  leadsPausedAgents           Agent[]   @relation("AgentLeadPauser")
  /// Причина паузы от руководителя — видна агенту в профиле. Необязательна.
  leadsPausedReason           String?
  /// ЭКСТРЕННАЯ ЗАМОРОЗКА — включает только руководитель. Агент выпадает из
  /// распределения полностью, его KPI замирает на последнем значении, а место в
  /// рейтинге сохраняется: заморозка это не наказание рейтингом, а остановка
  /// работы (увольнение на рассмотрении, разбирательство, длинная болезнь).
  frozenAt                    DateTime?
  frozenById                  String?
  frozenBy                    Agent?    @relation("AgentFreezer", fields: [frozenById], references: [id], onDelete: SetNull)
  frozenAgents                Agent[]   @relation("AgentFreezer")
  /// Причина заморозки — обязательна: запись в журнале без причины через месяц
  /// не объясняет ничего.
  frozenReason                String?
  /// ЧТО ИМЕННО за отсутствие — от этого зависят сроки передачи вернувшегося
  /// клиента (см. AbsenceKind и lib/returningClientRouting.ts). Не задан у уже
  /// замороженных на момент правки: код обязан вести себя с ними как с OTHER,
  /// то есть осторожно — автоматически клиентов не отбирать.
  absenceKind                 AbsenceKind?
  /// До какого момента отсутствие запланировано (отпуск до 30 дней, больничный до
  /// 7). Справочно для руководства и для будущего автовозврата; сроки передачи
  /// клиентов считаются не по нему, а по виду отсутствия.
  absenceUntil                DateTime?
  /// Голосовая заметка к причине заморозки (01.09.2026, кнопка микрофона в
  /// FreezeAgentModal) — файл как есть, не замена frozenReason. Путь под
  /// /uploads/voice-notes, см. POST /me/voice-notes.
  frozenReasonVoiceUrl        String?
  frozenReasonVoiceTranscript String?
  createdAt                   DateTime  @default(now())
  /// Секрет TOTP (Google Authenticator), зашифрован через SETTINGS_ENCRYPTION_KEY (см. crypto.ts).
  /// Записывается при /me/2fa/setup ещё до включения — totpEnabled становится true только
  /// после успешного /me/2fa/confirm (подтверждён код, значит секрет реально дошёл до приложения).
  totpSecret                  String?
  totpEnabled                 Boolean   @default(false)
  /// Ключи входа по отпечатку/лицу (passkeys). Один сотрудник — сколько угодно
  /// устройств: рабочий телефон, личный, ноутбук.
  passkeys                    Passkey[]
  /// Кэш последнего рассчитанного ежедневного KPI (0-100) — источник истины
  /// KpiDailyScore, это поле только для быстрого чтения (дашборд, распределение
  /// лидов в режиме "kpi"). Пересчитывается ночным кроном за прошедший день.
  /// null — ещё ни разу не считался (например, агент только что нанят); в таком
  /// случае распределение лидов трактует его как 100 (не штрафуем за отсутствие истории).
  kpi                         Int?
  /// Отказы от нового лида ПОДРЯД (спецификация 01.08.2026, часть 3): 1-й отказ —
  /// без штрафа, 2-й −1, 3-й −2, 4-й и далее −3 (см. lib/scoreJournal.ts). Сбрасывается
  /// в 0 при успешном принятии лида ("После успешной обработки любого нового лида
  /// счётчик отказов автоматически обнуляется") — не при каждом действии, а именно
  /// при "Принять", это единственная точка, где обработка нового лида начинается.
  consecutiveLeadDeclines     Int       @default(0)
  /// Кэш последней ИИ-рекомендации «как повысить Royal Score» (lib/scoreRecommendation.ts).
  /// Живой текст дорог для генерации на каждое открытие карточки — обновляется не
  /// чаще раза в день на агента, здесь только хранится последний результат.
  lastScoreAdvice             String?
  lastScoreAdviceAt           DateTime?
  /// Виды push, которые сотрудник ВЫКЛЮЧИЛ себе (ключи PushKind из
  /// @royal-home/shared). Хранятся именно выключенные, а не включённые: новый вид
  /// уведомления тогда доходит до всех сам, а не тонет молча у каждого, кто
  /// настраивал список до его появления.
  ///
  /// До 11.08.2026 push были «всё или ничего» на устройство: агент, которому мешал
  /// поток сообщений клиентов, отключал заодно и новые лиды — ровно то, ради чего
  /// уведомления и заводились.
  pushMuted                   String[]  @default([])
  /// Полное отключение push на все устройства сотрудника (решение владельца
  /// 31.08.2026 — админу и директору звонки и так приходят на прямой SIP-аппарат,
  /// пуш о том же звонке становится дублирующим шумом). ОТДЕЛЬНО от pushMuted:
  /// звонки идут без `kind` (см. lib/telephony/incomingCalls.ts) и поэтому его
  /// не ловят, а этот флаг перекрывает всё, независимо от вида уведомления.
  /// Лента в колокольчике (Notification) продолжает наполняться как раньше —
  /// выключается только доставка на устройство.
  pushDisabled                Boolean   @default(false)

  properties                  Property[]              @relation("AssignedAgent")
  intakeProperties            Property[]              @relation("IntakeAgent")
  createdProperties           Property[]              @relation("CreatedByAgent")
  handedOverProperties        Property[]              @relation("PropertyHandoverFrom")
  handoverBatches             AgentHandoverBatch[]    @relation("HandoverBatchFrom")
  deletedProperties           Property[]              @relation("DeletedByPropertyAgent")
  uploadedVideos              PropertyVideo[]
  socialVideosCreated         SocialVideoPost[]
  videoUploadSessions         VideoUploadSession[]
  propertyDrafts              PropertyDraft[]
  clients                     Client[]                @relation("AssignedAgent")
  deletedClients              Client[]                @relation("DeletedByClientAgent")
  lastAgentClients            Client[]                @relation("LastClientAgent")
  confirmedClientIntents      Client[]                @relation("ClientIntentConfirmation")
  reactivationOffers          Client[]                @relation("ReactivationOfferAgent")
  /// Раздел L (03.09.2026, план вечерней сессии): «это ваш клиент?» — карточки,
  /// по которым СПРОСИЛИ именно этого агента (см. Client.duplicateReviewAskedAgentId).
  duplicateReviewsAsked       Client[]                @relation("DuplicateReviewAskedAgent")
  /// Заявки на удаление клиента: поданные этим сотрудником и им же рассмотренные.
  deleteRequestsMade          ClientDeleteRequest[]   @relation("DeleteRequestAuthor")
  deleteRequestsRuled         ClientDeleteRequest[]   @relation("DeleteRequestDecider")
  /// Заявки на пересмотр числа объектов продавца: поданные этим сотрудником и им же рассмотренные.
  propertyCountDisputesMade   PropertyCountDispute[]  @relation("PropertyCountDisputeAuthor")
  propertyCountDisputesRuled  PropertyCountDispute[]  @relation("PropertyCountDisputeDecider")
  /// То же самое, но для объектов (31.08.2026, зеркало заявок на удаление клиента).
  propertyDeleteRequestsMade  PropertyDeleteRequest[] @relation("PropertyDeleteRequestAuthor")
  propertyDeleteRequestsRuled PropertyDeleteRequest[] @relation("PropertyDeleteRequestDecider")
  /// Заявки на изменение опубликованного объекта: поданные и решённые этим сотрудником (07.10.2026).
  propertyChangeRequestsMade  PropertyChangeRequest[] @relation("PropertyChangeRequestAuthor")
  propertyChangeRequestsRuled PropertyChangeRequest[] @relation("PropertyChangeRequestDecider")
  /// Отметки «выложено в группу Facebook», поставленные этим сотрудником (28.09.2026).
  groupShares                 PropertyGroupShare[]
  /// Возвраты роликов монтажёру на переделку, поданные этим сотрудником (20.09.2026).
  videoRemakeRequestsMade     VideoRemakeRequest[]    @relation("VideoRemakeRequestAuthor")
  /// Карточки, которые этот сотрудник проверил как служба безопасности.
  securityReviewed            Client[]                @relation("SecurityReviewer")
  /// Журнал изменений Royal Score: события про него и события, которые он вызвал.
  scoreEvents                 RoyalScoreEvent[]       @relation("ScoreEventAgent")
  scoreEventsCaused           RoyalScoreEvent[]       @relation("ScoreEventInitiator")
  /// Обязательные окна: итоги, которые этот сотрудник должен записать.
  pendingSummaries            PendingSummary[]        @relation("SummaryAgent")
  /// Показы этого сотрудника, по которым система звонила покупателю (13.09.2026).
  postShowingCalls            PostShowingCall[]       @relation("PostShowingCallAgent")
  /// Проверки собственника по показам этого сотрудника (16.09.2026).
  sellerProbeCalls            SellerProbeCall[]       @relation("SellerProbeAgent")
  /// Вопросы к собственнику, на которые ответил этот сотрудник.
  ownerAnswers                OwnerQuestion[]         @relation("OwnerQuestionAnswerer")
  managedCallbackAssignments CallbackRequest[] @relation("ManagedCallbackAssignee")
  interactions                Interaction[]           @relation("InteractionAgent")
  /// Записи хронологии, адресованные этому агенту, когда актор не он (SYSTEM/AI/BOT —
  /// см. Interaction.subjectAgentId, П-10).
  subjectInteractions         Interaction[]           @relation("InteractionSubject")
  deals                       Deal[]
  /// Сделки, комиссию по которым выплатил этот сотрудник (Пачка 14, 11.09.2026).
  dealsPayoutBy               Deal[]                  @relation("DealRealtorPayoutBy")
  /// Сделки, которые этот сотрудник аннулировал (C10, 02.10.2026).
  dealsAnnulledBy             Deal[]                  @relation("DealAnnulledBy")
  /// Документы сделок, загруженные этим сотрудником (Пачка 14, 11.09.2026).
  dealDocumentsUploaded       DealDocument[]
  /// Входящие звонки, по которым этому сотруднику поставлена задача перезвонить.
  incomingCallbacks           IncomingCall[]          @relation("IncomingCallCallback")
  incomingQualified           IncomingCall[]          @relation("IncomingCallQualifiedBy")
  /// Входящие, которые CRM увела этому агенту как ответственному (16.08.2026).
  incomingRouted              IncomingCall[]          @relation("IncomingCallRouted")
  priceChanges                PriceChange[]
  pushSubscriptions           PushSubscription[]
  pushActionTokens            PushActionToken[]
  /// Лента уведомлений в шапке (17-18.08.2026, по макету design_handoff: экран
  /// «notif»). Копия того, что уже уходит пушем — push эфемерен (не пришёл, если
  /// устройство офлайн), лента остаётся в БД и не теряется.
  notifications               Notification[]
  expenses                    Expense[]
  recurringExpenses           RecurringExpense[]
  kpiDailyScores              KpiDailyScore[]
  monthlyReports              MonthlyReport[]         @relation("MonthlyReportEditor")
  problemReports              ProblemReport[]         @relation("ProblemReportEditor")
  loginLogs                   LoginLog[]
  sessions                    Session[]
  cardSuggestions             CardSuggestion[]
  callAnalyses                CallAnalysis[]
  propertyShareLinks          PropertyShareLink[]
  ownerReportLinks            PropertyOwnerReportLink[]
  loginSmsCodes               LoginSmsCode[]
  /// Журнал вызовов ИИ-ассистента CRM (ai/assistant.ts) — не для ограничения
  /// доступа (это уже делает ownScope в runTool), а для прослеживаемости: если
  /// возникнет подозрение, что кто-то использует ассистента для сбора чужих
  /// данных, по этой таблице видно, кто, какой функцией и когда пользовался.
  aiAssistantAuditLogs        AiAssistantAuditLog[]
}

/// Журнал входов в CRM: одна запись = одна успешная выдача сессии (логин или логин+2FA).
/// Refresh-токены сюда не пишутся — это продление той же сессии, не новый вход.
/// Каждый сотрудник видит только свои записи (GET /me/logins).
model LoginLog {
  id          String   @id @default(uuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  /// Короткая человекочитаемая метка устройства, например "Chrome · Windows".
  device      String?
  /// Стабильный ключ устройства (браузер+ОС из user-agent) — по нему определяем
  /// «вход с нового устройства». IP не участвует: у мобильных операторов он меняется постоянно.
  deviceKey   String?
  /// Первый вход с этого deviceKey у данного агента — по нему шлём уведомления.
  isNewDevice Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([agentId, deviceKey])
}

/// Активная сессия входа — одна запись на устройство (агент+deviceKey), не на каждый
/// логин: повторный вход с того же браузера обновляет ту же строку. Refresh-токен несёт
/// id этой записи (sid) — так можно отозвать конкретное устройство (см. POST
/// /me/sessions/:id/revoke) и ограничить число одновременных устройств на аккаунт
/// (см. lib/sessions.ts). revokedAt=null и lastSeenAt моложе 7 дней — сессия активна;
/// иначе следующий /auth/refresh с её refresh-токеном отклоняется как истёкший.
model Session {
  id         String    @id @default(uuid())
  agentId    String
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deviceKey  String
  device     String
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@unique([agentId, deviceKey])
  @@index([agentId])
}

/// Месячный отчёт директору и админу (примечание владельца от 30.07: «чтобы каждый
/// месяц они мне приходили и я имел возможность добавлять инфу»).
///
/// Цифры считаются автоматически первого числа за прошедший месяц и СОХРАНЯЮТСЯ
/// снапшотом: отчёт за март, открытый в декабре, обязан показывать март таким, каким
/// он был, а не пересчитанный по сегодняшней базе (сделки отменяют, клиентов удаляют,
/// курс валюты меняется). Заметки — свободный текст владельца поверх цифр.
model MonthlyReport {
  id          String   @id @default(uuid())
  /// Первое число отчётного месяца, полночь по Душанбе. Уникально — один отчёт на месяц.
  periodStart DateTime @unique
  /// Снапшот цифр: воронка, сделки, комиссия, агенты, источники (см. lib/monthlyReport.ts).
  metrics     Json
  /// Дополнения владельца: что цифры не показывают.
  notes       String?
  /// Кто последний правил заметки — чтобы в отчёте было видно авторство.
  updatedById String?
  updatedBy   Agent?   @relation("MonthlyReportEditor", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([periodStart])
}

/// РАЗБОР ПРОБЛЕМНЫХ МЕСТ — еженедельный и ежемесячный (решение владельца
/// 11.08.2026: «крупный отчёт по всем проблемным местам агентов и клиентов, чтобы
/// понять, где происходит потеря контакта клиента, агента и так далее»).
///
/// ЧЕМ ОТЛИЧАЕТСЯ ОТ MonthlyReport. Тот отвечает «сколько заработали»: воронка,
/// комиссия, расходы, кто сколько закрыл. Этот отвечает на противоположный вопрос —
/// «где мы теряем»: оборванные диалоги, непринятые лиды, просроченные окна,
/// пропущенные звонки, объекты, застрявшие в подготовке. Две разные картины одного
/// месяца, и склеивать их в одну таблицу значило бы спрятать вторую под первой.
///
/// ЦИФРЫ — СНАПШОТ, по той же причине, что и в месячном отчёте: разобранный позже
/// звонок и заполненное позже окно не должны задним числом «исправлять» неделю, в
/// которой они висели непрочитанными. Заметки владельца лежат отдельным полем и
/// правятся когда угодно.
model ProblemReport {
  id                   String   @id @default(uuid())
  /// "week" | "month". Строкой, а не enum: периодов ровно два и добавлять третий
  /// (квартал) не должно означать миграцию типа в базе.
  period               String
  /// Начало отчётного периода — полночь по Душанбе (для месяца — первое число).
  periodStart          DateTime
  /// Конец периода, НЕ включая: [periodStart, periodEnd).
  periodEnd            DateTime
  /// Снапшот разбора: четыре раздела с выводом, динамикой и ссылками на карточки
  /// (см. lib/problemReport.ts, ProblemReportMetrics).
  metrics              Json
  /// Что видит владелец, а цифры не показывают: причины, договорённости, решения.
  notes                String?
  /// Голосовая заметка к notes (01.09.2026, кнопка микрофона) — файл как есть,
  /// не замена notes.
  notesVoiceUrl        String?
  notesVoiceTranscript String?
  updatedById          String?
  updatedBy            Agent?   @relation("ProblemReportEditor", fields: [updatedById], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  /// Один отчёт на период: повторная сборка (перезапуск контейнера, ручная кнопка,
  /// два тика крона подряд) не должна плодить вторую копию той же недели.
  @@unique([period, periodStart])
  @@index([period, periodStart])
}

/// Разбивка ежедневного KPI агента по метрикам — источник истины для Agent.kpi
/// (кэш последнего значения). Считается ночным кроном за прошедший день,
/// см. calculateDailyKPI в apps/api/src/kpi.ts.
/// ЖУРНАЛ ИЗМЕНЕНИЙ ROYAL SCORE — что и почему повлияло на счёт агента.
///
/// Спецификация владельца требует объяснимости: рядом с числом всегда должно быть
/// видно, из чего оно сложилось. Разбор по показателям это уже даёт (KpiDailyScore.
/// breakdown), но он отвечает на вопрос «сколько», а не «за что». Здесь — события
/// человеческим языком: «закрыта сделка», «просрочен показ», «директор поправил
/// вручную», с дельтой, причиной и тем, кто это сделал.
///
/// ЗАПИСИ НЕ УДАЛЯЮТСЯ И НЕ ПРАВЯТСЯ — маршрутов для этого нет вовсе. Журнал, из
/// которого можно вычеркнуть строку, не спор разрешает, а создаёт: «у меня было
/// плюс десять, а теперь нет».
model RoyalScoreEvent {
  id          String   @id @default(uuid())
  agentId     String
  agent       Agent    @relation("ScoreEventAgent", fields: [agentId], references: [id], onDelete: Cascade)
  at          DateTime @default(now())
  /// Код события: deal_closed | kpi_override | showing_missed и т.п. Строкой, а не
  /// enum: перечень будет пополняться по ходу, и миграция ради новой строки в
  /// журнале — цена без выгоды.
  kind        String
  /// Изменение в баллах, как его видит человек («+10»). Ноль допустим: бывают
  /// события без цены, но с объяснением. Float, а не Int: «объект исправлен после
  /// возврата на доработку» по спецификации даёт +2.7 (90% от снятых 3 баллов —
  /// 10% теряются навсегда, п. 20 таблицы владельца).
  delta       Float
  /// Человеческая формулировка: «Сделка №1042 закрыта».
  reason      String
  /// Кто инициировал. null — система (ночной пересчёт, автоматическое событие).
  initiatorId String?
  initiator   Agent?   @relation("ScoreEventInitiator", fields: [initiatorId], references: [id], onDelete: SetNull)
  /// ЧТО ИМЕННО породило событие: id сделки, показа, лида. Нужен ровно для одного —
  /// чтобы одно действие дало одни баллы. Без него повторный PATCH сделки (сеть
  /// моргнула, кнопку нажали дважды) писал бы «+10 за сделку» второй раз, и агент,
  /// умеющий кликать, обгонял бы агента, умеющего продавать.
  ///
  /// null — у событий, которые повторяться МОГУТ и должны: ручная правка счёта
  /// делается сколько угодно раз, и каждая обязана остаться в журнале отдельной
  /// строкой.
  sourceId    String?

  /// Уникальность — В ПРЕДЕЛАХ АГЕНТА, а не по всей базе (аудит 09.08.2026).
  /// Пока ключ был (kind, sourceId), «один штраф на карточку» означало один штраф
  /// на карточку НА ВСЮ КОМПАНИЮ: клиент, доставшийся второму агенту, приносил
  /// защиту от повтора вместе с собой — предупреждение о бездействии, штраф за
  /// незаполненную карточку и прочее второму и последующим агентам молча не
  /// записывались. Виноват оказывался только тот, кто дотронулся до карточки
  /// первым, а его сменщики получали её «уже отштрафованной» и работали без
  /// последствий вовсе.
  @@unique([kind, sourceId, agentId])
  @@index([agentId, at])
  /// Штраф за первый звонок (services/leads/firstCall.ts) ищет событие по одному
  /// sourceId, без kind и agentId, — уникальный ключ выше с него не начинается (№197).
  @@index([sourceId])
}

/// ОБЯЗАТЕЛЬНОЕ ОКНО — итог, который агент должен записать: по разговору, по
/// встрече, по принятому объекту.
///
/// Спецификация владельца требует, чтобы такое окно нельзя было просто закрыть.
/// ОТЛИЧИЕ ОТ СПЕЦИФИКАЦИИ, ОБОСНОВАННОЕ: оно блокирует не всю CRM, а выдачу НОВЫХ
/// лидов. Агент на показе с плохим интернетом не должен терять доступ к текущему
/// клиенту, а блокировка всего создаёт стимул заполнять мусором — и мусор в
/// карточке хуже пустоты, потому что по нему потом идёт подбор.
///
/// Отложить можно, но считано: срок и число откладываний в Настройках. Без счётчика
/// «отложить» — это кнопка «никогда».
model PendingSummary {
  id           String    @id @default(uuid())
  agentId      String
  agent        Agent     @relation("SummaryAgent", fields: [agentId], references: [id], onDelete: Cascade)
  /// call | meeting | property — по чему именно нужен итог.
  kind         String
  /// О чём итог: клиент или объект. Строкой, без внешнего ключа: запись переживает
  /// удаление карточки и после него всё равно должна быть закрыта или снята.
  subjectId    String
  /// Человеческая подпись предмета — чтобы окно не спрашивало «итог по uuid».
  subjectName  String
  /// С какого момента окно показывается. У итога объекта это «принят в работу
  /// плюс 36 часов», у остальных — сразу.
  dueAt        DateTime  @default(now())
  /// Отложено до этого момента. null — не откладывали.
  snoozedUntil DateTime?
  snoozeCount  Int       @default(0)
  /// Заполнено. Заполненные не удаляем: по ним видно, что человек делал.
  doneAt       DateTime?
  /// ЗАКРЫТО АГЕНТОМ БЕЗ ЗАПОЛНЕНИЯ (решение владельца 27.08.2026: «показал один
  /// раз — и хватит, дальше пусть висит в списке дел»). До этого окно возвращалось
  /// на каждом опросе, пока итог не запишут: агент по кругу жал «Отложить на 10
  /// минут», а после четвёртого раза кнопка исчезала и окно оставалось навсегда.
  ///
  /// Отдельная колонка, а не doneAt: «закрыл, сделаю потом» и «записал итог» —
  /// разные вещи. Слив их в одно поле, мы бы соврали и отчётам, и Royal Score.
  /// Невыполненное не пропадает: при закрытии заводится задача в списке дел
  /// (см. dismissSummary в lib/pendingSummaries.ts).
  dismissedAt  DateTime?
  createdAt    DateTime  @default(now())
  /// Когда РУКОВОДСТВУ отдельно ушёл пуш о просрочке этого окна (владелец
  /// 07.09.2026, разбор часов алармов) — независимо от штрафа/пуша агенту
  /// (те гейтятся обычными рабочими часами, см. lib/pendingSummaries.ts);
  /// пуш руководству ждёт часов алармов (Settings.alarmHours*).
  supervisorNotifiedAt DateTime?
  /// «Итог показа» просрочен дольше 24 часов от dueAt — агенту отдельный пуш,
  /// НЕЗАВИСИМО от переносов (пачка 10, 11.09.2026, п.3): прежний
  /// notifyOverdueSummaries штрафует только после snoozeMaxCount переносов, а на
  /// проде все 5 незакрытых показов провисели просроченными больше двух суток,
  /// ни разу не тронув snoozeCount (агент их не открывал вовсе). Только kind="meeting".
  showingAgentReminderAt DateTime?
  /// То же самое, для пуша РУКОВОДИТЕЛЮ через 48 часов и строки в утреннем отчёте
  /// (lib/morningNumbers.ts). Отдельное поле от supervisorNotifiedAt: то поле —
  /// часть snooze-гейта notifySupervisorsOfOverdueSummaries и означает другое.
  showingSupervisorAlertAt DateTime?

  /// Одно окно на предмет: повторный показ того же объекта или тот же принятый лид
  /// не должны плодить второе такое же требование.
  @@unique([kind, subjectId])
  @@index([agentId, doneAt])
  /// Выдача окна спрашивает «что показать агенту сейчас» — по агенту и обоим
  /// признакам закрытия сразу.
  @@index([agentId, doneAt, dismissedAt])
  /// Фоновые выборки без агента (lib/stuckPulse.ts: «висят дольше суток») —
  /// по признакам закрытия и сроку (№199).
  @@index([doneAt, dismissedAt, dueAt])
}

/// «УТОЧНЮ У СОБСТВЕННИКА И ВЕРНУСЬ» — механика, а не фраза.
///
/// Бот регулярно упирается в то, чего не знает никто, кроме собственника: готов ли
/// торговаться, свободна ли квартира на выходных, оставит ли мебель. Раньше он
/// говорил «уточню и вернусь» — и не возвращался никогда, потому что возвращаться
/// было нечему: фраза никуда не записывалась. Для клиента это хуже честного «не
/// знаю»: ему пообещали и забыли.
///
/// Теперь обещание превращается в запись: живой человек видит вопрос, отвечает, и
/// ответ САМ уходит клиенту в тот канал, откуда он писал. Круг замыкается кодом, а
/// не памятью агента.
model OwnerQuestion {
  id             String    @id @default(uuid())
  customerActionId String? @unique
  customerAction CustomerAction? @relation(fields: [customerActionId], references: [id], onDelete: Restrict)
  replyTarget Json?
  managedRevision BigInt?
  deliveryStatus String?
  /// Диалог, в котором прозвучало обещание, — по нему ответ и уходит обратно.
  conversationId String
  /// Кому отвечать (карточка клиента, если она уже заведена).
  clientId       String?
  /// О каком объекте речь, если бот его назвал.
  propertyId     String?
  /// Сам вопрос — словами бота, как он его понял.
  question       String
  askedAt        DateTime  @default(now())
  /// Ответ живого человека и кто его дал.
  answer         String?
  answeredAt     DateTime?
  answeredById   String?
  answeredBy     Agent?    @relation("OwnerQuestionAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)
  /// Когда ответ реально ушёл клиенту. Отдельно от answeredAt: человек мог ответить,
  /// а отправка сорваться — и это разные состояния, которые нельзя путать.
  deliveredAt    DateTime?
  /// Когда клиенту ушёл нейтральный автоответ бота из-за просрочки (владелец
  /// 05.08.2026 — реальный клиент прождал трое суток). Не то же самое, что answeredAt:
  /// вопрос остаётся открытым, сотрудник всё ещё обязан ответить по существу. Не даёт
  /// отправить автоответ на один и тот же вопрос дважды.
  autoRepliedAt  DateTime?

  @@index([conversationId])
  @@index([answeredAt])
  /// «Голос рынка» (03.10.2026): вопросы собственнику по объекту.
  @@index([propertyId])
}

/// «Соедините с оператором» — просьба клиента о живом звонке, записанная ботом.
/// Тот же принцип, что у OwnerQuestion: обещание превращается в запись, круг
/// замыкает код, а не память агента. Агент получает push, звонит из CRM
/// (наборщик/originate уже есть) и закрывает запрос.
/// Transport namespace, never a private identity proof. Unknown legacy mappings stay held.
model CustomerEndpointScope {
  legacyPhysicalQuiescence CustomerLegacyPhysicalQuiescence?
  recruitmentRecoveries RecruitmentRecovery[]
  rolloutAssignments CustomerAgentRolloutAssignment[]
  id String @id @default(uuid())
  realmKey String
  channel String
  transportKey String
  kind String @default("LEGACY_UNKNOWN")
  messengerAccountId String?
  messengerAccount MessengerAccount? @relation(fields: [messengerAccountId], references: [id], onDelete: SetNull)
  scopeRevision BigInt @default(0)
  /// Public installation metadata only; no credential or customer identity is stored.
  publicCredentialFingerprint String?
  publicResourceId String?
  inquiries CustomerInquiry[]
  botConversations BotConversation[]
  telegramConversations TelegramConversation[]
  telegramDirectConversations TelegramDirectConversation[]
  shieldStates OutboundShieldState[]
  shownProperties ShownProperty[]
  propertyExposures PropertyExposure[]
  propertyIngressTickets CustomerPropertyIngressTicket[]
  customerOutboxParts CustomerOutboxPart[]
  customerDeliveryAttempts CustomerDeliveryAttempt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([realmKey, channel, transportKey])
  @@index([messengerAccountId])
}

/// Single canonical state/contact row. Native deletion tombstones it; receipts survive.
model CustomerInquiry {
  recruitmentApplications JobApplication[] @relation("CustomerRecruitmentInquiry")
  id String @id @default(uuid())
  endpointScopeId String
  endpointScope CustomerEndpointScope @relation(fields: [endpointScopeId], references: [id], onDelete: Restrict)
  peerId String
  threadId String @default("")
  conversationId String? @unique
  conversation BotConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  telegramConversationId String? @unique
  telegramConversation TelegramConversation? @relation(fields: [telegramConversationId], references: [id], onDelete: SetNull)
  telegramDirectConversationId String? @unique
  telegramDirectConversation TelegramDirectConversation? @relation(fields: [telegramDirectConversationId], references: [id], onDelete: SetNull)
  stateRevision BigInt @default(0)
  intentRevision BigInt @default(0)
  ownershipEpoch BigInt @default(0)
  bindingRevision BigInt @default(0)
  ownerMode String @default("HOLD")
  /// Retained audit reference, not a private grant or cascade owner relationship.
  ownerAgentId String?
  ownerToken String?
  ownerLeaseUntil DateTime?
  migrationVersion Int @default(1)
  closedAt DateTime?
  publicState Json @default("{}")
  claimedContact Json?
  actionIntents Json @default("{}")
  lastAcceptedEventKey String?
  lastAcceptedOrder BigInt?
  legacyMemoryQuarantined Boolean @default(true)
  actions CustomerAction[]
  voiceSessions LiveVoiceSession[]
  deliveryParts CustomerOutboxPart[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([endpointScopeId, peerId, threadId])
  @@index([closedAt, ownerMode])
}

/// One global rollout policy. Expand starts OFF/compat; cutover needs a separate release.
model CustomerRuntimePolicy {
  rolloutConfig Json?
  id String @id @default("singleton")
  policyRevision BigInt @default(0)
  contractVersion String @default("compat")
  rolloutMode String @default("OFF")
  capabilities Json @default("{}")
  activeAgentRevisionId String?
  activeAgentRevision CustomerAgentRevision? @relation(fields: [activeAgentRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedAt DateTime @updatedAt
}

/// Immutable customer-core configuration. Registration and activation are server operations.
model CustomerAgentRevision {
  advancesFrom CustomerAgentRevisionAdvance[] @relation("CustomerRevisionAdvanceFrom")
  advancesTo CustomerAgentRevisionAdvance[] @relation("CustomerRevisionAdvanceTo")
  rolloutAssignments CustomerAgentRolloutAssignment[]
  id String @id
  manifestJson Json
  createdAt DateTime @default(now())
  activePolicies CustomerRuntimePolicy[]
  ingressTickets CustomerPropertyIngressTicket[] @relation("CustomerAgentTurnRevision")
  intakeTickets CustomerPropertyIngressTicket[] @relation("CustomerAgentIntakeRevision")
  outboxParts CustomerOutboxPart[]
}

/// Explicit owner publication for future turns only; append-only, original pins stay unchanged.
model CustomerAgentRevisionAdvance {
  id String @id @default(uuid())
  fromRevisionId String
  fromCohortId String
  toRevisionId String
  toCohortId String @unique
  policyRevision BigInt
  approvedAt DateTime @default(now())
  fromRevision CustomerAgentRevision @relation("CustomerRevisionAdvanceFrom", fields:[fromRevisionId], references:[id], onDelete:Restrict, onUpdate:Restrict)
  toRevision CustomerAgentRevision @relation("CustomerRevisionAdvanceTo", fields:[toRevisionId], references:[id], onDelete:Restrict, onUpdate:Restrict)
  @@unique([fromRevisionId,fromCohortId])
}

/// Immutable key-free provider configuration, resolved by the ORIGINAL manifest hash pair.
/// Registration is server-only; this table never enables the agent or approves API access.
model CustomerAgentRuntimeSnapshot {
  id String @id
  snapshotJson Json
  providerProfileHash String
  providerPolicyHash String
  createdAt DateTime @default(now())

  @@unique([providerProfileHash, providerPolicyHash], map: "customer_agent_runtime_profile_policy_key")
}

/// Local mutation journal. COMMITTED means resource persistence, not delivery/call completion.
model CustomerAction {
  id String @id @default(uuid())
  inquiryId String
  inquiry CustomerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  kind String
  generation BigInt
  status String @default("PROPOSED")
  stateRevision BigInt
  intentRevision BigInt
  ownershipEpoch BigInt
  bindingRevision BigInt
  scopeRevision BigInt
  policyRevision BigInt
  evidenceRefs Json
  resourceType String?
  resourceId String?
  receiptVersion Int?
  committedAt DateTime?
  supersededAt DateTime?
  failureCode String?
  /// Internal intake job progress; never projected as notification/delivery success.
  policyResult Json?
  /// Public per-action reference, unrelated to resource/Client IDs.
  publicRef String? @unique
  resourceRevision BigInt?
  callbackRequest CallbackRequest?
  bookedInteraction Interaction?
  ownerQuestion OwnerQuestion?
  pendingIntakeClient Client?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inquiryId, kind, generation])
  @@index([inquiryId, createdAt])
}

model CallbackRequest {
  id             String    @id @default(uuid())
  /// Local customer action receipt; null for legacy requests.
  customerActionId String? @unique
  customerAction CustomerAction? @relation(fields: [customerActionId], references: [id], onDelete: Restrict)
  requestKind String?
  lifecycleStatus String?
  lifecycleRevision BigInt?
  assignedAgentId String?
  assignedAgent Agent? @relation("ManagedCallbackAssignee", fields: [assignedAgentId], references: [id], onDelete: Restrict)
  acceptedAt DateTime?
  closureReason String?
  handoverFence Json?
  /// Диалог-источник (BotConversation.id) — по нему видно переписку.
  conversationId String?
  clientId       String?
  /// Откуда пришла просьба: INSTAGRAM | WHATSAPP | FACEBOOK | TELEGRAM.
  channel        String
  /// Куда звонить. Может быть пуст: в Instagram номера может не быть — тогда
  /// агент сначала просит его в переписке.
  phone          String?
  /// По какому вопросу, словами бота — чтобы агент звонил подготовленным.
  topic          String
  /// Просьбу высказал САМ КЛИЕНТ своими словами («соедините с оператором»), а не
  /// вывел бот по итогу разговора. Только такая просьба поднимает дежурного
  /// оператора и автодозвон (владелец 22.09.2026, см. ai/operatorHandoff.ts);
  /// остальные — обычная работа агентов, пуш идёт работающим с сообщениями.
  /// Умолчание true: записи, созданные до этого правила, вели себя именно так.
  byClientRequest Boolean  @default(true)
  requestedAt    DateTime  @default(now())
  /// Кто и когда закрыл: позвонил или пометил неактуальным.
  doneAt         DateTime?
  doneById       String?

  @@index([doneAt, requestedAt])
}

/// Кандидат на вакансию, собранный ботом в переписке (владелец 16.08.2026:
/// «бот либо берёт всю информацию сам, либо просит прислать на WhatsApp, а потом
/// передаёт руководству и админу»). Одна запись на диалог: анкета пополняется по
/// ходу разговора, а не плодится копиями на каждый ход.
/// Заявка агента на удаление карточки клиента (30.08.2026, просьба владельца).
/// Агент сам ничего не удаляет — он ПРОСИТ, решение принимает админ или директор.
/// Комментарий храним текстом: голос расшифровывается на фронте (useSpeechRecognition),
/// отдельного аудиофайла и его чистки не нужно.
model ClientDeleteRequest {
  id                     String    @id @default(uuid())
  clientId               String
  client                 Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Кто попросил.
  requestedById          String
  requestedBy            Agent     @relation("DeleteRequestAuthor", fields: [requestedById], references: [id], onDelete: Cascade)
  /// Код причины из DELETE_REQUEST_REASONS (packages/shared). Списки причин для
  /// покупателя и для продавца РАЗНЫЕ — не путать (см. selectableDeleteReasonsFor).
  reason                 String
  /// Необязателен: владелец сказал «достаточно выбрать причину». Обязателен только
  /// при причине OTHER — иначе руководство получает заявку без единого слова.
  comment                String?
  /// Голосовая заметка к comment (01.09.2026, кнопка микрофона) — файл как есть,
  /// не замена текста.
  commentVoiceUrl        String?
  commentVoiceTranscript String?
  /// PENDING — ждёт решения; APPROVED — карточка ушла в Корзину; REJECTED — отказ.
  status                 String    @default("PENDING")
  decidedById            String?
  decidedBy              Agent?    @relation("DeleteRequestDecider", fields: [decidedById], references: [id])
  decidedAt              DateTime?
  /// Почему отказали — без этого агент не понимает, что делать дальше.
  decisionNote           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([clientId, status])
}

/// ЗАЯВКА АГЕНТА НА ПЕРЕСМОТР ЧИСЛА ОБЪЕКТОВ (владелец 06.09.2026, разбор
/// слепых зон п.3; роль добавлена 07.09.2026 — «пусть у покупателя будет то
/// же самое»). То же устройство, что у ClientDeleteRequest выше: число пишет
/// ИИ (Client.sellerDeclaredPropertyCount для продавца,
/// Client.buyerDesiredPropertyCount для покупателя), агент не может
/// исправить его напрямую — только подать заявку, решение выносит руководитель
/// (право `clients.merge`, тот же круг, что уже решает споры о клиентах).
/// role различает, какую сторону клиента оспаривают — у клиента с dualIntent
/// может быть ОДНОВРЕМЕННО своя заявка на продавца и своя на покупателя.
/// Пока заявка PENDING, аларм «заявлено N, добавлено/закрыто M»
/// (lib/clientPropertyCountAlarm.ts) считает от числа ИИ (aiCount), а не от
/// предложенного агентом — иначе агент мог бы просто занижать число, чтобы не
/// получить аларм.
model PropertyCountDispute {
  id            String    @id @default(uuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   Agent     @relation("PropertyCountDisputeAuthor", fields: [requestedById], references: [id], onDelete: Cascade)
  /// SELLER — оспаривает sellerDeclaredPropertyCount; BUYER — buyerDesiredPropertyCount.
  role          String    @default("SELLER")
  /// Снапшот числа ИИ на момент подачи — решение руководителя должно быть по
  /// актуальному расхождению, а не по значению, которое ИИ мог уже поменять.
  aiCount       Int
  proposedCount Int
  reason        String
  /// PENDING — ждёт решения; APPROVED — соответствующее поле (по role) заменено
  /// на proposedCount; REJECTED — остаётся число ИИ.
  status        String    @default("PENDING")
  decidedById   String?
  decidedBy     Agent?    @relation("PropertyCountDisputeDecider", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([clientId, status])
  @@index([clientId, role, status])
}

/// Заявка агента на удаление карточки ОБЪЕКТА (31.08.2026) — зеркало
/// ClientDeleteRequest выше, то же устройство: агент называет причину, решение
/// принимает человек с правом `properties.delete` (директор/админ). Одобрение
/// удаляет объект тем же путём, что и прямое DELETE /properties/:id —
/// lib/trashProperty.ts, общая функция на оба входа.
model PropertyDeleteRequest {
  id                     String    @id @default(uuid())
  propertyId             String
  property               Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Кто попросил.
  requestedById          String
  requestedBy            Agent     @relation("PropertyDeleteRequestAuthor", fields: [requestedById], references: [id], onDelete: Cascade)
  /// Код причины из PROPERTY_DELETE_REQUEST_REASONS (packages/shared).
  reason                 String
  /// Необязателен, кроме причины OTHER — иначе руководство получает заявку без
  /// единого слова.
  comment                String?
  /// Голосовая заметка к comment (01.09.2026, кнопка микрофона) — файл как есть,
  /// не замена текста.
  commentVoiceUrl        String?
  commentVoiceTranscript String?
  /// PENDING — ждёт решения; APPROVED — объект ушёл в Корзину; REJECTED — отказ.
  status                 String    @default("PENDING")
  decidedById            String?
  decidedBy              Agent?    @relation("PropertyDeleteRequestDecider", fields: [decidedById], references: [id])
  decidedAt              DateTime?
  /// Почему отказали — без этого агент не понимает, что делать дальше.
  decisionNote           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([propertyId, status])
}

/// Вид заявки агента на изменение ОПУБЛИКОВАННОГО объекта (07.10.2026) — зеркало
/// PROPERTY_CHANGE_KINDS в packages/shared/src/propertyChangeRequest.ts.
enum PropertyChangeKind {
  PRICE_CHANGE
  CARD_DATA
  REMAKE_VIDEO
  UNPUBLISH
  OTHER
}

/// PENDING — ждёт решения; APPROVED — принято и выполнено; REJECTED — отказ;
/// CANCELLED — отозвана автором или закрыта вместе с объектом; FAILED — принято,
/// но CRM не смогла выполнить (текст в `error`, заявка остаётся видимой).
enum PropertyChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  FAILED
}

/// ЗАЯВКА АГЕНТА НА ИЗМЕНЕНИЕ ОПУБЛИКОВАННОГО ОБЪЕКТА (07.10.2026, решение
/// владельца): после публикации агент карточку не правит, а нажимает готовую
/// кнопку («Цена изменилась», «Перемонтировать ролик», …). Решает человек с правом
/// `properties.delete`; после «Принять» CRM сама делает то, что умеет через API
/// сетей, остаток руками — задачей человеку. Образец — PropertyDeleteRequest выше;
/// тело и итог — формы из packages/shared/src/propertyChangeRequest.ts.
model PropertyChangeRequest {
  id           String               @id @default(uuid())
  propertyId   String
  property     Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorId     String
  author       Agent                @relation("PropertyChangeRequestAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  kind         PropertyChangeKind
  status       PropertyChangeStatus @default(PENDING)
  /// Тело заявки по виду (priceChangePayloadSchema и соседи).
  payload      Json
  comment      String?
  decidedById  String?
  decidedBy    Agent?               @relation("PropertyChangeRequestDecider", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  /// PropertyChangeResult после «Принять»: что сделано, что остаётся руками.
  result       Json?
  /// Человеческий текст, если status = FAILED.
  error        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([propertyId, status])
  @@index([status, createdAt])
}

/// ВОЗВРАТ РОЛИКА МОНТАЖЁРУ НА ПЕРЕДЕЛКУ (20.09.2026, решение владельца: «чтобы
/// просто так не ходил, а причину чтобы я указал, зачем, чтобы он тоже прочитал»).
/// Одна запись — один заход, см. lib/publishedVideoFix.ts::sendBackToMontajer.
/// Поля карточки объекта здесь никогда не трогаются — это независимая история
/// «сколько раз и почему» поверх Property.videoRemakeCount.
model VideoRemakeRequest {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Код причины из VIDEO_REMAKE_REASONS (packages/shared) — строкой, тем же приёмом,
  /// что и PropertyDeleteRequest.reason выше: список причин меняется правкой одного
  /// файла в shared, без миграции. Человеческий текст — VIDEO_REMAKE_REASON_LABELS там же.
  reason        String
  /// Обязателен для WRONG_CAPTION и OTHER (zod-схема sendBackToMontajerSchema в
  /// packages/shared, применяется в routes/properties/videos.ts), необязателен
  /// для остальных причин.
  comment       String?
  /// Кто нажал «Вернуть монтажёру».
  requestedById String
  requestedBy   Agent    @relation("VideoRemakeRequestAuthor", fields: [requestedById], references: [id], onDelete: Cascade)
  /// ФАКТИЧЕСКИЙ текст, посчитанный на момент возврата тем же buildMontajerMessageText,
  /// что и реальная отправка, — не вторая копия сборки (владелец 20.09.2026: «я хочу
  /// видеть, что отправляется монтажёру»). GET /:id/montajer-preview зовёт ту же функцию
  /// с теми же входами и обязан вернуть то же самое — на этом стоит тест.
  messageText   String?
  /// Старые посты ролика снимаются не при возврате, а когда выходит новый ролик
  /// (владелец 30.10.2026: «когда выйдет новый»). Ставит возврат по смене цены или
  /// данных карточки; выполняет задание публикации (replaceOldPostsBeforeRemakePublish).
  replaceOldPostsOnPublish Boolean   @default(false)
  /// Когда задание публикации нового ролика сняло старые посты; null — ещё не снимало.
  oldPostsReplacedAt       DateTime?
  createdAt     DateTime @default(now())

  @@index([propertyId])
}

/// ЖУРНАЛ ВСЕГО, ЧТО CRM ОТПРАВИЛА МОНТАЖЁРУ ПО ОБЪЕКТУ (20.09.2026, владелец:
/// «что было отправлено монтажёру, я хочу видеть, что отправляется ему вообще,
/// где-то должно быть окно или что-то»). Одна запись — одно реально ушедшее
/// сообщение, текстом ровно как ушло. Пишется ЕДИНСТВЕННОЙ функцией
/// recordMontajerMessage (lib/videoHandoff.ts) из каждого места отправки —
/// первая передача на монтаж, перемонтаж, снятие с монтажа, удаление объекта,
/// квитанция после приёма, — а не отдельной вставкой на каждый вызов: новый
/// будущий вызов иначе забудут завести, и журнал начнёт молча врать неполнотой.
model MontajerMessage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// "HANDOFF" | "REMAKE" | "CANCELLED" | "PROPERTY_DELETED" | "RECEIPT" | "FACTS_CHANGED" —
  /// см. MontajerMessageKind в lib/videoHandoff.ts.
  kind       String
  text       String
  sentAt     DateTime @default(now())

  @@index([propertyId, sentAt])
}

/// ИСТОРИИ INSTAGRAM (21.09.2026) — ОТДЕЛЬНЫЙ журнал от Property.publishedChannels/
/// publishedPostIds намеренно: те два поля означают «где висит пост» (от них зависит
/// повторная публикация, снятие с публикации, выход объекта в продажу через
/// blockersForSale), а история живёт 24 часа и пропадает сама — добавлять
/// "INSTAGRAM_STORY" в publishedChannels значило бы врать этим механизмам, что
/// пост всё ещё где-то висит. Одна строка — одна опубликованная часть истории
/// (ролик длиннее 60 секунд режется на последовательные части, у каждой свой
/// mediaId и свой partIndex); «когда выкладывали последний раз» — это
/// MAX(publishedAt) по объекту.
model PropertyStoryPost {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// "INSTAGRAM" или "FACEBOOK" (28.09.2026, Page Stories API) — поле уже
  /// строкой (не enum), как channel у остальных публикаций в проекте. Одно и то
  /// же событие (VIDEO/PRICE_DROP/SOLD/CARD) может дать ДВЕ строки, по одной на
  /// канал — кулдаун повторов (lib/instagramStories.ts) считается ПО ПАРЕ
  /// (kind, channel), не по kind одному, иначе Facebook, включённый позже
  /// Instagram, никогда не получил бы свою историю.
  channel    String
  /// id media, который вернул Graph API на media_publish этой части.
  mediaId    String
  /// 0 у ролика короче 60 секунд (единственная часть) либо порядковый номер
  /// последовательной части нарезанного ролика — истории идут друг за другом
  /// в том же порядке, в котором опубликованы.
  partIndex  Int      @default(0)
  publishedAt DateTime @default(now())
  /// Вид истории (21.09.2026, история «цена снижена»): "VIDEO" — ролик монтажёра
  /// (единственный вид до этой миграции, значение по умолчанию сохраняет старые
  /// строки как есть), "PRICE_DROP" — автоматическая картинка при снижении цены
  /// (lib/instagramStories.ts::publishPropertyPriceDropStory). Различать виды
  /// нужно для дневного лимита повторов — история о снижении цены не чаще раза
  /// в сутки на объект, а ролик монтажёра под это ограничение не подпадает.
  kind        String   @default("VIDEO")

  @@index([propertyId, publishedAt])
  @@index([propertyId, kind, publishedAt])
}

/// КОНТЕЙНЕР INSTAGRAM, ПЕРЕЖИВШИЙ ОКНО ОЖИДАНИЯ (21.09.2026, случай №111 — объект
/// №111, публикация упала с «Видео не обработалось за отведённое время ожидания»,
/// пока Meta одновременно обрабатывала два объекта плюс историю; сам ролик крошечный
/// (22.3 с, 26.8 МБ), дело было не в весе, а в очереди у Meta). Раньше при истечении
/// ожидания `creation_id` терялся навсегда, хотя ролик у Meta уже был закачан и
/// обрабатывался — и его оставалось только опубликовать. Эта таблица — память об
/// этих контейнерах: lib/socialPublish.ts::rememberInstagramContainer пишет сюда
/// СРАЗУ после создания контейнера (с 22.09.2026 — до окна ожидания, а не после:
/// рестарт внутри окна иначе терял уже обработанный ролик молча), живой процесс
/// сам закрывает запись как PUBLISHED или REJECTED, а
/// lib/instagramPendingContainers.ts::runInstagramPendingContainersTick (крон,
/// каждые 5 минут, см. cron.ts) периодически проверяет каждый и либо публикует, либо
/// помечает протухшим.
model PendingInstagramContainer {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// creation_id, который вернул POST /{ig-user-id}/media — им же публикуем
  /// (POST /media_publish) и им же проверяем status_code.
  containerId String   @unique
  /// "REEL" — публикация в ленту (Property.publishedChannels/publishedPostIds/
  /// instagramUrl, тот же путь, что и обычная успешная публикация —
  /// lib/videoHandoff.ts::applySucceededPublishResults). "STORY" — история
  /// (PropertyStoryPost), publishedChannels не трогает.
  kind        String
  /// Только для kind="STORY": вид записи PropertyStoryPost, который нужно создать
  /// при завершении — "VIDEO" (ролик монтажёра) или "PRICE_DROP" (картинка
  /// «цена снижена»), см. PropertyStoryPost.kind.
  storyKind   String?
  /// Только для kind="STORY": порядковый номер части нарезанного ролика — тот же
  /// смысл, что и PropertyStoryPost.partIndex.
  partIndex   Int?
  /// PENDING — ждёт проверки; PUBLISHED — дозавершено успешно (запись остаётся
  /// для истории, крон её больше не трогает); REJECTED — Meta вернула ERROR при
  /// проверке (честный отказ, залогирован при переходе); EXPIRED — контейнер
  /// старше срока жизни у Meta (см. INSTAGRAM_CONTAINER_MAX_AGE_MS в
  /// lib/instagramPendingContainers.ts) и публиковать его больше нет смысла.
  /// CANCELLED — объект ушёл в Корзину, пока контейнер ждал обработки: публикуем
  /// не мы, а Meta по нашей команде, и команды больше не будет (22.09.2026,
  /// см. cancelPendingInstagramContainersForTrashed там же). В «Зависшую работу»
  /// не попадает намеренно: человеку тут делать нечего, это не сбой.
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  lastCheckedAt DateTime?
  resolvedAt  DateTime?
  /// Текст отказа/протухания — только когда status != PENDING/PUBLISHED.
  error       String?

  @@index([status, createdAt])
}

/// Public job openings maintained by staff; not candidate records or HR decisions.
model RecruitmentPosition {
  applications JobApplication[] @relation("CustomerRecruitmentPosition")
  hrApplications JobApplication[] @relation("HRRecruitmentPosition")
  key          String @id
  titleRu      String
  titleTg      String
  detailsRu    String @default("")
  detailsTg    String @default("")
  isOpen       Boolean @default(false)
  revision     Int @default(1)
  screeningRules Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  publications RecruitmentPublication[]
  keywords     RecruitmentKeyword[]
}

model RecruitmentPublication {
  code        String @id
  positionKey String
  position    RecruitmentPosition @relation(fields: [positionKey], references: [key], onDelete: Cascade, onUpdate: NoAction)
  @@index([positionKey])
}

model RecruitmentKeyword {
  word        String @id
  positionKey String
  position    RecruitmentPosition @relation(fields: [positionKey], references: [key], onDelete: Cascade, onUpdate: NoAction)
  @@index([positionKey])
}

model JobApplication {
  /// Managed own-inquiry intake; never a phone/profile identity merge.
  customerInquiryId String?
  customerInquiry CustomerInquiry? @relation("CustomerRecruitmentInquiry", fields: [customerInquiryId], references: [id], onDelete: Restrict)
  customerPositionKey String?
  customerPosition RecruitmentPosition? @relation("CustomerRecruitmentPosition", fields: [customerPositionKey], references: [key], onDelete: Restrict)
  customerApplicationRevision BigInt?
  customerPortfolio Json?
  recruitmentResume Json?
  recruitmentPhoneOverride Boolean @default(false)
  /// Explicit staff assignment of a historical application, never a CORE source.
  hrPositionKey String?
  hrPosition RecruitmentPosition? @relation("HRRecruitmentPosition", fields: [hrPositionKey], references: [key], onDelete: Restrict)
  @@unique([customerInquiryId, customerPositionKey])
  id                             String    @id @default(uuid())
  /// Диалог-источник. Уникален: upsert по нему и держит «одну анкету на разговор».
  conversationId                 String?   @unique
  /// Досье того, кто анкету заполнил. Появилось 21.09.2026: до него анкета жила
  /// только диалогом, и кандидат, написавший сперва в Instagram, а потом в
  /// WhatsApp, заводил ВТОРУЮ анкету, а бот заново спрашивал возраст и опыт.
  /// Досье есть у каждого написавшего с первого сообщения — в отличие от Client,
  /// который появляется только у оформленного лида.
  contactProfileId               String?
  contactProfile                 ContactProfile? @relation(fields: [contactProfileId], references: [id], onDelete: SetNull)
  /// Карточка клиента, если она у человека есть. Нужна экрану руководства: там
  /// анкеты сводятся с обращениями того же человека.
  clientId                       String?
  client                         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  channel                        String
  /// Имя профиля в мессенджере — на случай, когда кандидат не назвал своего.
  contactName                    String?
  name                           String?
  age                            Int?
  /// Опыт в недвижимости/продажах, словами кандидата.
  experience                     String?
  hasCar                         Boolean?
  /// Сильное желание работать — со слов кандидата, прямой да/нет вопрос модели
  /// (28.09.2026). Машина + желание = GREEN (Нурмухаммад, подтверждено Dan):
  /// решает jobPriority вместе с hasCar. Не спросили — null.
  strongMotivation               Boolean?
  /// Самое большое достижение в работе, словами кандидата (28.09.2026, для резюме).
  achievements                   String?
  languages                      String?
  /// Когда готов начать, словами кандидата.
  startWhen                      String?
  phone                          String?
  /// Когда боту поручили спросить номер у этого кандидата (догоняющая просьба,
  /// lib/askCandidatePhone.ts). Заполнено — второй раз не пишем: человек уже
  /// получил просьбу, и повторная выглядит как рассылка.
  phoneAskedAt                   DateTime?
  /// Город кандидата (16.08.2026: отбор ведём по Душанбе, но пишем как сказал).
  city                           String?
  /// Учится ли СЕЙЧАС в вузе. Курсы и тренинги сюда не относятся — они отказом не
  /// являются (правила отбора владельца 16.08.2026). null — ещё не спросили.
  studyingUniversity             Boolean?
  /// Учится ли СЕЙЧАС где угодно: школа, лицей, колледж, техникум, вуз. Курсы и
  /// тренинги — не в счёт. null — ещё не спросили, решения по отбору нет.
  /// Отдельное поле от studyingUniversity: по тому уже принято eligible у старых
  /// анкет, и переименование задним числом переписало бы историю отбора.
  studyingNow                    Boolean?
  /// Работает ли СЕЙЧАС где-то ещё. Критерий владельца 30.08.2026: берём тех, кто
  /// может работать полный день без совмещения. null — ещё не спросили.
  employedNow                    Boolean?
  /// Образование словами кандидата: юрист, МО, дизайн, строительство и т.п.
  education                      String?
  /// Был ли РЕАЛЬНЫЙ опыт работы в продажах товара/услуги или в недвижимости —
  /// прямой да/нет вопрос модели (25.09.2026, а не её собственное мнение о цвете):
  /// «интересно» или закупки/снабжение — false, не спросили — null. Решает
  /// jobPriority (ai/jobApplication.ts) вместе с ключевыми словами experience.
  salesExperience                Boolean?
  /// Высшее/диплом по целевой специальности (юрист, МО, дизайн интерьера,
  /// художник, графдизайн, IT, мастер-строитель «усто») — прямой да/нет вопрос
  /// модели, тем же поводом 25.09.2026. Не спросили — null.
  targetEducation                Boolean?
  /// Приоритет по опыту: GREEN — продажи или недвижимость; YELLOW — смежное
  /// (юрист, интерьер, ремонт, стройка); RED — опыт есть, но не по теме.
  /// Клиенту цвет не называется никогда — это внутренняя пометка для руководства.
  /// С 25.09.2026 ставится ТОЛЬКО кодом (jobPriority), не моделью — см. её шапку.
  priority                       String?
  /// Одной фразой: почему присвоен именно этот цвет. С 25.09.2026 тоже пишет код
  /// (jobPriorityReason), согласованно с priority.
  priorityReason                 String?
  /// Прошёл ли обязательный фильтр (возраст от 24 и не учится в вузе). false —
  /// анкета сохраняется для истории, но в очередь руководству не идёт.
  eligible                       Boolean?
  /// «Всё равно позвать» (02.10.2026): руководитель берёт кандидата в работу
  /// вопреки отбору. true — анкета считается прошедшей во всех корзинах и
  /// счётчиках (lib/vacancyVisibility.ts). Отдельно от eligible: тот бот
  /// пересчитывает на каждом ходе и затёр бы решение человека. null — решения нет.
  eligibleOverride               Boolean?
  /// Всё, что кандидат рассказал, одним текстом (включая присланное резюме).
  rawText                        String?
  /// Файл резюме (PDF/документ/фото) — последний присланный кандидатом за весь
  /// разговор, как есть, из закрытого хранилища переписки (lib/privateFiles.ts,
  /// то же имя, что у ConversationMessage.attachments[].file). Раньше от резюме
  /// оставался только пересказ модели в rawText — сам файл искали в переписке
  /// вручную. 17.09.2026, перед запуском рекламы вакансии.
  cvFile                         String?
  /// Воронка найма (владелец 31.08.2026, расширено с 4 до 6 стадий по разбору
  /// ATS-практик): NEW — не разобрана; REVIEWED — посмотрели; INTERVIEW —
  /// собеседование назначено (обязателен interviewAt); INTERVIEWED — проведено;
  /// HIRED — принят на работу (обязателен hiredAt); REJECTED — отказ (обычно с
  /// rejectionReason). Старое значение INVITED переименовано в INTERVIEW
  /// миграцией данных — смысл тот же, «позвали на собеседование».
  status                         String    @default("NEW")
  reviewedById                   String?
  /// Когда назначено собеседование. Обязательно при переходе в статус INTERVIEW —
  /// без даты «собеседование назначено» ничего не говорит руководству, что и
  /// когда делать дальше.
  interviewAt                    DateTime?
  /// Заметки по итогам общения: впечатление, сильные/слабые стороны — то, что
  /// не влезает в анкету бота и появляется только после живого разговора.
  interviewNote                  String?
  /// Почему отказали — коротко, словами того, кто принял решение. Не список
  /// вариантов на выбор: причин слишком много, а руководитель у нас один-два
  /// человека, свободный текст точнее любого справочника на такой команде.
  rejectionReason                String?
  /// Голосовая заметка к причине отказа (01.09.2026, кнопка микрофона в
  /// VacancyStageActions) — файл как есть, не замена rejectionReason.
  rejectionReasonVoiceUrl        String?
  rejectionReasonVoiceTranscript String?
  /// Когда фактически вышел на работу. Отдельно от updatedAt: сам статус могли
  /// проставить и раньше или позже реальной даты выхода.
  hiredAt                        DateTime?
  /// Кадровый резерв — сильный кандидат, который сейчас не подошёл (не было
  /// места, не вовремя написал), но к нему стоит вернуться при следующем наборе.
  /// Не статус, а пометка поверх REJECTED: не мешает пайплайну, но не даёт
  /// анкете затеряться совсем.
  talentPool                     Boolean   @default(false)
  /// Звонки робота с приглашением на собеседование (25.09.2026).
  inviteCalls                    InterviewInviteCall[]
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  @@index([status, createdAt])
  /// Все анкеты одного человека — свод «что он уже рассказал» и экран руководства.
  @@index([contactProfileId])
  @@index([clientId])
}

model KpiDailyScore {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Дата, за которую считался KPI (без времени — полночь Душанбе).
  date      DateTime
  score     Int
  /// {response?, crm?, discipline?, photo?, video?, contract?} — набранные/максимальные баллы по каждой
  /// активной в этот день метрике, для разбора споров и дашборда.
  breakdown Json?
  createdAt DateTime @default(now())

  @@unique([agentId, date])
  @@index([agentId])
  @@index([date])
}

/// Одна запись = одна подписка Web Push (браузер/устройство). У агента может быть
/// несколько одновременно (телефон + рабочий ПК) — уведомление уходит на все сразу.
model PushSubscription {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  /// Когда устройство в последний раз подтвердило, что живо (повторная регистрация
  /// подписки или подтверждение доставки кода входа). null — только createdAt.
  lastSeenAt DateTime?

  @@index([agentId])
  @@index([agentId, lastSeenAt])
}

/// Лента уведомлений сотрудника (17-18.08.2026, макет design_handoff: экран
/// «notif», колокольчик в шапке). Пишется РЯДОМ с каждым уже существующим
/// вызовом sendPushToAgent/sendPushToAgents (см. lib/notifications.ts) —
/// одна точка правды на текст, лента и пуш не расходятся. Push эфемерен
/// (не долетел — офлайн/нет подписки), эта таблица — постоянная история.
model Notification {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Тип события — тот же смысл, что `PushPayload.kind` (используется для
  /// подбора иконки на фронте и для личных настроек «отключить этот вид»).
  kind      String
  /// УРОВЕНЬ: APPROVAL | CRITICAL | INSIGHT | OTHER — деление ПО СУТИ ДЕЛА, как
  /// его описал владелец (ждёт решения / критичное / инсайты / прочее), а не по
  /// громкости. Не то же, что kind: вид отвечает «про что это» и его можно
  /// отключить в настройках, уровень отвечает «что это за дело» и отключению не
  /// подлежит. Умолчание выводится из kind (notificationLevelOf в
  /// packages/shared/src/push.ts) — иначе уровень пришлось бы дописать в сотню
  /// мест разом, и до тех пор три верхних раздела стояли бы пустыми.
  level     String   @default("OTHER")
  title     String
  body      String
  /// Куда вести при клике (react-router путь). Может быть пустым — тогда
  /// уведомление просто отмечается прочитанным без перехода.
  url       String?
  /// ТОТ ЖЕ tag, что уходит в PushPayload (владелец 20.08.2026, «одинаковые
  /// уведомления от одного повода — в одну строку, а не пачкой»). На
  /// устройстве уведомления с одинаковым tag уже схлопывались в один БАННЕР
  /// (см. PushPayload.tag) — здесь тот же принцип применён к самой ленте:
  /// повторное событие с тем же (agentId, tag) обновляет ЭТУ строку
  /// (count++, отметка read сбрасывается) вместо новой. null — уведомление
  /// без общего повода (разовое событие), схлопывать не с чем.
  tag       String?
  /// Сколько раз подряд повторилось одно и то же событие (тот же tag), пока
  /// агент не открыл ленту заново. 1 — обычное одиночное уведомление.
  count     Int      @default(1)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  /// ТОЧНЫЙ ПРИЗНАК «ПОГАШЕНО СИСТЕМОЙ, А НЕ ПРОЧИТАНО АГЕНТОМ» (Пачка 19,
  /// 12.09.2026). До этой колонки фронт красил «Передан» эвристикой
  /// (kind==="lead" && read && url на карточку — см. историю
  /// apps/web/src/lib/notificationTransferHint.ts) — ложные срабатывания были
  /// осознанным компромиссом: лид, который агент честно принял и прочитал сам,
  /// тоже подходил под условие. retiredAt ставит только closeNotifications
  /// (lib/notifications.ts), когда спутник гаснет из-за смены владельца/статуса
  /// клиента, а не открытия ленты агентом — эвристика больше не нужна.
  /// null — обычное уведомление (просмотрено агентом либо ещё не тронуто).
  retiredAt     DateTime?
  /// Человекочитаемая причина гашения — «клиент передан Иванову», «агент
  /// заморожен» и т.п. Пишется тем же вызовом, что ставит retiredAt.
  retiredReason String?

  @@index([agentId, read])
  @@index([agentId, createdAt])
  @@index([agentId, tag])
  /// Ночная проверка 01.10.2026, №196: shouldAlert (lib/notifications.ts) спрашивает
  /// «последнее уведомление с этим tag» у двенадцати тревог каждый час — без
  /// индекса по (tag, createdAt) это полный проход по ленте.
  @@index([tag, createdAt])
  /// Ночная уборка ленты (cron.ts, log-cleanup): `createdAt < срок` без агента.
  @@index([createdAt])
  /// Раздел «Срочное» отбирает непрочитанное по уровню — без индекса это
  /// последовательный проход по всей ленте агента на каждом открытии колокольчика.
  @@index([agentId, level, read])
}

/// ОЧЕРЕДЬ АЛАРМОВ РУКОВОДСТВУ — ЧАСЫ АЛАРМОВ (владелец 07.09.2026, разбор
/// «все уведомления/пуши/алармы руководителю — в его часы, 9:50–14:45»).
///
/// До этого модуля в CRM было больше 20 разных мест, где событие (заявка
/// агента, антифрод-эскалация, ночной финансовый крон, просроченный ключ и
/// т.д.) слало пуш директору/руководству НАПРЯМУЮ, в любой час — единого
/// способа отложить доставку не было, и почти в каждом месте пришлось бы
/// изобретать свою пару «флаг + повторный тик» (ровно так это и сделано
/// точечно для Client.phoneAskFlaggedAt и Client.refusedHighScoreFlaggedAt
/// до появления этой очереди). Вместо 20 разных флагов — один: событие
/// (любой час, дёшево) кладёт строку сюда через lib/directorAlertQueue.ts
/// ::enqueueDirectorAlert, а один общий сборщик flushDirectorAlertQueue
/// (гейт — isWithinAlarmHours) разбирает очередь и шлёт по-настоящему.
///
/// Получатели — ПРАВО или РОЛИ, не готовый список id: список агентов с
/// правом/ролью мог измениться за время ожидания в очереди, а доставлять
/// нужно тем, кто отвечает за это СЕЙЧАС, а не в момент события.
model PendingDirectorAlert {
  id                   String    @id @default(uuid())
  /// Право получателей (findAgentsWithPermission, например "clients.assign").
  /// Ровно одно из recipientPermission/recipientRoles заполнено.
  recipientPermission  String?
  /// Роли получателей (Agent.role), например ["DIRECTOR"] или ["DIRECTOR","ADMIN"].
  recipientRoles       String[]  @default([])
  /// Не слать этому агенту, даже если он входит в право/роли выше — например,
  /// директор, который сам только что вошёл с нового устройства, не должен
  /// получить дубль «вход с нового устройства» ещё и по директорскому каналу
  /// (свой собственный, персональный пуш он уже получил мгновенно).
  excludeAgentId       String?
  title                String
  body                 String
  url                  String?
  /// PushPayload.kind — для иконки на фронте, необязателен.
  kind                 String?
  /// Важность (владелец 09.09.2026, раздел «Срочное»). null — вывести из kind
  /// при доставке. Заполняется явно только теми алармами, для которых умолчание
  /// врёт: «агент бросил клиента» и еженедельная сводка о дублях — не одного веса.
  level                String?
  /// Тот же tag, что и у обычных Notification — дедуп/схлопывание в ленте
  /// работает тем же способом (upsertByTag в lib/notifications.ts).
  tag                  String?
  createdAt            DateTime  @default(now())
  /// null — ещё в очереди. Заполнено — сборщик уже разобрал эту строку
  /// (доставил либо получателей не нашлось — оба случая закрывают запись).
  sentAt               DateTime?

  @@index([sentAt, createdAt])
  /// shouldAlert (lib/notifications.ts, №196): последняя запись очереди с этим tag.
  @@index([tag, createdAt])
}

/// Журнал обращений к ИИ-ассистенту CRM (ai/assistant.ts) — прослеживаемость, а
/// не защита данных: изоляция по агенту (ownScope) уже стоит в runTool на каждом
/// инструменте. Эта таблица нужна, только чтобы разбирающий инцидент мог
/// посмотреть историю: кто, каким инструментом и когда пользовался.
///
/// argsSummary хранит МАКСИМУМ короткую подсказку про аргументы вызова (например
/// текст поискового запроса) — не сам результат и не чувствительные поля вроде
/// телефона: цель записи — проследить факт обращения, а не задублировать данные,
/// которые и так под ownScope.
model AiAssistantAuditLog {
  id          String   @id @default(uuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool        String
  argsSummary String?
  resultCount Int?
  createdAt   DateTime @default(now())

  @@index([agentId, createdAt])
}

/// Право на ОДНО действие из шторки уведомлений (решение владельца 11.08.2026:
/// кнопки «Принять»/«Отклонить» прямо в push).
///
/// Почему это вообще нужно: service worker живёт вне вкладки, у него нет ни JWT,
/// ни доступа к хранилищу приложения — нажатие на кнопку в шторке не может
/// сходить в API от имени агента. Поэтому право приезжает вместе с уведомлением.
///
/// Что здесь сделано, чтобы маркер не стал вторым паролем:
///  * в базе только SHA-256 — утечка дампа не даёт действующих маркеров;
///  * одноразовый: сжигается атомарным updateMany по `usedAt: null`, поэтому
///    двойное нажатие (или доставка уведомления на два устройства) не выполняет
///    действие дважды;
///  * привязан к паре «агент + клиент» и к одному виду действия — ничего, кроме
///    приёма или отклонения именно этого лида, им сделать нельзя;
///  * живёт минуты (Settings.pushActionTtlMinutes), чтобы уведомление, провисевшее
///    в шторке сутки, уже ничего не делало.
model PushActionToken {
  id        String    @id @default(uuid())
  /// SHA-256 в hex от самого маркера. Сам маркер существует только внутри
  /// зашифрованного payload уведомления и в памяти устройства агента.
  tokenHash String    @unique
  agentId   String
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Клиент (лид), к которому относится действие.
  clientId  String
  expiresAt DateTime
  /// Момент сжигания. null = маркер ещё не использован.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([agentId])
  @@index([expiresAt])
}

model District {
  id   String @id @default(uuid())
  name String @unique
  city String @default("Душанбе")

  /// Идентификатор источника (лицензированный адресный слой Душанбе,
  /// 12.09.2026, docs/geo-match-plan-12-09.md, блок B) — `id` четырёх районов
  /// в `районы.json`. Четыре района в базе уже существуют (см. seed.ts), скрипт
  /// импорта их не создаёт, а находит по имени и дописывает сюда geo-поля —
  /// поэтому `sourceId` необязателен: старую строку он тоже обязан принять.
  sourceId String? @unique
  /// Название на таджикском, как оно в источнике («Ноҳияи Исмоили Сомонӣ»).
  nameTj   String?
  lat      Decimal?
  lng      Decimal?
  /// Граница района, WKT (WGS84), как отдала выгрузка — POLYGON(...). Не
  /// парсится в отдельные точки: полигонов всего 31 на весь справочник,
  /// точка-в-полигоне считается в памяти (см. lib/geo.ts), PostGIS не подключаем.
  boundary String?

  properties      Property[]
  clients         Client[]
  cardSuggestions CardSuggestion[]
  buildings       Building[]
  streets         Street[]
  landmarks       Landmark[]
}

/// СПРАВОЧНИК ДОМОВ — лицензированный адресный слой Душанбе (12.09.2026,
/// docs/geo-match-plan-12-09.md, блок B). Источник: `дома.json` (24 325 записей),
/// разовая выгрузка, наполняется скриптом `prisma/scripts/import-geo.ts`, не
/// миграцией (в 338 миграциях репозитория `INSERT INTO` не встречается ни разу).
///
/// Источник правды НЕ меняется (раздел 3 плана): `Property.address/lat/lng/
/// districtId` остаются как есть, эта таблица ничему из них не противоречит и
/// пока ни с чем не связана внешним ключом — она база для будущего блока F
/// («дом как сущность», отложен) и для геосправочников блока B уже сейчас.
model Building {
  id         String   @id @default(uuid())
  /// Идентификатор дома в источнике (`id` из `дома.json`, вида `ya-…`/`osm-…`).
  /// Ключ идемпотентного upsert при повторном запуске импорта.
  sourceId   String   @unique
  /// Название улицы текстом, как в источнике. У 1 695 из 24 325 домов пусто —
  /// это дома в микрорайонах/жилых массивах советской застройки, где
  /// традиционного «улица + номер» адреса не было никогда, а не брак данных
  /// (проверено: у 988 из них нет и микрорайона/массива тоже — только точка).
  /// Поэтому поле nullable, хотя в остальном справочнике оно почти всегда есть.
  street     String?
  houseNumber String
  /// Название микрорайона текстом (не FK на Microdistrict — это тот же
  /// справочник, но связь один-к-одному по имени не гарантирована источником:
  /// у 21 512 из 24 325 домов поле пустое). Заполнено у 2 813 записей.
  microdistrict String?
  /// Жилой массив текстом, по той же причине не FK. Заполнено у 2 061 записи.
  livingArea String?
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  lat        Decimal
  lng        Decimal
  /// Назначение здания («Жилой дом», «Частный дом», church, government…) —
  /// источник смешивает русские и английские значения из разных выгрузок,
  /// импорт их не нормализует, значение хранится как есть.
  purpose     String?
  floors      Int?
  /// Материал стен — заполнен всего у одной записи из 24 325, оставлено на
  /// случай будущего дозаполнения источником.
  wallMaterial String?
  entrances   Int?
  apartments  Int?
  builtYear   Int?
  /// Контур здания, WKT (WGS84) — POLYGON(...), как отдал источник. Есть у
  /// 13 501 из 24 325 домов. Не парсится при импорте: точка-в-полигоне и
  /// проверка целостности читают строку напрямую (lib/geo.ts).
  outline    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([lat, lng])
  @@index([districtId])
  @@index([street])
}

/// СПРАВОЧНИК УЛИЦ — источник `улицы.json` (920 записей). Заменяет эвристику
/// извлечения улицы из адреса регуляркой `split(/[,\s]+/).find(w => w.length
/// > 4)`, живущую в двух копиях (`lib/ads/adMatching.ts:252-254`,
/// `routes/ads.ts:855-857`) — блок B этой правки не делает, справочник только
/// заводится, замена копий эвристики остаётся отдельной задачей.
model Street {
  id         String    @id @default(uuid())
  /// Идентификатор улицы в источнике (`id` из `улицы.json`, `osm-street-…`).
  sourceId   String    @unique
  name       String
  nameTj     String?
  /// «улица» | «проезд» | «проспект» | «переулок» | «жилая улица» — как в
  /// источнике, без своего enum: одно новое значение в будущей выгрузке не
  /// должно требовать миграции.
  kind       String
  /// Улица может лежать в нескольких районах сразу (источник отдаёт «Сино,
  /// Фирдавси» и даже все четыре района одной строкой для 19 улиц) — тогда
  /// однозначный FK невозможен, и districtId остаётся null. FK ставится только
  /// когда в источнике ровно одно название района.
  districtId String?
  district   District? @relation(fields: [districtId], references: [id])
  lat        Decimal
  lng        Decimal
  /// Геометрия улицы, WKT (WGS84) — MULTILINESTRING(...). Есть у 346 из 920.
  geometry   String?
  /// «Домов с адресом» источника — счётчик для справки, не пересчитывается
  /// импортом домов (это была бы N+1 агрегация по 24 325 строкам на 920
  /// улиц при каждом запуске).
  housesCount Int      @default(0)

  @@index([districtId])
  @@index([name])
}

/// СПРАВОЧНИК МИКРОРАЙОНОВ — источник `микрорайоны.json` (27 записей, все с
/// границей). Синонимы народных названий ЖК уже написаны константой в
/// `ai/dushanbeGeography.ts:34-150` (промт бота) — переезд в таблицу отдельной
/// задачей блока B, здесь только справочник.
model Microdistrict {
  id       String   @id @default(uuid())
  /// Идентификатор в источнике (`osm-rel-…`).
  sourceId String   @unique
  name     String
  nameTj   String?
  lat      Decimal
  lng      Decimal
  /// Граница, WKT (WGS84) — POLYGON(...). У всех 27 записей источника есть,
  /// поэтому здесь required, в отличие от LivingArea.
  boundary String
}

/// СПРАВОЧНИК ЖИЛЫХ МАССИВОВ — источник `жилые_массивы.json` (117 записей,
/// граница есть только у 13). То же назначение, что у Microdistrict, отдельная
/// таблица — источник различает эти два понятия (микрорайон = плановая единица
/// советской застройки, жилой массив = более общее название территории/ЖК),
/// смешивать их в одну таблицу значило бы потерять то, что уже разделил
/// источник.
model LivingArea {
  id       String  @id @default(uuid())
  sourceId String  @unique
  name     String
  nameTj   String?
  lat      Decimal
  lng      Decimal
  /// Граница, WKT (WGS84) — есть только у 13 из 117, поэтому nullable.
  boundary String?
}

/// СПРАВОЧНИК ОРИЕНТИРОВ — источник `ориентиры.json` (857 записей после
/// вычистки мусора Викиданных, см. `EXCLUDED_LANDMARK_CATEGORIES` в
/// `prisma/scripts/import-geo.ts`). Это и есть «у ЦУМа» из заказа владельца
/// (docs/geo-match-plan-12-09.md, раздел 0): точки, по которым агент и клиент
/// на самом деле называют место, когда не знают улицы и номера дома.
model Landmark {
  id         String    @id @default(uuid())
  /// Идентификатор в источнике (`id` из `ориентиры.json`, `wd-Q…` — Викиданные).
  /// Необязателен по той же причине, что у `District.sourceId`: записи, заведённые
  /// агентом (см. `source` ниже), из купленного слоя не приходят и своего
  /// идентификатора источника не имеют.
  sourceId   String?   @unique
  name       String
  /// «Альтернативные названия» источника, разбитые по `; ` (таджикское и
  /// английское название встречаются в одной строке через точку с запятой).
  /// У записей `source = "agent"` не используется — их синонимы живут в
  /// `GeoAlias` (targetType="landmark"), как и у всех остальных, см. докстринг
  /// GeoAlias — единственная точка входа для поиска и подбора.
  aliases    String[]  @default([])
  /// «Школа», «Больница», «Базар», «Мечеть»… — как в источнике, без enum по
  /// той же причине, что у Street.kind.
  category   String
  address    String?
  districtId String?
  district   District? @relation(fields: [districtId], references: [id])
  lat        Decimal
  lng        Decimal

  /// СКРЫТИЕ ВМЕСТО УДАЛЕНИЯ (12.09.2026, docs/geo-match-plan-12-09.md, блок J,
  /// решение владельца). Запись из купленного слоя удалить нельзя: следующий
  /// запуск `import-geo.ts` её же и воскресит (upsert по `sourceId`), и агент
  /// решит, что система не слушает его правку. `false` — запись не участвует
  /// ни в поиске (`lib/geoResolve.ts`), ни в подборе.
  enabled     Boolean  @default(true)
  /// "import" — из купленного слоя (наполняется `prisma/scripts/import-geo.ts`,
  /// апдейт по `sourceId`, никогда не создаёт запись без него); "agent" —
  /// заведено вручную в Настройках. Импорт запись с `source = "agent"` не
  /// трогает вовсе: у таких записей `sourceId` пуст, а импорт ищет строго по
  /// `sourceId` из файла источника — совпасть с пустым он не может структурно
  /// (см. также защитную проверку в `importLandmarks`).
  source      String   @default("import")
  /// Насколько широко люди понимают это название («ЦУМ» — это весь квартал
  /// вокруг входа, а не точка) — метры. Пусто, пока агент не задал явно;
  /// используется подбором вместо `DEFAULT_RADIUS_BY_TYPE`, когда задано.
  radiusM     Int?
  /// Кто завёл/последний раз правил запись. Внешнего ключа сюда намеренно нет —
  /// та же причина, что у `StyleExample.agentId` и `StageEvent.agentId`:
  /// сотрудника могут уволить и удалить из CRM, а справочник ориентиров и его
  /// история должны его пережить — запись не должна ни удаляться каскадом, ни
  /// мешать удалению самого агента. Кто именно — восстанавливается по журналу
  /// действий (`AuditLog`), где agentId и так необязателен по той же причине.
  createdById String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  /// ЗНАЧИМОСТЬ ОРИЕНТИРА (12.09.2026, docs/geo-match-plan-12-09.md, дополнение
  /// владельца к блоку J: «строка расстояний в стиле Booking.com» на карточке
  /// объекта не должна выбирать ориентиры просто по близости — рядом со
  /// школьным кварталом строка состояла бы из трёх школ). 0 — обычный,
  /// 50 — важный, 100 — очень важный; экран Настроек предлагает эти три
  /// значения, а не произвольное число. Участвует в отборе `lib/landmarkPick.ts`
  /// как множитель к обратному расстоянию.
  weight        Int     @default(0)
  /// Сколько раз название встретилось в разговорах — считается САМО отдельным
  /// блоком добычи из звонков/переписок (блок O, не эта задача); здесь только
  /// поле и место для него. Экран справочника показывает число, если оно
  /// больше нуля, — по нему видно, какие ориентиры реально звучат у клиентов.
  mentions      Int     @default(0)
  /// «До центра города», отдельно от обычного отбора по категории/расстоянию —
  /// как отдельная строка у Booking. Не более одной записи должно быть true
  /// одновременно по смыслу (это проверяется на экране, не в базе: справочник
  /// общий, и второй `isCityCenter` — это чья-то ошибка руками, а не гонка).
  isCityCenter  Boolean @default(false)

  @@index([lat, lng])
  @@index([category])
  @@index([enabled])
}

/// СЛОВАРЬ СИНОНИМОВ ГЕО-СПРАВОЧНИКА — единая точка входа для бота и подбора
/// (дополнение владельца 12.09.2026 к блоку B: «клиент пишет "82 мкр", в базе
/// "82-й микрорайон" — не совпадёт»). Заполняется импортом (`source: "import"`,
/// `prisma/scripts/import-geo.ts`) и очищается функцией `normalizeGeoText`
/// (`apps/api/src/lib/geoNormalize.ts`) — импорт и поиск (`lib/geoResolve.ts`)
/// обязаны звать ОДНУ и ту же функцию, иначе написание разъедется молча, как
/// уже разъехались площадь/этаж в двух копиях фильтра подбора (раздел D4
/// плана). `source: "generated"` — варианты, которые придумал сам импорт
/// («82 мкр» из «82-й микрорайон»); `"agent"` зарезервировано под будущую
/// ручную правку синонима из Настроек, этим импортом не используется.
///
/// FK на цель намеренно нет — по той же причине, что у `StyleExample.agentId`
/// и у `StageEvent` (запись должна пережить то, на что ссылается, и не мешать
/// его удалению), но здесь есть и структурная причина: `targetType` шесть
/// разных таблиц (Building/Street/Microdistrict/LivingArea/Landmark/District),
/// а внешний ключ Prisma всегда ведёт в одну. `targetId` проверяется кодом
/// (`geoResolve.ts`), а не базой.
model GeoAlias {
  id         String   @id @default(uuid())
  /// Как пишут люди: «82 мкр», «ЦУМ», «пр. Рудаки» — не хранится в чистом виде
  /// для поиска, только для отладки/показа откуда взялся синоним.
  text       String
  /// `text`, пропущенный через `normalizeGeoText` — по этому полю ищем:
  /// нижний регистр, без пунктуации, схлопнутые пробелы, `ё`→`е`.
  normalized String
  /// "building" | "street" | "microdistrict" | "livingArea" | "landmark" | "district"
  targetType String
  targetId   String
  /// "import" (само название источника) | "generated" (вариант, порождённый
  /// импортом) | "agent" (ручная правка, зарезервировано, этим скриптом не
  /// пишется).
  source     String
  createdAt  DateTime @default(now())

  @@unique([normalized, targetType, targetId])
  @@index([normalized])
  @@index([targetType, targetId])
  @@index([normalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "GeoAlias_normalized_trgm_idx")
}

model Property {
  investigationCases InvestigationCase[]
  narrationVersions PropertyNarrationVersion[]
  narrationDeliveries PropertyNarrationDelivery[]
  metadataSyncDrafts PublicationMetadataSync[]
  ownerReportDeliveries OwnerReportDelivery[]
  ownerReportSubscription OwnerReportSubscription?
  id                             String                     @id @default(uuid())
  /// Короткий числовой ID для читаемых URL (/properties/1042) — id остаётся настоящим
  /// первичным ключом для всех связей, shortId используется только для роутинга.
  shortId                        Int                        @unique @default(autoincrement())
  title                          String
  type                           PropertyType
  rooms                          Int?
  areaSqm                        Decimal
  /// Площадь участка в сотках — у дома и земли (владелец 21.09.2026). Необязательна:
  /// у квартиры участка нет, а старые объекты заведены без неё.
  landAreaSotka                  Decimal?
  floor                          Int?
  totalFloors                    Int?
  /// Количество окон — обязательное поле карточки объекта из спецификации владельца
  /// (31.07.2026, «Создание объекта»). Поля не существовало вовсе, а тип остекления
  /// в details.windows — это другое: «пластиковые» не отвечает на вопрос «сколько».
  /// Для покупателя это про свет и сторону, и спрашивают об этом на каждом показе.
  windowCount                    Int?
  price                          Decimal
  currency                       Currency                   @default(TJS)
  /// Район и адрес — обязательны для ЛЮБОГО обычного объекта, но НЕ для закрытого
  /// (offSite, решение владельца 14.09.2026: «только для своих» требует ровно цену
  /// и продавца). Nullable ради этого единственного случая — публичный путь как был,
  /// так и остался обязательным (propertyCreateSchema.superRefine), только в базе
  /// теперь пусто разрешено физически. Сервер сам достраивает то, что пусто, по
  /// координатам телефона агента (lookupGeoPoint, routes/properties/crud.ts) —
  /// оставшийся пробел не выдумывается.
  districtId                     String?
  district                       District?                  @relation(fields: [districtId], references: [id])
  address                        String?
  /// Канонный адрес (15.09.2026, проверка дублей на шаге «Где», решение владельца —
  /// «никакой похожести на глаз», только точное совпадение по индексу). Считается
  /// ОДИН РАЗ функцией normalizePropertyAddress (routes/properties/shared.ts) при
  /// создании/правке адреса и хранится колонкой — без неё проверка дубля на каждую
  /// напечатанную букву пересчитывала бы канонизацию для всей таблицы объектов.
  /// Существующие объекты заполнены разовым скриптом (scripts/backfill-property-
  /// canonical-address.ts), см. отчёт о переносе в описании миграции.
  canonicalAddress               String                     @default("")
  /// Ориентир — короткая фраза вроде «рядом с ТЦ Садбарг», «за Овиром» (пункт 10
  /// владельца, 23.09.2026): помогает покупателю и сотрудникам понять расположение
  /// объекта, когда точного адреса недостаточно. Необязателен, свободный текст.
  landmark                       String?
  condition                      PropertyCondition
  amenities                      String[]
  description                    String?
  /// Новый объект, заведённый ЧЕРЕЗ CRM, начинает не в продаже (решение владельца
  /// 02.08.2026): проверка карточки → фото → видео → монтаж, и только после
  /// последнего этапа — видео-обзор в Instagram и ссылка в карточке — AVAILABLE.
  ///
  /// Умолчание самой КОЛОНКИ при этом остаётся AVAILABLE нарочно: конвейер — это
  /// правило приёма объектов, а не свойство таблицы. Его ставит маршрут создания
  /// (routes/properties.ts), поэтому перенос старых объявлений и служебные записи
  /// не оказываются заперты в конвейере задним числом.
  status                         PropertyStatus             @default(AVAILABLE)
  /// Несайтовый объект (решение владельца 18.08.2026, docs/plan-18-08-private-listings-and-video.md
  /// §1) — агент нашёл его сам (сосед, знакомый) и делится им ТОЛЬКО приватной ссылкой
  /// с конкретным клиентом, никогда общим списком. Такой объект не публикуется на
  /// сайте (publishedOnSite не может стать true — проверка в routes/properties.ts и
  /// lib/siteSync.ts), не проходит конвейер AWAITING_PHOTOS→AWAITING_VIDEO→EDITING
  /// (создаётся сразу в AVAILABLE) и исключается из общей выдачи «Подбор объекта»/
  /// AI-рекомендаций (routes/clients.ts, GET /:id/match). Не проставляется задним
  /// числом существующим объектам — только на создании.
  offSite                        Boolean                    @default(false)
  /// Когда объект вошёл в ТЕКУЩЕЕ состояние. По нему считается просрочка этапа
  /// конвейера (сроки — в Настройках), и по нему же видно, сколько объект висит.
  /// Обновляется только при СМЕНЕ статуса, а не при любой правке карточки: иначе
  /// просрочка сбрасывалась бы от исправленной опечатки в адресе.
  stageEnteredAt                 DateTime                   @default(now())
  ownerContact                   String?
  assignedAgentId                String?
  assignedAgent                  Agent?                     @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  /// Агент-интейкер: принял заявку продавца и отработал (переговоры, съёмка). За это
  /// получает 0.5% из 2% комиссии при продаже. Заполняется при создании объекта из заявки продавца.
  intakeAgentId                  String?
  intakeAgent                    Agent?                     @relation("IntakeAgent", fields: [intakeAgentId], references: [id])
  /// Кто создал карточку объекта в CRM (нажал «Создать») — используется для видимости
  /// контакта владельца (см. stripOwnerContact в properties.ts). Не путать с intakeAgentId
  /// (бизнес-роль «принял продавца», назначается вручную и может отличаться от создателя).
  createdById                    String?
  createdBy                      Agent?                     @relation("CreatedByAgent", fields: [createdById], references: [id])
  /// ПЕРЕДАЧА ОБЪЕКТА ДРУГОМУ АГЕНТУ (владелец 24.09.2026). Объект, как и лид,
  /// новый хозяин ПРИНИМАЕТ сам — прочитав, от кого он пришёл и почему, — но без
  /// таймера: объект никого не заставляет ждать. Пока handoverPendingSince не пуст,
  /// карточка помечена «передан вам, примите»; принятие очищает поле, причина и
  /// прежний хозяин остаются как история последней передачи.
  handoverPendingSince           DateTime?
  handoverFromAgentId            String?
  handoverFromAgent              Agent?                     @relation("PropertyHandoverFrom", fields: [handoverFromAgentId], references: [id], onDelete: SetNull)
  handoverReason                 String?
  interestEvents                 PropertyInterestEvent[]
  /// Диалоги бота, в которых речь шла об этом объекте (ConversationProperty).
  conversationLinks              ConversationProperty[]
  siteDays                       SitePropertyDay[]
  /// Когда агенту последний раз ушло «Объект загорелся» (lib/propertyHotAlert.ts):
  /// не чаще раза в неделю на объект. Отдельным полем, а не поиском по ленте —
