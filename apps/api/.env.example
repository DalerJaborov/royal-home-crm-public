DATABASE_URL="postgresql://user:password@localhost:5432/royal_home_crm?schema=public&connection_limit=20&pool_timeout=20"
# ↑ connection_limit/pool_timeout ЯВНО (приёмка 08.09.2026): без них Prisma берёт
# пул по умолчанию (num_cpus*2+1, на разных машинах — по-разному, у одного
# разработчика вышло 13) — и локально при 6 одновременных пользователях он
# исчерпывался быстрее, чем «Timed out fetching a new connection from the pool»
# успевал кому-то показаться редким. dev Postgres (docker-compose.yml) держит
# дефолтный max_connections=100 — 20 те же, что и в docker-compose.prod.yml
# (аудит №4, 27.08.2026: там 15 на процесс при двух процессах, api+worker).
# Локально процесс один — можно чуть щедрее, запас всё равно большой.
# Секреты JWT — минимум 32 символа, в production API не стартует с "change-me".
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="90d"
# Cloudflare R2 (S3-совместимое хранилище) — 31.08.2026: сырое видео объектов
# ушло с R2 на диск сервера (см. lib/localVideoStorage.ts), эти ключи ему больше
# не нужны. Ключи ниже пока нужны ДВУМ оставшимся потребителям R2 (не мигрированы
# в этом заходе): вложениям чата (lib/outgoingMedia.ts) и чтению записей звонков
# прежней эпохи, до отказа от R2 07.08.2026 (lib/telephony/callRecordings.ts) —
# без ключей эти старые записи станут недоступны для воспроизведения.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="royalhome-property-video"
PORT=4000
UPLOADS_DIR="./uploads"
# Закрытое хранилище сырого видео объектов (31.08.2026) — ВНЕ UPLOADS_DIR
# (тот раздаётся статикой без проверки прав, см. app.ts). Доступ только через
# аутентифицированные роуты apps/api/src/routes/properties/videos.ts.
PROPERTY_VIDEO_DIR="./uploads-private-video"
# Части докачки видео с середины, пока файл не собран целиком — тоже вне UPLOADS_DIR.
PROPERTY_VIDEO_SESSIONS_DIR="./uploads-private-video-sessions"
# Документы сделки (титул, договор, паспорт, чек выплаты) — вне UPLOADS_DIR,
# постоянное хранение без автоочистки. В проде обязателен свой том в
# docker-compose.prod.yml (см. DEAL_DOCS_DIR там же).
DEAL_DOCS_DIR="./uploads-deal-docs"
CORS_ORIGIN="http://localhost:5173"
# Выставить 1 только если API работает за реверс-прокси (nginx/Caddy) — нужно для точного rate-limit по IP.
TRUST_PROXY="0"
# 32-байтный ключ (64 hex-символа) для шифрования секретов (Anthropic API key) в БД.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=""
# 32-байтный ключ (64 hex-символа) для шифрования запасных номеров телефона,
# которые клиент называет ВО ВРЕМЯ ЗВОНКА (lib/phoneCrypto.ts, lib/telephony/
# callPhoneMasking.ts) — требование владельца 03.09.2026: номер не должен
# оседать в расшифровке открытым текстом, откуда его можно списать в обход CRM.
# Намеренно ОТДЕЛЬНЫЙ ключ от SETTINGS_ENCRYPTION_KEY — утечка одного не должна
# открывать оба хранилища. Без ключа номер всё равно МАСКИРУЕТСЯ в тексте, просто
# не сохраняется зашифрованным для будущего дедупа (см. logSystemError при сбое).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_ENCRYPTION_KEY=""
# Токен бота от @BotFather — включает приём заявок в Telegram. Без него бот просто не запускается.
TELEGRAM_BOT_TOKEN=""
# Личный чат директора с ботом. Нужен ровно для одного: клиентский бот не должен
# квалифицировать владельца как лида, если тот напишет боту сам. Значение можно
# подсмотреть в Settings.telegramOwnerChatId — либо задать здесь вручную.
TELEGRAM_DIRECTOR_CHAT_ID=""
# Секрет вебхука Telegram (19.08.2026) — задать ТОЛЬКО на проде, где есть
# публичный HTTPS-домен. Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# После деплоя один раз вызвать setWebhook (см. telegram/api.ts) на
# https://<домен>/api/v1/webhooks/telegram с этим же секретом — иначе Telegram
# продолжит стучаться на старый long polling. Не задавать локально: без
# публичного домена вебхук недостижим, бот должен остаться на polling.
TELEGRAM_WEBHOOK_SECRET=""
# Токен утреннего отчёта для рабочей Claude-сессии (GET /api/v1/morning-report).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MORNING_REPORT_TOKEN=""
# Ключи Web Push (VAPID). Сгенерировать: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Без них push-уведомления молча отключаются (см. src/push.ts) — остальной CRM работает как обычно.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@royalhome.tj"
# Общий секрет для приёма заявок с сайта royalhome.tj (POST /api/v1/webhooks/website-lead).
# Тот же ключ прописывается на сайте в CRM_LEAD_API_KEY. Пустой = приём заявок выключен.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBSITE_LEAD_API_KEY=""
# Общий секрет для приёма отчётов ops/backup.sh и ops/restore-drill.sh
# (POST /api/v1/backups/report) — экран /backups. Пустой = приём отчётов
# выключен, скрипты продолжают работать как раньше (отчёт — best-effort).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BACKUP_REPORT_API_KEY=""
# Расшифровка голосовых клиентов — только GEMINI_API_KEY (aistudio.google.com).
# Ему можно велеть писать таджикской кириллицей, и он слушается; Whisper убран
# 02.08.2026 — он не принимает язык "tg" и возвращал таджикскую речь фарси.
# Пустой ключ = голосовые не распознаются, бот просит написать текстом.
GEMINI_API_KEY=""
# Резервная модель Gemini: если основная (gemini-3.6-flash, см. ai/geminiTransport.ts)
# после всех повторов всё ещё отвечает 503/429 (перегружена/лимит), делаем одну
# попытку этой моделью — тот же поставщик Google, просто другая нагрузка/очередь.
# gemini-2.5-flash-lite — стабильная, самая дешёвая и с отдельной квотой от 3.6-flash
# (проверено по ai.google.dev/gemini-api/docs/models 03.08.2026, дата закрытия не
# объявлена). Пустое значение = резерв выключен, только повторы на основной модели.
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"
# Второй ключ Gemini (свой проект в Google AI Studio) — подключается автоматически,
# когда основной ключ исчерпал все повторы и резервную модель. Страхует от отказов,
# специфичных именно ПЕРВОМУ ключу/проекту (лимит, блокировка), а не только от общей
# перегрузки модели. Пустое значение = второй ключ не используется.
GEMINI_API_KEY_2=""
# Публикация объектов на сайт royalhome.tj (кнопки "Опубликовать"/"Снять с публикации").
# Тот же ключ прописывается на сайте в CRM_SYNC_API_KEY. Пустой = синхронизация выключена.
SITE_SYNC_URL=""
SITE_SYNC_API_KEY=""
# Отдельный, более привилегированный ключ для аварийного сброса пароля админки
# сайта (Настройки → раздел сайта → "Аварийный сброс", за step-up с 2FA). Специально
# НЕ SITE_SYNC_API_KEY выше — тот ключ ещё используется для рутинной синхронизации
# объектов, утечка не должна открывать и полный доступ к аккаунту администратора.
# Тот же ключ прописывается на сайте в CRM_SYNC_ADMIN_RESET_KEY. Пустой = кнопка
# аварийного сброса сообщает "канал не настроен".
SITE_SYNC_ADMIN_RESET_KEY=""
# Публичный адрес CRM (для абсолютных ссылок на фото объектов, которые видит сайт).
CRM_PUBLIC_URL=""
# Публичный адрес САЙТА — из него собирается ссылка на объект, которую агент
# отправляет клиенту в мессенджер (<адрес>/listing/by-crm/<id объекта в CRM>).
# По умолчанию royalhome.tj.
SITE_PUBLIC_URL=""
# Записи телефонных разговоров с АТС (lib/telephony/callRecordings.ts). Каталог
# записей FreePBX, отданный по HTTP через тот же обратный туннель, что и ARI, —
# см. docs/telephony-sip-numbering.md, раздел «Запись разговоров». Наружу порт не
# открывается. По SSH/SCP файл НЕ забирается специально: это означало бы приватный
# ключ от АТС внутри контейнера CRM и в резервных копиях.
# Пустой адрес = записи не забираются, звонки при этом работают как раньше.
PBX_RECORDINGS_URL=""
# Общий токен, который сервер записей на АТС проверяет в заголовке X-Recordings-Token.
PBX_RECORDINGS_TOKEN=""

# Ниже — переменные, которые в коде читаются, но раньше не были в этом файле
# (аудит 18.08.2026). Разработчик, разворачивающий CRM с нуля, узнавал о них
# только вручную вычитывая исходники — теперь они хотя бы видны здесь.

# Модель Gemini для текстовых ответов бота. Пусто = используется дефолт из кода
# (см. ai/geminiTransport.ts, сейчас gemini-3.6-flash). Трогать только вместе со
# сверкой действующего списка моделей на ai.google.dev.
GEMINI_MODEL=""
# Собственный прокси-Worker перед Gemini/Instagram Graph API (обход геоблокировки
# VPS). Один и тот же прокси может обслуживать оба направления — поэтому
# GEMINI_PROXY_* используются и Instagram-клиентом как запасной вариант, если
# IG_PROXY_* не заданы отдельно. Пусто = запросы идут напрямую.
GEMINI_PROXY_URL=""
GEMINI_PROXY_KEY=""
IG_PROXY_URL=""
IG_PROXY_KEY=""

# Meta (WhatsApp Cloud API + Instagram Direct + Facebook Page). Это ЗАПАСНОЙ путь:
# основной источник — Настройки → Каналы в самой CRM (зашифровано в БД). Эти
# переменные срабатывают, только если поле в Настройках пустое — нужны в основном
# для холодного старта нового окружения до первого захода в Настройки.
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_WA_TOKEN=""
META_WA_PHONE_ID=""
META_IG_TOKEN=""
META_IG_APP_SECRET=""
META_PAGE_TOKEN=""
META_PAGE_ID=""

# Публичный адрес самой CRM (не сайта) — нужен passkeys/WebAuthn для проверки
# origin при входе по отпечатку/Face ID. Пусто = используется CORS_ORIGIN, а если
# и он не задан — http://localhost:5173. На проде должен указывать на реальный домен
# CRM, иначе вход по passkey молча перестанет работать у всех сразу.
PUBLIC_APP_URL=""
# Каталог приватных файлов (документы, доступные только админу/директору) —
# отдельно от UPLOADS_DIR специально, чтобы не раздавать их публичным маршрутом.
# Пусто = ./uploads-private рядом с рабочей директорией процесса.
PRIVATE_UPLOADS_DIR=""
# Запасное имя для MORNING_REPORT_TOKEN (см. выше) — на случай, если прод ещё не
# обновили после переименования переменной. Указывать оба сразу не нужно.
TEAM_REQUESTS_TOKEN=""

# Поток живых событий сервер→браузер (SSE, GET /api/v1/events, 12.09.2026).
# По умолчанию ВКЛЮЧЁН — и в dev, и в проде. LIVE_EVENTS=0 гасит поток целиком,
# не выкатывая код: фронт продолжит обновляться опросом по таймеру, просто
# медленнее (см. apps/web/src/lib/liveEvents.ts).
LIVE_EVENTS="1"

# Уборка диска (lib/diskCleanup.ts): 1 — только считать (по умолчанию), 0 — удалять. Первую ночь на проде оставить 1 и прочитать строку «[cron] Уборка диска…» в логах.
DISK_CLEANUP_DRY_RUN=1

# Живой голос: куда станция шлёт звук разговора (RTP/UDP, lib/telephony/liveVoiceRtpConfig.ts).
# Нужны ОБА значения: без хоста или порта робот не набирает и не берёт трубку.
# HOST — адрес CRM в туннеле до станции (на сайте 10.9.0.1), PORT — один фиксированный
# порт, проброшенный в контейнер (docker-compose.prod.yml, по умолчанию 40800).
LIVE_VOICE_RTP_HOST=""
LIVE_VOICE_RTP_PORT=40800
# Необязательно: адрес станции в туннеле (`10.9.0.2` или `10.9.0.2:4000`); звук принимается
# только оттуда. Пусто — по порту, который станция сообщила для канала.
LIVE_VOICE_RTP_PEER=""

# P0-7 аудита 10.10.2026 (docs/audit-bots-2026-10-10-object-routing.md) — РЕШЕНИЕ ВЛАДЕЛЬЦА.
# Пусто/не "1" (по умолчанию) — вариант (б): лид другого агента к хозяину объекта не
# переезжает, хозяин всегда получает уведомление. "1" — вариант (а): НЕпринятый лид из
# очереди переезжает к хозяину объекта (lib/propertyInterestNotice.ts).
OBJECT_INTEREST_PULLS_QUEUE_LEAD=""

# Customer-turn diagnostics, OFF by default. Separate random key (>=32 chars).
# Metadata/pseudonyms only; text opt-in retains residual personal-data risk.
BOT_TURN_TRACE_ENABLED=0
BOT_TURN_TRACE_HMAC_KEY=
BOT_TURN_TRACE_TEXT_ENABLED=0

# P03 public property facts before qualification, OFF until channel gates pass.
# Mixed actions/voice/Telegram remain legacy. Website requires stable messageId.
BOT_PROPERTY_CONTEXT_ENABLED=0
