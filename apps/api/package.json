{
  "name": "@royal-home/api",
  "description": "Royal Home CRM API server: Express + TypeScript, Prisma/PostgreSQL, JWT auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:prod": "tsx prisma/seed-prod.ts",
    "backfill:extra-phones": "tsx scripts/backfill-extra-phones-from-notes.ts",
    "backfill:instagram-urls": "tsx src/lib/backfillInstagramUrls.ts",
    "backfill:property-covers": "tsx src/lib/backfillPropertyCovers.ts",
    "geocode:coverage": "tsx scripts/geocode-coverage.ts",
    "backfill:job-applications": "tsx src/lib/backfillJobApplications.ts",
    "vacancies:ask-phone": "tsx src/lib/askCandidatePhone.ts",
    "test": "tsx tests/runParallel.ts",
    "test:seq": "vitest run",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@royal-home/shared": "0.1.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "aws4fetch": "^1.0.20",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exif-reader": "^2.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "heic-decode": "^2.1.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "otpauth": "^9.5.1",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "ws": "^8.21.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.16.10",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
