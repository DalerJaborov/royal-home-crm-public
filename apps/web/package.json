{
  "name": "@royal-home/web",
  "description": "Royal Home CRM web client: React 18 + Vite + Tailwind CSS, PWA",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "eslint \"src/**/*.{ts,tsx}\" && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:web-session": "playwright test --config=playwright.web-session.config.ts",
    "e2e:prod": "npm run build && node scripts/e2e-prod.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "screens": "node scripts/extract-screens.mjs",
    "sync-maplibre-worker": "node scripts/sync-maplibre-worker.mjs",
    "screens:check": "node scripts/extract-screens.mjs --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@royal-home/shared": "0.1.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.451.0",
    "maplibre-gl": "^6.9.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "react-virtuoso": "^4.18.13",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
