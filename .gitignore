# Playwright: состояние сессии для E2E и артефакты прогонов
apps/web/playwright/.auth/
apps/web/test-results/
apps/web/playwright-report/
# То же самое в КОРНЕ репозитория. Правило появилось 13.08.2026 после проверки:
# `npx playwright test --config=apps/web/playwright.config.ts`, запущенный из корня,
# кладёт состояние сюда, а не в apps/web — и `playwright/.auth/chromium.json` с живым
# refreshToken оказывался НЕ игнорируемым. В этот же день `git add -A` в соседней
# сессии уже утащил в коммит чужие незакоммиченные файлы; попади так токен, он уехал
# бы в GitHub. В историю не попал — проверено, но щиток нужен на оба каталога.
playwright/.auth/
test-results/
playwright-report/

# Снимки живых проходов (scripts/walkthrough.mjs, buyer.mjs, seller.mjs, roles.mjs,
