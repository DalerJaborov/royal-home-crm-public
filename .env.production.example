# Продакшн-переменные для docker-compose.prod.yml.
# Скопируйте в .env.production и заполните: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# PostgreSQL (внутри Docker-сети, наружу порт не открыт)
POSTGRES_USER="royalhome"
POSTGRES_PASSWORD=""   # сгенерировать: openssl rand -hex 16

# JWT (обязательно; API не стартует с пустыми/короткими значениями)
# сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Шифрование секретов в БД (64 hex-символа)
SETTINGS_ENCRYPTION_KEY=""

# Домен CRM — для CORS (пример: https://crm.royalhome.tj)
CRM_ORIGIN="https://crm.royalhome.tj"

# Необязательные интеграции
TELEGRAM_BOT_TOKEN=""         # бот приёма заявок от клиентов
TELEGRAM_DIRECTOR_CHAT_ID=""  # личный чат директора с ботом: бот не квалифицирует владельца как клиента
MORNING_REPORT_TOKEN=""       # утренний отчёт Claude-сессии: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VAPID_PUBLIC_KEY=""           # push-уведомления: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PRIVATE_KEY="" # gitleaks:allow -- reviewed synthetic test value or non-secret identifier
VAPID_SUBJECT="mailto:admin@royalhome.tj"
WEBSITE_LEAD_API_KEY=""       # приём заявок с сайта royalhome.tj (тот же ключ на сайте в CRM_LEAD_API_KEY)
# Карта на странице Объектов — OpenStreetMap, без ключа и без настройки.

# Публикация объектов на сайт royalhome.tj (кнопки "Опубликовать"/"Снять с публикации")
SITE_SYNC_URL=""               # напр. https://royalhome.tj/api/v1/crm — тот же ключ на сайте в CRM_SYNC_API_KEY
SITE_SYNC_API_KEY=""           # сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Аварийный сброс пароля админки сайта — ОТДЕЛЬНЫЙ ключ (тот же на сайте в CRM_SYNC_ADMIN_RESET_KEY).
# Нарочно не SITE_SYNC_API_KEY: утечка ключа синхронизации не должна открывать доступ к аккаунту админа.
SITE_SYNC_ADMIN_RESET_KEY=""   # сгенерировать так же: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRM_PUBLIC_URL="https://crm.royalhome.tj"   # публичный адрес CRM — для абсолютных ссылок на фото объектов на сайте

# Уборка диска (lib/diskCleanup.ts): 1 — только считать (по умолчанию), 0 — удалять. Первую ночь на проде оставить 1 и прочитать строку «[cron] Уборка диска…» в логах.
DISK_CLEANUP_DRY_RUN=1

# Customer-turn diagnostics, OFF by default. Separate random key (>=32 chars).
# Metadata/pseudonyms only; text opt-in retains residual personal-data risk.
BOT_TURN_TRACE_ENABLED=0
BOT_TURN_TRACE_HMAC_KEY=
BOT_TURN_TRACE_TEXT_ENABLED=0
