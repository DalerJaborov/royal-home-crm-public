# Настройки шлюза WhatsApp -> АТС. Копия кладётся на сервер в
# /opt/royalhome-wa-gateway/gateway.env (wa-install.sh), права 600.
# Секретов в этом файле НЕТ: пароль Meta — secrets/meta/meta_sip_password
# (основной номер) и secrets/meta/meta_sip_password.<номер> (дополнительные),
# ключ Cloudflare — secrets/cloudflare.ini (оба 600, оба вне git).

# Имя хоста для Meta. DNS-запись A на WA_PUBLIC_IP, БЕЗ прокси Cloudflare
# («серое облако»): Cloudflare не проксирует SIP.
WA_SIP_HOST=wa-sip.royalhome.tj
# Публичный IPv4 сервера (netcup). На нём слушает TLS 5061 и звук.
WA_PUBLIC_IP=62.83.97.196
# Номер WhatsApp агентства цифрами, без «+» (как в WhatsApp Manager).
WA_BUSINESS_NUMBER=992000000000
# ID номера в Cloud API (не секрет) — им сверяется, что CRM настроена на тот же номер.
WA_PHONE_ID=1295473220308902
# Дополнительные номера WhatsApp на этом же шлюзе (26.11.2026). Через запятую,
# каждый «номер:phone_number_id[:метка]»: номер — цифрами без «+», метка —
# латиницей (агент увидит на телефоне «WhatsApp <метка>»). Звонок на такой номер
# станция получает его phone_number_id — по нему CRM узнаёт бренд из строки
# канала (Настройки → Каналы). Пароль Meta у каждого номера свой:
# secrets/meta/meta_sip_password.<номер> (wa-sip-password.sh --number=<номер>).
# Пусто — шлюз с одним номером, как раньше.
WA_EXTRA_NUMBERS=
# WA_EXTRA_NUMBERS=992877914444:1476112588909838:Arvan

# VPN сервер <-> станция (OpenVPN, tun0): сервер 10.9.0.1, станция 10.9.0.2.
WA_STATION_LOCAL_IP=10.9.0.1
WA_STATION_IP=10.9.0.2
# UDP-транспорт станции (pjsip show transports: 0.0.0.0-udp 5062).
WA_STATION_PORT=5062
# Порт шлюза к станции (только внутри VPN).
WA_LOCAL_SIP_PORT=5070
# Городской номер, на который станция принимает входящие (входящий маршрут FreePBX).
WA_STATION_DID=6501414

WA_TLS_PORT=5061
# Звук. Не пересекается с 40800 (робот-консультант CRM).
WA_RTP_START=41000
WA_RTP_END=41199

# early — шлюз сразу снимает трубку у WhatsApp и играет гудки, пока станция ищет
# человека (Meta ждёт ответа ~30–60 с). relay — честные гудки, тогда WA_RING_MAX ≤ 25.
WA_ANSWER_MODE=early
# Сколько секунд шлюз ждёт, что станция соединит (агенту станция звонит до 150 с).
WA_RING_MAX=180
# auto — проверка пароля Meta включается, как только появился файл пароля;
# yes — без файла шлюз не стартует (ставить после шага «пароль Meta»).
WA_REQUIRE_AUTH=auto

# Почта для Let's Encrypt (уведомления о сертификате). Настоящий адрес даёт
# владелец; с заглушкой wa-cert.sh не запустится.
WA_ACME_EMAIL=change-me
