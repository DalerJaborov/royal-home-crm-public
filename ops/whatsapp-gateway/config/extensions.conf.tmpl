; =====================================================================
; Диалплан шлюза WhatsApp -> АТС. Шаблон: entrypoint подставляет ТОЛЬКО
; переменные окружения WA_BUSINESS_NUMBER, WA_STATION_DID, WA_ANSWER_MODE,
; WA_RING_MAX (envsubst по списку) — переменные диалплана здесь зовутся GW_*,
; чтобы их не спутать.
;
; Шлюз ничего не решает о маршруте: он принимает звонок Meta и передаёт его
; станции как обычный входящий на городской номер агентства. Кто возьмёт трубку
; (свой агент, офисный аппарат, очередь, автоответчик, ночной режим) — решают
; станция и CRM, тем же путём, что для звонка на городской номер.
; =====================================================================

[general]
static = yes
writeprotect = yes
clearglobalvars = yes

[globals]
; early — шлюз сразу снимает трубку на стороне WhatsApp и сам играет гудки,
;         пока станция ищет человека (Meta ждёт ответа ~30–60 с, потом у клиента
;         «Не отвечено» и штраф за низкий процент ответов; путь до агента на
;         станции бывает дольше — до 150 с). Клиент видит идущий таймер разговора
;         и слышит гудки.
; relay — честные гудки «до ответа человека» (180 Ringing). Тогда WA_RING_MAX
;         держать ≤ 25 с, иначе Meta сама обрывает звонок.
GW_ANSWER_MODE = ${WA_ANSWER_MODE}
GW_RING_MAX = ${WA_RING_MAX}
GW_STATION_DID = ${WA_STATION_DID}

; Meta шлёт INVITE на номер бизнеса в международном виде: sip:+<номер>@<наш хост>
; [SIP → Sample requests: «INVITE sip:+17015558857@meta-voip.example.com»].
; Всё, что адресовано не нашему номеру, отбивается: так случайный сканер,
; пробившийся через файрвол и проверку пароля, не попадёт никуда.
[from-whatsapp]
exten => +${WA_BUSINESS_NUMBER},1,Goto(wa-in,s,1)
exten => ${WA_BUSINESS_NUMBER},1,Goto(wa-in,s,1)
exten => h,1,NoOp(WA: отбой)
exten => _.,1,NoOp(WA: вызов на чужой номер ${EXTEN} — отбой)
 same => n,Hangup(1)

[wa-in]
exten => s,1,NoOp(WA: входящий от ${CALLERID(num)})
 ; ID звонка WhatsApp и BSUID — для будущей связки с вебхуком calls в CRM
 ; [SIP → Custom SIP headers: x-wa-meta-wacid, x-wa-meta-user-id].
 same => n,Set(__GW_WACID=${PJSIP_HEADER(read,x-wa-meta-wacid)})
 same => n,Set(__GW_UID=${PJSIP_HEADER(read,x-wa-meta-user-id)})
 ; НОМЕР ЗВОНЯЩЕГО. Meta присылает +<код страны><номер>, но может прислать BSUID
 ; вместо номера [SIP → «Usernames and business-scoped user IDs»]. Пропускаем
 ; только номер из цифр; всё остальное — пусто (CRM такой звонок не опознает,
 ; станция пойдёт по общему правилу, см. runbook, раздел «Чего не хватает CRM»).
 same => n,Set(GW_RAW=${CALLERID(num)})
 same => n,Set(GW_NUM=)
 same => n,ExecIf($[${REGEX("^[+]?[0-9]{7,15}$" ${GW_RAW})}]?Set(GW_NUM=${FILTER(0123456789,${GW_RAW})}))
 ; +992XXXXXXXXX -> девять цифр: ровно так городской транк станции доставляет
 ; номера (журнал станции «6501414 -> 9XXXXXXXX»), по ним ищут чёрный список
 ; станции, имя файла записи и автоответчика. Нормализуем ЗДЕСЬ, а не только на
 ; станции: CRM читает номер из события создания канала, до диалплана станции.
 ; Иностранный номер остаётся с «+», как его понимает toCrmPhone в CRM.
 same => n,Set(GW_LOCAL=0)
 same => n,ExecIf($["${GW_NUM:0:3}" = "992" & ${LEN(${GW_NUM})} = 12]?Set(GW_LOCAL=1))
 same => n,ExecIf($[${GW_LOCAL} = 1]?Set(GW_NUM=${GW_NUM:3}))
 same => n,ExecIf($[${GW_LOCAL} = 0 & "${GW_NUM}" != ""]?Set(GW_NUM=+${GW_NUM}))
 same => n,Set(CALLERID(all)="WhatsApp" <${GW_NUM}>)
 same => n,NoOp(WA: на станцию как ${CALLERID(num)}, wacid=${GW_WACID})
 ; Станция по VPN недоступна (проверка OPTIONS раз в 30 с) — трубку не снимаем:
 ; клиенту лучше «не отвечено», чем снятая трубка и тишина.
 same => n,GotoIf($["${DEVICE_STATE(PJSIP/station)}" = "UNAVAILABLE"]?down)
 same => n,ExecIf($["${GW_ANSWER_MODE}" = "early"]?Answer())
 ; r — гудки клиенту, пока станция не соединила (на снятом канале шлюз играет
 ; их сам, тон из indications.conf). b() — заголовки X-WA-* на плечо к станции.
 same => n,Dial(PJSIP/${GW_STATION_DID}@station,${GW_RING_MAX},rb(wa-station-headers^s^1))
 same => n,NoOp(WA: станция вернула ${DIALSTATUS})
 same => n,Hangup()
 same => n(down),Log(WARNING,WA: станция недоступна по VPN — звонок ${CALLERID(num)} не принят)
 same => n,Hangup(34)

; Предварительный обработчик плеча к станции: заголовки ставятся на исходящий
; канал до отправки INVITE. Станция кладёт их в переменные канала (фрагмент
; ops/asterisk/), CRM прочитает их в следующей правке.
[wa-station-headers]
exten => s,1,ExecIf($["${GW_WACID}" != ""]?Set(PJSIP_HEADER(add,X-WA-Call-Id)=${GW_WACID}))
 same => n,ExecIf($["${GW_UID}" != ""]?Set(PJSIP_HEADER(add,X-WA-User-Id)=${GW_UID}))
 same => n,Return()

; Со станции в шлюз звонить нельзя: исходящие звонки в WhatsApp платные и не
; включены (решение 17.11.2026). Любой вызов отсюда — отбой.
[from-station]
exten => h,1,NoOp()
exten => _.,1,Hangup(21)
