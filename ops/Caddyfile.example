# Пример продакшн-Caddyfile для crm.royalhome.tj и royalhome.tj — усиленная
# версия базового варианта из DEPLOY.md (раздел 4). Скопировать в
# /etc/caddy/Caddyfile, подставить реальные домены/IP, перечитать:
#   sudo systemctl reload caddy
#
# RATE_LIMIT ТРЕБУЕТ ПЛАГИНА. Штатный Caddy не умеет rate-limit из коробки.
# Нужна сборка с модулем github.com/mholt/caddy-ratelimit:
#   xcaddy build --with github.com/mholt/caddy-ratelimit
# либо готовый образ (docker): образ caddy:2-alpine НЕ подходит, нужен свой
# Dockerfile:
#   FROM caddy:2-builder AS builder
#   RUN xcaddy build --with github.com/mholt/caddy-ratelimit
#   FROM caddy:2-alpine
#   COPY --from=builder /usr/bin/caddy /usr/bin/caddy
# Если ставить пакетом apt (как в DEPLOY.md) — обычный `caddy` из репозитория
# Cloudsmith плагина не содержит; собрать через xcaddy на сервере или в CI и
# заменить бинарник /usr/bin/caddy (systemctl restart caddy после замены).
#
# Директива `rate_limit` ниже — синтаксис caddy-ratelimit v2. Если плагин не
# установлен, Caddy откажется стартовать с ошибкой "unrecognized directive" —
# это ожидаемо и лучше, чем тихо проигнорированный лимит; тогда закомментировать
# блоки rate_limit и полагаться на Cloudflare (docs/security-hardening-plan-11-09.md,
# раздел «Анти-DDoS») до сборки плагина.

{
	# JSON access-лог общий для всех сайтов — под него настроен фильтр
	# fail2ban (ops/harden-vps.sh, jail caddy-crm-auth).
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	# Таймауты — против медленных/зависших клиентов, держащих соединение
	# (slowloris-класс атак). В Caddy это настройка СЕРВЕРА (global `servers`),
	# а не сайта: внутри блока сайта директивы `timeouts` нет — так и на проде.
	servers {
		timeouts {
			# read_body — потолок на ВСЁ тело запроса (Go ReadTimeout), а не на паузу
			# между байтами. 10s резал загрузку ролика (25.11.2026, разбор 502 мастера):
			# часть 8 МБ на мобильном канале 2–6 Мбит/с идёт 11–30 с, nginx писал
			# «400 time=10.000 upstream=-», телефон получал 502. 5m (первая правка того дня)
			# хватало на 1 Мбит/с, но не на худший канал 300 Кбит/с: часть 8 МБ там ≈ 224 с,
			# с запасом ×2 — 448 с. И одиночный запрос до max_size (95 МиБ) на 1 Мбит/с идёт
			# ≈ 797 с. 15m закрывает оба случая. Число держит сторож scripts/audit-limits.mjs
			# (правило 5): оба расчёта, оба с запасом. От медленного заголовка защищает
			# read_header, от молчащего тела — client_body_timeout у nginx (пауза между байтами).
			read_body   15m
			read_header 5s
			# write 15m (16.11.2026): Instagram/Facebook забирают ролики до ~250 МБ по ссылке
			# /uploads/…; при 30 с/200 с медленное скачивание рвалось на середине.
			write       15m
			idle        2m
		}
	}

	# Общие зоны лимита: по IP, окно и потолок burst — под перебор пароля и
	# вебхуки достаточно жёстко, под обычный интерфейс агентов — не мешает.
	order rate_limit before basicauth
	rate_limit {
		zone auth_zone {
			match {
				path /api/v1/auth/*
			}
			key {remote_host}
			events 10
			window 1m
		}
		zone webhooks_zone {
			match {
				path /api/v1/webhooks/*
			}
			key {remote_host}
			events 60
			window 1m
		}
	}
}

crm.royalhome.tj {
	# Тело запроса (25.11.2026). Потолок ОДИНОЧНОГО запроса — PROXY_SINGLE_REQUEST_MAX_BYTES
	# (packages/shared/src/uploadLimits.ts, 90 МиБ): фото пачкой, импорт, расшифровка и
	# одиночные видео идут через API одним запросом, и 25MB отбивало файлы 25–90 МБ
	# HTML-страницей 413 без кода. 95MiB = потолок + запас на multipart-обёртку и ровно
	# под Cloudflare (100 МБ = 95,4 МиБ): файл больше всё равно не пройдёт выше по цепи.
	# Видео едет частями по 8 МБ (UPLOAD_PART_BYTES), им это число не мешает.
	# Сторож scripts/audit-limits.mjs (правило 7): max_size не ниже потолка.
	request_body {
		max_size 95MiB
	}

	# Ответы Caddy при его собственных ошибках (413 по max_size, 502/503/504 при недоступном
	# upstream) — JSON того же вида, что у nginx (apps/web/nginx.conf, @proxy_NNN): экран
	# читает code/message/retryable, а не разбирает HTML. Ответы API сюда не попадают.
	# Сторож (правило 8) требует этот блок. Синтаксис Caddy v2; проверка — `caddy validate`.
	handle_errors {
		@tooLarge expression {http.error.status_code} == 413
		handle @tooLarge {
			header Content-Type "application/json; charset=utf-8"
			respond `{"code":"PROXY_413","message":"Файл слишком большой для одного запроса. Сожмите файл или отправьте его частями.","error":"Файл слишком большой для одного запроса. Сожмите файл или отправьте его частями.","retryable":false}` 413
		}
		handle {
			header Content-Type "application/json; charset=utf-8"
			respond `{"code":"PROXY_{http.error.status_code}","message":"Сервер временно недоступен, обычно это несколько секунд. Повторите попытку.","error":"Сервер временно недоступен, обычно это несколько секунд. Повторите попытку.","retryable":true}` {http.error.status_code}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(self)"
		# CSP для API-домена не нужен (см. бриф, Пачка 4, п.6) — CRM API не
		# отдаёт HTML. CSP для web — отдельно на домене сайта/фронтенда, если
		# фронтенд обслуживается тем же Caddy (см. блок ниже пример для web).
		X-Frame-Options "DENY"
		-Server
	}

	rate_limit auth_zone webhooks_zone

	reverse_proxy 127.0.0.1:8080
}

# Пример для фронтенда, если он отдаётся отдельным доменом/поддоменом через
# этот же Caddy (сейчас web отдаётся тем же контейнером за crm.royalhome.tj —
# блок ниже как справка на случай разделения доменов).
# app.royalhome.tj {
# 	header {
# 		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
# 		X-Content-Type-Options "nosniff"
# 		Referrer-Policy "strict-origin-when-cross-origin"
# 		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; connect-src 'self' https://crm.royalhome.tj; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
# 		X-Frame-Options "DENY"
# 	}
# 	reverse_proxy 127.0.0.1:8080
# }

royalhome.tj {
	request_body {
		max_size 10MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	rate_limit webhooks_zone
	reverse_proxy 127.0.0.1:3000
}
